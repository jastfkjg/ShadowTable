# 由部署环境注入，Node 不自动读取 .env；不要提交真实密钥。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DB_PATH=data/shadowtable.sqlite
# 仅本地测试可设1，生产必须禁用。
DEV_AUTH=0

# 本地陪测面板，生产始终不可用。
DEV_PANEL=0

# 正式管理平台（两项同时配置才启用），仅 HTTPS；密钥建议 openssl rand -hex 32
ADMIN_ORIGIN=
ADMIN_KEY=

# 网页版玩家入口（配置后启用网页前端与访客登录），仅 HTTPS；完整源地址，不含末尾斜线
WEB_ORIGIN=
