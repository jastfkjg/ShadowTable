    { "id": "good_stage", "label": "三绿阶段奖励", "points": 3, "when": { "faction": "good", "outcome": "loss", "reason": ["assassination", "early_assassination"], "roleIdNot": ["merlin", "percival"] } },
    { "id": "good_stage_role", "label": "梅林／派西三绿阶段奖励", "points": 2, "when": { "faction": "good", "outcome": "loss", "reason": ["assassination", "early_assassination"], "roleId": ["merlin", "percival"] } },
    { "id": "good_loss", "label": "好人失利", "points": 1, "when": { "faction": "good", "outcome": "loss", "reason": ["quest_fail", "five_rejections"] } },
    { "id": "evil_win", "label": "坏人获胜", "points": 9, "when": { "faction": "evil", "outcome": "win" } },
    { "id": "evil_loss", "label": "坏人失利", "points": 1, "when": { "faction": "evil", "outcome": "loss", "reason": ["assassination", "early_assassination"] } },
    { "id": "role", "label": "梅林／派西角色奖励", "points": 3, "when": { "faction": "good", "outcome": "win", "roleId": ["merlin", "percival"] } },
    { "id": "shield", "label": "挡刀奖励", "points": 6, "when": { "faction": "good", "outcome": "win", "reason": ["assassination", "early_assassination"], "isTarget": true, "roleIdNot": ["merlin", "percival"] } },
    { "id": "honor_mvp", "label": "MVP 票选奖励", "points": 1, "when": { "outcome": "win", "honor": "mvp" } },
    { "id": "honor_svp", "label": "SVP 票选奖励", "points": 1, "when": { "outcome": "loss", "honor": "svp" } }
