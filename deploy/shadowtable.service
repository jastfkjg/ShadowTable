[Unit]
Description=ShadowTable API
After=network.target

[Service]
Type=simple
User=shadowtable
Group=shadowtable
WorkingDirectory=/opt/shadowtable/current
EnvironmentFile=/etc/shadowtable.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shadowtable

[Install]
WantedBy=multi-user.target
