# Node receives these variables through Compose. Do not commit real keys.
WEB_ORIGIN=https://table.example.com
# Both empty disables the administrator interface.
ADMIN_ORIGIN=
ADMIN_KEY=
# Only needed for WeChat mini-program login, not web guest login.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Enable only after publishing pages/web-login/web-login in the mini-program.
WECHAT_WEB_LOGIN=0
# Custom avatars: enable after configuring the JSON safe-mode message callback.
# Callback URL: https://<API domain>/api/wechat/avatar-review
# Use the same token and EncodingAESKey as the WeChat message settings.
AVATAR_UPLOADS=0
AVATAR_PUBLIC_ORIGIN=
WECHAT_MESSAGE_TOKEN=
WECHAT_MESSAGE_AES_KEY=
# Daily verified local snapshots go to /data/backups (host: /opt/shadowtable/data/backups).
# No S3/OSS upload is enabled by the application.
CLEANUP_ENABLED=1
CLEANUP_BATCH_SIZE=100
CLEANUP_INTERVAL_MINUTES=60
ROOM_LOBBY_RETENTION_DAYS=7
ROOM_GRACE_DAYS=3
ROOM_ENDED_RETENTION_DAYS=30
ROOM_ENTRY_RETENTION_DAYS=90
RECEIPT_RETENTION_DAYS=90
