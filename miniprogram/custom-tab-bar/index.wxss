.custom-tab-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; display: flex; box-sizing: border-box; height: calc(112rpx + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); border-top: 1rpx solid #30404a; background: #101c24; }
.tab-item { flex: 1; min-width: 0; min-height: 112rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; color: #b1bfc6; font-size: 22rpx; line-height: 1.25; }
.tab-item.selected { color: #e5c68b; }
.tab-item:active { opacity: .7; }
.tab-icon { width: 48rpx; height: 48rpx; }
