:host { display: block; }
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: calc(50px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  border-top: 1px solid #17232b;
  background: #101c24;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  height: 49px;
  min-height: 44px;
  margin: 0;
  padding: 3px 0;
  border: 0;
  border-radius: 0;
  box-sizing: border-box;
  background: #101c24;
  color: #b1bfc6;
  line-height: 1;
}
.tab-item::after { border: 0; }
.tab-item.is-selected { color: #e5c68b; }
.tab-item:active { opacity: 1; }
.tab-icon { display: block; width: 24px; height: 24px; }
.tab-label { font-size: 10px; line-height: 14px; }
