<view wx:if="{{!keyboardVisible && !entrySheetVisible}}" class="tab-bar" role="tablist" aria-label="主导航">
  <button wx:for="{{list}}" wx:key="pagePath" class="tab-item {{selected === index ? 'is-selected' : ''}}" hover-class="none" data-index="{{index}}" bindtap="switchTab" role="tab" aria-label="{{item.text}}" aria-selected="{{selected === index}}">
    <image class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" aria-hidden="true" />
    <text class="tab-label">{{item.text}}</text>
  </button>
</view>
