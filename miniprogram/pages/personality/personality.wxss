.persona-portrait { position:relative; z-index:1; width:204px; height:204px; animation:persona-arrive .45s ease both; }
.persona-subtype { margin:0; font-size:32px; line-height:1.35; color:var(--text,#f2eee5); font-weight:650; letter-spacing:1px; }
