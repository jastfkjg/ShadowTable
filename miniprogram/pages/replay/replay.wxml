<app-nav class="replay-nav" title="对局复盘" back="{{true}}" bindback="back" />
<view class="page replay-page">
  <view wx:if="{{loading}}" class="status">正在读取对局复盘…</view>
  <view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button class="secondary" bindtap="load" disabled="{{loading}}" hover-class="none">重新加载</button></view>
  <block wx:if="{{replay && !loading && !error}}">
    <view class="replay-date">{{replay.dateLabel}} · {{replay.capacity}}人 · 已结束</view>
    <view class="replay-heading"><text class="replay-board">{{replay.boardName}}</text><text class="replay-badge {{replay.self.outcome}}">{{replay.outcomeLabel}}</text></view>
    <view class="replay-winner {{replay.winnerTone}}">{{replay.winnerLabel}}</view>
    <view class="replay-muted">{{replay.final.label}}{{replay.final.resultLabel?' · '+replay.final.resultLabel:''}}</view>
    <view class="replay-mine"><view><view class="replay-mine-name">{{replay.self.seat}}号 · {{replay.self.name}}（我）</view><view>初始 <text class="{{replay.initialSelf.faction}}">{{replay.initialSelf.roleLabel || '未记录'}}</text></view></view><view class="replay-points">{{replay.scoreLabel}}<text wx:if="{{replay.score.status==='scored'}}">分</text></view></view>
    <view wx:if="{{replay.message}}" class="replay-notice">{{replay.message}}</view>
    <view class="replay-quest-summary"><text class="replay-muted">任务结果 · {{questLabel}}</text><scroll-view wx:if="{{taskPips.length}}" class="replay-task-pips" scroll-x show-scrollbar="{{false}}"><view class="replay-pips-inner"><view wx:for="{{taskPips}}" wx:key="id" class="replay-pip {{item.success?'good':'evil'}}">{{item.number}} {{item.success?'✓':'×'}}</view></view></scroll-view></view>
    <view class="replay-tabs" role="tablist"><button class="{{view==='global'?'selected':''}}" data-view="global" bindtap="chooseView" role="tab" aria-selected="{{view==='global'}}" hover-class="none">全局复盘</button><button class="{{view==='mine'?'selected':''}}" data-view="mine" bindtap="chooseView" role="tab" aria-selected="{{view==='mine'}}" hover-class="none">我的视角</button></view>
    <view wx:if="{{view==='mine'}}" class="replay-note">仅显示我的行动与受到的影响。</view>
    <view id="replay-initial" class="replay-section">
      <view class="replay-section-heading"><text>初始身份</text><text wx:if="{{view==='global'}}" class="replay-legend"><text class="good">{{replay.goodCount}} 好人</text> / <text class="evil">{{replay.evilCount}} 坏人</text><text wx:if="{{replay.unknownCount}}"> / {{replay.unknownCount}} 未记录</text></text></view>
      <view class="replay-player-grid"><button wx:for="{{initialPlayers}}" wx:key="seat" class="replay-player {{item.isSelf?'is-self':''}}" data-seat="{{item.seat}}" bindtap="openPlayer" hover-class="none" aria-label="{{item.seat}}号{{item.name}}，初始{{item.roleLabel}}，查看身份轨迹"><view class="replay-seat-name"><text>{{item.seat}}号</text><text>{{item.name}}</text><text wx:if="{{item.isSelf}}" class="replay-self-tag">我</text></view><view class="replay-player-role {{item.faction}}">{{item.roleLabel}}</view></button></view>
    </view>
    <view class="replay-section">
      <view class="replay-section-heading"><text>每轮过程</text><text class="replay-legend">点击展开详情</text></view>
      <scroll-view class="replay-jumps" scroll-x show-scrollbar="{{false}}"><view class="replay-jumps-inner"><button data-id="replay-initial" bindtap="jumpTo" hover-class="none">开局</button><button wx:for="{{rounds}}" wx:key="id" data-id="{{item.id}}" bindtap="jumpTo" hover-class="none">{{item.number?'第'+item.number+'轮':'未记录轮次'}}</button><button data-id="replay-final" bindtap="jumpTo" hover-class="none">结算</button></view></scroll-view>
      <view wx:if="{{!rounds.length}}" class="replay-empty">每轮过程未记录。</view>
      <view wx:for="{{rounds}}" wx:for-item="round" wx:key="id" id="{{round.id}}" class="replay-round">
        <button class="disclosure-button replay-round-toggle" bindtap="toggleRound" data-id="{{round.id}}" aria-expanded="{{round.expanded}}" hover-class="none"><view class="replay-round-number">{{round.number || '–'}}</view><view class="replay-round-summary"><view class="replay-round-title"><text>{{round.title}}</text><view class="replay-round-result {{round.tone}}">{{round.badge}}<view class="replay-arrow {{round.expanded?'expanded':''}}" aria-hidden="true"></view></view></view><view class="replay-note">{{round.summary}}</view></view></button>
        <view wx:if="{{round.expanded}}" class="replay-stages">
          <view wx:if="{{!round.events.length}}" class="replay-note">本轮没有我的行动记录。</view>
          <view wx:for="{{round.events}}" wx:for-item="event" wx:key="id" class="replay-stage">
            <view class="replay-stage-dot" aria-hidden="true"></view><view class="replay-stage-heading"><text>{{event.title}}</text><text wx:if="{{event.badge}}" class="replay-badge {{event.tone}}">{{event.badge}}</text></view>
            <view wx:if="{{event.summary}}" class="replay-event-summary">{{event.summary}}</view>
            <view wx:for="{{event.rows}}" wx:for-item="row" wx:key="id" class="replay-action"><view class="replay-action-heading"><text class="{{row.tone}}">{{row.headline}}</text><text class="replay-note">{{row.action}}</text></view><view class="replay-action-detail">{{row.detail}}</view><view wx:if="{{row.result}}" class="replay-action-result">{{row.result}}</view></view>
            <block wx:if="{{event.drawRows.length}}"><view class="replay-draw-heading">抽取 B 牌</view><view wx:for="{{event.drawRows}}" wx:for-item="draw" wx:key="id" class="replay-draw"><view>{{draw.headline}}</view><view class="{{draw.tone}}">{{draw.detail}}</view><view class="replay-note">{{draw.result}}</view></view><view class="replay-note">新身份技能在下一轮启用。</view></block>
            <view wx:if="{{event.confirmationsLabel}}" class="replay-note replay-confirmations">{{event.confirmationsLabel}}</view>
            <view wx:if="{{event.footer}}" class="replay-event-footer">{{event.footer}}</view>
          </view>
        </view>
      </view>
    </view>
    <view id="replay-final" class="replay-section replay-final">
      <view class="replay-section-heading"><text>最终结算</text><text class="replay-legend">{{replay.final.label}}</text></view>
      <view wx:if="{{replay.final.targetSeat!==null}}" class="replay-final-knife"><view class="{{replay.final.actor.faction}}">{{replay.final.actorLabel}}</view><view class="replay-final-arrow" aria-hidden="true">→</view><view class="{{replay.final.target.faction}}">{{replay.final.targetLabel}}</view></view>
      <view wx:if="{{replay.final.resultLabel}}" class="replay-final-verdict {{replay.winnerTone}}">{{replay.final.resultLabel}} · {{replay.winnerLabel}}</view>
      <view wx:if="{{replay.final.corrected}}" class="replay-note">最终结算已按管理员更正后的结果更新。</view>
      <view wx:if="{{replay.excludedReason}}" class="replay-notice">不计入原因：{{replay.excludedReason}}</view>
      <view class="replay-my-result"><text>我的结果</text><view class="replay-score-line"><text class="{{replay.self.outcome==='loss'?'evil':replay.self.outcome==='win'?'good':'neutral'}}">{{replay.selfFactionLabel}}阵营 · {{replay.outcomeLabel}}</text><text class="replay-points">{{replay.scoreLabel}}<text wx:if="{{replay.score.status==='scored'}}">分</text></text></view><view wx:for="{{replay.score.breakdown}}" wx:key="id" class="replay-score-award"><text>{{item.label}}</text><text class="accent">{{item.pointsLabel}}</text></view><view wx:if="{{replay.score.manualOverride}}" class="replay-note">管理员调整：{{replay.score.manualOverride.reason}}</view><view wx:if="{{replay.score.status!=='scored'}}" class="replay-note">{{replay.score.reason || '本局未计分'}}</view></view>
      <view class="replay-section-heading replay-personal-title">我的身份与行动</view>
      <view class="replay-path"><view wx:for="{{selfTrajectory.steps}}" wx:key="id" class="replay-path-step"><view class="replay-note">{{item.label}}</view><view class="{{item.tone}}">{{item.text}}</view><view wx:if="{{item.detail}}" class="replay-note">{{item.detail}}</view></view></view>
      <button class="disclosure-button replay-all-players" bindtap="togglePlayers" aria-expanded="{{playersExpanded}}" hover-class="none"><text>{{playersExpanded?'收起':'查看'}}所有玩家身份轨迹</text><view class="replay-arrow {{playersExpanded?'expanded':''}}" aria-hidden="true"></view></button>
      <view wx:if="{{playersExpanded}}" class="replay-player-grid"><button wx:for="{{finalPlayers}}" wx:key="seat" class="replay-player {{item.isSelf?'is-self':''}}" data-seat="{{item.seat}}" bindtap="openPlayer" hover-class="none" aria-label="{{item.seat}}号{{item.name}}，最终{{item.roleLabel}}，查看身份轨迹"><view class="replay-seat-name"><text>{{item.seat}}号</text><text>{{item.name}}</text></view><view class="replay-player-role {{item.faction}}">{{item.roleLabel}}</view><view class="replay-note">{{item.alive?'在场':'已出局'}}</view></button></view>
      <view class="replay-end">本局记录结束</view>
    </view>
  </block>
</view>
<view wx:if="{{playerDetail}}" class="replay-backdrop" catchtap="closePlayer" catchtouchmove="blockScroll"><view class="replay-sheet" catchtap="blockScroll" role="dialog" aria-modal="true" aria-label="{{playerDetail.seat}}号{{playerDetail.name}}身份轨迹"><view class="replay-sheet-heading"><text>{{playerDetail.seat}}号 · {{playerDetail.name}}</text><button bindtap="closePlayer" aria-label="关闭身份轨迹" hover-class="none">×</button></view><scroll-view class="replay-sheet-body" scroll-y enhanced show-scrollbar="{{false}}"><view class="replay-path"><view wx:for="{{playerDetail.steps}}" wx:key="id" class="replay-path-step"><view class="replay-note">{{item.label}}</view><view class="{{item.tone}}">{{item.text}}</view><view wx:if="{{item.detail}}" class="replay-note">{{item.detail}}</view></view></view></scroll-view></view></view>
