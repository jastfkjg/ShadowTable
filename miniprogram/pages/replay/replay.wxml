<app-nav class="replay-nav" title="对局复盘" back="{{true}}" bindback="back" />
<view class="page replay-page">
  <view wx:if="{{loading}}" class="status">正在读取对局复盘…</view>
  <view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button class="secondary" bindtap="load" disabled="{{loading}}" hover-class="none">重新加载</button></view>
  <block wx:if="{{replay && !loading && !error}}">
    <view class="replay-overview">
    <view class="replay-date"><image src="/assets/record-calendar.svg" aria-hidden="true" /><text>{{replay.dateLabel}} · {{replay.capacity}}人 · 已结束</text></view>
    <view class="replay-heading"><text class="replay-board">{{replay.boardName}}</text><text class="replay-badge {{replay.self.outcome}}">{{replay.outcomeLabel}}</text></view>
    <view class="replay-result-heading"><view class="replay-result-symbol" aria-hidden="true"><image src="/assets/record-cup.svg" /></view><view class="replay-result-copy"><view class="replay-winner {{replay.winnerTone}}">{{replay.winnerLabel}}</view><view class="replay-muted">{{replay.final.label}}{{replay.final.resultLabel?' · '+replay.final.resultLabel:''}}</view></view></view>
    <view class="replay-mine"><image wx:if="{{replay.initialSelf.rolePortrait}}" class="replay-mine-portrait" src="{{replay.initialSelf.rolePortrait}}" mode="aspectFit" aria-hidden="true" /><view class="replay-mine-copy"><view class="replay-mine-name">{{replay.self.seat}}号 · {{replay.self.name}}（我）</view><view>初始 <text class="{{replay.initialSelf.faction}}">{{replay.initialSelf.roleLabel || '未记录'}}</text></view></view><view class="replay-points {{replay.score.status!=='scored'?'is-unscored':''}}">{{replay.scoreLabel}}<text wx:if="{{replay.score.status==='scored'}}">分</text></view></view>
    </view>
    <view wx:if="{{replay.message}}" class="replay-notice"><image src="/assets/record-info.svg" aria-hidden="true" /><text>{{replay.message}}</text></view>
    <view class="replay-quest-summary"><text class="replay-muted">任务结果 · {{questLabel}}</text><scroll-view wx:if="{{taskPips.length}}" class="replay-task-pips" scroll-x show-scrollbar="{{false}}"><view class="replay-pips-inner"><view wx:for="{{taskPips}}" wx:key="id" class="replay-pip {{item.success?'good':'evil'}}">{{item.number}} {{item.success?'✓':'×'}}</view></view></scroll-view></view>
    <view class="replay-tabs" role="tablist"><button class="{{view==='global'?'selected':''}}" data-view="global" bindtap="chooseView" role="tab" aria-selected="{{view==='global'}}" hover-class="none">全局复盘</button><button class="{{view==='mine'?'selected':''}}" data-view="mine" bindtap="chooseView" role="tab" aria-selected="{{view==='mine'}}" hover-class="none">我的视角</button></view>
    <view wx:if="{{view==='mine'}}" class="replay-note">仅显示我的行动与受到的影响。</view>
    <view id="replay-initial" class="replay-section">
      <view class="replay-section-heading"><view class="replay-section-title"><image src="/assets/record-users.svg" aria-hidden="true" /><text>初始身份</text></view><text wx:if="{{view==='global'}}" class="replay-legend"><text class="good">{{replay.goodCount}} 好人</text> / <text class="evil">{{replay.evilCount}} 坏人</text><text wx:if="{{replay.unknownCount}}"> / {{replay.unknownCount}} 未记录</text></text></view>
      <view class="replay-player-grid {{view==='mine'?'is-mine-view':''}}"><button wx:for="{{initialPlayers}}" wx:key="seat" class="replay-player {{item.isSelf?'is-self':''}}" data-seat="{{item.seat}}" bindtap="openPlayer" hover-class="ledger-pressed" aria-label="{{item.seat}}号{{item.name}}，初始{{item.roleLabel}}，查看身份轨迹"><view class="replay-seat-name"><text>{{item.seat}}号</text><text>{{item.name}}</text><text wx:if="{{item.isSelf}}" class="replay-self-tag">我</text></view><image wx:if="{{item.rolePortrait}}" class="replay-player-portrait" src="{{item.rolePortrait}}" mode="aspectFit" aria-hidden="true" /><view wx:else class="replay-player-unknown" aria-hidden="true">?</view><view class="replay-player-role {{item.faction}}"><view class="replay-faction-dot is-{{item.faction}}" aria-hidden="true"></view><text>{{item.roleLabel}}</text></view></button></view>
    </view>
    <view class="replay-section">
      <view class="replay-section-heading"><view class="replay-section-title"><image src="/assets/record-list.svg" aria-hidden="true" /><text>每轮过程</text></view><text class="replay-legend">{{rounds.length}} 轮记录</text></view>
      <scroll-view class="replay-jumps" scroll-x show-scrollbar="{{false}}"><view class="replay-jumps-inner"><button class="{{activeRoundId==='replay-initial'?'selected':''}}" data-id="replay-initial" bindtap="jumpTo" hover-class="none">开局</button><button wx:for="{{rounds}}" wx:key="id" class="{{activeRoundId===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="jumpTo" hover-class="none">{{item.number?'第'+item.number+'轮':'未记录轮次'}}</button><button class="{{activeRoundId==='replay-final'?'selected':''}}" data-id="replay-final" bindtap="jumpTo" hover-class="none">结算</button></view></scroll-view>
      <view wx:if="{{!rounds.length}}" class="replay-empty">每轮过程未记录。</view>
      <view wx:for="{{rounds}}" wx:for-item="round" wx:key="id" id="{{round.id}}" class="replay-round {{round.expanded?'is-expanded':''}}">
        <button class="disclosure-button replay-round-toggle" bindtap="toggleRound" data-id="{{round.id}}" aria-expanded="{{round.expanded}}" aria-label="{{round.title}}，{{round.badge}}，{{round.expanded?'收起':'展开'}}详情" hover-class="none"><view class="replay-round-number">{{round.number || '–'}}</view><view class="replay-round-summary"><view class="replay-round-title"><text>{{round.title}}</text><view class="replay-round-result"><text class="replay-badge {{round.tone}}">{{round.badge}}</text><view class="replay-arrow {{round.expanded?'expanded':''}}" aria-hidden="true"></view></view></view><view wx:if="{{!round.expanded}}" class="replay-note">{{round.summary}}</view></view></button>
        <view wx:if="{{round.expanded}}" class="replay-stages">
          <view wx:if="{{!round.events.length}}" class="replay-note">本轮没有我的行动记录。</view>
          <view wx:for="{{round.events}}" wx:for-item="event" wx:key="id" class="replay-stage">
            <view class="replay-stage-heading"><text>{{event.title}}</text><text wx:if="{{event.badge && !event.hideBadge}}" class="{{event.kind==='skills'?'replay-legend':'replay-badge '+event.tone}}">{{event.badge}}</text></view>
            <view wx:if="{{event.stats.length}}" class="replay-task-summary">
              <view class="replay-stats"><view wx:for="{{event.stats}}" wx:for-item="stat" wx:key="id" class="replay-stat"><view class="replay-stat-value {{stat.tone}}">{{stat.value}}<text>{{stat.unit}}</text></view><view class="replay-stat-label">{{stat.label}}</view></view></view>
              <view class="replay-team"><text class="replay-team-label">{{event.kind==='vote'?'组队队伍':'任务队伍'}}</text><text>{{event.teamLabel}}</text></view>
              <view wx:if="{{event.leader}}" class="replay-note replay-leader">{{event.leader}}号带队</view>
            </view>
            <view wx:if="{{event.summary && !event.stats.length}}" class="replay-event-summary">{{event.summary}}</view>
            <block wx:if="{{event.kind==='vote' || event.kind==='quest'}}">
              <view wx:if="{{event.rows.length}}" class="replay-roster-heading">{{event.kind==='vote'?'投票明细':'逐人出牌'}}</view>
              <view class="replay-ballots"><view wx:for="{{event.rows}}" wx:for-item="row" wx:key="id" class="replay-ballot"><text class="replay-ballot-player">{{row.headline}}</text><text class="replay-ballot-value {{row.tone}}">{{row.detail}}</text></view></view>
            </block>
            <block wx:else>
              <view wx:for="{{event.rows}}" wx:for-item="row" wx:key="id" class="replay-action {{event.kind==='conversion'?'replay-conversion':''}}">
                <view class="replay-action-heading"><view class="replay-actor"><text wx:if="{{row.actorSeat}}" class="replay-actor-seat {{row.tone}}">{{row.actorSeat}}号</text><text class="replay-actor-role {{row.tone}}">{{row.actorLabel || row.headline}}</text></view><text wx:if="{{row.action}}" class="replay-note replay-action-kind">{{row.action}}</text></view>
                <view wx:if="{{event.kind==='conversion'}}" class="replay-conversion-result"><text class="{{row.beforeTone}}">{{row.beforeLabel}}</text><text class="replay-note" aria-hidden="true">→</text><text class="{{row.tone}}">{{row.afterLabel}}</text></view>
                <block wx:else>
                  <view class="replay-action-detail {{row.targetLabel?'has-target':''}}"><view wx:if="{{row.targetLabel}}" class="replay-target-arrow" aria-hidden="true"></view><text>{{row.targetLabel || row.detail}}</text></view>
                  <view wx:if="{{row.extraDetail}}" class="replay-note replay-action-extra">{{row.extraDetail}}</view>
                  <view wx:if="{{row.result}}" class="replay-action-result {{row.resultTone}}"><view wx:if="{{event.kind==='skills'}}" class="replay-result-marker" aria-hidden="true"></view><text>{{row.resultLabel || row.result}}</text></view>
                </block>
              </view>
            </block>
            <block wx:if="{{event.drawRows.length}}"><view class="replay-draw-heading">抽取 B 牌</view><view wx:for="{{event.drawRows}}" wx:for-item="draw" wx:key="id" class="replay-draw"><view>{{draw.headline}}</view><view class="{{draw.tone}}">{{draw.detail}}</view><view class="replay-note">{{draw.result}}</view></view><view class="replay-note">新身份技能在下一轮启用。</view></block>
            <view wx:if="{{event.settlements.length}}" class="replay-settlements"><view wx:for="{{event.settlements}}" wx:for-item="settlement" wx:key="id" class="replay-settlement"><text class="replay-note">{{settlement.label}}</text><text class="{{settlement.tone}}">{{settlement.text}}</text></view></view>
            <view wx:if="{{event.confirmationsLabel}}" class="replay-note replay-confirmations">{{event.confirmationsLabel}}</view>
            <view wx:if="{{event.footer}}" class="replay-event-footer">{{event.footer}}</view>
          </view>
        </view>
      </view>
    </view>
    <view id="replay-final" class="replay-section replay-final">
      <view class="replay-section-heading"><view class="replay-section-title"><image src="/assets/record-swords.svg" aria-hidden="true" /><text>最终结算</text></view><text class="replay-legend">{{replay.final.summaryLabel}}</text></view>
      <view class="replay-final-summary">
        <block wx:if="{{replay.final.hasKnife}}">
          <view class="replay-final-context"><image src="/assets/record-sword.svg" aria-hidden="true" /><text>最终盘刀</text></view>
          <view class="replay-final-knife">
            <view class="replay-final-player">
              <image wx:if="{{replay.final.actor.rolePortrait}}" class="replay-final-portrait" src="{{replay.final.actor.rolePortrait}}" mode="aspectFit" aria-hidden="true" /><view wx:else class="replay-final-portrait replay-final-unknown" aria-hidden="true">?</view>
              <view wx:if="{{replay.final.actor}}" class="replay-final-seat">{{replay.final.actor.seat}}号</view>
              <view class="replay-final-role {{replay.final.actor.faction || 'unknown'}}">{{replay.final.actor.roleLabel || '带刀人未记录'}}</view>
            </view>
            <view class="replay-final-direction"><view class="replay-final-arrow" aria-hidden="true"></view><text>刺杀目标</text></view>
            <view class="replay-final-player">
              <image wx:if="{{replay.final.targetSeat!==0 && replay.final.target.rolePortrait}}" class="replay-final-portrait" src="{{replay.final.target.rolePortrait}}" mode="aspectFit" aria-hidden="true" /><view wx:else class="replay-final-portrait replay-final-unknown" aria-hidden="true">{{replay.final.targetSeat===0?'0':'?'}}</view>
              <view class="replay-final-seat">{{replay.final.targetSeat}}号</view>
              <view class="replay-final-role {{replay.final.targetSeat===0?'neutral':replay.final.target.faction || 'unknown'}}">{{replay.final.targetSeat===0?'空刀':replay.final.target.roleLabel || '目标身份未记录'}}</view>
            </view>
          </view>
        </block>
        <view class="replay-final-verdict is-{{replay.winnerTone}}">
          <view class="replay-verdict-symbol {{replay.winnerTone}}" aria-hidden="true"><view wx:if="{{replay.winner}}" class="replay-verdict-check"></view><text wx:else>—</text></view>
          <view class="replay-verdict-copy"><view class="replay-verdict-title {{replay.winnerTone}}">{{replay.winnerLabel}}</view><view wx:if="{{replay.final.resultLabel}}" class="replay-note">{{replay.final.resultLabel}}</view></view>
          <text class="replay-verdict-tag {{replay.winnerTone}}">最终结果</text>
        </view>
      </view>
      <view wx:if="{{replay.final.corrected}}" class="replay-note replay-final-note">最终结算已按管理员更正后的结果更新。</view>
      <view wx:if="{{replay.excludedReason}}" class="replay-notice">不计入原因：{{replay.excludedReason}}</view>
      <view class="replay-my-result"><view class="replay-score-line"><view class="replay-my-outcome"><view class="replay-note">我的结果</view><view class="{{replay.self.outcome==='loss'?'evil':replay.self.outcome==='win'?'good':'neutral'}}">{{replay.selfFactionLabel}}阵营 · {{replay.outcomeLabel}}</view></view><view class="replay-my-points"><view class="replay-points {{replay.score.status!=='scored'?'is-unscored':''}}">{{replay.scoreLabel}}<text wx:if="{{replay.score.status==='scored'}}">分</text></view><view class="replay-note">本局积分</view></view></view><view wx:for="{{replay.score.breakdown}}" wx:key="id" class="replay-score-award"><text>{{item.label}}</text><text class="accent">{{item.pointsLabel}}</text></view><view wx:if="{{replay.score.manualOverride}}" class="replay-note replay-score-note">管理员调整：{{replay.score.manualOverride.reason}}</view><view wx:if="{{replay.score.status!=='scored'}}" class="replay-note replay-score-note">{{replay.score.reason || '本局未计分'}}</view></view>
      <view class="replay-section-heading replay-personal-title"><view class="replay-section-title"><image src="/assets/record-list.svg" aria-hidden="true" /><text>我的身份与行动</text></view><text class="replay-legend">{{replay.self.seat}}号 · 我</text></view>
      <template is="replayTrajectory" data="{{steps:selfTrajectory.steps}}" />
      <button class="disclosure-button replay-all-players" bindtap="togglePlayers" aria-expanded="{{playersExpanded}}" hover-class="none"><view class="replay-all-players-label"><image src="/assets/record-users.svg" aria-hidden="true" /><text>{{playersExpanded?'收起':'查看'}}所有玩家身份轨迹</text></view><view class="replay-arrow {{playersExpanded?'expanded':''}}" aria-hidden="true"></view></button>
      <block wx:if="{{playersExpanded}}"><view class="replay-note replay-players-hint">按最终身份展示，点击查看完整轨迹</view><view class="replay-player-grid"><button wx:for="{{finalPlayers}}" wx:key="seat" class="replay-player {{item.isSelf?'is-self':''}}" data-seat="{{item.seat}}" bindtap="openPlayer" hover-class="ledger-pressed" aria-label="{{item.seat}}号{{item.name}}，最终{{item.roleLabel}}，{{item.alive?'在场':'已出局'}}，查看身份轨迹"><view class="replay-seat-name"><text>{{item.seat}}号</text><text>{{item.name}}</text><text wx:if="{{item.isSelf}}" class="replay-self-tag">我</text></view><image wx:if="{{item.rolePortrait}}" class="replay-player-portrait" src="{{item.rolePortrait}}" mode="aspectFit" aria-hidden="true" /><view wx:else class="replay-player-unknown" aria-hidden="true">?</view><view class="replay-player-role {{item.faction}}"><view class="replay-faction-dot is-{{item.faction}}" aria-hidden="true"></view><text>{{item.roleLabel}}</text></view><view class="replay-note">{{item.alive?'在场':'已出局'}}</view></button></view></block>
      <view class="replay-end">本局记录结束</view>
    </view>
  </block>
</view>
<template name="replayTrajectory">
  <view class="replay-path"><view wx:for="{{steps}}" wx:key="id" class="replay-path-step">
    <view class="replay-path-heading"><text class="replay-path-stage">{{item.stageLabel}}</text><text>{{item.actionLabel}}</text></view>
    <view class="replay-path-content {{item.isAction?'is-action':''}}"><image wx:if="{{item.rolePortrait}}" class="replay-path-portrait" src="{{item.rolePortrait}}" mode="aspectFit" aria-hidden="true" /><view class="replay-path-copy"><view class="replay-path-text {{item.textTone || item.tone}}">{{item.text}}</view><view wx:if="{{item.contextLabel || item.statusLabel}}" class="replay-path-context"><image wx:if="{{item.isAction && item.contextLabel}}" src="/assets/record-info.svg" aria-hidden="true" /><text wx:if="{{item.contextLabel}}">{{item.contextLabel}}</text><text wx:if="{{item.statusLabel}}" class="replay-presence {{item.alive?'':'is-out'}}">{{item.statusLabel}}</text></view></view></view>
  </view></view>
</template>
<view wx:if="{{playerDetail}}" class="replay-backdrop" catchtap="closePlayer" catchtouchmove="blockScroll"><view class="replay-sheet" catchtap="blockScroll" role="dialog" aria-modal="true" aria-label="{{playerDetail.seat}}号{{playerDetail.name}}身份轨迹">
  <view class="replay-sheet-handle" aria-hidden="true"></view>
  <view class="replay-sheet-heading"><view class="replay-sheet-identity"><view class="replay-sheet-name"><text>{{playerDetail.seat}}号 · {{playerDetail.name}}</text><text wx:if="{{playerDetail.isSelf}}" class="replay-sheet-self">我</text></view><view class="replay-note">身份轨迹</view></view><button bindtap="closePlayer" aria-label="关闭身份轨迹" hover-class="ledger-pressed">×</button></view>
  <view class="replay-sheet-profile"><image wx:if="{{playerDetail.finalPlayer.rolePortrait}}" class="replay-sheet-portrait" src="{{playerDetail.finalPlayer.rolePortrait}}" mode="aspectFit" aria-hidden="true" /><view wx:else class="replay-sheet-portrait replay-final-unknown" aria-hidden="true">?</view><view class="replay-sheet-role-copy"><view class="replay-sheet-role {{playerDetail.finalPlayer.faction || 'unknown'}}">{{playerDetail.finalPlayer.roleLabel || '最终身份未记录'}}</view><view class="replay-note">{{playerDetail.finalPlayer?playerDetail.finalPlayer.factionLabel+'阵营 · 最终身份':'最终身份未记录'}}</view></view><text wx:if="{{playerDetail.finalPlayer}}" class="replay-presence {{playerDetail.finalPlayer.alive?'':'is-out'}}">{{playerDetail.finalPlayer.alive?'在场':'已出局'}}</text></view>
  <scroll-view class="replay-sheet-body" scroll-y enhanced show-scrollbar="{{false}}"><template is="replayTrajectory" data="{{steps:playerDetail.steps}}" /></scroll-view>
  <button class="primary replay-sheet-done" bindtap="closePlayer" hover-class="ledger-pressed">完成</button>
</view></view>
