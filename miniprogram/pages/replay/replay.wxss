.replay-faction-dot { flex-shrink:0; width:5px; height:5px; margin-top:6px; border-radius:50%; background:var(--muted); }.replay-faction-dot.is-good { background:var(--good); }.replay-faction-dot.is-evil { background:var(--evil); }.replay-faction-dot.is-third { background:var(--third); }
.replay-player-grid.is-mine-view { grid-template-columns:1fr; }.is-mine-view button.replay-player { flex-direction:row; align-items:center; gap:10px; min-height:76px; padding:8px 12px; }.is-mine-view .replay-seat-name { width:auto; max-width:40%; }.is-mine-view .replay-player-role { width:auto; min-height:0; align-items:center; }.is-mine-view .replay-faction-dot { margin-top:0; }
.replay-page .ledger-pressed { opacity:.72; }
.replay-jumps { margin: 9px 0 0; border-bottom: 1rpx solid var(--replay-divider); }.replay-jumps-inner { display: inline-flex; min-width: 100%; white-space: nowrap; }
.replay-jumps button { position: relative; flex: 1 0 auto; width: auto; min-width: 44px; min-height: 48px; margin: 0; padding: 8px 9px; color: var(--muted); border-radius: 0; font-size: 12px; font-weight: 400; }
.replay-jumps button.selected { color: var(--accent); font-weight: 600; }.replay-jumps button.selected::before { content: ""; position: absolute; left: 10px; right: 10px; bottom: 0; height: 2px; background: var(--accent); border-radius: 2px; }
.replay-round { margin-top:10px; padding:0 14px; border-radius:20px; background:var(--surface); }
