.replay-points { flex-shrink:0; max-width:42%; color:var(--accent); font-size:23px; font-weight:600; line-height:1.4; overflow-wrap:anywhere; font-variant-numeric:tabular-nums; }.replay-points text { margin-left:3px; font-size:12px; font-weight:400; }.replay-points.is-unscored { font-size:15px; font-weight:500; }
.replay-notice { display:flex; align-items:flex-start; gap:7px; padding:0 3px; margin:15px 0; color:var(--muted); font-size:12px; line-height:1.8; }.replay-notice image { flex-shrink:0; width:15px; height:15px; margin-top:3px; }.replay-notice text { min-width:0; }
.replay-quest-summary { margin:18px 2px 0; }.replay-quest-summary>.replay-muted { font-size:12px; }.replay-task-pips { width:100%; margin-top:9px; }.replay-pips-inner { display:flex; min-width:100%; gap:8px; padding-bottom:2px; }
.replay-pip { display:flex; align-items:center; justify-content:center; flex:1 0 44px; min-width:44px; height:35px; padding:0 7px; box-sizing:border-box; border-radius:10px; font-size:12px; }.replay-pip.good { background:rgba(163,223,190,.08); }.replay-pip.evil { background:rgba(242,182,174,.08); }
.replay-tabs { display:flex; gap:3px; padding:3px; margin:19px 0 0; border-radius:12px; background:var(--surface); }
.replay-tabs button { position:relative; flex:1; min-width:0; width:0; min-height:44px; margin:0; padding:8px; border-radius:9px; color:var(--muted); font-size:13px; font-weight:400; }.replay-tabs button.selected { color:var(--accent); background:#30424d; font-weight:600; }
