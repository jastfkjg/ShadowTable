.replay-page { --replay-divider: rgba(177,191,198,.13); max-width:600px; padding:12px 16px calc(32px + env(safe-area-inset-bottom)); font-size:14px; }
.replay-page .inline-error button { min-height:44px; }
.replay-page .good, .replay-sheet .good { color:var(--good); }.replay-page .evil, .replay-sheet .evil { color:var(--evil); }
.replay-page .unknown, .replay-page .neutral { color:var(--muted); }.replay-page .accent { color:var(--accent); }.replay-page .third { color:var(--third); }
.replay-date, .replay-note, .replay-legend { color:var(--muted); font-size:12px; line-height:1.7; }
.replay-muted { color:var(--muted); font-size:12px; line-height:1.7; }
