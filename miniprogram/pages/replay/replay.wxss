.replay-section { margin-top:24px; }.replay-section-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px 12px; font-size:16px; font-weight:600; }.replay-section-title { display:flex; align-items:center; gap:6px; }.replay-section-title image { width:17px; height:17px; flex-shrink:0; }.replay-legend { font-size:12px; font-weight:400; text-align:right; }
