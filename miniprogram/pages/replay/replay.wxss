.replay-sheet-handle { flex-shrink:0; width:38px; height:4px; margin:0 auto 17px; border-radius:4px; background:var(--border); }.replay-sheet-heading { display:flex; flex-shrink:0; justify-content:space-between; align-items:center; gap:12px; margin-bottom:15px; }.replay-sheet-identity { flex:1; min-width:0; }.replay-sheet-name { display:flex; align-items:baseline; flex-wrap:wrap; gap:6px; font-size:18px; font-weight:600; }.replay-sheet-name>text { min-width:0; overflow-wrap:anywhere; }.replay-sheet-name .replay-sheet-self { color:var(--accent); font-size:12px; font-weight:400; }.replay-sheet-identity>.replay-note { margin-top:4px; }.replay-sheet-heading button { flex-shrink:0; width:44px; min-width:44px; min-height:44px; margin:0 -10px 0 0; padding:0; color:var(--muted); font-size:28px; font-weight:400; }
.replay-sheet-profile { display:flex; flex-shrink:0; align-items:center; gap:12px; padding:5px 0 19px; border-bottom:1px solid rgba(177,191,198,.14); }.replay-sheet-portrait { flex-shrink:0; width:52px; height:52px; }.replay-sheet-role-copy { flex:1; min-width:0; overflow-wrap:anywhere; }.replay-sheet-role { font-size:18px; font-weight:500; line-height:1.4; }.replay-sheet-profile .replay-presence { padding:3px 8px; }
.replay-sheet-body { flex-shrink:1; min-height:0; height:44vh; max-height:420px; }.replay-sheet .replay-path { padding-top:5px; margin-top:18px; }.replay-sheet .replay-path-step { padding-bottom:24px; }.replay-sheet .replay-path-step:last-child { padding-bottom:8px; }.replay-sheet .replay-path-step::before { box-shadow:0 0 0 4px var(--surface); }.replay-sheet .replay-path-portrait { width:40px; height:40px; }.replay-sheet .is-action .replay-path-portrait { width:32px; height:32px; }.replay-sheet .replay-path-text { font-size:14px; }.replay-sheet .replay-note { color:var(--muted); }
button.replay-sheet-done { flex-shrink:0; width:100%; min-height:48px; margin:20px 0 0; border-radius:var(--dialog-control-radius); font-size:16px; }
@keyframes replay-sheet-in { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
@media (max-width:350px) { .replay-page { padding-left:12px; padding-right:12px; }.replay-overview { padding-left:12px; padding-right:12px; }.replay-board { font-size:16px; }.replay-player-grid { gap:5px; padding:7px; }.replay-seat-name { font-size:10px; }.replay-player-grid .replay-player-role { font-size:12px; }.replay-round { padding-left:12px; padding-right:12px; }.replay-round-result { gap:6px; }.replay-final-knife { padding-left:8px; padding-right:8px; gap:4px; }.replay-final-role { font-size:13px; }.replay-verdict-tag { font-size:10px; padding:3px 5px; }.replay-sheet { padding-left:18px; padding-right:18px; } }
@media (max-height:500px) { .replay-sheet { max-height:96vh; padding-bottom:calc(12px + env(safe-area-inset-bottom)); }.replay-sheet-body { height:46vh; } }
@media (min-width: 600px) { .replay-page { padding: 24px 24px calc(32px + env(safe-area-inset-bottom)); }.replay-player-grid { grid-template-columns: repeat(4,minmax(0,1fr)); } }
@media (prefers-reduced-motion: reduce) { .replay-arrow { transition: none; }.replay-sheet { animation: none; } }
