@import "./layout.wxss";

.fb-compose {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  color: var(--text);
}

.fb-form, .fb-footer {
  width: 100%;
  max-width: 600px;
  align-self: center;
  box-sizing: border-box;
}
.fb-form { padding: 22px 18px 28px; }
.fb-field + .fb-field { margin-top: 24px; }
.fb-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 10px;
  font-size: 17px;
  font-weight: 600;
}
.fb-area-grid, .fb-photos {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}
/* Pin the button to its track, including when WeChat applies its native size rules. */
.fb-area-grid button.fb-area[size="mini"] {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 6px 2px;
  box-sizing: border-box;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--control-bg);
  color: var(--text);
  font-size: 14px;
  font-weight: 400;
  line-height: 1.4;
}
.fb-area-grid button.fb-area.selected {
  background: rgba(229, 198, 139, .12);
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 600;
}

.fb-inputbox {
  padding: 14px 14px 10px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface);
}
.fb-inputbox:focus-within { border-color: var(--accent); }
.fb-inputbox textarea {
  display: block;
  width: 100%;
  height: 148px;
  padding: 0;
  box-sizing: border-box;
  background: transparent;
  color: var(--text);
  font-size: 16px;
  line-height: 1.6;
}
.fb-count { text-align: right; margin-top: 6px; }
.fb-photos { max-width: 384px; }
.fb-photos .fb-thumb, .fb-photos button.fb-add {
  position: relative;
  width: 100%;
  height: 76px;
  border-radius: 12px;
}
.fb-thumb image { display: block; width: 100%; height: 100%; border-radius: inherit; }
.fb-photos button.fb-add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 6px;
  min-height: 0;
  margin: 0;
  padding: 4px 0;
  border: 1px dashed var(--control-border);
  background: var(--control-bg);
  color: var(--muted);
  font-size: 12px;
  font-weight: 400;
  line-height: 1.4;
}
.fb-plus { position: relative; width: 18px; height: 18px; }
.fb-plus::before, .fb-plus::after { content: ""; position: absolute; top: 8px; left: 1px; width: 16px; height: 2px; border-radius: 1px; background: currentColor; }
.fb-plus::after { transform: rotate(90deg); }
.fb-thumb button.fb-remove {
  display: flex;
  position: absolute;
  top: -4px; right: -4px;
  align-items: flex-start; justify-content: flex-end;
  width: 44px; height: 44px; min-height: 0; margin: 0; padding: 4px;
  color: var(--text); background: transparent;
}
.fb-remove text { width: 23px; line-height: 23px; border-radius: 50%; background: var(--bg); text-align: center; font-size: 18px; }
.fb-footer {
  margin-top: auto;
  padding: 12px 18px calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid rgba(177,191,198,.16);
}
.fb-footer button.fb-send, .fb-footer button.fb-send[disabled]:not([type]) {
  width: 100%; min-height: 48px; margin: 0; padding: 10px 16px; border-radius: 12px;
}
.fb-footer button.fb-send[disabled]:not([type]) {
  opacity: 1; color: var(--muted); background: var(--surface); border-color: var(--surface);
}
.fb-error { margin-bottom: 10px; color: var(--evil); font-size: 14px; }

@media (max-height: 680px) {
  .fb-form { padding-top: 16px; padding-bottom: 20px; }
  .fb-field + .fb-field { margin-top: 18px; }
  .fb-inputbox textarea { height: 108px; }
}
@media (max-width: 319px) {
  .fb-area-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
