.fb-receipt { display: flex; align-items: center; gap: 14px; margin: 2px 0 24px; }
.fb-receipt-title { font-size: 23px; font-weight: 600; line-height: 1.35; }
.fb-receipt .fb-muted { margin-top: 3px; }
.fb-check {
  display: flex; align-items: center; justify-content: center; flex: none;
  width: 46px; height: 46px; border-radius: 50%;
  background: rgba(163, 223, 190, .12); color: var(--good);
}
.fb-check::after {
  content: ""; width: 8px; height: 16px; margin-top: -4px;
  border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg);
}

.fb-record {
  background: var(--surface); border: 1px solid rgba(177, 191, 198, .2);
  border-radius: 16px; margin-bottom: 12px; overflow: hidden;
}

button.fb-summary {
  display: block; width: 100%; margin: 0; padding: 16px; border-radius: 0;
  background: transparent; color: var(--text); text-align: left; font-weight: 400;
}
.fb-record-head, .fb-record-foot, .fb-response-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.fb-kind { color: var(--muted); font-size: 13px; }
.fb-status {
  flex: none; padding: 3px 9px; border-radius: 16px; background: #353832;
  color: var(--accent); font-size: 12px; line-height: 1.45; font-weight: 500;
}
.fb-status.done { background: #293e36; color: var(--good); }
.fb-prose, .fb-reply-text { white-space: pre-wrap; word-break: break-word; }
.fb-prose { margin: 10px 0; font-size: 16px; line-height: 1.6; }
.clamped { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; }
.fb-record-foot { margin-top: 14px; color: var(--muted); font-size: 12px; line-height: 1.5; }
.fb-record-foot .fb-chevron.open { transform: rotate(-45deg); }
.fb-response { padding: 11px 13px; border-radius: 9px; background: var(--control-bg); }
.fb-response-head { flex-wrap: wrap; color: var(--good); font-size: 13px; font-weight: 600; }
.fb-reply-text { margin-top: 3px; color: var(--muted); font-size: 13px; line-height: 1.6; }
.fb-attachments { margin: 0 16px; padding: 14px 0 16px; border-top: 1px solid rgba(177,191,198,.16); }
.fb-subhead { display: flex; align-items: baseline; gap: 8px; font-size: 14px; font-weight: 600; }
.fb-gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; max-width: 424px; margin-top: 8px; }
.fb-gallery.few { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 228px; }
.fb-gallery button.fb-photo[size="mini"] {
  display: flex; position: relative; width: 100%; height: 0; min-height: 44px; padding: 0 0 100%; margin: 0;
  overflow: hidden; box-sizing: border-box; border-radius: 10px; background: var(--control-bg);
  color: var(--muted); font-size: 12px; line-height: 1.4; box-shadow: inset 0 0 0 1px var(--border);
}
.fb-gallery button.fb-photo[disabled] { opacity: 1; }
.fb-photo image, .fb-photo text { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.fb-photo text { display: flex; align-items: center; justify-content: center; }
.fb-photo-retry { color: var(--accent); }
