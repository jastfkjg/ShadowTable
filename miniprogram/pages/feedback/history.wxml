<app-nav title="我的反馈" back="{{true}}" bindback="back" />
<view class="fb-page fb-history">
  <view wx:if="{{submitted}}" class="fb-receipt" role="status">
    <view class="fb-check" aria-hidden="true"></view>
    <view><view class="fb-receipt-title">反馈已提交</view><view class="fb-muted">可随时回到「我的反馈」查看回复。</view></view>
  </view>
  <view wx:for="{{items}}" wx:key="id" class="fb-record">
    <button class="disclosure-button fb-summary" hover-class="none" aria-expanded="{{expanded === item.id}}"
      aria-label="{{item.category}}，{{item.reply ? '已回复' : '待处理'}}，{{expanded === item.id ? '收起详情' : '展开详情'}}"
      data-id="{{item.id}}" bindtap="toggle">
      <view class="fb-well {{item.icon}}"><image src="./{{item.icon}}.svg" aria-hidden="true" /></view>
      <view class="fb-copy"><view class="fb-kind">{{item.category}}{{item.area ? ' · ' + item.area : ''}}</view><view class="fb-meta">{{item.date}}</view></view>
      <text class="fb-status {{item.reply ? 'done' : ''}}">{{item.reply ? '已回复' : '待处理'}}</text>
      <view class="fb-arrow {{expanded === item.id ? 'open' : ''}}" aria-hidden="true"></view>
    </button>
    <view wx:if="{{expanded === item.id}}" class="fb-detail">
      <view class="fb-prose" user-select="{{true}}">{{item.content}}</view>
      <view wx:if="{{item.photos}}" class="fb-attachments">
        <view class="fb-subhead">附件截图 <text class="fb-meta">{{item.photos}} 张</text></view>
        <view class="fb-gallery {{item.photos <= 2 ? 'few' : ''}}">
          <button wx:for="{{photos}}" wx:for-item="photo" wx:key="index" size="mini" class="fb-photo"
            hover-class="none" data-id="{{item.id}}" data-index="{{photo.index}}" bindtap="preview"
            disabled="{{photo.state === 'loading'}}" aria-label="{{photo.state === 'error' ? '重新加载' : '查看'}}第 {{photo.index + 1}} 张截图">
            <image wx:if="{{photo.src}}" src="{{photo.src}}" mode="aspectFill" data-id="{{item.id}}" data-index="{{photo.index}}"
              data-src="{{photo.src}}" binderror="imageError" aria-hidden="true" />
            <text wx:elif="{{photo.state === 'error'}}" class="fb-photo-retry">点击重试</text>
            <text wx:else>加载中…</text>
          </button>
        </view>
      </view>
      <view wx:if="{{item.reply}}" class="fb-response">
        <view class="fb-response-head"><text>开发者回复</text><text class="fb-meta">{{item.replyDate}}</text></view>
        <view class="fb-prose" user-select="{{true}}">{{item.reply}}</view>
      </view>
    </view>
    <view wx:else class="fb-excerpt">{{item.content}}</view>
  </view>
  <view wx:if="{{loading}}" class="fb-empty" role="status">正在读取反馈…</view>
  <view wx:elif="{{error}}" class="fb-empty" role="alert">{{error}}<button hover-class="none" class="secondary" bindtap="retry">重试</button></view>
  <view wx:elif="{{!items.length}}" class="fb-empty"><view class="fb-choice-title">还没有反馈</view><view class="fb-muted">提交后，可在这里查看进度和回复。</view><button hover-class="none" class="secondary" bindtap="back">去写反馈</button></view>
  <button hover-class="none" wx:elif="{{next}}" class="secondary" bindtap="more">加载更多</button>
</view>
<app-dialog id="app-dialog" />
