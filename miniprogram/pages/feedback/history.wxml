<app-nav title="我的反馈" back="{{true}}" bindback="back" />
<view class="fb-page">
  <view class="fb-record" wx:for="{{items}}" wx:key="id">
    <button hover-class="none" class="disclosure-button fb-summary" aria-expanded="{{expanded === item.id}}" data-id="{{item.id}}" bindtap="toggle">
      <view class="fb-row"><text class="fb-meta">{{item.category}}{{item.area ? ' · ' + item.area : ''}}</text><text class="fb-status {{item.reply ? 'done' : ''}}">{{item.reply ? '已回复' : '待处理'}}</text></view>
      <view class="fb-excerpt {{expanded === item.id ? 'open' : ''}}">{{item.content}}</view>
      <view class="fb-row"><text class="fb-meta">{{item.date}}</text><text class="fb-action">{{expanded === item.id ? '收起' : '查看详情'}}</text></view>
    </button>
    <view wx:if="{{expanded === item.id}}" class="fb-detail">
      <view wx:if="{{item.photos}}" class="fb-chips"><button hover-class="none" wx:for="{{item.images}}" wx:for-item="photo" wx:key="*this" class="fb-chip" disabled="{{imageBusy}}" bindtap="preview" data-id="{{item.id}}" data-index="{{photo}}">截图 {{photo + 1}}</button></view>
      <view wx:if="{{item.reply}}" class="fb-response"><view class="fb-action">开发者回复</view><view class="fb-prose">{{item.reply}}</view><view class="fb-meta">{{item.replyDate}}</view></view>
      <view wx:else class="fb-muted">反馈已收到，回复会显示在这里。</view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="fb-empty" role="status">正在读取反馈…</view>
  <view wx:elif="{{error}}" class="fb-empty" role="alert">{{error}}<button hover-class="none" class="secondary" bindtap="retry">重试</button></view>
  <view wx:elif="{{!items.length}}" class="fb-empty"><view class="fb-choice-title">还没有反馈</view><view class="fb-muted">提交后，可在这里查看进度和回复。</view><button hover-class="none" class="secondary" bindtap="back">去写反馈</button></view>
  <button hover-class="none" wx:elif="{{next}}" class="secondary" bindtap="more">加载更多</button>
</view>
<app-dialog id="app-dialog" />
