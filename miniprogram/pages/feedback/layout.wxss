.fb-page { padding:20px 18px calc(28px + env(safe-area-inset-bottom)); color:var(--text); box-sizing:border-box; }
.fb-start { padding-top:4px; }
.fb-history-link { display:flex; align-items:center; justify-content:flex-end; gap:6px; margin-left:auto; width:fit-content; min-height:44px; color:var(--muted); font-size:15px; }
.fb-history-link text { font-size:22px; }
.fb-title { font-size:28px; font-weight:650; line-height:1.4; margin:14px 0 24px; }
.fb-choice { display:flex; align-items:center; gap:14px; padding:18px 16px; margin:0 0 12px; background:var(--surface); border:1px solid rgba(177,191,198,.18); border-radius:16px; }
.fb-copy { flex:1; min-width:0; }
.fb-choice-title { font-size:18px; font-weight:600; }
.fb-muted,.fb-meta,.fb-count,.fb-placeholder { color:var(--muted); }
.fb-muted { font-size:14px; margin-top:4px; line-height:1.55; }
.fb-meta,.fb-count { font-size:12px; font-weight:400; line-height:1.5; }
.fb-chevron { width:7px; height:7px; margin-right:4px; border:solid var(--muted); border-width:1.5px 1.5px 0 0; transform:rotate(45deg); }
.fb-well { width:46px; height:46px; border-radius:13px; display:flex; align-items:center; justify-content:center; }
.fb-well image { width:25px; height:25px; }
.fb-well.issue { background:#3b372d; }.fb-well.idea { background:#284039; }.fb-well.other { background:#38354b; }
.fb-art { display:block; width:140px; height:110px; margin:40px auto 0; opacity:.13; }
.fb-pressed { opacity:.78; }
.fb-chips { display:flex; flex-wrap:wrap; gap:8px; }
button.fb-chip { min-height:44px; padding:6px 15px; margin:0; color:var(--text); border:1px solid var(--border); background:var(--surface); font-size:14px; line-height:1.4; }
.fb-record { background:var(--surface); border-radius:16px; border:1px solid rgba(177,191,198,.2); margin-bottom:12px; overflow:hidden; }
button.fb-summary { display:block; width:100%; margin:0; padding:16px; background:transparent; color:var(--text); text-align:left; border:0; font-size:16px; line-height:1.5; font-weight:400; }
.fb-row { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.fb-status { color:var(--accent); font-size:13px; }.fb-status.done { color:var(--good); }
.fb-excerpt { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin:10px 0; }
.fb-excerpt.open,.fb-prose { white-space:pre-wrap; overflow-wrap:anywhere; }
.fb-prose { line-height:1.65; margin:8px 0; }
.fb-action { font-size:14px; color:var(--accent); }
.fb-detail { padding:14px 16px 18px; border-top:1px solid rgba(177,191,198,.16); }
.fb-detail .fb-chips { margin-bottom:12px; }
.fb-response { border-left:2px solid var(--accent); padding-left:12px; }
.fb-empty { text-align:center; color:var(--muted); padding:48px 12px; }
.fb-empty button { margin-top:18px; }
