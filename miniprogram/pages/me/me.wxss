.me-page { padding-top: 26rpx; padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
button.me-profile { display: block; width: 100%; min-height: 172rpx; margin: 0; padding: 26rpx 28rpx; text-align: left; background: var(--surface); border-radius: 24rpx; }
.me-profile-main { display: flex; align-items: center; gap: 24rpx; min-width: 0; }
.me-profile .profile-avatar { width: 104rpx; height: 104rpx; }
.me-profile .avatar-fallback { font-size: 44rpx; }
.me-profile .profile-identity { min-width: 0; flex: 1; }
.me-profile .profile-name { font-size: 38rpx; line-height: 1.3; overflow-wrap: anywhere; }
.me-identity-tag { display: inline-block; width: auto; margin-top: 4rpx; padding: 0 10rpx; border: 1rpx solid rgba(177,191,198,.32); border-radius: 8rpx; color: var(--muted); font-size: 21rpx; line-height: 1.6; }
.me-edit { margin-top: 6rpx; color: var(--accent); font-size: 25rpx; line-height: 1.4; }
.me-edit text { margin-left: 4rpx; }
.me-page .account-note { margin: 18rpx 0 0; }
.me-results { margin-top: 48rpx; }
.me-results-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 18rpx; font-size: 32rpx; font-weight: 600; }
button.me-detail-link { width: auto; min-height: 88rpx; margin: -20rpx 0; padding: 12rpx 0 12rpx 12rpx; color: var(--accent); font-size: 25rpx; font-weight: 400; }
.me-detail-link.is-empty { color: var(--muted); }
.me-detail-link text { margin-left: 6rpx; }
.me-stats-panel { padding: 20rpx 26rpx 22rpx; background: var(--surface); border-radius: 24rpx; }
.me-stats-panel .personal-metrics { gap: 10rpx; padding: 4rpx 0; }
.me-stats-panel .metric-value { font-size: 46rpx; line-height: 1.35; }
.me-stats-panel .small { font-size: 24rpx; }
.me-links { margin-top: 48rpx; border-top: 0; }
button.personal-link { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 112rpx; margin: 0; padding: 22rpx 0; text-align: left; border-bottom: 1rpx solid rgba(177,191,198,.22); border-radius: 0; font-size: 30rpx; font-weight: 500; }
.me-link-copy { min-width: 0; flex: 1; text-align: left; }
.me-chevron { flex-shrink: 0; margin-left: 20rpx; color: var(--muted); font-size: 38rpx; font-weight: 400; line-height: 1; }
