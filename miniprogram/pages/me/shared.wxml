<template name="personalPanel">
<view class="page personal-page me-page tab-page">
  <view wx:if="{{loading && !profile}}" class="status" role="status">正在读取个人资料…</view>
  <view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button class="secondary" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}" bindtap="load" loading="{{loading}}" disabled="{{loading}}">重新加载</button></view>
  <block wx:if="{{profile}}">
    <navigator class="me-profile" url="/pages/profile/profile" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}" aria-label="编辑资料，头像和昵称">
      <view class="me-profile-main">
        <image wx:if="{{profile.avatarUrl}}" class="profile-avatar" src="{{profile.avatarUrl}}" mode="aspectFill" aria-label="我的头像" />
        <view wx:else class="profile-avatar avatar-fallback" aria-hidden="true">{{profile.initial}}</view>
        <view class="profile-identity"><view class="profile-name">{{profile.displayName}}</view><view class="me-profile-caption">编辑资料<view class="me-chevron" aria-hidden="true"></view></view></view>
      </view>
    </navigator>
    <view wx:if="{{profile.identityType==='guest'}}" class="account-note small muted">当前为游客身份。清除缓存或登录过期后，无法自动找回资料与战绩。</view>
    <view class="me-overview">
      <navigator class="me-results" url="/pages/stats/stats" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}" aria-label="查看详细战绩统计">
        <view class="personal-metrics me-stats-panel">
          <view class="me-metric"><view class="metric-value {{stats && stats.total >= 10000 ? 'me-value-compact' : ''}}">{{stats ? stats.total : '—'}}</view><text class="small muted">总局数</text></view>
          <view class="me-metric"><view class="metric-value {{stats && stats.total ? '' : 'muted'}}">{{stats ? stats.rateLabel : '—'}}</view><text class="small muted">胜率</text></view>
        </view>
      </navigator>
      <view class="me-points">
        <navigator class="me-points-link" url="/pages/scores/scores" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}" aria-label="查看积分明细">
          <view class="metric-value {{stats && (stats.score.total >= 10000 || stats.score.total <= -1000) ? 'me-value-compact' : ''}}">{{stats ? stats.score.total : '—'}}</view><text class="small muted">积分</text>
        </navigator>
      </view>
      <view class="me-overview-note"><text>{{stats ? stats.wins + ' 胜 · ' + stats.losses + ' 负' : '战绩读取中…'}}</text></view>
    </view>
    <navigator wx:if="{{currentRoom}}" class="me-current-room" url="{{'/pages/table/table?code='+currentRoom.code+'&resume=1'}}" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}" aria-label="{{'返回牌桌，房间'+currentRoom.code+'，'+currentRoom.statusLabel+'，'+currentRoom.relationLabel}}">
      <view class="me-room-icon" aria-hidden="true"></view>
      <view class="me-room-copy"><view class="me-room-title"><text>当前牌桌</text><text class="me-room-state {{currentRoom.status==='playing'?'playing':''}}">{{currentRoom.statusLabel}}</text></view><view class="me-room-caption">{{currentRoom.boardLabel}} · {{currentRoom.capacity}}人 · {{currentRoom.relationLabel}}</view></view>
      <view class="me-room-return"><text>返回</text><view class="me-chevron" aria-hidden="true"></view></view>
    </navigator>
    <view class="personal-links me-links me-links-primary">
      <view class="me-section-label">我的记录</view>
      <view class="me-link-group">
        <navigator class="personal-link" url="/pages/matches/matches" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}"><view class="me-icon-well me-well-blue"><view class="me-icon me-icon-history" aria-hidden="true"></view></view><view class="me-link-copy"><view class="me-link-title">对局记录</view><view class="me-link-caption">回看身份、胜负与对局过程</view></view><view class="me-chevron" aria-hidden="true"></view></navigator>
        <navigator class="personal-link me-fun-link" url="/pages/stats/stats?tab=fun" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}"><view class="me-icon-well me-well-purple"><view class="me-icon me-icon-spark" aria-hidden="true"></view></view><view class="me-link-copy"><view class="me-link-title">趣味记录</view><view class="me-link-caption">刀法、挡刀，还有那些名场面</view></view><view class="me-chevron" aria-hidden="true"></view></navigator>
        <navigator class="personal-link" url="/pages/badges/badges" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}"><view class="me-icon-well me-well-gold"><view class="me-icon me-icon-medal" aria-hidden="true"></view></view><view class="me-link-copy"><view class="me-link-title">荣誉徽章</view><view class="me-link-caption">查看本月荣誉，佩戴你的徽章</view></view><view class="me-chevron" aria-hidden="true"></view></navigator>
      </view>
    </view>
    <view class="personal-links me-links me-links-community">
      <view class="me-section-label">一起看看</view>
      <view class="me-link-group">
        <navigator class="personal-link" url="/pages/leaderboard/leaderboard" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}"><view class="me-icon-well me-well-green"><view class="me-icon me-icon-rank" aria-hidden="true"></view></view><view class="me-link-copy"><view class="me-link-title">排行榜</view><view class="me-link-caption">看看同桌朋友的表现</view></view><view class="me-chevron" aria-hidden="true"></view></navigator>
        <navigator class="personal-link" url="/pages/monthly/monthly" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}"><view class="me-icon-well me-well-orange"><view class="me-icon me-icon-calendar" aria-hidden="true"></view></view><view class="me-link-copy"><view class="me-link-title">月度战报</view><view class="me-link-caption">回顾这个月一起打过的局</view></view><view class="me-chevron" aria-hidden="true"></view></navigator>
      </view>
    </view>
    <view class="personal-links me-links me-links-secondary"><view class="me-link-group">
      <navigator class="personal-link" url="/pages/help/help" open-type="navigate" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}"><view class="me-icon-well me-well-slate"><view class="me-icon me-icon-book" aria-hidden="true"></view></view><view class="me-link-copy"><view class="me-link-title">帮助与规则</view><view class="me-link-caption">流程、角色与板子说明</view></view><view class="me-chevron" aria-hidden="true"></view></navigator>
      <button class="personal-link" bindtap="about" hover-class="me-pressed" hover-start-time="{{0}}" hover-stay-time="{{70}}" aria-label="关于桌边助手"><view class="me-icon-well me-well-slate"><view class="me-icon me-icon-info" aria-hidden="true"></view></view><view class="me-link-copy"><view class="me-link-title">关于桌边助手</view></view><view class="me-chevron" aria-hidden="true"></view></button>
    </view></view>
  </block>
</view>
<view wx:if="{{monthlyReset}}" class="monthly-reset-backdrop" catchtouchmove="blockMonthlyResetScroll">
  <view class="monthly-reset-dialog" role="dialog" aria-modal="true" aria-label="新月积分提醒">
    <view class="monthly-reset-mark" aria-hidden="true"><image src="/assets/record-calendar.svg" /></view>
    <view class="monthly-reset-eyebrow">{{monthlyReset.monthLabel}} · 新的开始</view>
    <view class="monthly-reset-title">新的一月，从零出发</view>
    <view class="monthly-reset-copy">上月积分已清零，本月重新累计。一起把新的故事留在牌桌上。</view>
    <view class="monthly-reset-report">
      <view class="monthly-reset-period">{{monthlyReset.previousLabel}} · 我的战绩</view>
      <view class="monthly-reset-stats">
        <view><text class="monthly-reset-value">{{monthlyReset.previous.total}}</text><text class="monthly-reset-label">对局</text></view>
        <view><text class="monthly-reset-value">{{monthlyReset.previous.rateLabel}}</text><text class="monthly-reset-label">胜率</text></view>
        <view><text class="monthly-reset-value monthly-reset-points">{{monthlyReset.previous.points}}</text><text class="monthly-reset-label">积分</text></view>
      </view>
      <view class="monthly-reset-result">{{monthlyReset.previous.total ? monthlyReset.previous.wins + ' 胜 · ' + monthlyReset.previous.losses + ' 负' : '上月暂无有效对局'}}<text wx:if="{{monthlyReset.previous.scoredGames}}"> · {{monthlyReset.previous.scoredGames}} 场计分局</text></view>
    </view>
    <view class="monthly-reset-footnote">积分每月 1 日清零，历史战绩继续保留</view>
    <view wx:if="{{resetError}}" class="monthly-reset-error" role="alert">{{resetError}}</view>
    <button class="monthly-reset-confirm" bindtap="dismissMonthlyReset" loading="{{resetSaving}}" disabled="{{resetSaving}}" hover-class="me-pressed">{{resetError ? '重试并开启新一月' : '开启新一月'}}</button>
  </view>
</view>
</template>
