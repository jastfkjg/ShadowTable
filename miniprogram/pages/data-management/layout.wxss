/* Shared by the native page and the web client. */
.data-management-page, .data-confirm-backdrop { --data-line: rgba(177,191,198,.13); --data-danger-bg: rgba(242,182,174,.08); --data-danger-border: rgba(242,182,174,.38); }
.data-management-page, .data-month-card, .data-month-select, .data-impact-row, .data-confirm-backdrop, .data-confirm-sheet, .data-confirm-top, .data-confirm-content, .data-confirm-footer, .data-page-footer { box-sizing:border-box; }
.data-management-page { max-width:600px; margin:0 auto; padding:20px 20px calc(146px + env(safe-area-inset-bottom)); color:var(--text); }
.data-intro { margin:0 2px 18px; }
.data-title { font-size:26px; letter-spacing:-.5px; font-weight:600; line-height:1.35; }
.data-subtitle { margin-top:8px; color:var(--muted); font-size:13px; line-height:1.6; }
.data-icon { display:block; width:20px; height:20px; flex-shrink:0; }
.data-month-card { padding:0 17px 14px; border-radius:22px; background:var(--surface); }
.data-month-picker { display:block; }
.data-month-select { display:flex; align-items:center; gap:8px; min-height:55px; border-bottom:1px solid var(--data-line); }
.data-month-select .data-icon { width:18px; height:18px; margin-right:1px; }
.data-month-title { min-width:0; font-size:16px; font-weight:500; line-height:1.6; overflow-wrap:anywhere; }
.data-month-tag { flex-shrink:0; padding:3px 7px; border-radius:5px; font-size:10px; font-weight:400; line-height:1.4; letter-spacing:.3px; color:var(--accent); background:rgba(229,198,139,.1); }
.data-chevron { display:block; width:6px; height:6px; flex-shrink:0; border-right:1.5px solid currentColor; border-top:1.5px solid currentColor; transform:rotate(45deg); margin-right:3px; }
.data-chevron.is-down { transform:rotate(135deg); margin-bottom:3px; }
.data-chevron.is-up { transform:rotate(-45deg); margin-bottom:-3px; }
.data-month-select .data-chevron { margin-left:auto; color:var(--muted); }
.data-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); padding:20px 0 16px; }
.data-metric { position:relative; min-width:0; text-align:center; }
.data-metric+.data-metric::before { content:''; position:absolute; left:0; top:6px; height:30px; width:1px; background:var(--data-line); }
.data-metric-value { color:var(--text); font-size:30px; font-weight:600; line-height:1.1; letter-spacing:-.7px; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.data-metric.is-accent .data-metric-value { color:var(--accent); }
.data-metric.is-negative .data-metric-value { color:var(--evil); }
.data-metric.is-compact .data-metric-value { font-size:22px; letter-spacing:-.3px; }
.data-metric-unit { margin-left:2px; font-size:15px; font-weight:400; }
.data-metric-label { display:block; margin-top:9px; font-size:12px; line-height:1.5; color:var(--muted); }
.data-card-caption { border-top:1px solid var(--data-line); padding-top:13px; color:var(--muted); font-size:12px; line-height:1.6; text-align:center; }
.data-section-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:24px; margin:19px 3px 8px; font-size:15px; font-weight:600; }
.data-section-caption { flex-shrink:0; color:var(--muted); font-size:12px; font-weight:400; }
.data-impact-group { padding:0 15px; border-radius:20px; background:var(--surface); }
.data-impact-row { position:relative; display:flex; align-items:center; gap:12px; min-height:63px; padding:10px 0; }
.data-impact-row+.data-impact-row::before { content:''; position:absolute; left:47px; right:0; top:0; border-top:1px solid var(--data-line); }
.data-icon-well { display:flex; align-items:center; justify-content:center; width:35px; height:37px; flex-shrink:0; border-radius:11px; }
.data-icon-well.is-blue { background:#263b48; }.data-icon-well.is-purple { background:#302f40; }.data-icon-well.is-gold { background:#38362e; }
.data-impact-copy { min-width:0; }
.data-impact-title { font-size:14px; font-weight:500; line-height:1.5; }
.data-impact-description { margin-top:3px; font-size:12px; line-height:1.6; color:var(--muted); }
.data-retained { display:flex; align-items:flex-start; gap:10px; margin:16px 3px 0; }
.data-retained-icon { flex-shrink:0; width:17px; height:17px; margin-top:1px; opacity:.85; }
.data-retained-title { color:var(--text); font-size:12px; font-weight:500; line-height:1.6; }
.data-retained-copy { margin-top:3px; color:var(--muted); font-size:11px; line-height:1.6; }
.data-management-page .data-rules-toggle { display:flex; align-items:center; justify-content:flex-start; gap:8px; width:auto; min-height:44px; margin:0 3px; padding:0; border-radius:0; font-size:12px; font-weight:400; color:var(--muted); background:transparent; }
.data-rules-toggle .data-chevron { width:5px; height:5px; }
.data-rules-copy { margin:0 3px; padding:8px 0 18px; color:var(--muted); font-size:12px; line-height:1.8; white-space:pre-line; }
.data-page-footer { position:fixed; bottom:0; left:0; right:0; z-index:10; max-width:600px; margin:0 auto; padding:12px 20px calc(20px + env(safe-area-inset-bottom)); color:var(--text); background:var(--bg); }
.data-page-footer::before { content:''; position:absolute; left:20px; right:20px; top:0; border-top:1px solid rgba(177,191,198,.13); }
.data-footer-note { display:flex; align-items:center; justify-content:center; gap:6px; margin-bottom:10px; color:var(--muted); font-size:12px; line-height:1.5; }
.data-warning-icon { display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; width:13px; height:13px; border:1px solid currentColor; border-radius:50%; font-family:Arial,sans-serif; font-size:9px; line-height:1; }
.data-page-footer .data-clear { display:flex; align-items:center; justify-content:center; gap:10px; width:100%; min-height:48px; margin:0; padding:10px 16px; border:1px solid rgba(242,182,174,.38); border-radius:12px; color:var(--evil); background:rgba(242,182,174,.08); font-size:15px; font-weight:600; line-height:1.5; }
.data-page-footer .data-clear[disabled] { opacity:.55; color:var(--muted); border-color:var(--border); background:var(--control-bg); }
.data-success { margin:0 0 18px; padding:14px 16px; border-radius:12px; color:var(--good); background:rgba(163,223,190,.08); font-size:13px; line-height:1.7; }
.data-status, .data-pending { padding:20px 0; color:var(--muted); font-size:13px; line-height:1.7; }
.data-empty { padding:30px 12px; text-align:center; font-size:15px; line-height:1.6; }
.data-empty .data-subtitle { font-size:12px; }.data-empty>image,.data-empty>img { display:block; width:30px; height:30px; margin:0 auto 16px; opacity:.7; }
.data-confirm-backdrop { position:fixed; inset:0; z-index:1100; display:flex; align-items:flex-end; justify-content:center; background:var(--overlay-scrim,rgba(2,10,15,.7)); }
.data-confirm-sheet { display:flex; flex-direction:column; width:100%; max-width:600px; max-height:90vh; overflow:hidden; border:1px solid var(--overlay-border,rgba(177,191,198,.24)); border-bottom:0; border-radius:var(--sheet-radius,24px) var(--sheet-radius,24px) 0 0; color:var(--text); background:var(--surface); animation:data-sheet-enter .18s ease-out; }
.data-confirm-top { flex-shrink:0; padding:10px 22px 0; }
.data-sheet-handle { width:32px; height:4px; margin:0 auto 12px; border-radius:4px; background:var(--border); }
.data-confirm-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:10px; }
.data-confirm-title { font-size:20px; font-weight:600; line-height:1.5; }
.data-confirm-heading .data-confirm-close { display:flex; align-items:center; justify-content:center; width:44px; min-height:44px; margin:-5px -12px -5px 0; padding:0; color:var(--muted); background:transparent; font-size:26px; font-weight:300; }
.data-confirm-month { display:flex; align-items:center; gap:7px; margin:0 0 20px; color:var(--accent); font-size:13px; line-height:1.6; }
.data-confirm-month .data-icon { width:16px; height:16px; }
.data-confirm-body { display:block; flex:0 1 auto; min-height:0; overflow-y:auto; overscroll-behavior:contain; }
.data-confirm-content { padding:0 22px; }
.data-confirm-overview { padding:20px 12px 13px; border-radius:16px; background:var(--bg); }
.data-confirm-overview .data-metrics { padding:0 0 17px; }.data-confirm-overview .data-metric-value { font-size:29px; }.data-confirm-overview .data-metric.is-compact .data-metric-value { font-size:20px; }
.data-confirm-overview .data-card-caption { padding-top:11px; font-size:11px; }
.data-confirm-scope { padding-top:18px; }.data-confirm-scope-title { margin-bottom:10px; font-size:13px; font-weight:500; line-height:1.5; }
.data-scope-line { display:flex; align-items:center; gap:9px; margin:9px 0; color:var(--muted); font-size:12px; line-height:1.7; }
.data-scope-line .data-icon { width:16px; height:16px; opacity:.85; }
.data-confirm-content .data-retained { margin:18px 0 0; padding:16px 0 0; border-top:1px solid var(--data-line); }
.data-confirm-footer { flex-shrink:0; padding:19px 22px calc(24px + env(safe-area-inset-bottom)); }
.data-footer-note.is-danger { color:var(--evil); margin-bottom:12px; }
.data-confirm-actions { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.65fr); gap:12px; }
.data-confirm-actions button { display:flex; align-items:center; justify-content:center; width:100%; min-height:48px; margin:0; padding:10px 12px; border-radius:12px; font-size:14px; font-weight:500; line-height:1.5; }
.data-confirm-actions .data-confirm-cancel { border:1px solid rgba(177,191,198,.25); color:var(--text); background:rgba(177,191,198,.07); }
.data-confirm-actions .data-confirm-submit { border:1px solid var(--evil); color:var(--bg); background:var(--evil); font-weight:600; }
.data-confirm-actions button[disabled],.data-confirm-heading button[disabled] { opacity:.55; }
.data-confirm-error { margin-top:16px; color:var(--evil); font-size:13px; line-height:1.7; }
.data-confirm-pending { margin-top:8px; color:var(--muted); font-size:12px; line-height:1.7; }
.me-pressed { opacity:.74; }
@media(max-width:359px) { .data-management-page { padding-left:16px; padding-right:16px; }.data-title { font-size:24px; }.data-impact-title { font-size:13px; }.data-impact-description { font-size:11px; }.data-metric-value { font-size:28px; }.data-page-footer { padding-left:16px; padding-right:16px; }.data-card-caption { font-size:11px; }.data-month-card { padding-left:14px; padding-right:14px; } }
@media(max-height:500px) { .data-confirm-top { padding-top:8px; }.data-sheet-handle { margin-bottom:6px; }.data-confirm-heading { margin-bottom:4px; }.data-confirm-month { margin-bottom:10px; }.data-confirm-footer { padding-top:12px; padding-bottom:calc(16px + env(safe-area-inset-bottom)); } }
@keyframes data-sheet-enter { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
@media(prefers-reduced-motion:reduce) { .data-confirm-sheet { animation:none; } }
