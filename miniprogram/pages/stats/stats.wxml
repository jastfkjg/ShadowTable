<app-nav title="我的战绩" back="{{true}}" backLabel="返回我的" bindback="back" share="{{tab!=='fun' && !!stats.total}}" shareDisabled="{{loading || !!error}}" shareLabel="分享战绩图片" bindshare="shareStats" />
<view class="page personal-page stats-page">
  <view wx:if="{{loading && !stats}}" class="status">正在读取战绩…</view>
  <view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button hover-class="none" class="secondary" bindtap="load" disabled="{{loading}}">重试</button></view>
  <block wx:if="{{stats}}">
    <view wx:if="{{tab!=='fun'}}" class="stats-overview" aria-label="总战绩">
      <view class="personal-metrics"><view><view class="metric-value">{{stats.total}}</view><text class="small muted">总局数</text></view><view><view class="metric-value">{{stats.wins}}</view><text class="small muted">总胜场数</text></view><view><view class="metric-value accent">{{stats.rateLabel}}</view><text class="small muted">总胜率</text></view></view>
      <navigator class="stats-record-link" url="/pages/matches/matches" hover-class="stats-link-pressed"><text>查看对局记录</text><view class="stats-chevron" aria-hidden="true"></view></navigator>
    </view>
    <view class="stats-tabs" aria-label="战绩分类"><button hover-class="none" bindtap="chooseTab" data-id="records" class="{{tab==='records'?'selected':''}}" aria-pressed="{{tab==='records'}}"><text class="stats-tab-label">战绩统计</text></button><button hover-class="none" bindtap="chooseTab" data-id="fun" class="{{tab==='fun'?'selected':''}}" aria-pressed="{{tab==='fun'}}"><text class="stats-tab-label">趣味记录</text></button></view>
    <block wx:if="{{tab!=='fun'}}">
    <view wx:if="{{stats.score.games}}" class="stats-points">
      <view class="personal-metrics"><view><view class="metric-value">{{stats.score.total}}</view><text class="small muted">总积分</text></view><view><view class="metric-value">{{stats.score.games}}</view><text class="small muted">计分局数</text></view><view><view class="metric-value">{{stats.scoreAverageLabel}}</view><text class="small muted">场均积分</text></view></view>
      <view class="small muted score-streak"><text>计分局连胜</text><text>当前 {{stats.score.current}} · 最高 {{stats.score.best}}</text></view>
    </view>
    <view wx:else class="stats-points stats-points-empty">
      <view wx:if="{{stats.score.total}}" class="score-adjusted-total"><text class="small muted">总积分</text><text class="metric-value">{{stats.score.total}}</text></view>
      <view class="score-empty-title">暂无计分对局</view>
      <view class="small muted score-empty-note">{{stats.score.total ? '积分调整可在对局记录中查看。' : stats.total ? '未计分对局也可累计胜负战绩。' : '完成计分对局后展示积分与连胜。'}}</view>
    </view>
    <view wx:if="{{stats.total}}" class="stats-breakdown">
      <view class="stats-section-title">阵营战绩</view>
      <view wx:for="{{stats.byFaction}}" wx:key="faction" class="faction-group">
        <button hover-class="none" class="disclosure-button faction-toggle" bindtap="toggleFaction" data-faction="{{item.faction}}" aria-expanded="{{item.expanded}}" aria-label="{{item.label}}，{{item.total}}局，{{item.wins}}胜，胜率{{item.rateLabel}}，{{item.expanded?'收起角色':'展开角色'}}">
          <view class="faction-heading"><text class="faction-name">{{item.label}}</text><text class="faction-detail">{{item.total}} 局 · {{item.wins}} 胜</text><text wx:if="{{item.score.games}}" class="faction-detail faction-score">{{item.score.total}} 分 · {{item.score.games}} 场计分 · 场均 {{item.scoreAverageLabel}}</text></view>
          <view class="faction-result"><text class="faction-rate">{{item.rateLabel}}</text><text class="faction-detail">胜率</text></view>
          <view class="stats-chevron faction-chevron {{item.expanded?'expanded':''}}" aria-hidden="true"></view>
        </button>
        <view wx:if="{{item.expanded}}" class="role-list">
          <view class="role-list-heading"><text>角色</text><text class="role-stat">局数</text><text class="role-stat">胜场</text><text class="role-stat">胜率</text></view>
          <view wx:for="{{item.roles}}" wx:for-item="role" wx:key="role" class="role-row"><view class="role-name"><text>{{role.role}}</text><view wx:if="{{role.score.games}}" class="small muted">{{role.score.total}} 分 · 场均 {{role.scoreAverageLabel}}</view></view><text class="role-stat">{{role.total}}</text><text class="role-stat">{{role.wins}}</text><text class="role-stat">{{role.rateLabel}}</text></view>
        </view>
      </view>
    </view>
    </block>
    <view wx:if="{{tab==='fun'}}" class="fun-content">
      <view wx:if="{{!stats.fun.available}}" class="muted">趣味记录将在服务更新后开放</view>
      <view wx:elif="{{!stats.fun.cards.length}}" class="fun-empty muted">暂无趣味记录</view>
      <view wx:if="{{stats.fun.legacyGames}}" class="fun-note small muted">{{stats.fun.legacyGames}} 局旧对局未记录完整过程，缺失数据不按零次计算。</view>
      <view wx:for="{{stats.fun.cards}}" wx:for-item="card" wx:key="id" wx:if="{{funExpanded || 3 > index}}" class="fun-card">
        <view class="fun-heading"><text>{{card.title}}</text><view class="fun-heading-actions"><button wx:if="{{card.shareMetric}}" class="share-entry-button" bindtap="shareFun" data-card="{{card.id}}" disabled="{{loading || error}}" hover-class="none" aria-label="分享{{card.title}}的{{card.shareLabel}}图片"><image class="share-entry-icon" src="/assets/share.svg" aria-hidden="true" /></button></view></view>
        <view class="fun-metrics {{card.isCombat?'three':''}}"><navigator wx:for="{{card.metrics}}" wx:for-item="metric" wx:key="id" url="{{metric.url}}" class="fun-metric" hover-class="fun-pressed" aria-label="{{metric.label}} {{metric.valueLabel}}{{metric.unit}}，查看相关对局"><view class="fun-number {{metric.color}}">{{metric.valueLabel}}<text class="small muted"> {{metric.unit}}</text></view><view class="small">{{metric.label}} ›</view></navigator></view>
        <view wx:if="{{card.isCombat && card.opportunities}}" class="fun-bar" aria-hidden="true"><view wx:for="{{card.metrics}}" wx:for-item="metric" wx:key="id" class="fun-bar-{{metric.color}}" style="width:{{metric.percent}}%"></view></view>
        <view class="fun-caption small muted">{{card.isCombat?'有效敌方命中率':'成功率'}} {{card.rateLabel}} · {{card.opportunities}} {{card.isCombat?'次出手':'次机会'}}</view>
        <view wx:if="{{funRulesExpanded && (card.id==='classic:shield' || card.id==='knights:shield' || card.id==='other:shield')}}" class="small muted">挡刀率以终局时作为在场非梅林好人、面对最终非空刀的局数为分母。</view>
        <view wx:if="{{funRulesExpanded && card.aimLabel}}" class="small muted">{{card.aimLabel}}；选中敌方但被挡下仍计未生效。</view>
        <view class="small muted">{{card.coverage}}</view>
        <block wx:if="{{card.isCombat && card.roles.length}}"><button hover-class="none" class="disclosure-button fun-role-toggle" bindtap="toggleFunRoles" data-id="{{card.id}}" aria-expanded="{{funRoles[card.id]}}">按出刀角色查看 {{funRoles[card.id]?'⌄':'›'}}</button><view wx:if="{{funRoles[card.id]}}" class="fun-roles"><navigator wx:for="{{card.roles}}" wx:for-item="role" wx:key="role" url="{{role.url}}" class="fun-role" hover-class="fun-pressed"><view>{{role.label}} ›</view><view class="small muted">{{role.value===null?"尚无完整记录":"敌方 "+role.countLabel+" · 同伴 "+role.ally+" · 未生效 "+role.failed+" / "+role.opportunities+" 次"}}</view></navigator></view></block>
      </view>
      <button wx:if="{{stats.fun.cards.length > 3}}" class="disclosure-button secondary fun-more" bindtap="toggleFunCards" aria-expanded="{{funExpanded}}" hover-class="none">{{funExpanded?'收起更多记录':'查看其余 '+(stats.fun.cards.length-3)+' 项趣味记录'}}</button>
      <button wx:if="{{stats.fun.cards.length}}" class="disclosure-button fun-role-toggle" bindtap="toggleFunRules" aria-expanded="{{funRulesExpanded}}" hover-class="none">统计说明 {{funRulesExpanded?'⌃':'⌄'}}</button>
      <view wx:if="{{stats.fun.cards.length && funRulesExpanded}}" class="fun-note small muted">派西按初始身份记三绿／三炸；梅林只统计最终刺杀机会。轮内刀、枪、决斗与最终刀分别记录；空刀单列。未使用和作废不计失败。</view>
    </view>
  </block>
</view>
