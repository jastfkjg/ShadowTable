<template name="statisticsPanel">
<view class="page personal-page stats-page">
  <view wx:if="{{loading && !stats}}" class="status" role="status">正在读取战绩…</view>
  <view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button hover-class="stats-pressed" class="secondary" bindtap="load" disabled="{{loading}}">重试</button></view>
  <block wx:if="{{stats}}">
    <view class="overview-card" aria-label="战绩概览">
      <view class="overview-metrics">
        <view class="overview-metric"><view class="overview-value {{stats.total >= 10000 ? 'stats-number-compact' : ''}}">{{stats.total}}</view><text class="overview-label">对局</text></view>
        <view class="overview-metric"><view class="overview-value overview-rate">{{stats.rateValue || stats.rateLabel}}<text wx:if="{{stats.rateUnit}}" class="rate-unit">{{stats.rateUnit}}</text></view><text class="overview-label">胜率</text></view>
        <view class="overview-metric"><view class="overview-value {{stats.wins >= 10000 ? 'stats-number-compact' : ''}}">{{stats.wins}}</view><text class="overview-label">胜场</text></view>
      </view>
      <view wx:if="{{stats.byFaction.length}}" class="overview-factions">
        <button wx:for="{{stats.byFaction}}" wx:key="faction" class="overview-faction" hover-class="stats-pressed" bindtap="openFactionDetails" data-faction="{{item.faction}}" aria-label="{{item.label+'，'+item.wins+'胜'+item.losses+'负，胜率'+item.rateLabel+'，查看详情'}}"><view class="stats-faction-dot is-{{item.faction}}" aria-hidden="true"></view><text class="overview-faction-name">{{item.shortLabel || item.label}}</text><text>{{item.wins}} 胜 {{item.losses}} 负</text><view class="stats-chevron stats-faction-chevron" aria-hidden="true"></view></button>
      </view>
    </view>
    <view class="stats-score">
      <button class="stats-score-entry" hover-class="stats-pressed" bindtap="openScoreHistory" disabled="{{loading || !!error}}" aria-label="查看本月积分明细"><view class="stats-score-label"><view class="stats-coin-icon" aria-hidden="true"></view><text>本月积分</text><text class="stats-score-value">{{stats.score.month || 0}}</text></view><view class="stats-score-link"><text>积分明细</text><view class="stats-chevron" aria-hidden="true"></view></view></button>
    </view>
    <view wx:if="{{stats.total}}" class="stats-breakdown">
      <view class="stats-section-title"><text>角色战绩</text><text class="stats-section-note">共 {{stats.roleCount}} 个角色</text></view>
      <view class="stats-role-panel">
        <view class="stats-role-toolbar"><view class="stats-role-filters" aria-label="按阵营筛选角色"><button class="{{!roleFilter || roleFilter==='all'?'selected':''}}" hover-class="stats-pressed" bindtap="filterRoles" data-faction="all" aria-pressed="{{!roleFilter || roleFilter==='all'}}">全部</button><button wx:for="{{stats.byFaction}}" wx:key="faction" class="{{roleFilter===item.faction?'selected':''}}" hover-class="stats-pressed" bindtap="filterRoles" data-faction="{{item.faction}}" aria-pressed="{{roleFilter===item.faction}}">{{item.shortLabel || item.label}}</button></view><text class="stats-role-key">局数 · 胜率</text></view>
        <view class="stats-role-grid">
          <button wx:for="{{roleRows || stats.byRole}}" wx:key="roleKey" class="stats-role-tile" hover-class="stats-role-pressed" bindtap="openRoleDetails" data-key="{{item.roleKey}}" aria-label="{{item.role+'，'+item.factionLabel+'，'+item.total+'局，'+item.wins+'胜，胜率'+item.rateLabel+'，查看详情'}}">
            <image class="stats-role-portrait" src="{{item.portrait}}" mode="aspectFit" lazy-load="{{true}}" aria-hidden="true" />
            <view class="stats-role-name"><view class="stats-faction-dot is-{{item.faction}}" aria-hidden="true"></view><view><view>{{item.roleTitle || item.role}}</view><view wx:if="{{item.roleSubtitle}}">{{item.roleSubtitle}}</view></view></view>
            <view class="stats-role-record"><text>{{item.total}} 局</text><text class="stats-role-separator" aria-hidden="true">·</text><text class="stats-role-rate">{{item.rateLabel}}</text></view>
          </button>
        </view>
        <view wx:if="{{roleRows && !roleRows.length}}" class="stats-roles-empty">该阵营暂无角色战绩</view>
        <view class="stats-role-hint">点击角色，查看战绩</view>
      </view>
      <view class="stats-scope-note">胜率按结算时的角色与阵营统计</view>
    </view>
    <view wx:else class="stats-empty"><view>暂无有效对局</view><view class="small muted">完成并登记胜负后，这里会展示你的战绩。</view></view>
  </block>
</view>
</template>

<template name="statsDetailSheet">
  <view class="stats-detail-backdrop" catchtap="closeStatsDetails" catchtouchmove="blockStatsScroll">
    <view class="stats-detail-sheet" catchtap="blockStatsScroll" role="dialog" aria-modal="true" aria-label="{{statsDetail.title+'战绩详情'}}">
      <view class="stats-detail-handle" aria-hidden="true"></view>
      <view class="stats-detail-heading">
        <image wx:if="{{statsDetail.kind==='role'}}" class="stats-detail-portrait" src="{{statsDetail.portrait}}" mode="aspectFit" aria-hidden="true" />
        <view class="stats-detail-identity"><view class="stats-detail-title">{{statsDetail.title}}</view><view class="stats-detail-caption"><block wx:if="{{statsDetail.kind==='role'}}">{{statsDetail.factionLabel}} · </block>全部有效对局</view></view>
        <button class="stats-detail-close" hover-class="stats-pressed" bindtap="closeStatsDetails" aria-label="关闭战绩详情">×</button>
      </view>
      <scroll-view class="stats-detail-body" scroll-y="{{true}}" show-scrollbar="{{false}}">
        <view class="stats-detail-metrics"><view><view class="stats-detail-number">{{statsDetail.total}}</view><text>对局</text></view><view><view class="stats-detail-number accent">{{statsDetail.rateLabel}}</view><text>胜率</text></view><view><view class="stats-detail-number">{{statsDetail.wins}}</view><text>胜场</text></view></view>
        <view class="stats-detail-record">{{statsDetail.wins}} 胜 · {{statsDetail.losses}} 负<text wx:if="{{statsDetail.excluded}}"> · {{statsDetail.excluded}} 局未计入</text></view>
        <view class="stats-detail-scope"><image src="/assets/record-info.svg" aria-hidden="true" /><text>胜率仅统计有效对局</text></view>
      </scroll-view>
      <button class="primary stats-detail-done" hover-class="stats-pressed" bindtap="closeStatsDetails">完成</button>
    </view>
  </view>
</template>
