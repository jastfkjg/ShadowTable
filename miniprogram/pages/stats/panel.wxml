<template name="statisticsPanel">
<view class="page personal-page stats-page">
  <view wx:if="{{loading && !stats}}" class="status">正在读取战绩…</view>
  <view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button hover-class="none" class="secondary" bindtap="load" disabled="{{loading}}">重试</button></view>
  <block wx:if="{{stats}}">
    <view class="stats-overview" aria-label="总战绩">
      <view class="records-scope"><text>全部对局</text><button wx:if="{{stats.total}}" class="records-share" hover-class="none" bindtap="shareStats" disabled="{{loading || !!error}}" aria-label="分享战绩图片"><image src="/assets/share.svg" aria-hidden="true" /><text>分享</text></button></view>
      <view class="stats-section-title overview-title">战绩概览</view>
      <view class="overview-card">
        <view class="overview-metrics">
          <view class="overview-metric">
            <text class="overview-label">总胜率</text>
            <view class="overview-value overview-rate">{{stats.rateValue || stats.rateLabel}}<text wx:if="{{stats.rateUnit}}" class="rate-unit">{{stats.rateUnit}}</text></view>
            <text class="overview-caption">{{stats.wins}} 胜 / {{stats.total}} 局</text>
          </view>
          <view class="overview-metric">
            <text class="overview-label">总积分</text>
            <view class="overview-value">{{stats.score.total}}</view>
            <text class="overview-caption">{{stats.score.games ? stats.score.games + ' 局计分' : '暂无计分对局'}}</text>
          </view>
        </view>
        <view class="overview-footer">
          <view wx:if="{{stats.score.games}}" class="overview-average"><text>场均积分</text><text class="overview-average-value">{{stats.scoreAverageLabel}}</text></view>
          <text wx:elif="{{stats.score.total}}" class="score-empty-note muted">来自积分调整</text>
          <button class="overview-details" hover-class="none" bindtap="openScoreHistory" disabled="{{loading || !!error}}" aria-label="查看积分明细"><text>积分明细</text><view class="stats-chevron" aria-hidden="true"></view></button>
        </view>
      </view>
    </view>
    <view wx:if="{{stats.total}}" class="stats-breakdown">
      <view class="stats-section-title"><text>阵营与角色</text><text wx:if="{{stats.roleCount}}" class="stats-section-note">共 {{stats.roleCount}} 个角色</text></view>
      <view class="faction-list"><view wx:for="{{stats.byFaction}}" wx:key="faction" class="faction-group">
        <button hover-class="none" class="disclosure-button faction-toggle" bindtap="toggleFaction" data-faction="{{item.faction}}" aria-expanded="{{item.expanded}}" aria-label="{{item.label}}，{{item.total}}局，{{item.wins}}胜，胜率{{item.rateLabel}}，{{item.expanded?'收起角色':'展开角色'}}">
          <image class="faction-emblem" src="{{item.faction==='good'?'/assets/record-shield-good.svg':'/assets/record-shield.svg'}}" aria-hidden="true" /><view class="faction-heading"><text class="faction-name">{{item.label}}</text><text class="faction-detail">{{item.total}} 局 · {{item.wins}} 胜</text></view>
          <view class="faction-result"><text class="faction-rate">{{item.rateLabel}}</text><text class="faction-detail">胜率</text></view>
          <view class="stats-chevron faction-chevron {{item.expanded?'expanded':''}}" aria-hidden="true"></view>
          <text wx:if="{{item.score.games}}" class="faction-detail faction-score">积分 {{item.score.total}} · {{item.score.games}} 局计分 · 场均 {{item.scoreAverageLabel}}</text>
        </button>
        <view wx:if="{{item.expanded && item.roles.length}}" class="role-list">
          <view class="role-list-heading"><text>角色</text><text class="role-stat">战绩</text><text class="role-stat">胜率</text></view>
          <view wx:for="{{item.roles}}" wx:for-item="role" wx:key="role" wx:if="{{item.rolesExpanded || 5 > index}}" class="role-row"><view class="role-name"><text>{{role.role}}</text><view wx:if="{{role.score.games}}" class="small muted">{{role.score.total}} 分 · 场均 {{role.scoreAverageLabel}}</view></view><text class="role-stat role-record">{{role.total}} 局 · {{role.wins}} 胜</text><text class="role-stat">{{role.rateLabel}}</text></view>
          <button wx:if="{{item.roles.length > 5}}" class="disclosure-button role-more" hover-class="none" bindtap="toggleFactionRoles" data-faction="{{item.faction}}" aria-expanded="{{item.rolesExpanded}}">{{item.rolesExpanded?'收起角色':'查看全部 '+item.roles.length+' 个角色'}}<view class="stats-chevron {{item.rolesExpanded?'expanded':''}}" aria-hidden="true"></view></button>
        </view>
      </view></view>
    </view>
    <view wx:else class="stats-empty"><view>暂无有效对局</view><view class="small muted">完成并登记胜负后，这里会展示你的战绩。</view></view>
  </block>
</view>
</template>
