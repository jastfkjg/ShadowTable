.stats-page { padding-top: 26rpx; }
button.stats-share { width: 100%; min-height: 48px; margin: 12rpx 0 0; padding: 12rpx 20rpx; font-size: 28rpx; color: var(--accent); }
button.fun-share { width: auto; min-height: 48px; margin: 12rpx 0 0; padding: 12rpx 0; justify-content: flex-start; font-size: 26rpx; color: var(--accent); }
.stats-overview { border-radius: 24rpx; background: var(--surface); padding: 8rpx 28rpx 12rpx; }
.stats-overview .personal-metrics { padding: 20rpx 0; gap: 12rpx; }
.stats-overview .metric-value { font-size: 44rpx; line-height: 1.35; }
.stats-breakdown { margin-top: 32rpx; }
button.stats-breakdown-toggle { width: 100%; min-height: 96rpx; margin: 0; padding: 0; justify-content: space-between; font-size: 33rpx; font-weight: 600; }
.faction-group { border-bottom: 1rpx solid rgba(177,191,198,.22); }
button.faction-toggle { width: 100%; min-height: 116rpx; margin: 0; padding: 22rpx 0; justify-content: space-between; gap: 18rpx; text-align: left; border-radius: 0; }
.faction-heading { display: flex; flex-direction: column; min-width: 0; }
.faction-name { font-size: 32rpx; font-weight: 600; }
.faction-detail { color: var(--muted); font-size: 25rpx; }
.faction-chevron { flex-shrink: 0; color: var(--muted); font-size: 42rpx; line-height: 1; }
.role-list { padding: 8rpx 20rpx 20rpx; background: var(--surface); border-radius: 16rpx; margin-bottom: 20rpx; }
.role-list-heading, .role-row { display: grid; grid-template-columns: minmax(0,1.6fr) repeat(3,minmax(0,.7fr)); gap: 8rpx; align-items: center; }
.role-list-heading { color: var(--muted); font-size: 24rpx; padding: 12rpx 0; }
.role-row { padding: 16rpx 0; border-top: 1rpx solid rgba(177,191,198,.14); font-size: 26rpx; font-variant-numeric: tabular-nums; }
.role-list-heading text:not(:first-child), .role-row text:not(:first-child) { text-align: right; }
.role-name { min-width: 0; overflow-wrap: anywhere; }

.stats-points { margin-top: 24rpx; padding: 12rpx 28rpx 24rpx; border-radius: 24rpx; background: var(--surface); }
.stats-points .metric-value { font-size: 40rpx; }
.score-streak { text-align: center; }
.role-name .small { font-size: 24rpx; font-weight: 400; margin-top: 6rpx; }
.stats-tabs { display: flex; gap: 16rpx; margin: 28rpx 0; }
.stats-tabs button { flex: 1; width: 0; margin: 0; min-height: 48px; color: var(--muted); border-bottom: 2rpx solid var(--border); border-radius: 0; }
.stats-tabs button.selected { color: var(--accent); border-bottom-color: var(--accent); }
.fun-card { padding: 28rpx 0; border-bottom: 1rpx solid var(--border); }
.fun-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; font-weight: 600; font-size: 32rpx; }
.fun-metrics { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; margin: 24rpx 0; }
.fun-metrics.three { grid-template-columns: repeat(3,minmax(0,1fr)); gap: 8rpx; }
.fun-metric { display: block; padding: 12rpx 0; min-height: 48px; }
.fun-number { font-size: 44rpx; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.4; }
.fun-number.good { color: var(--good); } .fun-number.evil { color: var(--evil); }
.fun-bar { height: 12rpx; display: flex; overflow: hidden; border-radius: 8rpx; margin-bottom: 20rpx; background: var(--border); }
.fun-bar-good { background: var(--good); } .fun-bar-evil { background: var(--evil); } .fun-bar-muted { background: var(--muted); }
.fun-caption { margin-bottom: 8rpx; }
.fun-note, .fun-empty { margin: 24rpx 0; }
button.fun-role-toggle { justify-content: space-between; min-height: 48px; padding: 16rpx 0; margin: 12rpx 0 0; color: var(--accent); font-size: 26rpx; }
.fun-role { display: block; padding: 18rpx 20rpx; margin: 8rpx 0; background: var(--surface); border-radius: 12rpx; }

.fun-pressed { background: var(--surface); }

.stats-record-link { display: flex; align-items: center; min-height: 48px; margin-top: 24rpx; color: var(--accent); font-size: 28rpx; }
.fun-card { padding: 28rpx; margin: 20rpx 0; border: 0; border-radius: 20rpx; background: var(--surface); }
.fun-heading { align-items: flex-start; }
.fun-heading > text:first-child { min-width: 0; overflow-wrap: anywhere; }
.fun-heading > text:last-child { flex-shrink: 0; }
.fun-metrics { margin: 16rpx 0; }
.fun-number { overflow-wrap: anywhere; font-size: 40rpx; }
.fun-caption { margin-bottom: 0; }
button.fun-more { width: 100%; min-height: 48px; }
.stats-tabs { margin: 20rpx 0; }
