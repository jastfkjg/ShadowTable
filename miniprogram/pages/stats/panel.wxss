.stats-page { padding-top: 12px; }
.records-scope { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 36px; color: var(--muted); font-size: 12px; }
button.records-share, button.records-share[disabled]:not([type]) { display: flex; flex-shrink: 0; width: auto; min-height: 44px; margin: -4px 0 -4px auto; padding: 0 0 0 8px; gap: 5px; color: var(--muted); font-size: 12px; font-weight: 400; border-radius: 8px; }
.records-share image { width: 16px; height: 16px; }
.overview-title { margin-top: 20px; }
.overview-card { padding: 20px 16px 12px; border-radius: 16px; background: var(--surface); }
.overview-metrics { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); }
.overview-metric { min-width: 0; padding: 0 8px; }
.overview-metric + .overview-metric { padding-left: 28px; border-left: 1rpx solid var(--records-line); }
.overview-label { display: block; color: var(--muted); font-size: 13px; }
.overview-value { margin: 6px 0 4px; color: var(--accent); font-size: 44px; font-weight: 600; line-height: 1.15; letter-spacing: -1px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.overview-rate { white-space: nowrap; }
.rate-unit { margin-left: 2px; font-size: 22px; letter-spacing: 0; }
.overview-caption { display: block; color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.overview-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; margin-top: 20px; padding-top: 10px; border-top: 1rpx solid var(--records-line); }
.overview-average { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; min-width: 0; color: var(--muted); font-size: 13px; }
.overview-average-value { color: var(--text); font-size: 24px; font-weight: 600; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
button.overview-details { width: auto; flex-shrink: 0; min-height: 44px; margin: 0 0 0 auto; padding: 0 4px 0 8px; gap: 10px; color: var(--accent); font-size: 13px; font-weight: 500; border-radius: 8px; }
.stats-chevron { width: 6px; height: 6px; flex-shrink: 0; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); margin-right: 3px; transition: transform 160ms ease; }
.stats-chevron.expanded { transform: rotate(135deg); }
.stats-breakdown { margin-top: 32px; }
.stats-section-title { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; font-size: 18px; font-weight: 600; }
.stats-section-note { color: var(--muted); font-size: 12px; font-weight: 400; }
.faction-list { padding: 0 16px; border-radius: 16px; background: var(--surface); overflow: hidden; }
.faction-group + .faction-group { border-top: 1rpx solid var(--records-line); }
button.faction-toggle { display: grid; grid-template-columns: 24px minmax(0,1fr) auto 10px; width: 100%; min-height: 106px; margin: 0; padding: 20px 0; gap: 6px 12px; text-align: left; border-radius: 0; font-weight: 400; }
.faction-emblem { flex-shrink: 0; width: 24px; height: 24px; align-self: flex-start; margin-top: 2px; }
.faction-heading { display: flex; flex: 1; flex-direction: column; min-width: 0; gap: 4px; }
.faction-name { font-size: 17px; font-weight: 600; }
.faction-detail { color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }
.faction-score { grid-column: 2 / 4; }
.faction-result { display: flex; flex-direction: column; align-items: flex-end; flex-shrink: 0; align-self: flex-start; gap: 4px; }
.faction-rate { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
.faction-chevron { grid-column: 4; grid-row: 1 / 3; color: var(--muted); }
.role-list { border-top: 1rpx solid var(--records-line); padding-bottom: 7px; }
.role-list-heading, .role-row { display: grid; grid-template-columns: minmax(0,1.15fr) minmax(0,1fr) minmax(0,.65fr); gap: 8px; align-items: center; }
.role-list-heading { color: var(--muted); font-size: 12px; padding: 9px 0; }
.role-row { min-height: 52px; padding: 13px 0; box-sizing: border-box; border-top: 1rpx solid var(--records-line); font-size: 14px; font-variant-numeric: tabular-nums; }
.role-stat { text-align: right; overflow-wrap: anywhere; }
.role-record { font-size: 12px; color: var(--muted); }
.role-name { min-width: 0; font-size: 15px; overflow-wrap: anywhere; }
.role-name .small { font-size: 12px; font-weight: 400; margin-top: 6px; }
button.role-more { justify-content: center; gap: 12px; width: 100%; margin: 0; padding: 12px 0; min-height: 48px; color: var(--accent); font-size: 12px; }
.score-empty-note { font-size: 12px; line-height: 1.7; }
.stats-empty { padding: 24px 0 8px; font-size: 14px; }
.stats-empty .small { margin-top: 8px; font-size: 12px; }
/* Compact records keep definitions in the optional explanation panel. */
.fun-scope { justify-content: flex-end; gap: 12px; margin: -4px 0 8px; }
button.fun-info-button, .fun-scope button.records-share { display: flex; align-items: center; gap: 5px; width: auto; min-height: 44px; margin: 0; padding: 0 2px; color: var(--muted); font-size: 14px; font-weight: 400; }
.fun-info-button image, .fun-scope .records-share image { width: 18px; height: 18px; }
.fun-section-title { display: flex; align-items: center; gap: 8px; margin: 18px 0 10px; color: var(--muted); font-size: 13px; }
.fun-scope + .fun-section-title { margin-top: 4px; }
.fun-card { padding: 14px 16px; margin-bottom: 10px; border-radius: 16px; background: var(--surface); }
.fun-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 8px; min-height: 24px; font-weight: 600; font-size: 17px; line-height: 1.5; }
.fun-title { display: flex; align-items: center; gap: 8px; min-width: 0; }
.fun-title text { min-width: 0; overflow-wrap: anywhere; }
.fun-title-icon { flex-shrink: 0; width: 19px; height: 19px; }
.fun-heading-actions { display: flex; align-items: center; flex-shrink: 0; margin-left: auto; }
.fun-sample { color: var(--muted); font-size: 12px; font-weight: 400; }
.fun-heading-actions button.share-entry-button, .fun-heading-actions button.share-entry-button[disabled]:not([type]) { margin: -10px -8px -10px 0; }
.fun-heading-actions .share-entry-icon { width: 20px; height: 20px; }
.fun-metrics { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0; margin: 10px 0 0; }
.fun-metrics.three { grid-template-columns: repeat(3,minmax(0,1fr)); }
.fun-metrics.single { align-items: center; }
button.fun-metric { display: block; width: 100%; margin: 0; text-align: left; font-weight: 400; min-width: 0; padding: 0 12px; min-height: 58px; border-radius: 0; border-left: 1rpx solid var(--records-line); }
button.fun-metric:first-child { border-left: 0; padding-left: 0; }
button.fun-metric:last-child { padding-right: 0; }
.fun-number { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px; font-size: 34px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.08; }
.fun-number > text:first-child { overflow-wrap: anywhere; word-break: break-all; min-width: 0; max-width: 100%; }
.fun-metric-label { margin-top: 6px; font-size: 13px; line-height: 1.4; overflow-wrap: anywhere; }
.fun-metric-chevron { color: var(--muted); }
.fun-metrics.three .fun-number { font-size: 32px; }
.fun-number.good { color: var(--good); } .fun-number.evil { color: var(--evil); } .fun-number.muted { color: var(--muted); }
.fun-rate { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; padding-left: 12px; border-left: 1rpx solid var(--records-line); }
.fun-rate-value { font-size: 30px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.22; overflow-wrap: anywhere; }
.fun-rate-label { font-size: 13px; margin-top: 6px; color: var(--muted); }
.fun-empty { margin: 24px 0; font-size: 14px; }
button.fun-role-toggle { justify-content: space-between; min-height: 44px; width: 100%; padding: 8px 0; margin: 10px 0 -8px; border-top: 1rpx solid var(--records-line); border-radius: 0; color: var(--muted); font-size: 13px; }
button.fun-role { display: block; width: 100%; text-align: left; font-weight: 400; font-size: 14px; padding: 12px; margin: 8px 0 0; background: var(--bg); border-radius: 8px; }
.fun-role .small { font-size: 12px; }
.fun-rules { padding: 16px; margin-bottom: 16px; border: 1rpx solid var(--records-line); border-radius: 16px; font-size: 13px; line-height: 1.75; }
.fun-rule-item + .fun-rule-item, .fun-rules > view + view { margin-top: 16px; }
.fun-rule-title { color: var(--text); }
@media (max-width: 350px) {
  .overview-card { padding-left: 12px; padding-right: 12px; }
  .overview-metric { padding-left: 4px; padding-right: 4px; }
  .overview-metric + .overview-metric { padding-left: 20px; }
  .overview-value { font-size: 38px; }
  .rate-unit { font-size: 20px; }
  button.faction-toggle { column-gap: 8px; }
  .faction-list, .fun-card { padding-left: 12px; padding-right: 12px; }
  button.fun-metric { padding-left: 8px; padding-right: 8px; }
  .fun-metric-label { font-size: 12px; }
}
@media (prefers-reduced-motion: reduce) { .stats-chevron { transition: none; } }
