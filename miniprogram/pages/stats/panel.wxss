@import "../../fun-records.wxss";
.stats-page { padding-top:8px; }
.stats-pressed { opacity:.72; }
.overview-card { padding:24px 12px 10px; border-radius:22px; background:var(--surface); }
.overview-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:4px; }
.overview-metric { min-width:0; text-align:center; }
.overview-value { color:var(--text); font-size:32px; font-weight:600; line-height:1.2; letter-spacing:-.7px; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.overview-value.overview-rate { color:var(--accent); white-space:nowrap; }
.overview-value.stats-number-compact { font-size:24px; }
.rate-unit { margin-left:1px; font-size:20px; letter-spacing:0; }
.overview-label { display:block; margin-top:8px; color:var(--muted); font-size:12px; }
.overview-factions { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:0 20px; margin-top:14px; }
button.overview-faction { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:5px; width:auto; min-height:44px; margin:0; padding:4px 0; color:var(--muted); font-size:12px; font-weight:400; }
.overview-faction-name { color:var(--text); }
.stats-faction-dot { width:5px; height:5px; border-radius:50%; flex-shrink:0; background:var(--muted); }
.stats-faction-dot.is-good { background:var(--good); }.stats-faction-dot.is-evil { background:var(--evil); }.stats-faction-dot.is-third { background:var(--third); }
.stats-score { margin-top:12px; padding:0 16px; border-radius:18px; background:var(--surface); }
button.stats-score-entry { display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%; min-height:64px; margin:0; padding:10px 0; font-size:13px; font-weight:400; }
.stats-score-label,.stats-score-link { display:flex; align-items:center; gap:8px; min-width:0; }
.stats-score-value { color:var(--accent); font-size:22px; font-weight:600; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.stats-score-link { flex-shrink:0; color:var(--muted); font-size:12px; }
.stats-points-icon { flex-shrink:0; width:18px; height:18px; }
.stats-chevron { width:6px; height:6px; flex-shrink:0; border-top:1.5px solid currentColor; border-right:1.5px solid currentColor; transform:rotate(45deg); margin-right:3px; }
.stats-chevron.expanded { transform:rotate(135deg); }
.stats-faction-chevron { width:5px; height:5px; color:var(--muted); margin-left:2px; }
.stats-breakdown { margin-top:24px; }
.stats-section-title { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin:0 4px 12px; font-size:16px; font-weight:600; }
.stats-section-note { color:var(--muted); font-size:12px; font-weight:400; }
.stats-role-panel { padding:12px 12px 18px; background:var(--surface); border-radius:22px; }
.stats-role-toolbar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
.stats-role-filters { display:flex; flex-wrap:wrap; gap:2px; padding:3px; border-radius:11px; background:var(--control-bg); }
.stats-role-filters button { display:flex; justify-content:center; min-width:44px; width:auto; min-height:44px; margin:0; padding:8px 10px; color:var(--muted); font-size:12px; font-weight:400; border-radius:8px; }
.stats-role-filters button.selected { color:var(--accent); background:#31434d; font-weight:600; }
.stats-role-key { color:var(--muted); font-size:11px; white-space:nowrap; }
.stats-role-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px 6px; }
button.stats-role-tile { display:flex; align-items:center; justify-content:flex-start; flex-direction:column; gap:0; width:100%; min-width:0; min-height:148px; margin:0; padding:0 2px 4px; color:var(--text); font-weight:400; border-radius:14px; }
.stats-role-pressed { background:#243842; }
.stats-role-portrait { display:block; width:80px; height:80px; max-width:100%; margin-bottom:10px; }
.stats-role-name { display:flex; align-items:flex-start; justify-content:center; gap:4px; width:100%; min-height:40px; color:var(--text); font-size:13px; font-weight:500; line-height:1.5; text-align:center; overflow-wrap:anywhere; }
.stats-role-name>.stats-faction-dot { margin-top:7px; }
.stats-role-name>view:last-child { min-width:0; }
.stats-role-record { display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:4px; margin-top:2px; color:var(--muted); font-size:12px; line-height:1.5; font-variant-numeric:tabular-nums; }
.stats-role-separator { opacity:.7; }.stats-role-rate { color:var(--text); }
.stats-role-hint,.stats-scope-note { margin-top:18px; text-align:center; color:var(--muted); font-size:11px; line-height:1.6; }
.stats-roles-empty { padding:24px 0; color:var(--muted); text-align:center; font-size:13px; }
.stats-empty { padding:28px 4px 8px; font-size:14px; }.stats-empty .small { margin-top:8px; font-size:12px; }
.stats-share-row { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin:4px 4px 0; color:var(--muted); font-size:12px; line-height:1.6; }
button.stats-share-button { display:flex; align-items:center; justify-content:center; gap:6px; width:auto; min-height:44px; margin:0; padding:8px 4px 8px 12px; color:var(--accent); font-size:13px; font-weight:500; line-height:1.5; }
.stats-share-button image { width:17px; height:17px; flex-shrink:0; }
.stats-share-notice { margin:8px 4px; color:var(--muted); font-size:13px; line-height:1.6; }
.stats-detail-backdrop { position:fixed; inset:0; z-index:950; display:flex; align-items:flex-end; justify-content:center; background:var(--overlay-scrim); }
.stats-detail-sheet { width:100%; max-width:600px; max-height:90vh; padding:16px 24px calc(24px + env(safe-area-inset-bottom)); border:1rpx solid var(--overlay-border); border-bottom:0; border-radius:var(--sheet-radius) var(--sheet-radius) 0 0; background:var(--surface); box-sizing:border-box; animation:stats-detail-enter 180ms ease-out; }
.stats-detail-handle { width:40px; height:4px; margin:0 auto 20px; border-radius:4px; background:var(--border); }
.stats-detail-heading { position:relative; display:flex; align-items:center; gap:12px; min-height:64px; padding-right:36px; margin-bottom:20px; }
.stats-detail-portrait { flex-shrink:0; width:64px; height:64px; }
.stats-detail-identity { min-width:0; flex:1; }.stats-detail-title { color:var(--text); font-size:23px; font-weight:600; line-height:1.4; overflow-wrap:anywhere; }
.stats-detail-caption { margin-top:6px; color:var(--muted); font-size:12px; line-height:1.6; }
button.stats-detail-close { position:absolute; right:-12px; top:-10px; width:44px; min-height:44px; margin:0; padding:0; color:var(--muted); font-size:32px; font-weight:400; }
.stats-detail-body { height:168px; max-height:calc(80vh - 210px); }
.stats-detail-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; text-align:center; }
.stats-detail-number { font-size:32px; font-weight:600; line-height:1.3; overflow-wrap:anywhere; font-variant-numeric:tabular-nums; }
.stats-detail-metrics text { display:block; margin-top:6px; color:var(--muted); font-size:12px; }
.stats-detail-record { margin:20px 0; text-align:center; color:var(--muted); font-size:12px; }
.stats-detail-scope { display:flex; align-items:center; justify-content:center; gap:7px; padding:14px 0 0; border-top:1px solid rgba(177,191,198,.14); color:var(--muted); font-size:12px; }
.stats-detail-scope image { flex-shrink:0; width:14px; height:14px; }
button.stats-detail-done { min-height:48px; margin-top:20px; font-size:15px; border-radius:14px; }
@keyframes stats-detail-enter { from { transform:translateY(20px); opacity:.8; } to { transform:none; opacity:1; } }
@media(max-width:350px) { .overview-value { font-size:28px; }.rate-unit { font-size:18px; }.stats-role-panel { padding-left:8px; padding-right:8px; }.stats-role-grid { column-gap:4px; }.stats-role-name { font-size:12px; }.stats-role-record { font-size:11px; }.stats-detail-sheet { padding-left:16px; padding-right:16px; } }
@media(prefers-reduced-motion:reduce) { .stats-detail-sheet { animation:none; } }
