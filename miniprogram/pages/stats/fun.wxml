<template name="funPanel">
<view class="page personal-page stats-page fun-page">
<view wx:if="{{loading && !stats}}" class="status">正在读取趣味记录…</view>
<view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button hover-class="none" class="secondary" bindtap="load" disabled="{{loading}}">重试</button></view>
<block wx:if="{{stats}}">
    <view class="fun-content">
      <view wx:if="{{!stats.fun.available}}" class="muted">趣味记录将在服务更新后开放</view>
      <view wx:elif="{{!stats.fun.cards.length}}" class="fun-empty muted">暂无趣味记录</view>
      <block wx:for="{{stats.fun.cards}}" wx:for-item="card" wx:key="id">
      <view wx:if="{{card.sectionTitle}}" class="fun-section-title"><text>{{card.sectionTitle}}</text></view>
      <view class="fun-card">
        <view class="fun-heading"><view class="fun-title"><view wx:if="{{card.icon}}" class="fun-symbol fun-symbol-{{card.iconTone}}" aria-hidden="true"><image class="fun-title-icon" src="{{card.icon}}" mode="aspectFit" /></view><text>{{card.title}}</text></view><text wx:if="{{card.headerNote}}" class="fun-sample">{{card.headerNote}}</text></view>
        <view class="fun-metrics {{card.metrics.length===1?'single':card.metrics.length===3?'three':''}} {{card.iconTone==='purple'?'fun-survival':''}}"><button wx:for="{{card.metrics}}" wx:for-item="metric" wx:key="id" data-url="{{metric.url}}" bindtap="openFunMatches" class="fun-metric" hover-class="stats-pressed" aria-label="{{metric.honorTitle || metric.label}}，{{metric.label}} {{metric.valueLabel}}{{metric.unit}}，查看相关对局"><view class="fun-number {{metric.value===null?'muted':metric.color}}"><text>{{metric.valueLabel}}</text></view><view class="fun-metric-label">{{metric.honorTitle || metric.label}} <text class="fun-metric-chevron" aria-hidden="true">›</text></view></button><view wx:if="{{card.metrics.length===1 && card.rateAvailable}}" class="fun-rate"><text class="fun-rate-value">{{card.rateLabel}}</text><text class="fun-rate-label">成功率</text></view></view>
        <block wx:if="{{card.isCombat && card.roles.length}}"><button hover-class="none" class="disclosure-button fun-role-toggle" bindtap="toggleFunRoles" data-id="{{card.id}}" aria-expanded="{{funRoles[card.id]}}"><text>按角色查看</text><view class="stats-chevron {{funRoles[card.id]?'expanded':''}}" aria-hidden="true"></view></button><view wx:if="{{funRoles[card.id]}}" class="fun-roles"><button wx:for="{{card.roles}}" wx:for-item="role" wx:key="role" data-url="{{role.url}}" bindtap="openFunMatches" class="fun-role" hover-class="none"><view>{{role.label}} ›</view><view class="small muted">{{role.value===null?"尚无完整记录":card.enemyLabel+" "+role.countLabel+" · "+card.allyLabel+" "+role.ally+" · 未生效 "+role.failed+" / "+role.opportunities+" 次"}}</view></button></view></block>
      </view>
      </block>

    </view>
</block>
</view>
</template>
