<import src="../../loading-placeholder.wxml" />
<template name="funPanel">
  <view class="page personal-page stats-page fun-page">
    <template wx:if="{{loading && !stats}}" is="loadingPlaceholder" data="{{kind:'metrics'}}" />
    <view wx:if="{{error && !connectionVisible}}" class="inline-error" role="alert"><view>{{error}}</view><button hover-class="none" class="secondary" bindtap="load" disabled="{{loading}}">重试</button></view>
    <view wx:if="{{stats}}" class="fun-content">
      <view wx:if="{{!stats.fun.available}}" class="muted">趣味记录将在服务更新后开放</view>
      <view wx:elif="{{!stats.fun.tiles.length}}" class="fun-empty muted">暂无趣味记录</view>
      <block wx:else>
        <view class="fun-records-filters" role="group" aria-label="趣味记录筛选">
          <button bindtap="filterFun" data-filter="all" class="{{funFilter!=='counted'?'selected':''}}" aria-pressed="{{funFilter!=='counted'}}" hover-class="stats-pressed">全部 {{stats.fun.totalCount}}</button>
          <button bindtap="filterFun" data-filter="counted" class="{{funFilter==='counted'?'selected':''}}" aria-pressed="{{funFilter==='counted'}}" hover-class="stats-pressed">有次数 {{stats.fun.recordedCount}}</button>
        </view>
        <view wx:if="{{funFilter==='counted' && !stats.fun.recordedCount}}" class="fun-records-empty"><view>还没有累计次数的记录</view><button bindtap="filterFun" data-filter="all" hover-class="stats-pressed">查看全部记录 ›</button></view>
        <view class="fun-records-grid">
          <view wx:for="{{funFilter==='counted'?stats.fun.recordedTiles:stats.fun.tiles}}" wx:for-item="tile" wx:key="key" class="fun-record {{tile.hasCount?'':'is-quiet'}}">
            <view class="fun-record-main {{tile.rateLabel?'has-rate':''}}"><button class="fun-record-entry" data-key="{{tile.key}}" bindtap="openFunDetails" aria-haspopup="dialog" hover-class="stats-pressed" aria-label="{{tile.accessibilityLabel}}">
              <view class="fun-record-identity"><image class="fun-record-icon {{tile.iconTone==='portrait'?'is-portrait':''}}" src="{{tile.icon}}" mode="aspectFit" aria-hidden="true" /><text>{{tile.roleLabel}}</text></view>
              <view class="fun-record-title">{{tile.title}}</view>
              <view class="fun-record-bottom"><view class="fun-record-value {{tile.color}}"><text>{{tile.valueLabel}}</text><text wx:if="{{tile.unit}}" class="fun-record-unit">{{tile.unit}}</text></view></view>
              <view class="fun-record-caption">{{tile.rateLabel || tile.stateLabel}}<text wx:if="{{tile.sampleLabel}}" class="fun-record-sample">{{tile.sampleLabel}}</text></view>
            </button><button class="fun-record-link" data-url="{{tile.url}}" bindtap="openFunMatches" hover-class="stats-pressed" aria-label="查看{{tile.title}}相关对局">›</button></view>
            <block wx:if="{{tile.roles.length}}"><button class="disclosure-button fun-record-role-toggle" bindtap="toggleFunRoles" data-id="{{tile.key}}" aria-expanded="{{!!funRoles[tile.key]}}" hover-class="none"><text>按角色查看</text><text aria-hidden="true">{{funRoles[tile.key]?'−':'+'}}</text></button><view wx:if="{{funRoles[tile.key]}}" class="fun-record-roles"><view wx:for="{{tile.roles}}" wx:for-item="role" wx:key="role" class="fun-record-role-wrap"><button class="fun-record-role" data-key="{{tile.key}}" bindtap="openFunDetails" aria-haspopup="dialog" hover-class="stats-pressed"><view>{{role.label}}</view><view class="fun-record-role-count">{{role.countLabel}}{{role.value===null?'':' '+tile.unit}}</view></button><button class="fun-record-link is-role" data-url="{{role.url}}" bindtap="openFunMatches" hover-class="stats-pressed" aria-label="查看{{role.label}}的{{tile.title}}相关对局">›</button></view></view></block>
          </view>
        </view>
        <view wx:if="{{stats.fun.legacyGames}}" class="fun-records-note">{{stats.fun.legacyGames}} 局旧对局未记录完整过程，缺失数据不按零次计算</view>
      </block>
    </view>
  </view>
</template>
