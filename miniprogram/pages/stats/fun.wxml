<template name="funPanel">
<view class="page personal-page stats-page">
<view wx:if="{{loading && !stats}}" class="status">正在读取趣味记录…</view>
<view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button hover-class="none" class="secondary" bindtap="load" disabled="{{loading}}">重试</button></view>
<block wx:if="{{stats}}">
    <view class="fun-content">
      <view wx:if="{{stats.fun.cards.length || stats.fun.legacyGames}}" class="records-scope fun-scope">
        <button class="disclosure-button fun-info-button" hover-class="none" bindtap="toggleFunRules" aria-expanded="{{funRulesExpanded}}" aria-label="{{funRulesExpanded?'收起统计说明':'展开统计说明'}}"><image src="/assets/record-info.svg" aria-hidden="true" /><text>说明</text></button>
        <button wx:if="{{stats.fun.shareable}}" class="records-share" hover-class="none" bindtap="shareStats" disabled="{{loading || !!error}}" aria-label="分享完整趣味记录图片"><image src="/assets/share.svg" aria-hidden="true" /><text>分享</text></button>
      </view>
      <view wx:if="{{funRulesExpanded}}" class="fun-rules small muted">
        <view class="fun-rule-title">统计说明</view>
        <view>仅统计已记录的有效机会；“—”表示未知，“0”表示已记录但未发生。点击称号可查看相关对局。</view>
        <view wx:if="{{stats.fun.legacyGames}}">{{stats.fun.legacyGames}} 局旧对局未记录完整过程，缺失数据不按零次计算。</view>
        <view wx:for="{{stats.fun.cards}}" wx:for-item="card" wx:key="id" class="fun-rule-item">
          <view class="fun-rule-title">{{card.title}} · {{card.coverage}}</view>
          <view wx:if="{{card.isHonor}}">按获奖局数统计，每局每项最多累计一次。</view>
          <view wx:if="{{card.description}}">{{card.description}}</view>
          <view wx:for="{{card.metrics}}" wx:for-item="metric" wx:key="id" wx:if="{{metric.honorTitle}}">{{metric.honorTitle}}：{{metric.label}}</view>
          <view wx:if="{{card.rateAvailable && card.metrics.length>1}}">{{card.isCombat?card.combatRateLabel:'成功率'}} {{card.rateLabel}} · {{card.sampleLabel}}</view>
          <view wx:if="{{card.roleLabel}}">适用身份：{{card.metrics[0].roleDetail}}</view>
          <view wx:if="{{card.id==='classic:shield' || card.id==='knights:shield' || card.id==='other:shield'}}">挡刀率按终局面对最终非空刀的有效机会计算。</view>
          <view wx:if="{{card.aimLabel}}">{{card.aimLabel}}；选中敌方但被挡下仍计未生效。</view>
        </view>
        <view wx:if="{{stats.fun.cards.length}}" class="fun-rule-item">派西按初始身份统计：三蓝且梅林未被刺计最强派西，三红或梅林被刺计竭尽全力，一局最多一次。梅林、刺客只统计最终刺杀机会。守卫实际挡下伤害、魔术师换号让原目标避开伤害才计保护，比例分母为实际保护总次数。职业杀手、痛击队友合并轮内刀、枪、决斗造成的实际出局，缴械不计击杀。按技能发生时的阵营区分友方与对方；缺失过程不按零次计算。</view>
      </view>
      <view wx:if="{{!stats.fun.available}}" class="muted">趣味记录将在服务更新后开放</view>
      <view wx:elif="{{!stats.fun.cards.length}}" class="fun-empty muted">暂无趣味记录</view>
      <block wx:for="{{stats.fun.cards}}" wx:for-item="card" wx:key="id">
      <view wx:if="{{card.sectionTitle}}" class="fun-section-title"><text>{{card.sectionTitle}}</text></view>
      <view class="fun-card">
        <view class="fun-heading"><view class="fun-title"><image wx:if="{{card.icon}}" class="fun-title-icon" src="{{card.icon}}" aria-hidden="true" /><text>{{card.title}}</text></view><view class="fun-heading-actions"><text wx:if="{{card.headerNote}}" class="fun-sample">{{card.headerNote}}</text><button wx:if="{{card.shareMetric}}" class="share-entry-button" bindtap="openFunMenu" data-card="{{card.id}}" disabled="{{loading || error}}" hover-class="none" aria-label="{{card.title}}更多操作"><image class="share-entry-icon" src="/assets/record-more.svg" aria-hidden="true" /></button></view></view>
        <view class="fun-metrics {{card.metrics.length===1?'single':card.metrics.length===3?'three':''}}"><button wx:for="{{card.metrics}}" wx:for-item="metric" wx:key="id" data-url="{{metric.url}}" bindtap="openFunMatches" class="fun-metric" hover-class="none" aria-label="{{metric.honorTitle || metric.label}}，{{metric.label}} {{metric.valueLabel}}{{metric.unit}}，查看相关对局"><view class="fun-number {{metric.color}}"><text>{{metric.valueLabel}}</text></view><view class="fun-metric-label">{{metric.honorTitle || metric.label}} <text class="fun-metric-chevron" aria-hidden="true">›</text></view></button><view wx:if="{{card.metrics.length===1 && card.rateAvailable}}" class="fun-rate"><text class="fun-rate-value">{{card.rateLabel}}</text><text class="fun-rate-label">成功率</text></view></view>
        <block wx:if="{{card.isCombat && card.roles.length}}"><button hover-class="none" class="disclosure-button fun-role-toggle" bindtap="toggleFunRoles" data-id="{{card.id}}" aria-expanded="{{funRoles[card.id]}}"><text>按角色查看</text><view class="stats-chevron {{funRoles[card.id]?'expanded':''}}" aria-hidden="true"></view></button><view wx:if="{{funRoles[card.id]}}" class="fun-roles"><button wx:for="{{card.roles}}" wx:for-item="role" wx:key="role" data-url="{{role.url}}" bindtap="openFunMatches" class="fun-role" hover-class="none"><view>{{role.label}} ›</view><view class="small muted">{{role.value===null?"尚无完整记录":card.enemyLabel+" "+role.countLabel+" · "+card.allyLabel+" "+role.ally+" · 未生效 "+role.failed+" / "+role.opportunities+" 次"}}</view></button></view></block>
      </view>
      </block>

    </view>
</block>
</view>
</template>
