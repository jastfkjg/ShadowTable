.web-login-page { max-width: 580px; padding-top: 48rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.login-title { font-size: 44rpx; font-weight: 600; margin-bottom: 32rpx; }
.login-copy { color: var(--muted); font-size: 28rpx; line-height: 1.7; margin: 16rpx 0; }
.login-account { display: flex; gap: 24rpx; align-items: center; margin: 32rpx 0; }
.login-avatar { width: 112rpx; height: 112rpx; border-radius: 50%; flex-shrink: 0; }
.login-initial { display: flex; align-items: center; justify-content: center; color: var(--accent); background: var(--surface); }
.login-name { font-size: 36rpx; overflow-wrap: anywhere; }
.login-details { padding: 28rpx; border: 1px solid var(--border); border-radius: 20rpx; margin: 28rpx 0; }
.login-label { color: var(--muted); font-size: 26rpx; margin-bottom: 8rpx; }
.login-label:not(:first-child) { margin-top: 24rpx; }
.login-website { word-break: break-all; }
.login-actions { margin-top: 36rpx; }
.web-login-page button { width: 100%; min-height: 48px; margin-top: 20rpx; }
@media (orientation: landscape) { .login-title { font-size: 24px; } .login-copy, .login-label { font-size: 14px; } .login-name { font-size: 20px; } }
