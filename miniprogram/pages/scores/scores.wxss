.scores-page { max-width: 600px; padding-top: 28rpx; }
.score-overview { padding: 28rpx; background: var(--surface); border-radius: 24rpx; }
.score-overview-label { color: var(--muted); font-size: 26rpx; }
.score-balance { display: flex; align-items: baseline; gap: 12rpx; margin: 4rpx 0 24rpx; color: var(--accent); font-size: 64rpx; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.score-balance > text:first-child { min-width: 0; }
.score-unit { font-size: 26rpx; font-weight: 400; flex-shrink: 0; }
.score-sources { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--border); }
.score-sources > view { min-width: 0; }
.score-source-label, .score-source-note { display: block; color: var(--muted); font-size: 24rpx; }
.score-source-value { display: block; margin: 6rpx 0; font-size: 32rpx; font-weight: 500; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.score-source-unit { font-size: 24rpx; font-weight: 400; }
.ledger-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 28rpx; font-size: 30rpx; font-weight: 600; }
.ledger-count { color: var(--muted); font-size: 24rpx; font-weight: 400; white-space: nowrap; }
button.ledger-explain { width: auto; flex-shrink: 0; min-height: 48px; margin: 0; padding: 12rpx 0 12rpx 16rpx; font-size: 24rpx; font-weight: 400; color: var(--muted); }
.ledger-day { margin-top: 24rpx; padding: 8rpx 0; font-size: 24rpx; color: var(--muted); }
.ledger-entry { border-bottom: 1rpx solid var(--border); }
.ledger-day-last { border-bottom: 0; }
button.ledger-match, .ledger-adjustment { display: block; width: 100%; margin: 0; padding: 24rpx 0; text-align: left; border-radius: 0; font-weight: 400; box-sizing: border-box; }
.ledger-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 24rpx; }
.ledger-title { flex: 1 1 160rpx; min-width: 0; font-size: 30rpx; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.ledger-points { flex-shrink: 0; font-size: 32rpx; font-weight: 600; color: var(--accent); white-space: nowrap; font-variant-numeric: tabular-nums; }
.ledger-points.negative { color: var(--evil); }
.ledger-unit { font-size: 24rpx; font-weight: 400; }
.ledger-subrow { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; margin-top: 8rpx; font-size: 26rpx; }
.ledger-subrow > text { min-width: 0; overflow-wrap: anywhere; }
.ledger-chevron { width: 12rpx; height: 12rpx; flex-shrink: 0; margin-right: 6rpx; border-top: 3rpx solid var(--muted); border-right: 3rpx solid var(--muted); transform: rotate(45deg); }
.ledger-meta, .ledger-balance { margin-top: 8rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.ledger-reason { margin-top: 12rpx; font-size: 26rpx; overflow-wrap: anywhere; }
.ledger-balance { display: flex; flex-wrap: wrap; gap: 0 12rpx; }
.ledger-balance > text { white-space: nowrap; font-variant-numeric: tabular-nums; }
.ledger-end { text-align: center; color: var(--muted); font-size: 24rpx; padding: 32rpx 0 8rpx; }
.ledger-empty { padding: 60rpx 24rpx; text-align: center; color: var(--muted); font-size: 26rpx; }
.ledger-empty-title { margin-bottom: 12rpx; color: var(--text); font-size: 30rpx; }
button.ledger-more { width: 100%; min-height: 48px; margin: 16rpx 0; color: var(--accent); font-size: 26rpx; }
.ledger-more-error, .ledger-notice { color: var(--muted); font-size: 26rpx; margin: 24rpx 0; }
.ledger-pressed { opacity: .72; }
@media (min-width: 600px) { .scores-page { padding: 24px 24px calc(32px + env(safe-area-inset-bottom)); } }
@media (min-width: 600px) {
  .score-overview { padding: 20px; border-radius: 16px; }
  .score-overview-label, .ledger-subrow, .ledger-reason, .ledger-empty, .ledger-more-error, .ledger-notice { font-size: 16px; }
  .score-balance { font-size: 40px; gap: 8px; margin: 4px 0 16px; }
  .score-unit { font-size: 16px; }
  .score-sources { gap: 24px; padding-top: 16px; }
  .score-source-label, .score-source-note, .score-source-unit, .ledger-count, .ledger-day, .ledger-unit, .ledger-meta, .ledger-balance, .ledger-end { font-size: 14px; }
  .score-source-value { font-size: 20px; margin: 4px 0; }
  .ledger-heading { margin-top: 20px; gap: 12px; font-size: 18px; }
  button.ledger-explain { padding: 8px 0 8px 12px; font-size: 14px; }
  .ledger-day { margin-top: 16px; padding: 4px 0; }
  button.ledger-match, .ledger-adjustment { padding: 16px 0; }
  .ledger-row { gap: 16px; }
  .ledger-title { flex-basis: 120px; font-size: 18px; }
  .ledger-points { font-size: 20px; }
  .ledger-subrow { margin-top: 6px; gap: 16px; }
  .ledger-chevron { width: 7px; height: 7px; border-width: 2px; }
  .ledger-meta, .ledger-balance { margin-top: 6px; }
  .ledger-reason { margin-top: 8px; }
  .ledger-end { padding: 24px 0 8px; }
  button.ledger-more { font-size: 16px; margin: 16px 0; }
  .ledger-empty { padding: 40px 16px; }
  .ledger-empty-title { font-size: 18px; margin-bottom: 8px; }
}
