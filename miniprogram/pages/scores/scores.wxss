.scores-page { max-width: 600px; padding-top: 28rpx; }
.scores-page .inline-error button { min-height: 48px; }
.score-overview { padding: 16rpx 28rpx 32rpx; background: var(--surface); border: 1rpx solid var(--border); border-radius: 24rpx; }
.score-overview-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 16rpx; }
.score-overview-label { color: var(--muted); font-size: 28rpx; }
button.ledger-explain { display: flex; align-items: center; gap: 10rpx; width: auto; flex-shrink: 0; min-height: 44px; margin: 0 0 0 auto; padding: 8rpx 0 8rpx 8rpx; font-size: 24rpx; font-weight: 400; color: var(--muted); }
.ledger-help-icon { display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border: 2rpx solid currentColor; border-radius: 50%; font-size: 22rpx; line-height: 1; box-sizing: border-box; }
.score-balance { display: flex; align-items: baseline; gap: 16rpx; margin-top: 4rpx; color: var(--accent); font-size: 88rpx; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.score-balance-compact { font-size: 64rpx; }
.score-balance > text:first-child { min-width: 0; }
.score-unit { font-size: 32rpx; font-weight: 400; flex-shrink: 0; }
.ledger-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; margin-top: 48rpx; font-size: 36rpx; font-weight: 600; }
.ledger-count { color: var(--muted); font-size: 24rpx; font-weight: 400; white-space: nowrap; }
.ledger-day { display: flex; align-items: center; gap: 24rpx; margin-top: 32rpx; padding: 8rpx 0; font-size: 26rpx; color: var(--muted); }
.ledger-day > text { flex-shrink: 0; }
.ledger-day-rule { flex: 1; height: 1rpx; background: var(--border); }
.ledger-entry { border-bottom: 1rpx solid var(--border); }
.ledger-day-last { border-bottom: 0; }
button.ledger-record, .ledger-record { display: block; width: 100%; min-width: 0; margin: 0; padding: 28rpx 0; text-align: left; border-radius: 0; font-weight: 400; box-sizing: border-box; }
.ledger-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.ledger-description { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.ledger-title { font-size: 32rpx; font-weight: 500; line-height: 1.5; }
.ledger-meta { margin-top: 6rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.ledger-value { display: flex; flex-shrink: 0; align-items: center; gap: 28rpx; }
.ledger-points { font-size: 40rpx; font-weight: 600; color: var(--accent); line-height: 1.3; white-space: nowrap; font-variant-numeric: tabular-nums; }
.ledger-points.negative { color: var(--evil); }
.ledger-points.neutral { color: var(--text); }
.ledger-unit { font-size: 26rpx; font-weight: 400; }
/* Keep score columns aligned even when an adjustment has no detail link. */
.ledger-accessory { display: flex; align-items: center; justify-content: center; width: 16rpx; flex-shrink: 0; }
.ledger-chevron { width: 12rpx; height: 12rpx; border-top: 2rpx solid var(--muted); border-right: 2rpx solid var(--muted); transform: rotate(45deg); }
.ledger-reason, .ledger-balance { margin-top: 8rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.ledger-balance { display: flex; flex-wrap: wrap; gap: 0 12rpx; }
.ledger-balance > text { min-width: 0; font-variant-numeric: tabular-nums; }
.ledger-end { display: flex; align-items: center; justify-content: center; gap: 24rpx; text-align: center; color: var(--muted); font-size: 24rpx; padding: 40rpx 0 8rpx; }
.ledger-end-rule { flex: 0 1 72rpx; height: 1rpx; background: var(--border); }
.ledger-empty { padding: 64rpx 24rpx; text-align: center; color: var(--muted); font-size: 26rpx; }
.ledger-empty-title { margin-bottom: 12rpx; color: var(--text); font-size: 30rpx; }
button.ledger-more { width: 100%; min-height: 48px; margin: 16rpx 0; color: var(--accent); font-size: 26rpx; }
.ledger-more-error, .ledger-notice { color: var(--muted); font-size: 26rpx; margin: 24rpx 0; }
.ledger-pressed { opacity: .72; }
@media (min-width: 600px) {
  .scores-page { padding: 24px 24px calc(32px + env(safe-area-inset-bottom)); }
  .score-overview { padding: 8px 20px 24px; border-radius: 16px; }
  .score-overview-heading { gap: 0 12px; }
  .score-overview-label, .ledger-empty, .ledger-more-error, .ledger-notice { font-size: 16px; }
  button.ledger-explain { gap: 6px; padding: 8px 0 8px 8px; font-size: 14px; }
  .ledger-help-icon { width: 16px; height: 16px; border-width: 1px; font-size: 12px; }
  .score-balance { font-size: 52px; gap: 10px; margin-top: 4px; }
  .score-balance-compact { font-size: 40px; }
  .score-unit { font-size: 18px; }
  .ledger-count, .ledger-day, .ledger-unit, .ledger-meta, .ledger-reason, .ledger-balance, .ledger-end { font-size: 14px; }
  .ledger-heading { margin-top: 28px; gap: 12px; font-size: 20px; }
  .ledger-day { margin-top: 24px; padding: 4px 0; gap: 16px; }
  button.ledger-record, .ledger-record { padding: 20px 0; }
  .ledger-row { gap: 16px; }
  .ledger-title { font-size: 18px; }
  .ledger-value { gap: 16px; }
  .ledger-points { font-size: 24px; }
  .ledger-accessory { width: 10px; }
  .ledger-chevron { width: 7px; height: 7px; border-width: 1px; }
  .ledger-meta, .ledger-reason, .ledger-balance { margin-top: 6px; }
  .ledger-balance { gap: 0 8px; }
  .ledger-end { padding: 28px 0 8px; gap: 16px; }
  .ledger-end-rule { flex-basis: 48px; }
  button.ledger-more { font-size: 16px; margin: 16px 0; }
  .ledger-empty { padding: 40px 16px; }
  .ledger-empty-title { font-size: 18px; margin-bottom: 8px; }
  .ledger-more-error, .ledger-notice { margin: 16px 0; }
}
