.scores-page { --ledger-line:rgba(177,191,198,.13); max-width:600px; padding:12px 16px calc(32px + env(safe-area-inset-bottom)); }
.scores-page .inline-error button { min-height:48px; }
.score-overview { padding:12px 17px 20px; background:var(--surface); border-radius:22px; }
.score-overview-heading { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:0 12px; }
.score-overview-label { display:flex; align-items:center; gap:7px; color:var(--muted); font-size:13px; }.score-overview-label image { flex-shrink:0; width:18px; height:18px; }
button.ledger-explain { display:flex; align-items:center; gap:5px; width:auto; flex-shrink:0; min-height:44px; margin:0 0 0 auto; padding:4px 0 4px 8px; font-size:12px; font-weight:400; color:var(--muted); }.ledger-help-icon { width:16px; height:16px; flex-shrink:0; }
.score-balance { display:flex; align-items:baseline; gap:7px; margin-top:2px; color:var(--accent); font-size:49px; font-weight:600; line-height:1.2; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }.score-balance-compact { font-size:36px; }.score-balance>text:first-child { min-width:0; }.score-unit { font-size:18px; font-weight:400; flex-shrink:0; }.score-overview-note { margin-top:12px; color:var(--muted); font-size:12px; line-height:1.5; }
.ledger-heading { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin:24px 4px 6px; font-size:16px; font-weight:600; }.ledger-count { color:var(--muted); font-size:12px; font-weight:400; white-space:nowrap; }
.ledger-day { display:flex; align-items:center; flex-wrap:wrap; gap:7px; min-height:44px; padding:0 4px; margin-top:6px; color:var(--text); font-size:13px; }.ledger-day image { flex-shrink:0; width:16px; height:16px; }
.ledger-entry { position:relative; padding:0 14px; background:var(--surface); }.ledger-entry::after { content:''; position:absolute; left:14px; right:14px; bottom:0; height:1px; background:var(--ledger-line); pointer-events:none; }.ledger-day-first { border-top-left-radius:22px; border-top-right-radius:22px; }.ledger-day-last { border-bottom-left-radius:22px; border-bottom-right-radius:22px; }.ledger-day-last::after { display:none; }
button.ledger-record, .ledger-record { display:block; width:100%; min-width:0; min-height:85px; margin:0; padding:17px 0; text-align:left; border-radius:0; font-weight:400; box-sizing:border-box; }
.ledger-row { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:51px; }.ledger-symbol { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:34px; height:36px; }.ledger-symbol image { width:20px; height:20px; flex-shrink:0; }.ledger-symbol image.ledger-portrait { width:40px; height:40px; }.ledger-symbol.is-adjustment { border-radius:11px; background:#42392f; }
.ledger-description { flex:1; min-width:0; overflow-wrap:anywhere; }.ledger-title { font-size:14px; font-weight:500; line-height:1.5; }.ledger-meta { margin-top:6px; color:var(--muted); font-size:12px; line-height:1.6; }
.ledger-value { display:flex; flex-shrink:0; align-items:center; gap:8px; max-width:42%; }.ledger-points { font-size:24px; font-weight:600; color:var(--accent); line-height:1.3; overflow-wrap:anywhere; font-variant-numeric:tabular-nums; }.ledger-points.negative { color:var(--evil); }.ledger-points.neutral { color:var(--text); }.ledger-unit { font-size:12px; font-weight:400; color:var(--muted); }
.ledger-accessory { display:flex; align-items:center; justify-content:center; width:7px; flex-shrink:0; }.ledger-chevron { width:5px; height:5px; border-top:1.5px solid var(--muted); border-right:1.5px solid var(--muted); transform:rotate(45deg); }
.ledger-reason, .ledger-balance { margin:8px 0 0 42px; color:var(--muted); font-size:12px; line-height:1.7; overflow-wrap:anywhere; }.ledger-balance { display:flex; justify-content:space-between; flex-wrap:wrap; gap:0 10px; }.ledger-balance>text { min-width:0; color:var(--text); font-variant-numeric:tabular-nums; }
.ledger-row-compact { display:grid; grid-template-columns:34px minmax(0,1fr); gap:8px; }.ledger-row-compact .ledger-symbol { grid-row:1 / 3; }.ledger-row-compact .ledger-description { grid-column:2; grid-row:1; }.ledger-row-compact .ledger-value { grid-column:2; grid-row:2; max-width:100%; justify-content:space-between; }.ledger-row-compact .ledger-points { font-size:21px; }
.ledger-end { display:flex; align-items:center; justify-content:center; gap:12px; text-align:center; color:var(--muted); font-size:12px; padding:24px 0 8px; }.ledger-end-rule { flex:0 1 36px; height:1px; background:var(--ledger-line); }
.ledger-empty { padding:32px 12px; text-align:center; color:var(--muted); font-size:13px; }.ledger-empty-title { margin-bottom:8px; color:var(--text); font-size:15px; }
button.ledger-more { width:100%; min-height:48px; margin:12px 0; color:var(--accent); font-size:14px; }.ledger-more-error, .ledger-notice { color:var(--muted); font-size:13px; line-height:1.7; margin:16px 0; }.ledger-pressed { opacity:.72; }
@media(max-width:350px) { .scores-page { padding-left:12px; padding-right:12px; }.score-balance-compact { font-size:28px; }.ledger-entry { padding-left:12px; padding-right:12px; }.ledger-row { gap:7px; }.ledger-title { font-size:13px; }.ledger-symbol { width:30px; }.ledger-row-compact { grid-template-columns:30px minmax(0,1fr); }.ledger-points { font-size:22px; }.ledger-value { gap:6px; }.ledger-reason,.ledger-balance { margin-left:37px; } }
@media(min-width:600px) { .scores-page { padding-left:24px; padding-right:24px; } }
