<template name="ledgerContent">
  <view class="ledger-row {{item.pointsCompact?'ledger-row-compact':''}}">
    <view class="ledger-symbol {{!item.isMatch?'is-adjustment':''}}" aria-hidden="true"><image wx:if="{{item.rolePortrait}}" class="ledger-portrait" src="{{item.rolePortrait}}" mode="aspectFit" /><image wx:else src="{{item.isMatch?'/assets/record-coin.svg':'/assets/record-adjust.svg'}}" /></view>
    <view class="ledger-description">
      <view class="ledger-title">{{item.title}}</view>
      <view class="ledger-meta">{{item.timeLabel}} · {{item.detail}}</view>
    </view>
    <view class="ledger-value">
      <text class="ledger-points {{item.negative?'negative':item.points===0?'neutral':''}}">{{item.pointsLabel}}<text class="ledger-unit"> 分</text></text>
      <view class="ledger-accessory" aria-hidden="true"><view wx:if="{{item.isMatch}}" class="ledger-chevron"></view></view>
    </view>
  </view>
  <block wx:if="{{!item.isMatch}}">
    <view wx:if="{{item.reason}}" class="ledger-reason">{{item.reason}}</view>
    <view class="ledger-balance">操作时积分 <text>{{item.beforePoints}} → {{item.afterPoints}}</text></view>
  </block>
</template>
<app-nav title="积分明细" back="{{true}}" bindback="back" />
<view class="page scores-page">
  <view wx:if="{{loading && !loaded && !connectionVisible}}" class="status">正在读取积分明细…</view>
  <view wx:if="{{error && !connectionVisible}}" class="inline-error" role="alert"><view>{{error}}</view><button class="secondary" bindtap="load" disabled="{{loading}}" hover-class="none">重新加载</button></view>
  <view wx:if="{{notice}}" class="ledger-notice" role="status">{{notice}}</view>
  <block wx:if="{{loaded}}">
    <view class="score-overview">
      <view class="score-overview-heading">
        <view class="score-overview-label"><image src="/assets/record-coin.svg" aria-hidden="true" /><text>当前积分</text></view>
        <button class="ledger-explain" bindtap="openScoringRules" hover-class="ledger-pressed" aria-label="查看计分规则"><image class="ledger-help-icon" src="/assets/record-info.svg" aria-hidden="true" /><text>计分规则</text></button>
      </view>
      <view class="score-balance {{summary.total>=1000000 || summary.total<=-100000?'score-balance-compact':''}}"><text>{{summary.total}}</text><text class="score-unit">分</text></view>
      <view class="score-overview-note">仅当月有效 · 每月 1 日清零</view>
    </view>
    <view class="ledger-heading"><text>本月积分记录</text><text class="ledger-count">共 {{total}} 条</text></view>
    <view wx:if="{{!records.length && !error}}" class="ledger-empty"><view class="ledger-empty-title">暂无积分记录</view><view>完成计分对局后，可在这里查看得分。</view></view>
    <block wx:for="{{records}}" wx:key="id">
      <view wx:if="{{index===0 || item.dayKey!==records[index-1].dayKey}}" class="ledger-day"><image src="/assets/record-calendar.svg" aria-hidden="true" /><text>{{item.dayLabel}}</text></view>
      <view class="ledger-entry {{index===0 || item.dayKey!==records[index-1].dayKey?'ledger-day-first':''}} {{index===records.length-1 || item.dayKey!==records[index+1].dayKey?'ledger-day-last':''}}">
        <button wx:if="{{item.isMatch}}" class="ledger-record" bindtap="openMatch" data-id="{{item.id}}" hover-class="ledger-pressed" aria-label="{{item.title+'，'+item.timeLabel+'，'+item.detail+'，'+item.pointsLabel+'分，在对局记录中查看详情'}}">
          <template is="ledgerContent" data="{{item}}" />
        </button>
        <view wx:else class="ledger-record">
          <template is="ledgerContent" data="{{item}}" />
        </view>
      </view>
    </block>
    <view wx:if="{{moreError && !connectionVisible}}" class="ledger-more-error" role="alert"><view>{{moreError}}</view><button bindtap="retryMore" class="ledger-more" hover-class="ledger-pressed">重新加载</button></view>
    <button wx:elif="{{hasMore && !error}}" class="ledger-more" bindtap="loadMore" disabled="{{loadingMore || loading}}" loading="{{loadingMore}}" hover-class="ledger-pressed">{{loadingMore?'正在加载…':'加载更多'}}</button>
    <view wx:elif="{{records.length && !error}}" class="ledger-end"><view class="ledger-end-rule" aria-hidden="true"></view><text>已显示全部记录</text><view class="ledger-end-rule" aria-hidden="true"></view></view>
  </block>
</view>
<app-dialog id="app-dialog" />
