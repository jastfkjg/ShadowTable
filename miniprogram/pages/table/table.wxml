<view class="page">
  <view class="brand">
    <text class="brand-mark">影中执刃</text>
    <view class="brand-actions">
      <button wx:if="{{room}}" class="switch-table" bindtap="returnHome" disabled="{{busy}}" aria-label="切换牌桌，保留当前座位">切换牌桌</button>
      <button class="connection-button" bindtap="connectionInfo" aria-label="{{!network || needsLogin ? '连接异常' : loading || busy || hasPendingRequest ? '正在同步' : serverConnected ? '连接正常' : '连接未确认'}}">
        <view class="connection-dot {{!network || needsLogin ? 'offline' : loading || busy || hasPendingRequest ? 'pending' : serverConnected ? 'online' : 'offline'}}" />
      </button>
    </view>
  </view>
  <view wx:if="{{loading}}" class="status" role="status">正在连接牌桌…</view>
  <view wx:if="{{error}}" class="dialog-backdrop" catchtouchmove="blockScroll">
    <view class="error-dialog" role="dialog" aria-modal="true" aria-label="操作提示">
      <view class="dialog-title">{{recoverableError?'连接需要恢复':'暂时无法完成'}}</view>
      <view class="dialog-message">{{error}}</view>
      <view class="dialog-actions">
        <button wx:if="{{recoverableError && !hasPendingRequest}}" class="secondary" bindtap="returnHome" disabled="{{busy}}">返回入口</button>
        <button wx:if="{{recoverableError}}" class="primary" bindtap="retry" loading="{{busy}}" disabled="{{busy}}">{{needsLogin?'重新登录':'重试'}}</button>
        <button wx:else class="primary" bindtap="dismissError">知道了</button>
      </view>
    </view>
  </view>
  <view wx:if="{{actionDialog && !error && room.needsSubmission && !room.me.submitted}}" class="dialog-backdrop" catchtouchmove="blockScroll">
    <view class="error-dialog action-dialog" role="dialog" aria-modal="true" aria-label="当前操作">
      <view class="dialog-title">{{room.phase==='identity'?'查看身份':actionLabel}}</view>
      <view wx:if="{{room.phase==='identity'}}" class="action-identity">
        <view wx:if="{{actionSecret}}" class="action-identity-details">
          <view class="identity-title">{{actionSecret.role}}</view>
          <view class="muted">{{actionSecret.faction}}</view>
          <view class="private-info"><view class="label">你的视角</view>{{actionSecret.information}}</view>
        </view>
        <button class="secondary" bindtap="revealActionIdentity" loading="{{busy && !actionSecret}}" disabled="{{busy || !network}}">{{actionSecret?'立即遮盖':'查看身份与视角'}}</button>
      </view>
      <view class="action-choice-list">
        <button wx:for="{{actionChoices}}" wx:key="value" class="primary" bindtap="submitChoice" data-value="{{item.value}}" disabled="{{busy || !network}}">{{room.phase==='identity'?(room.assisted?'已完成互认，确认':'已记住身份'):item.label}}</button>
      </view>
      <scroll-view wx:if="{{actionTargets.length}}" scroll-y class="action-target-scroll">
        <button wx:for="{{actionTargets}}" wx:key="seat" class="secondary" bindtap="submitTarget" data-seat="{{item.seat}}" disabled="{{busy || !network}}">{{item.seat}}号 · {{item.name}}</button>
      </scroll-view>
      <button class="text-button" bindtap="closeAction" disabled="{{busy}}">稍后</button>
    </view>
  </view>
  <view wx:if="{{toolType && room.canUseTools && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll">
    <view class="error-dialog" role="dialog" aria-modal="true" aria-label="发起操作">
      <view class="dialog-title">{{toolTitle?toolTitle:toolType==='vote'?'发起投票':toolType==='quest'?'发起任务':toolType==='reverseStrike'?'刀逆仆':toolType==='offline'?'线下刀人':'刀梅林'}}</view>
      <block wx:if="{{toolType==='vote' || toolType==='quest' || (room.knights && toolType==='assassination')}}">
        <view class="small muted">{{room.knights && toolType==='assassination'?'选择线下多数决议的红方带刀人（平票先猜拳）；由本人录入目标或空刀。提前起刀只能在发言环节。':toolType==='vote'?'可选队伍，也可直接发起全员投票。':'选择任务队员。'}}</view>
        <scroll-view scroll-y class="tool-seat-scroll" style="height: {{toolPlayers.length>6?400:296}}rpx;">
        <view class="tool-seat-grid">
          <button wx:for="{{toolPlayers}}" wx:key="seat" class="tool-seat-option {{item.selected?'active':''}}" bindtap="toggleToolSeat" data-seat="{{item.seat}}" disabled="{{busy}}" aria-label="{{item.seat+'号 '+item.name+(item.selected?'，已选':'')}}">{{item.seat}}号 · {{item.name}}</button>
        </view>
        </scroll-view>
        <view class="small muted">已选 {{toolSeats.length}} 人</view>
        <picker wx:if="{{toolType==='quest'}}" range="{{toolThresholds}}" value="{{toolThreshold-1}}" bindchange="pickToolThreshold" disabled="{{busy}}">
          <view class="picker setting-row"><text>判失败需要</text><text>{{toolThreshold}} 张失败票 · 更改</text></view>
        </picker>
      </block>
      <view wx:else class="dialog-message">{{toolDescription?toolDescription:toolType==='offline'?'线下刀人后，由房主记录完成。':toolType==='reverseStrike'?'刺客选择逆仆，结果私密。':'刺客选择梅林，结算后公开是否命中。'}}</view>
      <view class="dialog-actions">
        <button class="secondary" bindtap="closeTool" disabled="{{busy}}">取消</button>
        <button class="primary" bindtap="launchTool" disabled="{{busy || (toolType==='quest' && toolSeats.length<toolThreshold)}}">发起</button>
      </view>
    </view>
  </view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <block wx:if="{{!room}}">
    <form class="panel entry-panel" bindsubmit="submitEntry">
      <label class="label" for="nickname">桌上昵称</label>
      <input class="input" id="nickname" name="nickname" type="nickname" maxlength="16"
        value="{{name}}" bindinput="inputName" bindblur="inputName"
        placeholder="点此使用微信昵称或输入" disabled="{{busy}}" />
      <view class="entry-tabs">
        <button class="entry-tab {{entryMode!=='join'?'active':''}}" data-mode="create" bindtap="switchEntry" disabled="{{busy}}">创建房间</button>
        <button class="entry-tab {{entryMode==='join'?'active':''}}" data-mode="join" bindtap="switchEntry" disabled="{{busy}}">加入房间</button>
      </view>
      <block wx:if="{{entryMode!=='join'}}">
        <view class="field-title">人数</view>
        <view class="capacity-grid">
          <button wx:for="{{capacities}}" wx:key="*this" class="capacity-option {{capacity===item?'active':''}}"
            data-capacity="{{item}}" bindtap="pickCapacity" disabled="{{busy || loading}}"
            aria-label="{{item+'人'+(capacity===item?'，已选':'')}}">{{item}}人</button>
        </view>
        <view class="field-title">板子</view>
        <view wx:if="{{availableBoards.length===1}}" class="single-board">{{boardName}}</view>
        <view wx:else class="board-options">
          <button wx:for="{{availableBoards}}" wx:key="id" class="board-option {{boardId===item.id?'active':''}}"
            data-index="{{index}}" bindtap="pickBoard" disabled="{{busy || loading}}">
            <text>{{item.name}}</text><text class="selection-mark">{{boardId===item.id?'已选':'选择'}}</text>
          </button>
        </view>
        <text wx:if="{{boardAssisted}}" class="small muted assisted-hint">互认、起刀与最终胜负在线下完成</text>
        <button class="text-button rules-toggle" bindtap="toggleRules">{{showRules?'收起配置':'角色配置'}}</button>
        <view wx:if="{{showRules}}" class="rules-detail">
          <view wx:for="{{boardRoleConfiguration}}" wx:key="faction" class="role-line">{{item.label}}：{{item.roles}}</view>
        </view>
        <button class="primary" form-type="submit" data-action="create" loading="{{busy}}" disabled="{{loading || busy}}">创建 {{capacity}} 人房间</button>
      </block>
      <block wx:else>
        <label class="field-title" for="room-code">房间码</label>
        <input class="input room-input" id="room-code" name="code" type="number" maxlength="6"
          value="{{code}}" bindinput="inputCode" placeholder="输入6位房间码" disabled="{{busy}}" />
        <button class="primary" form-type="submit" data-action="join" loading="{{busy}}" disabled="{{loading || busy}}">加入房间</button>
      </block>
    </form>
    <block wx:if="{{memberRooms.length}}">
      <view class="section-title">我的牌桌</view>
      <view wx:for="{{memberRooms}}" wx:key="code" class="member-room">
        <button class="secondary room-open" data-code="{{item.code}}" bindtap="openRoom" disabled="{{busy || loading}}">
          {{item.code}} · {{item.seat===null?'重新入座':item.seat+'号'}} · {{item.phaseName}}
        </button>
        <button wx:if="{{item.isHost}}" class="room-delete" data-code="{{item.code}}" bindtap="deleteRoom" disabled="{{busy || loading}}" aria-label="{{'删除牌桌'+item.code}}">删除</button>
      </view>

    </block>
  </block>
  <block wx:else>
    <view class="room-summary">
      <button class="copy-room" bindtap="copyRoomCode" aria-label="{{'复制房间号'+room.code}}">
        <text>房间 {{room.code}}</text><text class="copy-label">复制</text>
      </button>
      <text class="summary-seat">你在 {{room.me.seat}} 号</text>
    </view>
    <view class="row subline room-subline">
      <view class="room-board-info">
        <text class="room-board-name">{{room.boardName}} · {{room.capacity}}人</text>
        <button class="room-rules-button" bindtap="openRoomRules" aria-label="查看当前板子的角色配置">配置说明</button>
      </view>
      <text class="room-host-label">{{room.me.isHost?'房主':'玩家'}}</text>
    </view>
    <view wx:if="{{showRoomRules && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll">
      <view class="error-dialog" role="dialog" aria-modal="true" aria-label="角色配置">
        <view class="dialog-title">角色配置</view>
        <view class="small muted">{{room.boardName}} · {{room.capacity}}人</view>
        <view class="configuration-roles">
          <view wx:for="{{room.roleConfiguration}}" wx:key="faction" class="role-line">{{item.label}}：{{item.roles}}</view>
        </view>
        <view class="dialog-actions">
          <button class="primary" bindtap="closeRoomRules">知道了</button>
        </view>
      </view>
    </view>
    <view wx:if="{{room.assisted}}" class="notice">线下辅助 · 互认、起刀与胜负在线下完成</view>
    <view class="phase-strip"
      ><view class="kicker"
        >{{room.game?'第 '+room.game+' 局':'准备开局'}} {{!room.flexible && room.round?' / 任务 '+room.round:''}}</view
      ><view class="phase-title">{{room.phaseName}}</view
      ><text wx:if="{{room.leader && !room.flexible}}" class="muted"
        >队长 {{room.leader}} 号 · 连续否决 {{room.rejects}} / 5</text
      ></view
    >
    <block wx:if="{{room.phase!=='lobby'}}">
      <button wx:if="{{!revealed}}" class="identity-compact" bindtap="reveal" disabled="{{busy || !network}}" aria-label="查看我的身份">
        <text>我的身份</text><text class="identity-compact-action">查看 ›</text>
      </button>
      <view wx:else class="identity open">
        <view class="identity-title">{{secret.role}}</view>
        <text class="muted">{{secret.faction}}</text>
        <view class="private-info">{{secret.information}}<text wx:if="{{secret.outcome}}" class="label">{{secret.outcome}}</text></view>
        <button class="secondary" bindtap="reveal" disabled="{{busy || !network}}">立即遮盖</button>
      </view>
    </block>
    <view wx:if="{{room.needsSubmission}}" class="action-entry">
      <text>{{room.me.submitted?'本轮操作已提交':'待完成操作'}}</text>
      <button wx:if="{{!room.me.submitted}}" class="secondary" bindtap="openAction" disabled="{{busy || actionLoading || !network}}" loading="{{actionLoading}}">立即操作</button>
    </view>
    <block wx:if="{{room.phase==='lobby'}}">
      <view class="panel"
        >
        <button wx:if="{{room.me.isHost}}" class="text-button" bindtap="toggleRoomSettings">{{showRoomSettings?'收起设置':'人数与板子设置'}}</button>
        <view wx:if="{{room.me.isHost && showRoomSettings}}">
          <picker range="{{roomCapacities}}" value="{{roomCapacityIndex}}" bindchange="configureCapacity" disabled="{{busy}}">
            <view class="picker setting-row"><text>人数</text><text>{{room.capacity}}人 · 更改</text></view>
          </picker>
          <picker wx:if="{{roomBoards.length>1}}" range="{{roomBoards}}" range-key="name" value="{{roomBoardIndex}}" bindchange="configureBoard" disabled="{{busy}}">
            <view class="picker setting-row"><text>板子</text><text>{{room.boardName}} · 更改</text></view>
          </picker>
          <view wx:else class="picker">{{room.boardName}}</view>
          <text class="small muted">修改后需全员重新准备</text>
        </view>
        <text class="muted small">全员准备后开局</text>
        <button class="primary" bindtap="ready" disabled="{{busy}}">
          {{room.me.ready?'取消准备':'我准备好了'}}</button
        ><button
          wx:if="{{room.me.isHost}}"
          class="secondary"
          bindtap="start"
          disabled="{{busy}}"
        >
          发放身份
        </button></view
      >
    </block>
    <view class="section-title"
      >座位
      <text class="small muted"
        >{{room.phase==='lobby'?'点空位换座':'金色为队员，「你」为自己'}}</text
      ></view
    >
    <view class="seats"
      ><button
        wx:for="{{seats}}"
        wx:key="seat"
        class="seat {{item.mine?'mine':''}} {{item.inTeam?'team':''}} {{item.selected?'selected':''}}"
        data-seat="{{item.seat}}"
        aria-label="{{item.seat+'号，'+item.name+(item.mine?'，你的座位':'')+(item.selected?'，已选入队':item.inTeam?'，任务队员':'')}}"
        bindtap="seat"
        disabled="{{busy || (room.phase==='lobby'?item.occupied:!(room.phase==='proposal' && !room.flexible && room.leader===room.me.seat))}}"
      >
        <view class="seat-number"
          >{{item.seat}}<text class="seat-flag"
            >{{item.mine?'你':item.host?'房主':''}}</text
          ></view
        ><view class="seat-name">{{item.name}}{{item.alive===false?" · 已出局":""}}</view
        ><view class="seat-meta"
          >{{room.phase==='lobby'?(item.occupied?(item.ready?'已准备':'未准备'):'可入座'):(item.selected?'已选入队':item.inTeam?'任务队员':'')}}</view
        >
      </button></view
    >
    <block wx:if="{{room.phase==='lobby'}}">
      <button wx:if="{{room.me.isHost && room.players.length>1}}" class="text-button" bindtap="toggleTransfer">{{showTransfer?'收起转交':'转交房主'}}</button>
      <view wx:if="{{room.me.isHost && room.players.length>1 && showTransfer}}" class="panel"
        ><text class="label">选择新房主</text
        ><block wx:for="{{room.players}}" wx:key="seat"
          ><button
            wx:if="{{item.seat!==room.me.seat}}"
            class="compact secondary"
            data-seat="{{item.seat}}"
            bindtap="transfer"
            disabled="{{busy}}"
          >
            交给 {{item.seat}} 号 · {{item.name}}
          </button></block
        ></view
      >
      <button class="leave-button" bindtap="leave" disabled="{{busy}}">
        离开房间
      </button>
    </block>
    <block wx:else>
      <view wx:if="{{room.phase==='proposal' && !room.canUseTools && !room.flexible}}" class="panel"
        ><view class="label">本轮需要 {{room.teamSize}} 人</view
        ><text class="muted"
          >{{room.leader===room.me.seat?'点座位选人，再提交队伍':'等待队长选人'}}</text
        ><view class="team-line">当前队伍：{{teamText}}</view
        ><button
          wx:if="{{room.leader===room.me.seat}}"
          class="primary"
          bindtap="propose"
          disabled="{{busy || selected.length!==room.teamSize}}"
        >
          提交队伍（已选 {{selected.length}} / {{room.teamSize}}）
        </button></view
      >
      <view
        wx:if="{{room.phase==='teamVote' || room.phase==='quest' || room.phase==='teamResult'}}"
        class="panel"
        ><text class="label">{{room.team.length?'任务队伍 '+teamText+' 号':'全员投票'}}</text
        ><text class="muted"
          >{{room.phase==='teamVote'?'全员表决，结算后公开票型':'仅公开票数，不公开出牌人'}}</text>
        </view
      >
      <view wx:if="{{room.result}}" class="result"
        ><text class="kicker">{{room.result.winner?'最终结果':(room.flexible || room.assisted || room.offlineAssassination) && room.phase==='ended'?'线下结算完毕':'本局终止'}}</text
        ><view class="phase-title"
          >{{room.result.winner==='good'?'好人获胜':room.result.winner==='evil'?'坏人获胜':(room.flexible || room.assisted || room.offlineAssassination) && room.phase==='ended'?'以线下结算为准':'不判胜负'}}</view
        ><text>{{room.result.reason}}</text
        ><button
          wx:if="{{room.me.isHost}}"
          class="primary"
          bindtap="rematch"
          disabled="{{busy}}"
        >
          同房再开一局</button
        ><text wx:else class="muted">等待房主开启下一局</text></view
      >
      <view wx:if="{{room.phase==='offlineFinal'}}" class="panel">
        <text class="label">{{room.offlineAssassination?'请莫德雷德线下刺梅林':'请线下完成特殊结算'}}</text><text class="muted">{{room.offlineAssassination?'三次任务已成功，请在线下完成刺梅林并确认胜负。':'任务记录已保留。起刀、内奸及最终胜负在线下完成，小程序不自动判定。'}}</text>
        <button wx:if="{{room.me.isHost}}" class="primary" bindtap="closeOffline" disabled="{{busy}}">线下已完成，记录结果</button>
      </view>
      <view wx:if="{{room.canUseTools}}" class="panel host-panel">
        <view class="label">房主操作</view>
        <view wx:if="{{room.knights}}" class="small muted">第{{room.knights.round}}轮 · 仙女{{room.knights.fairy}}号 · B牌剩余{{room.knights.remainingCards}}张</view>
        <view class="tool-actions">
          <button class="secondary" bindtap="openTool" data-kind="vote" disabled="{{busy}}">投票</button>
          <button class="secondary" bindtap="openTool" data-kind="quest" disabled="{{busy}}">做任务</button>
          <button class="secondary" bindtap="openTool" data-kind="{{room.knifeOffline?'offline':'assassination'}}" disabled="{{busy}}">{{room.knifeOffline?'线下刀人':'刀梅林'}}</button>
          <block wx:if="{{room.knights}}">
            <button class="secondary" bindtap="openTool" data-kind="skills" disabled="{{busy}}">使用技能</button>
            <button class="secondary" bindtap="openTool" data-kind="conversion" disabled="{{busy}}">身份转换</button>
            <button class="secondary" bindtap="openTool" data-kind="fairy" disabled="{{busy}}">仙女查验</button>
            <button class="secondary" bindtap="openTool" data-kind="night" disabled="{{busy}}">夜晚</button>
            <button class="secondary" bindtap="openTool" data-kind="nextRound" disabled="{{busy}}">进入下一轮</button>
          </block>
          <button wx:if="{{room.hasReverse && !room.knifeOffline}}" class="secondary" bindtap="openTool" data-kind="reverseStrike" disabled="{{busy}}">刀逆仆</button>
        </view>
        <view wx:if="{{room.operationProgress}}" class="operation-progress">
          <view class="progress-heading"><text>当前操作进度</text><text>{{room.operationProgress.completed}} / {{room.operationProgress.total}} 已完成</text></view>
          <view wx:for="{{room.operationProgress.players}}" wx:key="seat" class="progress-player">
            <text class="progress-player-name">{{item.seat}}号 · {{item.name}}</text>
            <text class="progress-state {{!item.required?'not-required':item.completed?'completed':'pending'}}">{{!item.required?'无需操作':item.completed?'已完成':'未完成'}}</text>
          </view>
        </view>
        <button wx:if="{{room.hasActiveOperation && room.phase!=='offlineFinal'}}" class="primary" bindtap="settleTool" disabled="{{busy}}" loading="{{busy}}">结算当前操作</button>
        <button wx:if="{{room.hasActiveOperation}}" class="text-button" bindtap="cancelTool" disabled="{{busy}}">作废当前操作</button>
      </view>
      <view wx:elif="{{room.flexible && room.phase==='tools'}}" class="panel">
        <view class="label">等待房主发起操作</view>
      </view>
      <view wx:if="{{history.length}}" class="section-title">公开记录</view
      ><view wx:for="{{history}}" wx:key="key" class="history-row"
        ><view>{{item.text}}</view
        ><text class="muted small">{{item.detail}}</text></view
      >
    </block>
    <view wx:if="{{room.canUseTools}}" class="finish-game-footer">
      <button class="finish-game-button" bindtap="finishTools" disabled="{{busy}}">结束本局</button>
    </view>
  </block>
</view>
