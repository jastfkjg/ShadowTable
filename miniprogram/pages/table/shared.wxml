        <button wx:if="{{room.phase==='lobby'}}" class="lobby-header-link room-invite-button" hover-class="room-invite-pressed" open-type="share" disabled="{{busy || loading || hasPendingRequest || reconnecting || !network}}" aria-label="{{'邀请好友加入房间'+room.code}}"><image class="lobby-header-icon" src="/assets/room-invite.svg" aria-hidden="true" /><text class="lobby-header-label">邀请好友</text><view class="lobby-header-chevron is-placeholder" aria-hidden="true" /></button>
