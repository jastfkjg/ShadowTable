<import src="./public-history.wxml" />
<import src="../../loading-placeholder.wxml" />
<include src="./public-history.wxml" />
<view wx:if="{{roomFeedback && !error}}" class="room-feedback {{homeShell?'above-tab':''}}" role="status" aria-live="polite">{{roomFeedback}}</view>
<import src="../home/role-groups.wxml" />
<import src="../../avoidance.wxml" />
<template is="avoidanceSelection" data="{{avoidanceOpen,avoidanceLoading,avoidance,avoidanceGroups,avoidanceDraft,avoidanceDraftName,error,busy,hasPendingRequest,network}}" />
<import src="../home/room-card.wxml" />

<template name="tablePhase">
    <view class="phase-strip">
      <view class="phase-heading">
        <view class="table-symbol blue" aria-hidden="true"><image src="/assets/table-cards.svg" /></view>
        <view class="phase-heading-copy">
        <text class="phase-label">当前阶段</text>
        <text class="phase-name">{{room.phaseName}}</text>
        </view>
      </view>
      <view wx:if="{{!room.flexible && (room.round || room.leader)}}" class="phase-detail">
        <text wx:if="{{room.round}}">任务 {{room.round}}</text>
        <text wx:if="{{room.leader}}">队长 {{room.leader}} 号 · 连续否决 {{room.rejects}} / 5</text>
      </view>
      <view
        wx:if="{{room.phase==='teamVote' || room.phase==='quest' || room.phase==='teamResult'}}"
        class="phase-team"
        ><text class="label">{{room.team.length?'任务队伍 '+teamText+' 号':'全员投票'}}</text
        ><text class="muted"
          >{{room.phase==='teamVote'?'全员表决，结算后公开票型':'仅公开票数，不公开出牌人'}}</text>
        </view
      >
      <view wx:if="{{room.operationStatus || room.needsSubmission}}" class="action-entry" role="status">
        <view class="action-status-copy"><view>{{room.needsSubmission && !room.me.submitted ? '请'+actionEntryLabel : room.operationStatus ? room.operationStatus.title : room.me.submitted?'已提交，等待其他玩家':'本次无需你操作'}}</view><view class="small muted">{{room.operationStatus.detail}}</view></view>
        <button hover-class="none" wx:if="{{room.needsSubmission && !room.me.submitted}}" class="primary" bindtap="openAction" disabled="{{hasPendingRequest || busy || actionLoading || !network}}" loading="{{actionLoading}}">{{actionEntryLabel}}</button>
      </view>
    </view>
</template>
<block wx:if="{{!error && !actionDialog && !dealtIdentityDialog && !identityChange && !fairyResult && !identityHistoryOpen && !historyOpen}}"><include src="../../player-card.wxml" /></block>
<view wx:if="{{identityHistoryOpen && revealed && secret.identityHistory.length > 1 && !error}}" class="dialog-backdrop identity-history-backdrop table-sheet-backdrop process-backdrop" catchtap="closeIdentityHistory" catchtouchmove="blockScroll">
  <view class="identity-history-sheet table-sheet process-sheet process-history {{processBodyHeight?'has-measured-body':''}}" catchtap="blockScroll" role="dialog" aria-modal="true" aria-label="本局身份历程">
    <view class="process-sheet-top"><view class="table-sheet-handle" aria-hidden="{{true}}" />
    <view class="identity-history-heading table-sheet-heading">
      <view class="table-sheet-title"><view class="table-symbol blue"><image src="/assets/home-clock.svg" aria-hidden="true" /></view><view class="identity-history-title">身份历程</view></view>
      <button hover-class="none" class="identity-history-close" bindtap="closeIdentityHistory" aria-label="关闭身份历程">×</button>
    </view>
    <view class="process-context identity-history-context"><text>本局 · {{room.me.seat}}号</text><view class="identity-privacy-note"><image src="/assets/table-lock.svg" aria-hidden="true" /><text>仅你可见</text></view></view>
    </view>
    <scroll-view scroll-y="{{true}}" enhanced show-scrollbar="{{false}}" class="identity-history-body process-sheet-body" style="{{processBodyHeight?'height:'+processBodyHeight+'px;':''}}"><view class="process-sheet-fields">
      <view class="identity-history-timeline">
        <view wx:for="{{secret.identityHistory}}" wx:key="id" class="identity-history-event">
          <view class="identity-history-dot {{item.current?'is-current':''}}" aria-hidden="{{true}}" />
          <view wx:if="{{item.current}}" class="identity-history-record-heading"><image wx:if="{{item.portrait}}" class="process-history-art" src="{{item.portrait}}" mode="aspectFit" aria-hidden="true" /><view class="identity-history-role-copy"><text class="identity-history-role faction-{{item.factionTone}}">{{item.role}}</text><view class="identity-history-meta small muted">{{item.sinceLabel}}</view></view><text class="identity-history-badge is-current">当前</text></view>
          <button wx:else hover-class="none" class="disclosure-button identity-history-toggle" bindtap="toggleIdentityHistory" data-id="{{item.id}}" aria-expanded="{{identityHistoryExpandedId===item.id}}" aria-label="{{(identityHistoryExpandedId===item.id?'收起':'展开')+item.role+'历史身份'}}"><image wx:if="{{item.portrait}}" class="process-history-art" src="{{item.portrait}}" mode="aspectFit" aria-hidden="true" /><view class="identity-history-role-copy"><text class="identity-history-role faction-{{item.factionTone}}">{{item.role}}</text><view class="identity-history-meta small muted">{{item.sinceLabel}}</view></view><text class="identity-history-badge">{{item.initial?'初始':'曾用'}}</text><view class="identity-history-chevron {{identityHistoryExpandedId===item.id?'is-expanded':''}}" aria-hidden="{{true}}" /></button>
          <view wx:if="{{item.current}}" class="identity-history-summary small muted">{{item.faction}}{{item.skillStatus?' · '+item.skillStatus.title:''}}</view>
          <view wx:if="{{item.skillHistory.length}}" class="identity-skill-history"><view wx:for="{{item.skillHistory}}" wx:for-item="skill" wx:for-index="skillIndex" wx:key="id" class="identity-skill-record"><text class="identity-skill-label small muted">{{skillIndex===0?'技能记录':''}}</text><view class="identity-skill-value"><text class="identity-skill-round small muted">第{{skill.round}}轮</text><text class="identity-skill-separator muted" aria-hidden="true">·</text><text class="identity-skill-text">{{skill.text}}</text></view></view></view>
          <view wx:if="{{!item.current && identityHistoryExpandedId===item.id}}" class="identity-history-detail"><view class="identity-history-faction small muted"><view class="identity-history-faction-dot faction-{{item.factionTone}}" aria-hidden="true" />{{item.faction}}</view><view class="identity-history-information">{{item.detailAvailable?item.information:'旧对局未记录当时视野，仅保留初始身份。'}}</view><view class="identity-history-readonly small muted"><image src="/assets/process-eye.svg" aria-hidden="true" /><text>曾用身份 · 仅供回看</text></view></view>
        </view>
      </view>
    </view></scroll-view>
    <view class="identity-history-footer process-sheet-footer table-sheet-footer"><button hover-class="none" class="primary" bindtap="hideIdentityHistory"><image src="/assets/identity-hide.svg" aria-hidden="true" /><text>立即遮盖</text></button></view>
  </view>
</view>
<import src="../../honors.wxml" />
<template is="honorBallot" data="{{honorDialog:honorDialog && !error,honorGroups,honorReady,honorSelected,honorRequired,honors,busy:busy || hasPendingRequest || !network}}" />
<template name="tableResult">
    <view wx:if="{{latestResult && (room.phase==='tools' || room.phase==='ended')}}" class="latest-result" role="status" aria-label="最近操作结果">
      <view class="result-summary-heading"><view class="table-result-label"><image src="/assets/home-clock.svg" aria-hidden="true" /><text class="small muted">最近结果</text></view><button hover-class="none" class="history-toggle" bindtap="showLatestRecord">查看记录 ›</button></view>
      <view class="latest-result-title result-heading"><text wx:if="{{latestResult.resultTone}}" class="quest-result-icon {{latestResult.resultTone}}" aria-hidden="true">{{latestResult.resultTone==='success'?'✓':'×'}}</text><text>{{latestResult.resultRows ? '技能最终结果' : latestResult.text}}</text><text wx:if="{{latestResult.resultTeam}}" class="result-team">队伍 {{latestResult.resultTeam}}</text></view>
      <view wx:if="{{latestResult.resultRows}}">
        <view wx:if="{{latestResult.historyNote}}" class="latest-result-note small muted">{{latestResult.historyNote}}</view>
        <view class="history-result-rows"><view wx:for="{{latestResult.resultRows}}" wx:for-item="row" wx:key="label" class="history-result-line {{row.final?'is-final':''}}"><text class="history-result-label">{{row.label}}</text><text class="history-result-value">{{row.value}}</text></view></view>
      </view>
      <view wx:elif="{{latestResult.latestDetail || latestResult.detail}}" class="history-detail">{{latestResult.latestDetail || latestResult.detail}}</view>
    </view>
</template>
<template name="tableFinalResult">
  <view class="final-result" role="status" aria-label="本局最终结果">
    <text class="kicker {{room.replayId?'final-result-replay-kicker':''}}">{{room.result.winner?'最终结果':(room.flexible || room.assisted || room.offlineAssassination) && room.phase==='ended'?'线下结算完毕':'本局终止'}}</text>
    <button wx:if="{{room.replayId}}" class="final-result-replay" bindtap="viewReplay" hover-class="none" disabled="{{hasPendingRequest || busy}}" aria-label="查看本局复盘"><view class="final-result-replay-control"><image class="final-result-replay-icon" src="/assets/record-replay.svg" aria-hidden="true" /><text>查看复盘</text></view></button>
    <view class="final-result-title">{{room.result.winner==='good'?'好人获胜':room.result.winner==='evil'?'坏人获胜':room.result.winner==='third'?'盗贼阵营获胜':(room.flexible || room.assisted || room.offlineAssassination) && room.phase==='ended'?'以线下结算为准':'不判胜负'}}</view>
    <view wx:if="{{room.result.reason && room.result.reason!=='房主已登记线下结果，战绩已归档。' && room.result.reason!=='房主已登记线下胜负，战绩已归档。'}}" class="final-result-detail">{{room.result.reason}}</view>
    <view wx:if="{{room.result.source}}" class="small muted final-result-source">{{room.result.source==='manual'?'房主登记':room.result.source==='system'?'系统判定':''}}</view>
    <view wx:if="{{room.recordNotice}}" class="small muted final-result-source">{{room.recordNotice}}</view>
    <view wx:if="{{room.myScore || room.scoreSettings}}" class="final-result-score">
      <block wx:if="{{room.myScore}}">
        <block wx:if="{{room.myScore.status==='scored'}}">
          <view class="final-result-score-heading">
            <view class="metric-value accent">本局 {{room.myScore.total>=0?'+':''}}{{room.myScore.total}} 分</view>
            <button class="text-button final-result-score-link" hover-class="none" bindtap="viewScoreRecord">查看积分明细 ›</button>
          </view>
          <view wx:for="{{room.myScore.breakdown}}" wx:key="id" class="score-award"><text>{{item.label}}</text><text>{{item.points>=0?'+':''}}{{item.points}}</text></view>
        </block>
        <view wx:else class="small muted">不计积分 · {{room.myScore.reason}}</view>
      </block>
      <view wx:else class="small muted">{{room.scoreNotice || (room.scoreSettings.enabled?'本局计分已开启':'本局计分已关闭')}}</view>
    </view>
    <view wx:if="{{room.myFun.hasEffectiveHighlights && room.phase==='ended'}}" class="final-result-fun">
      <view class="final-result-fun-heading">
        <view class="label">我的本局趣味记录</view>
        <button class="text-button final-result-fun-link" hover-class="none" bindtap="viewFunRecord">查看趣味统计 ›</button>
      </view>
      <view wx:for="{{room.myFun.highlights}}" wx:key="id" class="score-award"><text>{{item.label}}</text><text>{{item.count}}{{item.unit}}</text></view>
      <view wx:if="{{room.myFun.reason}}" class="small muted final-result-source">{{room.myFun.reason}}</view>
    </view>
    <template is="honorResults" data="{{honors,busy:busy || hasPendingRequest || !network}}" />
    <button hover-class="none" wx:if="{{room.me.isHost}}" class="{{honors.status==='not_started' || honors.status==='open'?'secondary':'primary'}}" bindtap="rematch" disabled="{{hasPendingRequest || busy}}">同房再开一局</button>
    <view wx:else class="muted final-result-waiting">等待房主开启下一局</view>
  </view>
</template>
<view wx:if="{{dealtIdentityDialog && !error}}" class="dialog-backdrop table-sheet-backdrop dealt-identity-backdrop" catchtouchmove="blockScroll">
  <view class="error-dialog dealt-identity-dialog table-sheet {{dealtIdentitySecret?'is-revealed':'is-covered'}} {{dealtIdentitySecret.role==='莫甘娜'?'is-morgana':''}} {{processBodyHeight?'has-measured-body':''}}" role="dialog" aria-modal="true" aria-label="身份已发放">
    <view class="table-sheet-top dealt-identity-top"><view class="table-sheet-handle" aria-hidden="true" /><view class="table-sheet-heading"><view class="table-sheet-title"><view class="table-symbol blue" aria-hidden="true"><image src="/assets/table-cards.svg" /></view><text>身份已发放</text></view><button hover-class="none" class="table-sheet-close" bindtap="closeDealtIdentity" aria-label="关闭并遮盖身份">×</button></view></view>
    <scroll-view class="table-sheet-body dealt-identity-body" style="{{processBodyHeight?'height:'+processBodyHeight+'px;':''}}" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="table-sheet-fields dealt-identity-fields">
        <view class="small muted identity-privacy-note"><image src="/assets/table-lock.svg" aria-hidden="true" /><text>仅供本人查看</text></view>
        <block wx:if="{{dealtIdentitySecret}}">
          <template is="avoidanceResult" data="{{result:dealtIdentitySecret.avoidance}}" />
          <view class="dealt-role-heading"><image wx:if="{{dealtIdentitySecret.portrait}}" class="private-role-art" src="{{dealtIdentitySecret.portrait}}" mode="aspectFit" aria-hidden="true" /><view class="dealt-role-copy"><view class="identity-title faction-{{dealtIdentitySecret.factionTone}}">{{dealtIdentitySecret.role}}</view><view class="private-faction faction-{{dealtIdentitySecret.factionTone}}">● {{dealtIdentitySecret.faction}}</view></view></view>
          <view class="identity-vision">
            <view class="identity-vision-heading"><text>你的视野</text><text wx:if="{{dealtIdentitySecret.vision.players.length}}" class="identity-vision-count">{{dealtIdentitySecret.vision.players.length}} 人</text></view>
            <block wx:if="{{dealtIdentitySecret.vision.players.length}}">
              <view class="identity-vision-label">{{dealtIdentitySecret.vision.label}}</view>
              <view class="identity-vision-players"><view wx:for="{{dealtIdentitySecret.vision.players}}" wx:key="seat" class="identity-vision-player">
                <view class="vision-player-avatar" aria-hidden="true"><text>{{item.avatarInitial}}</text><image wx:if="{{item.avatarUrl && !item.avatarFailed}}" src="{{item.avatarUrl}}" mode="aspectFill" data-seat="{{item.seat}}" data-url="{{item.avatarUrl}}" binderror="seatAvatarError" aria-hidden="true" /></view>
                <view class="vision-player-copy"><view class="vision-player-primary"><text class="identity-vision-seat">{{item.seat}}<text class="identity-vision-unit">号</text></text><text class="vision-player-name">{{item.name}}</text></view><view wx:if="{{item.role}}" class="identity-vision-role">{{item.role}}</view></view>
              </view></view>
              <view wx:if="{{dealtIdentitySecret.vision.note}}" class="identity-vision-note">{{dealtIdentitySecret.vision.note}}</view>
            </block>
            <view wx:else class="identity-vision-text">{{dealtIdentitySecret.information}}</view>
          </view>
          <view wx:if="{{dealtIdentitySecret.skillStatus}}" class="dealt-skill-status"><view class="dealt-skill-status-title">技能状态 · {{dealtIdentitySecret.skillStatus.title}}</view>{{dealtIdentitySecret.skillStatus.detail}}</view>
          <view class="small muted identity-return-note">之后可在房间号右侧的「查看身份」再次查看。</view>
        </block>
        <block wx:else><view class="identity-sealed-art" aria-hidden="true"><image src="/assets/table-cards.svg" /><view><image src="/assets/table-lock.svg" /></view></view><view class="identity-sealed-title">身份已就绪</view><view class="private-info muted identity-sealed-copy">请确认屏幕仅自己可见，再查看身份与视野。</view></block>
      </view>
    </scroll-view>
    <view class="table-sheet-footer dealt-identity-footer">
      <button wx:if="{{dealtIdentitySecret}}" hover-class="none" class="primary" bindtap="closeDealtIdentity">记住了，遮盖身份</button>
      <block wx:else><button hover-class="none" class="primary" bindtap="revealDealtIdentity" disabled="{{busy || !network}}" loading="{{busy && busyAction==='dealtIdentity'}}">查看身份</button><button hover-class="none" class="text-button" bindtap="closeDealtIdentity">稍后查看</button></block>
    </view>
  </view>
</view>
<view wx:if="{{fairyResult && !identityChange && !error}}" class="dialog-backdrop table-sheet-backdrop process-backdrop" catchtouchmove="blockScroll">
  <view class="error-dialog table-sheet process-sheet process-inspection {{processBodyHeight?'has-measured-body':''}}" role="dialog" aria-modal="true" aria-label="仙女查验结果">
    <view class="process-sheet-top"><view class="table-sheet-handle" aria-hidden="true" /><view class="table-sheet-heading"><view class="table-sheet-title"><view class="table-symbol blue"><image src="/assets/process-eye.svg" aria-hidden="true" /></view><text>仙女查验结果</text></view><button wx:if="{{fairyResultRevealed}}" hover-class="none" class="table-sheet-close process-private-hide" bindtap="hidePrivatePreview" aria-label="立即遮盖查验结果"><image src="/assets/process-eyeoff.svg" aria-hidden="true" /></button></view></view>
    <scroll-view class="process-sheet-body" style="{{processBodyHeight?'height:'+processBodyHeight+'px;':''}}" scroll-y enhanced show-scrollbar="{{false}}"><view class="process-sheet-fields">
      <view class="identity-privacy-note"><image src="/assets/table-lock.svg" aria-hidden="true" /><text>仅供本人查看</text></view>
      <block wx:if="{{fairyResultRevealed}}">
        <view wx:if="{{fairyResult.displaySeat}}" class="process-inspection-result" aria-label="{{fairyResult.summary || fairyResult.information}}">
          <view><text class="small muted">查验对象</text><view class="process-inspection-seat">{{fairyResult.displaySeat}}<text>号</text></view></view>
          <view class="process-inspection-faction"><text class="small muted">查验结果</text><view class="process-inspection-faction-value faction-{{fairyResult.factionTone}}">{{fairyResult.displayFaction}}</view></view>
        </view>
        <view wx:else class="fairy-result-summary">{{fairyResult.summary || fairyResult.information}}</view>
      </block>
      <view wx:else class="process-sealed"><view class="table-symbol blue"><image src="/assets/table-lock.svg" aria-hidden="true" /></view><view>查验结果已遮盖</view><text class="small muted">请确认周围无人查看。</text></view>
    </view></scroll-view>
    <view class="process-sheet-footer table-sheet-footer"><button wx:if="{{fairyResultRevealed}}" hover-class="none" class="primary" bindtap="acknowledgeFairyResult" disabled="{{hasPendingRequest || busy}}">记住了</button><button wx:else hover-class="none" class="primary" bindtap="revealFairyResult" disabled="{{busy}}">查看查验结果</button></view>
  </view>
</view>
<view wx:if="{{identityChange && !error}}" class="dialog-backdrop table-sheet-backdrop process-backdrop" catchtouchmove="blockScroll">
  <view class="error-dialog table-sheet process-sheet process-new-identity {{processBodyHeight?'has-measured-body':''}}" role="dialog" aria-modal="true" aria-label="你的新身份">
    <view class="process-sheet-top"><view class="table-sheet-handle" aria-hidden="true" /><view class="table-sheet-heading"><view class="table-sheet-title"><view class="table-symbol blue"><image src="/assets/table-cards.svg" aria-hidden="true" /></view><text>你已获得新身份</text></view><button wx:if="{{identityChangeRevealed}}" hover-class="none" class="table-sheet-close process-private-hide" bindtap="hidePrivatePreview" aria-label="立即遮盖新身份"><image src="/assets/process-eyeoff.svg" aria-hidden="true" /></button></view></view>
    <scroll-view class="process-sheet-body" style="{{processBodyHeight?'height:'+processBodyHeight+'px;':''}}" scroll-y enhanced show-scrollbar="{{false}}"><view class="process-sheet-fields">
      <view class="identity-privacy-note"><image src="/assets/table-lock.svg" aria-hidden="true" /><text>仅供本人查看</text></view>
      <block wx:if="{{identityChangeRevealed}}">
        <view class="dealt-role-heading"><image wx:if="{{identityChange.portrait}}" class="private-role-art" src="{{identityChange.portrait}}" mode="aspectFit" aria-hidden="true" /><view class="identity-title faction-{{identityChange.factionTone}}">{{identityChange.role}}</view><view class="private-faction faction-{{identityChange.factionTone}}">● {{identityChange.faction}}</view></view>
        <view class="private-info-group"><view class="private-info"><view class="label"><image src="/assets/process-eye.svg" aria-hidden="true" />你的视野</view>{{identityChange.visionText || identityChange.information}}</view><view wx:if="{{identityChange.abilityText}}" class="private-info"><view class="label"><image src="/assets/record-spark.svg" aria-hidden="true" />角色能力</view>{{identityChange.abilityText}}</view></view>
        <view wx:if="{{identityChange.skillStatus}}" class="process-skill-status"><image src="/assets/home-clock.svg" aria-hidden="true" /><view><view>{{identityChange.skillStatus.title}}</view><view wx:if="{{identityChange.skillStatus.detail}}" class="small muted">{{identityChange.skillStatus.detail}}</view></view></view>
        <view wx:if="{{identityChange.timingNote}}" class="process-private-note small muted">{{identityChange.timingNote}}</view>
      </block>
      <view wx:else class="process-sealed"><view class="table-symbol blue"><image src="/assets/table-lock.svg" aria-hidden="true" /></view><view>新身份已遮盖</view><text class="small muted">请确认周围无人查看，再查看新身份。</text></view>
    </view></scroll-view>
    <view class="process-sheet-footer table-sheet-footer"><button wx:if="{{identityChangeRevealed}}" hover-class="none" class="primary" bindtap="acknowledgeIdentity" disabled="{{hasPendingRequest || busy}}">记住了，遮盖身份</button><button wx:else hover-class="none" class="primary" bindtap="revealChangedIdentity" disabled="{{busy}}">查看新身份</button></view>
  </view>
</view>
<app-nav wx:if="{{!homeShell && isLobby}}" title="对局" />
<app-nav wx:elif="{{!homeShell}}" title="牌桌" back="{{true}}" backText="对局" backLabel="返回对局，保留当前座位" bindback="returnHome" />
<view class="page {{isLobby ? 'tab-page home-lobby' : ''}} {{enteringCode ? 'is-entering-room' : ''}} {{room ? 'table-room' : ''}} {{room && room.phase!=='lobby' ? 'has-public-history' : ''}} {{room && room.phase==='lobby' ? 'table-lobby' : ''}} {{room && room.canUseTools && room.hasActiveOperation && room.phase!=='offlineFinal' ? 'has-host-bar' : ''}}" bindtouchstart="startRoomSwipePageTouch" bindtap="tapRoomSwipePage">
  <view wx:if="{{!invitation && !room}}" class="brand">
    <view class="brand-identity">
      <view wx:if="{{isLobby}}" class="home-brand-symbol" aria-hidden="true"><image src="/assets/record-shield.svg" /></view>
      <text class="brand-mark">桌边助手</text>
      <button hover-class="none" class="connection-button" bindtap="connectionInfo" aria-label="{{reconnecting?'正在重连服务器':!network || needsLogin ? '服务器连接异常' : loading || roomsRefreshing || busy || hasPendingRequest ? '正在同步' : serverConnected ? '服务器连接正常' : '服务器连接未确认'}}">
        <view class="connection-dot {{isLobby && connectionPhase==='connecting'?'pending':!network || needsLogin?'offline':reconnecting || loading || roomsRefreshing || busy || hasPendingRequest?'pending':serverConnected?'online':'offline'}}" />
        <text wx:if="{{isLobby ? reconnecting || loading || roomsRefreshing || busy || hasPendingRequest || !network || needsLogin : reconnecting || !network || needsLogin}}" class="connection-label">{{isLobby?(connectionPhase==='connecting'?'同步中':needsLogin?'待登录':!network?'未连接':connectionPhase==='waiting' || reconnecting?'等待重连':'同步中'):reconnecting?'重连中':!network || needsLogin?'连接断开':loading || roomsRefreshing || busy || hasPendingRequest?'同步中':serverConnected?'已连接':'连接中'}}</text>
      </button>
    </view>
    <button hover-class="none" wx:if="{{!room}}" class="switch-table home-entry home-help" bindtap="openHelp" aria-label="打开使用帮助"><image class="home-help-icon" src="/assets/home-help.svg" aria-hidden="true" /></button>
  </view>
  <button hover-class="none" wx:if="{{!isLobby && !room && !loading && !invitation}}" class="secondary" bindtap="returnHome">返回对局，创建或加入房间</button>
