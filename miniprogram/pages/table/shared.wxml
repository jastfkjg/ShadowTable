    </view>
    <block wx:for="{{visibleMemberRooms}}" wx:key="code">
      <view wx:if="{{item.sectionLabel}}" class="room-subheading"><text>{{item.sectionLabel}}</text></view>
      <template is="personalRoomCard" data="{{item,busy,loading,roomsRefreshing,hasPendingRequest,roomSwipeCode,roomSwipeOffset,roomSwipeDragging,enteringCode,connectionUnavailable:!!(loading || reconnecting || !network || needsLogin)}}" />
    </block>
    <view wx:if="{{showHistorySection && historyRooms.length}}" class="room-archive-group">
    <view class="room-archive-section {{historyExpanded?'is-expanded':''}}">
      <button class="disclosure-button room-archive-toggle" hover-class="none" bindtap="toggleRoomHistory" aria-label="{{(historyExpanded?'收起':'展开')+'历史牌桌'}}" aria-expanded="{{historyExpanded}}" aria-controls="room-history-list" disabled="{{busy || loading || roomsRefreshing || hasPendingRequest}}"><text class="room-archive-title">历史牌桌</text><view class="room-archive-chevron {{historyExpanded?'is-expanded':''}}" aria-hidden="true" /></button>
      <view id="room-history-list"><block wx:if="{{historyExpanded}}">
        <template wx:for="{{historyRooms}}" wx:key="code" is="personalRoomCard" data="{{item,compact:true,busy,loading,roomsRefreshing,hasPendingRequest,roomSwipeCode,roomSwipeOffset,roomSwipeDragging,enteringCode,connectionUnavailable:!!(loading || reconnecting || !network || needsLogin)}}" />
      </block></view>
    </view>
    </view>
    <view wx:if="{{!memberRooms.length && !loading && !reconnecting && network && !needsLogin}}" class="room-empty"><view class="room-empty-title">还没有牌桌</view><view class="room-empty-hint">创建新房间，或输入房间码与朋友同桌。</view></view>
    <view wx:elif="{{memberRooms.length && !visibleMemberRooms.length && !(showHistorySection && historyRooms.length)}}" class="room-empty"><text>没有符合条件的牌桌</text><button hover-class="none" class="history-toggle" bindtap="filterRooms" data-filter="all">查看全部</button></view>
    <view wx:if="{{memberRooms.length && (loading || reconnecting || !network || needsLogin)}}" class="home-room-sync-note">牌桌信息将在连接恢复后自动更新</view>
    </view>
    <view wx:if="{{roomMenu && !error}}" class="dialog-backdrop room-menu-backdrop" catchtouchmove="blockScroll"><view class="error-dialog room-list-dialog room-menu-dialog {{roomMenu.available===false?'is-expired':''}}" role="dialog" aria-modal="true" aria-label="{{'房间管理，房间'+roomMenu.code}}">
      <view class="room-menu-handle" aria-hidden="true" />
      <view class="room-menu-header"><view class="room-menu-heading">房间管理</view><button hover-class="none" class="room-menu-close" bindtap="closeRoomMenu" aria-label="关闭房间管理" disabled="{{busy || hasPendingRequest}}"><view class="room-menu-cross" aria-hidden="true" /></button></view>
      <scroll-view scroll-y class="room-menu-body">
        <view class="room-menu-context"><view class="room-menu-table-icon"><image src="/assets/home-table-blue.svg" aria-hidden="true" /></view><view class="room-menu-copy"><view class="room-menu-code">房间 <text>{{roomMenu.code}}</text></view><view class="room-menu-board">{{roomMenu.boardName || '牌桌'}}</view></view><text wx:if="{{roomMenu.available===false || roomMenu.statusLabel}}" class="room-menu-status">{{roomMenu.available===false?'已失效':roomMenu.statusLabel}}</text></view>
        <view class="room-menu-options">
          <button hover-class="none" class="room-menu-action" bindtap="roomMenuAction" data-kind="hide" disabled="{{busy || hasPendingRequest}}"><view class="room-menu-action-icon"><image src="/assets/room-menu-remove.svg" aria-hidden="true" /></view><view class="room-menu-copy"><text class="room-menu-label">{{roomMenu.available===false?'移除失效记录':'从列表移除'}}</text><text class="room-menu-description">{{roomMenu.available===false?'从你的牌桌列表清理这条记录':'仅整理个人列表，保留成员关系与座位'}}</text></view><view class="room-menu-chevron" aria-hidden="true" /></button>
          <button hover-class="none" wx:if="{{roomMenu.available!==false && roomMenu.isMember && roomMenu.canLeave===true}}" class="room-menu-action is-leave" bindtap="roomMenuAction" data-kind="leave" disabled="{{busy || hasPendingRequest}}"><view class="room-menu-action-icon"><image src="/assets/room-menu-leave.svg" aria-hidden="true" /></view><view class="room-menu-copy"><text class="room-menu-label">离开房间</text><text class="room-menu-description">退出成员关系，并释放座位</text></view><view class="room-menu-chevron" aria-hidden="true" /></button>
          <button hover-class="none" wx:if="{{roomMenu.available!==false && roomMenu.isHost}}" class="room-menu-action danger" bindtap="roomMenuAction" data-kind="delete" disabled="{{busy || hasPendingRequest}}"><view class="room-menu-action-icon"><image src="/assets/room-menu-delete.svg" aria-hidden="true" /></view><view class="room-menu-copy"><text class="room-menu-label">解散房间</text><text class="room-menu-description">关闭房间，所有成员将无法继续进入</text></view><view class="room-menu-chevron" aria-hidden="true" /></button>
        </view>
      </scroll-view>
      <view class="room-menu-footer"><button hover-class="none" class="secondary room-menu-cancel" bindtap="closeRoomMenu" disabled="{{busy || hasPendingRequest}}">取消</button></view>
    </view></view>
    <view wx:if="{{noteRoom && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll"><view class="error-dialog room-list-dialog" role="dialog" aria-modal="true" aria-label="个人备注">
