<import src="./public-history.wxml" />
<include src="./public-history.wxml" />
<template name="tablePhase">
    <view class="phase-strip">
      <view class="phase-heading">
        <text class="phase-label">当前阶段</text>
        <text class="phase-name">{{room.phaseName}}</text>
      </view>
      <view wx:if="{{!room.flexible && (room.round || room.leader)}}" class="phase-detail">
        <text wx:if="{{room.round}}">任务 {{room.round}}</text>
        <text wx:if="{{room.leader}}">队长 {{room.leader}} 号 · 连续否决 {{room.rejects}} / 5</text>
      </view>
      <view
        wx:if="{{room.phase==='teamVote' || room.phase==='quest' || room.phase==='teamResult'}}"
        class="phase-team"
        ><text class="label">{{room.team.length?'任务队伍 '+teamText+' 号':'全员投票'}}</text
        ><text class="muted"
          >{{room.phase==='teamVote'?'全员表决，结算后公开票型':'仅公开票数，不公开出牌人'}}</text>
        </view
      >
      <view wx:if="{{room.operationStatus || room.needsSubmission}}" class="action-entry" role="status">
        <view class="action-status-copy"><view>{{room.needsSubmission && !room.me.submitted ? '请'+actionEntryLabel : room.operationStatus ? room.operationStatus.title : room.me.submitted?'已提交，等待其他玩家':'本次无需你操作'}}</view><view class="small muted">{{room.operationStatus.detail}}</view></view>
        <button hover-class="none" wx:if="{{room.needsSubmission && !room.me.submitted}}" class="primary" bindtap="openAction" disabled="{{hasPendingRequest || busy || actionLoading || !network}}" loading="{{actionLoading}}">{{actionEntryLabel}}</button>
      </view>
    </view>
</template>
<block wx:if="{{!error && !actionDialog && !dealtIdentityDialog && !identityChange && !fairyResult && !identityHistoryOpen && !historyOpen}}"><include src="../../player-card.wxml" /></block>
<view wx:if="{{identityHistoryOpen && revealed && secret.identityHistory.length > 1 && !error}}" class="dialog-backdrop identity-history-backdrop" catchtap="closeIdentityHistory" catchtouchmove="blockScroll">
  <view class="identity-history-sheet" catchtap="blockScroll" role="dialog" aria-modal="true" aria-label="本局身份历程">
    <view class="identity-history-handle" aria-hidden="{{true}}" />
    <view class="identity-history-heading">
      <view><view class="identity-history-title">身份历程</view><view class="small muted">本局 · {{room.me.seat}}号</view></view>
      <button hover-class="none" class="identity-history-close" bindtap="closeIdentityHistory" aria-label="关闭身份历程">×</button>
    </view>
    <scroll-view scroll-y="{{true}}" class="identity-history-body">
      <view class="identity-history-timeline">
        <view wx:for="{{secret.identityHistory}}" wx:key="id" class="identity-history-event">
          <view class="identity-history-dot {{item.current?'is-current':''}}" aria-hidden="{{true}}" />
          <view wx:if="{{item.current}}" class="identity-history-record-heading"><text class="identity-history-role faction-{{item.factionTone}}">{{item.role}}</text><text class="identity-history-badge is-current">当前</text></view>
          <button wx:else hover-class="none" class="disclosure-button identity-history-toggle" bindtap="toggleIdentityHistory" data-id="{{item.id}}" aria-expanded="{{identityHistoryExpandedId===item.id}}" aria-label="{{(identityHistoryExpandedId===item.id?'收起':'展开')+item.role+'历史身份'}}"><text class="identity-history-role faction-{{item.factionTone}}">{{item.role}}</text><text class="identity-history-badge">{{item.initial?'初始':'曾用'}}</text><view class="identity-history-chevron {{identityHistoryExpandedId===item.id?'is-expanded':''}}" aria-hidden="{{true}}" /></button>
          <view class="identity-history-meta small muted">{{item.sinceLabel}}</view>
          <view wx:if="{{item.current}}" class="identity-history-summary small muted">{{item.faction}}{{item.skillStatus?' · '+item.skillStatus.title:''}}</view>
          <view wx:if="{{item.skillHistory.length}}" class="identity-skill-history"><view class="small muted">技能记录</view><view wx:for="{{item.skillHistory}}" wx:for-item="skill" wx:key="id" class="identity-skill-record"><text class="identity-skill-round small muted">第{{skill.round}}轮</text><text class="identity-skill-text">{{skill.text}}</text></view></view>
          <view wx:if="{{!item.current && identityHistoryExpandedId===item.id}}" class="identity-history-detail"><view class="small muted">{{item.faction}}</view><view class="identity-history-information">{{item.detailAvailable?item.information:'旧对局未记录当时视野，仅保留初始身份。'}}</view><view class="identity-history-readonly small muted">曾用身份 · 仅供回看</view></view>
        </view>
      </view>
    </scroll-view>
    <view class="identity-history-footer"><view class="small muted">本局记录 · 仅你可见</view><button hover-class="none" class="secondary" bindtap="hideIdentityHistory">立即遮盖</button></view>
  </view>
</view>
<template name="tableResult">
    <view wx:if="{{latestResult && (room.phase==='tools' || room.phase==='ended')}}" class="latest-result" role="status" aria-label="最近操作结果">
      <view class="result-summary-heading"><text class="small muted">最近结果</text><button hover-class="none" class="history-toggle" bindtap="showLatestRecord">查看记录 ›</button></view>
      <view class="latest-result-title result-heading"><text wx:if="{{latestResult.resultTone}}" class="quest-result-icon {{latestResult.resultTone}}" aria-hidden="true">{{latestResult.resultTone==='success'?'✓':'×'}}</text><text>{{latestResult.resultRows ? '技能最终结果' : latestResult.text}}</text><text wx:if="{{latestResult.resultTeam}}" class="result-team">队伍 {{latestResult.resultTeam}}</text></view>
      <view wx:if="{{latestResult.resultRows}}">
        <view wx:if="{{latestResult.historyNote}}" class="latest-result-note small muted">{{latestResult.historyNote}}</view>
        <view class="history-result-rows"><view wx:for="{{latestResult.resultRows}}" wx:for-item="row" wx:key="label" class="history-result-line {{row.final?'is-final':''}}"><text class="history-result-label">{{row.label}}</text><text class="history-result-value">{{row.value}}</text></view></view>
      </view>
      <view wx:elif="{{latestResult.latestDetail || latestResult.detail}}" class="history-detail">{{latestResult.latestDetail || latestResult.detail}}</view>
    </view>
</template>
<template name="tableFinalResult">
  <view class="final-result" role="status" aria-label="本局最终结果">
    <text class="kicker">{{room.result.winner?'最终结果':(room.flexible || room.assisted || room.offlineAssassination) && room.phase==='ended'?'线下结算完毕':'本局终止'}}</text>
    <view class="final-result-title">{{room.result.winner==='good'?'好人获胜':room.result.winner==='evil'?'坏人获胜':room.result.winner==='third'?'盗贼阵营获胜':(room.flexible || room.assisted || room.offlineAssassination) && room.phase==='ended'?'以线下结算为准':'不判胜负'}}</view>
    <view wx:if="{{room.result.reason && room.result.reason!=='房主已登记线下结果，战绩已归档。' && room.result.reason!=='房主已登记线下胜负，战绩已归档。'}}" class="final-result-detail">{{room.result.reason}}</view>
    <view wx:if="{{room.result.source}}" class="small muted final-result-source">{{room.result.source==='manual'?'房主登记':room.result.source==='system'?'系统判定':''}}</view>
    <view wx:if="{{room.recordNotice}}" class="small muted final-result-source">{{room.recordNotice}}</view>
    <view wx:if="{{room.myScore || room.scoreSettings}}" class="final-result-score">
      <block wx:if="{{room.myScore}}">
        <block wx:if="{{room.myScore.status==='scored'}}">
          <view class="final-result-score-heading">
            <view class="metric-value accent">本局 {{room.myScore.total>=0?'+':''}}{{room.myScore.total}} 分</view>
            <button class="text-button final-result-score-link" hover-class="none" bindtap="viewScoreRecord">查看积分明细 ›</button>
          </view>
          <view wx:for="{{room.myScore.breakdown}}" wx:key="id" class="score-award"><text>{{item.label}}</text><text>{{item.points>=0?'+':''}}{{item.points}}</text></view>
        </block>
        <view wx:else class="small muted">不计积分 · {{room.myScore.reason}}</view>
      </block>
      <view wx:else class="small muted">{{room.scoreNotice || (room.scoreSettings.enabled?'本局计分已开启':'本局计分已关闭')}}</view>
    </view>
    <view wx:if="{{room.myFun.hasEffectiveHighlights && room.phase==='ended'}}" class="final-result-fun">
      <view class="final-result-fun-heading">
        <view class="label">我的本局趣味记录</view>
        <button class="text-button final-result-fun-link" hover-class="none" bindtap="viewFunRecord">查看趣味统计 ›</button>
      </view>
      <view wx:for="{{room.myFun.highlights}}" wx:key="id" class="score-award"><text>{{item.label}}</text><text>{{item.count}}{{item.unit}}</text></view>
      <view wx:if="{{room.myFun.reason}}" class="small muted final-result-source">{{room.myFun.reason}}</view>
    </view>
    <button hover-class="none" wx:if="{{room.me.isHost}}" class="primary" bindtap="rematch" disabled="{{hasPendingRequest || busy}}">同房再开一局</button>
    <view wx:else class="muted final-result-waiting">等待房主开启下一局</view>
  </view>
</template>
<view wx:if="{{dealtIdentityDialog && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll">
  <view class="error-dialog dealt-identity-dialog" role="dialog" aria-modal="true" aria-label="身份已发放">
    <view class="dialog-title">身份已发放</view>
    <view class="small muted identity-privacy-note">仅供本人查看</view>
    <block wx:if="{{dealtIdentitySecret}}">
      <view class="identity-title faction-{{dealtIdentitySecret.factionTone}}">{{dealtIdentitySecret.role}}</view>
      <view class="muted">{{dealtIdentitySecret.faction}}</view>
      <view class="private-info"><view class="label">你的视野</view>{{dealtIdentitySecret.information}}</view>
      <view wx:if="{{dealtIdentitySecret.skillStatus}}" class="private-info"><view class="label">技能状态 · {{dealtIdentitySecret.skillStatus.title}}</view>{{dealtIdentitySecret.skillStatus.detail}}</view>
      <view class="small muted identity-return-note">之后可在房间号右侧的「查看身份」再次查看。</view>
      <button hover-class="none" class="primary" bindtap="closeDealtIdentity">记住了，遮盖身份</button>
    </block>
    <block wx:else>
      <view class="private-info muted">请确认屏幕仅自己可见，再查看身份与视野。</view>
      <button hover-class="none" class="primary" bindtap="revealDealtIdentity" disabled="{{busy || !network}}" loading="{{busy && busyAction==='dealtIdentity'}}">查看身份</button>
      <button hover-class="none" class="text-button" bindtap="closeDealtIdentity">稍后查看</button>
    </block>
  </view>
</view>
<view wx:if="{{fairyResult && !identityChange && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll">
  <view class="error-dialog" role="dialog" aria-modal="true" aria-label="仙女查验结果">
    <view class="dialog-title">仙女查验结果</view>
    <view class="small muted">仅供本人查看</view>
    <block wx:if="{{fairyResultRevealed}}">
      <view class="fairy-result-summary">{{fairyResult.summary || fairyResult.information}}</view>
      <button hover-class="none" class="text-button" bindtap="hidePrivatePreview">立即遮盖</button>
      <button hover-class="none" class="primary" bindtap="acknowledgeFairyResult" disabled="{{hasPendingRequest || busy}}">记住了，遮盖结果</button>
    </block>
    <block wx:else>
      <view class="private-info muted">结果已遮盖，请确认周围无人查看。</view>
      <button hover-class="none" class="primary" bindtap="revealFairyResult" disabled="{{busy}}">查看查验结果</button>
    </block>
  </view>
</view>
<view wx:if="{{identityChange && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll">
  <view class="error-dialog" role="dialog" aria-modal="true" aria-label="你的新身份">
    <view class="dialog-title">你已获得新身份</view>
    <view class="small muted">仅供本人查看 · {{identityChange.passiveVision?'视野随技能结算自动更新':'新技能下一轮可用'}}</view>
    <block wx:if="{{identityChangeRevealed}}">
      <view class="identity-title faction-{{identityChange.factionTone}}">{{identityChange.role}}</view>
      <view class="muted">{{identityChange.faction}}</view>
      <view class="private-info">{{identityChange.information}}</view>
<view wx:if="{{identityChange.skillStatus}}" class="private-info"><view class="label">技能状态 · {{identityChange.skillStatus.title}}</view>{{identityChange.skillStatus.detail}}</view>
      <button hover-class="none" class="text-button" bindtap="hidePrivatePreview">立即遮盖</button>
      <button hover-class="none" class="primary" bindtap="acknowledgeIdentity" disabled="{{hasPendingRequest || busy}}">记住了，遮盖身份</button>
    </block>
    <block wx:else>
      <view class="private-info muted">身份已遮盖，请确认周围无人查看。</view>
      <button hover-class="none" class="primary" bindtap="revealChangedIdentity" disabled="{{busy}}">查看新身份</button>
    </block>
  </view>
</view>
<app-nav wx:if="{{!homeShell && isLobby}}" title="对局" />
<app-nav wx:elif="{{!homeShell}}" title="牌桌" back="{{true}}" backText="对局" backLabel="返回对局，保留当前座位" bindback="returnHome" />
<view class="page {{isLobby ? 'tab-page home-lobby' : ''}} {{enteringCode ? 'is-entering-room' : ''}} {{room ? 'table-room' : ''}} {{room && room.phase!=='lobby' ? 'has-public-history' : ''}} {{room && room.phase==='lobby' ? 'table-lobby' : ''}} {{room && room.canUseTools && room.hasActiveOperation && room.phase!=='offlineFinal' ? 'has-host-bar' : ''}}">
  <view wx:if="{{!invitation && !room}}" class="brand">
    <view class="brand-identity">
      <text class="brand-mark">桌边助手</text>
      <button hover-class="none" class="connection-button" bindtap="connectionInfo" aria-label="{{reconnecting?'正在重连服务器':!network || needsLogin ? '服务器连接异常' : loading || roomsRefreshing || busy || hasPendingRequest ? '正在同步' : serverConnected ? '服务器连接正常' : '服务器连接未确认'}}">
        <view class="connection-dot {{reconnecting?'pending':!network || needsLogin ? 'offline' : loading || roomsRefreshing || busy || hasPendingRequest ? 'pending' : serverConnected ? 'online' : 'offline'}}" />
        <text wx:if="{{isLobby || reconnecting || !network || needsLogin}}" class="connection-label">{{reconnecting?'重连中':!network || needsLogin?'连接断开':loading || roomsRefreshing || busy || hasPendingRequest?'同步中':serverConnected?'已连接':'连接中'}}</text>
      </button>
    </view>
    <button hover-class="none" wx:if="{{!room}}" class="switch-table home-entry" bindtap="openHelp" aria-label="打开使用帮助"><text class="help-entry-icon" aria-hidden="true">?</text><text>帮助</text></button>
  </view>
  <button hover-class="none" wx:if="{{!isLobby && !room && !loading && !invitation}}" class="secondary" bindtap="returnHome">返回对局，创建或加入房间</button>
  <view wx:if="{{loading && !invitation}}" class="status" role="status">正在连接牌桌…</view>
  <view wx:if="{{error}}" class="dialog-backdrop" catchtouchmove="blockScroll">
    <view class="error-dialog" role="dialog" aria-modal="true" aria-label="操作提示">
      <view class="dialog-title">{{recoverableError?'连接需要恢复':'暂时无法完成'}}</view>
      <view class="dialog-message">{{error}}</view>
      <view class="dialog-actions">
        <button hover-class="none" wx:if="{{recoverableError && !hasPendingRequest}}" class="secondary" bindtap="returnHome" disabled="{{busy}}">回首页</button>
        <button hover-class="none" wx:if="{{recoverableError}}" class="primary" bindtap="retry" loading="{{busy}}" disabled="{{busy}}">{{needsLogin?'重新登录':'重试'}}</button>
        <button hover-class="none" wx:else class="primary" bindtap="dismissError">知道了</button>
      </view>
    </view>
  </view>
  <view wx:if="{{actionDialog && !error && room.needsSubmission && !room.me.submitted}}" class="dialog-backdrop {{skillTargetMode?'skill-target-backdrop':''}}" catchtouchmove="blockScroll">
    <view wx:if="{{skillAction}}" class="error-dialog action-dialog skill-dialog {{skillTargetMode?'skill-target-dialog':''}}" role="dialog" aria-modal="true" aria-label="{{skillTitle}}">
      <view class="skill-header">
        <view wx:if="{{skillTargetMode}}" class="skill-meta">{{skillTargetMeta}}</view>
        <view class="skill-title">{{skillTitle}}</view>
        <view class="skill-hint">{{skillHint}}</view>
      </view>
      <scroll-view wx:if="{{skillTargets.length || swapPlayers.length}}" scroll-y class="skill-body" style="height: {{skillBodyHeight}}{{skillTargetMode?'px':'rpx'}}; max-height: {{skillTargetMode?'52vh':'42vh'}};">
        <view wx:if="{{skillTargetMode}}" class="skill-target-heading"><text>{{skillTargetMode==='swap'?'选择两个座位':'选择目标'}}</text><text class="skill-target-caption">{{skillTargetCaption}}</text></view>
        <view wx:if="{{room.phase==='hunterTurn' || room.phase==='paladinTurn'}}" class="skill-context">{{room.operationStatus.detail}}</view>
        <view wx:if="{{skillTargets.length}}" class="skill-target-grid">
          <button hover-class="none" wx:for="{{skillTargets}}" wx:key="value" class="skill-option {{draftChoice===item.value?'is-selected':''}} {{item.disabledReason?'skill-option-unavailable':''}}" bindtap="submitChoice" data-value="{{item.value}}" disabled="{{item.disabledReason || hasPendingRequest || busy || !network}}" aria-label="{{item.label+' '+item.name+(item.disabledReason?'，'+item.disabledReason:'')+(draftChoice===item.value?'，已选':'')}}">
            <view class="skill-seat">{{item.seat}}<text class="skill-seat-unit"> 号</text></view><view class="skill-name">{{item.disabledReason || item.name}}</view><text wx:if="{{draftChoice===item.value}}" class="skill-check" aria-hidden="{{true}}">✓</text>
          </button>
        </view>
        <block wx:if="{{swapOptions.length}}">
          <view class="skill-context">已选 {{swapSeats.length}} / 2</view>
          <view class="skill-target-grid">
            <button hover-class="none" wx:for="{{swapPlayers}}" wx:key="seat" class="skill-option {{item.selected?'is-selected':''}} {{item.disabledReason?'skill-option-unavailable':''}}" bindtap="toggleSwapSeat" data-seat="{{item.seat}}" disabled="{{item.disabledReason || hasPendingRequest || busy || !network || (swapSeats.length===2 && !item.selected)}}" aria-label="{{item.seat+'号 '+item.name+(item.disabledReason?'，'+item.disabledReason:'')+(item.selected?'，已选':'')}}">
              <view class="skill-seat">{{item.seat}}<text class="skill-seat-unit"> 号</text></view><view class="skill-name">{{item.disabledReason || item.name}}</view><text wx:if="{{item.selected}}" class="skill-check" aria-hidden="{{true}}">✓</text>
            </button>
          </view>
        </block>
        <view wx:if="{{skillEligibility}}" class="skill-eligibility">{{skillEligibility}}</view>
      </scroll-view>
        <view wx:if="{{skillOtherChoices.length}}" class="skill-other-choices">
          <button hover-class="none" wx:for="{{skillOtherChoices}}" wx:key="value" class="skill-other {{item.value==='mode:'?'skill-navigation':''}} {{draftChoice===item.value?'is-selected':''}}" bindtap="submitChoice" data-value="{{item.value}}" disabled="{{hasPendingRequest || busy || !network}}" aria-label="{{item.label+(draftChoice===item.value?'，已选':'')}}"><text wx:if="{{!skillTargetMode}}" class="skill-other-mark" aria-hidden="{{true}}">{{draftChoice===item.value?'✓':item.value==='pass'?'○':'›'}}</text><text>{{item.label}}</text><view wx:if="{{skillTargetMode && item.value!=='mode:'}}" class="skill-pass-mark" aria-hidden="{{true}}" /></button>
        </view>
      <view class="skill-footer">
        <view class="skill-summary" aria-live="polite">{{skillTargetMode?skillSummary:draftChoice?'已选择：'+draftLabel:swapSeats.length?'还需选择一个座位':'尚未选择'}}</view>
        <view wx:if="{{skillTargetMode}}" class="skill-consequence">{{skillConsequence}}</view>
        <view wx:if="{{hunterModes && draftChoice==='pass'}}" class="small">本轮若出局，将不会触发被动开枪。是否确认？</view>
        <button hover-class="none" class="primary skill-confirm" bindtap="confirmChoice" disabled="{{hasPendingRequest || busy || !network || !draftChoice}}" loading="{{busy && busyAction==='submit'}}">{{busy && busyAction==='submit'?'正在提交…':skillTargetMode?skillConfirmLabel:draftChoice?(draftLabel==='本轮确认'?'确认本轮选择':'确认'+draftLabel):'请先选择'}}</button>
        <button hover-class="none" class="text-button skill-later" bindtap="closeAction" disabled="{{busy}}">稍后选择</button>
      </view>
    </view>
    <view wx:else class="error-dialog action-dialog" role="dialog" aria-modal="true" aria-label="当前操作">
      <view class="dialog-title">{{room.phase==='identity'?'查看身份':actionLabel}}</view>
      <view wx:if="{{room.phase==='teamVote'}}" class="action-team">{{room.team.length?'任务队伍：'+teamText+'号':'本次为全员表决（未指定任务队伍）'}}</view>
      <view wx:if="{{room.phase==='identity'}}" class="action-identity">
        <view wx:if="{{actionSecret}}" class="action-identity-details">
          <view class="identity-title faction-{{actionSecret.factionTone}}">{{actionSecret.role}}</view>
          <view class="muted">{{actionSecret.faction}}</view>
          <view class="private-info"><view class="label">你的视角</view>{{actionSecret.information}}</view>
<view wx:if="{{actionSecret.skillStatus}}" class="private-info"><view class="label">技能状态 · {{actionSecret.skillStatus.title}}</view>{{actionSecret.skillStatus.detail}}</view>
        </view>
        <button hover-class="none" class="secondary" bindtap="revealActionIdentity" loading="{{busy && busyAction==='actionIdentity'}}" disabled="{{!actionSecret && (busy || !network || hasPendingRequest)}}">{{actionSecret?'立即遮盖':'查看身份与视角'}}</button>
      </view>
      <view wx:if="{{room.phase==='hunterTurn' || room.phase==='paladinTurn'}}" class="small muted">{{room.operationStatus.detail}}</view>
      <view wx:if="{{hunterModes}}" class="small muted">{{hunterMode ? (hunterMode==='detonate' ? '第 2 步：选择相邻一人，自己将自爆出局' : '第 2 步：选择出局时开枪的目标') : '第 1 步：选择技能方式'}}</view>
      <view class="action-choice-list">
        <button hover-class="none" wx:for="{{actionChoices}}" wx:key="value" class="{{stagedChoice ? (draftChoice===item.value ? 'primary' : 'secondary') : (swapOptions.length ? 'secondary' : 'primary')}}" aria-label="{{item.label+(stagedChoice && draftChoice===item.value ? '，已选' : '')}}" bindtap="submitChoice" data-value="{{item.value}}" disabled="{{hasPendingRequest || busy || !network}}">{{stagedChoice && draftChoice===item.value?'✓ ':''}}{{room.phase==='identity'?'已记住身份与视野':item.label}}</button>
      </view>
      <block wx:if="{{swapOptions.length}}">
        <view class="small muted">选择两个座位 · 已选 {{swapSeats.length}} / 2；再次点击可取消</view>
        <view class="tool-seat-grid swap-seat-grid">
          <button hover-class="none" wx:for="{{swapPlayers}}" wx:key="seat" class="tool-seat-option {{item.selected?'active':''}}" bindtap="toggleSwapSeat" data-seat="{{item.seat}}" disabled="{{busy || !network || (swapSeats.length===2 && !item.selected)}}" aria-label="{{item.seat+'号 '+item.name+(item.selected?'，已选':'')}}"><view>{{item.selected?'✓ ':''}}{{item.seat}}号</view><view class="swap-seat-name">{{item.name}}</view></button>
        </view>
        <button hover-class="none" class="primary" bindtap="confirmSwap" disabled="{{hasPendingRequest || busy || !network || swapSeats.length!==2}}">确认换号</button>
      </block>
      <block wx:if="{{stagedChoice}}">
        <view class="small muted">{{draftChoice?'已选：'+draftLabel+'，确认提交后不可更改':'请先选择，再确认提交'}}</view>
        <button hover-class="none" class="primary" bindtap="confirmChoice" disabled="{{hasPendingRequest || busy || !network || !draftChoice}}" loading="{{busy && busyAction==='submit'}}">确认提交</button>
      </block>
      <scroll-view wx:if="{{actionTargets.length}}" scroll-y class="action-target-scroll">
        <button hover-class="none" wx:for="{{actionTargets}}" wx:key="seat" class="secondary" bindtap="submitTarget" data-seat="{{item.seat}}" disabled="{{hasPendingRequest || busy || !network}}">{{item.seat}}号 · {{item.name}}</button>
      </scroll-view>
      <button hover-class="none" class="text-button" bindtap="closeAction" disabled="{{busy}}">稍后</button>
    </view>
  </view>
  <view wx:if="{{toolType && room.canUseTools && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll">
    <view class="error-dialog" role="dialog" aria-modal="true" aria-label="发起操作">
      <view class="dialog-title">{{toolTitle?toolTitle:toolType==='vote'?'发起投票':toolType==='quest'?'发起任务':toolType==='reverseStrike'?'刀逆仆':toolType==='offline'?'线下刀人':'刀梅林'}}</view>
      <block wx:if="{{toolType==='vote' || toolType==='quest' || (room.knights && toolType==='assassination')}}">
        <view class="small muted">{{room.knights && toolType==='assassination'?'选择线下多数决议的红方带刀人（平票先猜拳）；由本人录入目标或空刀。提前起刀只能在发言环节。':toolType==='vote'?'可选队伍，也可直接发起全员投票。':'选择任务队员。'}}</view>
        <scroll-view scroll-y class="tool-seat-scroll" style="height: {{toolPlayers.length>6?400:296}}rpx;">
        <view class="tool-seat-grid">
          <button hover-class="none" wx:for="{{toolPlayers}}" wx:key="seat" class="tool-seat-option {{item.selected?'active':''}}" bindtap="toggleToolSeat" data-seat="{{item.seat}}" disabled="{{busy}}" aria-label="{{item.seat+'号 '+item.name+(item.selected?'，已选':'')}}">{{item.seat}}号 · {{item.name}}</button>
        </view>
        </scroll-view>
        <view class="small muted">已选 {{toolSeats.length}} 人</view>
        <view wx:if="{{toolType==='quest'}}" class="quest-threshold">
          <view class="label">失败票门槛</view>
          <view class="threshold-options">
            <button hover-class="none" class="tool-seat-option {{toolThreshold===1?'active':''}}" bindtap="pickToolThreshold" data-value="1" disabled="{{busy}}" aria-label="{{'1 张失败票'+(toolThreshold===1?'，已选':'')}}">{{toolThreshold===1?'✓ ':''}}1 张</button>
            <button hover-class="none" class="tool-seat-option {{toolThreshold===2?'active':''}}" bindtap="pickToolThreshold" data-value="2" disabled="{{busy}}" aria-label="{{'2 张失败票'+(toolThreshold===2?'，已选':'')}}">{{toolThreshold===2?'✓ ':''}}2 张</button>
          </view>
          <view class="small muted">至少 {{toolThreshold}} 张失败票，任务才失败</view>
          <view wx:if="{{toolSeats.length>0 && toolSeats.length<toolThreshold}}" class="small threshold-hint">请至少选择 {{toolThreshold}} 名任务队员</view>
        </view>
      </block>
      <view wx:else class="dialog-message">{{toolDescription?toolDescription:toolType==='offline'?'线下刀人后，由房主记录完成。':toolType==='reverseStrike'?'刺客选择逆仆，结果私密。':'刺客选择梅林，结算后公开是否命中。'}}</view>
      <view class="dialog-actions">
        <button hover-class="none" class="secondary" bindtap="closeTool" disabled="{{busy}}">取消</button>
        <button hover-class="none" class="primary" bindtap="launchTool" disabled="{{hasPendingRequest || busy || (toolType==='quest' && toolSeats.length<toolThreshold)}}">发起</button>
      </view>
    </view>
  </view>
  <view wx:if="{{reconnecting}}" class="notice" role="status"><view>{{hasPendingRequest?'正在确认提交结果，请勿重复提交':'连接中断，正在重连；当前显示上次同步的内容'}}</view><button hover-class="none" class="text-button" bindtap="recoverConnection" disabled="{{busy || loading}}">立即重试</button></view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{invitation && !room && !isLobby}}" class="room-invitation">
    <text class="invitation-eyebrow">朋友邀请你同桌</text>
    <view class="invitation-title">{{invitation.code ? '房间 '+invitation.code : '房间邀请'}}</view>
    <view wx:if="{{invitation.boardName}}" class="invitation-board">{{invitation.boardName}}</view>
    <view wx:if="{{invitationError}}" class="invitation-message" role="alert">{{invitationError}}</view>
    <view wx:elif="{{loading || busy}}" class="invitation-message" role="status">{{hasPendingRequest?'正在确认加入结果…':'正在进入房间…'}}</view>
    <form wx:if="{{invitationNeedsName && !invitationError}}" bindsubmit="submitInvitation" class="invitation-form">
      <label class="label" for="invite-nickname">玩家昵称</label>
      <input id="invite-nickname" class="input {{entryNameError?'has-error':''}}" name="nickname" type="nickname" maxlength="16" value="{{name}}" bindinput="inputName" placeholder="填写或选择微信昵称" disabled="{{busy || hasPendingRequest}}" />
      <view wx:if="{{entryNameError}}" class="entry-field-error" role="alert">{{entryNameError}}</view>
      <view class="small muted invitation-help">首次确认后用于牌桌和排行榜，可在“我的”中修改。</view>
      <view wx:if="{{invitation.occupied >= invitation.capacity}}" class="invitation-message">座位已满，将以旁观者进入房间。</view>
      <view wx:if="{{entryError}}" class="entry-field-error" role="alert">{{entryError}}</view>
      <button class="primary" hover-class="none" form-type="submit" loading="{{busy}}" disabled="{{busy || loading || hasPendingRequest || !network || needsLogin}}">进入房间</button>
    </form>
    <view class="invitation-actions">
      <button wx:if="{{invitationError && invitationRetry}}" class="secondary" hover-class="none" bindtap="retry" disabled="{{busy || loading}}">重试邀请</button>
      <button class="text-button" hover-class="none" bindtap="returnHome" disabled="{{busy || hasPendingRequest}}">返回对局</button>
    </view>
  </view>
  <view wx:if="{{resultDialog && room.canUseTools && !error}}" class="dialog-backdrop score-backdrop" catchtouchmove="blockScroll">
    <view class="error-dialog score-dialog {{resultStep==='reason'?(resultOther && resultReasonOptions.length?'score-other-panel':'score-reason-panel'):resultStep==='review'?(resultSummary.length===1?'score-review-compact':'score-review-panel'):''}} {{resultStep==='reason' && !resultOther && resultReasonOptions.length>2?'score-more-reasons':''}}" role="dialog" aria-modal="true" aria-label="登记本局结果">
      <view class="score-header"><view class="dialog-title">登记本局结果</view><view class="score-step-label" aria-label="第{{resultStepIndex+1}}步：{{resultStepTitle}}"><view class="score-steps {{resultSteps.length>3?'has-extra-step':''}}"><block wx:for="{{resultSteps}}" wx:key="id"><view wx:if="{{index}}" class="score-step-connector" aria-hidden="true"></view><view class="score-step {{index===resultStepIndex?'is-current':index<resultStepIndex?'is-complete':''}}" aria-current="{{index===resultStepIndex?'step':false}}"><text class="score-step-number">{{index+1}}</text><text>{{item.shortLabel}}</text></view></block></view></view></view>
      <view class="score-body">
      <scroll-view scroll-y class="score-scroll" scroll-top="{{resultScrollTop}}">
      <view class="score-content {{resultStep==='reason'?'score-registration-content':''}}">
        <block wx:if="{{resultStep==='reason'}}">
          <block wx:if="{{!resultOther && resultReasonOptions.length}}">
            <view class="score-reasons" aria-label="登记方式">
              <button wx:for="{{resultReasonOptions}}" wx:key="id" hover-class="none" class="secondary score-choice {{resultReason===item.id?'is-selected':''}}" data-id="{{item.id}}" bindtap="pickScoreReason" aria-pressed="{{resultReason===item.id}}"><view class="score-choice-mark" aria-hidden="true"></view><view class="score-choice-title">{{item.label}}</view></button>
              <button class="secondary score-choice score-excluded {{resultChoice==='none'?'is-selected':''}}" data-value="none" bindtap="pickResult" aria-pressed="{{resultChoice==='none'}}" hover-class="none"><view class="score-choice-mark" aria-hidden="true"></view><view class="score-choice-title">不计战绩</view></button>
            </view>
          </block>
          <block wx:else>
            <view class="score-option-heading"><text class="score-entry-title">仅登记胜方</text><text>不计积分</text></view>
            <view class="score-winners" aria-label="仅登记胜方"><button wx:for="{{room.winnerOptions}}" wx:key="value" class="secondary score-choice {{resultChoice===item.value?'is-selected':''}}" data-value="{{item.value}}" bindtap="pickResult" aria-pressed="{{resultChoice===item.value}}" hover-class="none"><view class="score-choice-mark" aria-hidden="true"></view><text class="score-choice-title">{{item.label}}</text></button></view>
            <button wx:if="{{!resultReasonOptions.length}}" class="secondary score-choice score-excluded {{resultChoice==='none'?'is-selected':''}}" data-value="none" bindtap="pickResult" aria-pressed="{{resultChoice==='none'}}" hover-class="none"><view class="score-choice-mark" aria-hidden="true"></view><view class="score-choice-title">不计战绩</view></button>
          </block>
        </block>
        <block wx:if="{{resultStep==='actor' || resultStep==='target'}}">
          <view class="score-section-title">{{resultStep==='actor'?'选择带刀人':'选择刺杀目标'}}</view><view wx:if="{{resultStep==='target'}}" class="score-helper">未指定目标可选空刀。</view>
          <view class="score-targets capacity-grid">
            <button wx:for="{{resultPlayers}}" wx:key="seat" wx:if="{{resultStep==='actor'}}" class="secondary {{resultActor===item.seat?'is-selected':''}}" bindtap="pickFunActor" data-seat="{{item.seat}}" aria-pressed="{{resultActor===item.seat}}" hover-class="none"><text>{{item.seat}}号</text><text class="score-player-name">{{item.name}}</text></button>
            <button wx:for="{{resultPlayers}}" wx:key="seat" wx:if="{{resultStep==='target'}}" class="secondary {{resultTarget===item.seat?'is-selected':''}}" bindtap="pickScoreTarget" disabled="{{resultNeedsActor && resultActor===item.seat}}" data-seat="{{item.seat}}" aria-pressed="{{resultTarget===item.seat}}" hover-class="none"><text>{{item.seat}}号</text><text class="score-player-name">{{item.name}}</text></button>
            <button wx:if="{{resultStep==='target'}}" class="secondary score-empty-target {{resultTarget===0?'is-selected':''}}" bindtap="pickScoreTarget" data-seat="0" aria-pressed="{{resultTarget===0}}" hover-class="none">空刀</button>
          </view>
        </block>
        <block wx:if="{{resultStep==='review'}}">
          <view class="result-review"><view wx:for="{{resultSummary}}" wx:key="label" class="result-review-row"><text class="small muted">{{item.label}}</text><text>{{item.value}}</text></view></view>
          <view class="result-review-note">{{resultNotice}}</view>
          <view wx:if="{{room.hasActiveOperation}}" class="result-warning">当前未结算的操作将作废。</view>
        </block>
      </view>
      </scroll-view>
      </view>
      <view class="score-footer {{resultStep==='reason' && !resultOther && resultReasonOptions.length?'has-other-entry':''}}">
        <button wx:if="{{resultStep==='reason' && !resultOther && resultReasonOptions.length}}" class="score-other-entry" bindtap="toggleResultOther" hover-class="none"><text>仅登记胜方</text><view class="score-chevron" aria-hidden="true"></view></button>
        <view wx:if="{{resultNextHint}}" class="score-next-hint" role="status"><text>{{resultNextHint}}</text></view><view class="dialog-actions"><button wx:if="{{resultStep==='reason' && resultOther && resultReasonOptions.length}}" class="secondary score-back-button" bindtap="toggleResultOther" disabled="{{busy || hasPendingRequest}}" hover-class="none">返回</button><button wx:else class="secondary score-back-button" bindtap="backResult" disabled="{{busy || hasPendingRequest}}" hover-class="none">{{resultStep==='reason'?'取消':'上一步'}}</button><button wx:if="{{resultStep!=='review'}}" class="primary" bindtap="nextResult" disabled="{{!resultNextEnabled || busy || hasPendingRequest}}" hover-class="none">下一步<view class="score-forward" aria-hidden="true"></view></button><button wx:else class="primary" bindtap="saveResult" disabled="{{!resultReady || busy || hasPendingRequest}}" hover-class="none">确认并结束</button></view>
      </view>
    </view>
  </view>
  <block wx:if="{{isLobby}}">
    <view wx:if="{{pendingTableCode}}" class="inline-error"><view>房间 {{pendingTableCode}} 有一项操作尚未确认。</view><button hover-class="none" class="secondary" bindtap="resumePending">返回牌桌处理</button></view>
    <view class="home-entry-actions">
      <button class="home-action home-action-create" hover-class="none" data-mode="create" bindtap="switchEntry" disabled="{{busy || loading || hasPendingRequest}}">
        <image class="home-action-icon" src="/assets/home-create.svg" aria-hidden="true" />
        <text class="home-action-title">创建房间</text><text class="home-action-hint">选人数，开新局</text>
      </button>
      <button class="home-action home-action-join" hover-class="none" data-mode="join" data-action="join" bindtap="switchEntry" disabled="{{busy || loading || hasPendingRequest}}">
        <image class="home-action-icon" src="/assets/home-join.svg" aria-hidden="true" />
        <text class="home-action-title">加入房间</text><text class="home-action-hint">输入 6 位房间码</text>
      </button>
    </view>
    <include src="../home/entry-sheet.wxml" />
    <view class="section-title history-heading"><text>我的牌桌<text wx:if="{{memberRooms.length}}" class="room-count">{{memberRooms.length}}</text></text><button hover-class="none" class="history-toggle room-refresh" bindtap="refreshRooms" disabled="{{busy || loading || roomsRefreshing || hasPendingRequest}}"><image class="room-refresh-icon {{roomsRefreshing?'is-refreshing':''}}" src="/assets/home-refresh.svg" aria-hidden="true" />{{roomsRefreshing?'刷新中…':'刷新'}}</button></view>
    <view wx:if="{{memberRooms.length>=6 || roomListFilter!=='all'}}" class="room-filters">
      <button hover-class="none" wx:for="{{roomFilters}}" wx:key="id" class="room-filter {{roomListFilter===item.id?'active':''}}" bindtap="filterRooms" data-filter="{{item.id}}" aria-pressed="{{roomListFilter===item.id}}">{{item.label}}</button>
    </view>
    <view wx:if="{{undoRoom}}" class="room-undo" role="status"><text>已从列表移除 {{undoRoom.code}}</text><button hover-class="none" class="history-toggle" bindtap="undoRemoveRoom" disabled="{{busy || hasPendingRequest}}">撤销</button></view>
    <view wx:for="{{visibleMemberRooms}}" wx:key="code" class="member-room room-list-item {{item.available===false?'is-unavailable':''}}" data-code="{{item.code}}" bindtap="openRoom">
      <view class="room-list-top"><text class="room-list-title">{{item.note || item.boardName || '房间 '+item.code}}</text><text class="room-status {{item.status}}">{{enteringCode===item.code?'进入中…':item.statusLabel}}</text></view>
      <view wx:if="{{item.note && item.boardName}}" class="room-list-board">{{item.boardName}}</view>
      <view class="room-list-code"><text>房间 {{item.code}}</text><button class="room-list-copy" hover-class="none" data-code="{{item.code}}" catchtap="copyListedRoom" aria-label="{{'复制房间码'+item.code}}"><view class="lobby-copy-icon" aria-hidden="true" /></button></view>
      <view class="room-list-meta"><text class="room-list-people">{{item.peopleLabel}}</text><text class="room-list-relation">{{item.compactRelation || item.relationLabel}}</text></view>
      <view class="room-list-footer"><text class="room-list-time">{{item.updatedAt?'最近活动 '+item.activityLabel:''}}</text><button class="room-list-open" hover-class="none" data-code="{{item.code}}" catchtap="openRoom" disabled="{{busy || loading || hasPendingRequest || enteringCode || item.available===false}}" aria-label="{{(item.entryLabel || '返回牌桌')+'，房间'+item.code+'，'+item.statusLabel}}"><text>{{enteringCode===item.code?'正在进入…':item.entryLabel || '返回牌桌'}}</text><text wx:if="{{item.available!==false}}" aria-hidden="true">→</text></button></view>
      <button hover-class="none" class="room-more" data-code="{{item.code}}" catchtap="openRoomMenu" disabled="{{busy || loading || hasPendingRequest}}" aria-label="{{'管理房间'+item.code+'的个人记录'}}">⋯</button>
    </view>
    <view wx:if="{{!memberRooms.length && !loading}}" class="room-empty"><view class="room-empty-title">还没有牌桌</view><view class="room-empty-hint">创建新房间，或输入房间码与朋友同桌。</view></view>
    <view wx:elif="{{memberRooms.length && !visibleMemberRooms.length}}" class="room-empty"><text>没有符合条件的牌桌</text><button hover-class="none" class="history-toggle" bindtap="filterRooms" data-filter="all">查看全部</button></view>
    <view wx:if="{{roomMenu && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll"><view class="error-dialog room-list-dialog room-menu-dialog" role="dialog" aria-modal="true" aria-label="{{'房间管理，房间'+roomMenu.code}}">
      <view class="room-menu-header"><view class="room-menu-heading">房间管理</view><view class="room-menu-code">房间 {{roomMenu.code}}</view></view>
      <view class="room-menu-options">
        <button hover-class="none" class="room-menu-action" bindtap="roomMenuAction" data-kind="hide" disabled="{{busy || hasPendingRequest}}"><view class="room-menu-copy"><text class="room-menu-label">从列表移除</text></view><text class="room-menu-chevron" aria-hidden="true">›</text></button>
        <button hover-class="none" wx:if="{{roomMenu.available!==false && roomMenu.isMember}}" class="room-menu-action" bindtap="roomMenuAction" data-kind="leave" disabled="{{busy || hasPendingRequest || !roomMenu.canLeave}}"><view class="room-menu-copy"><text class="room-menu-label">离开房间</text><text wx:if="{{!roomMenu.canLeave}}" class="room-menu-description">{{roomMenu.canLeave===false?'当前状态暂不可离开':'离开权限暂未同步'}}</text></view><text class="room-menu-chevron" aria-hidden="true">›</text></button>
      </view>
      <button hover-class="none" wx:if="{{roomMenu.available!==false && roomMenu.isHost}}" class="room-menu-action danger" bindtap="roomMenuAction" data-kind="delete" disabled="{{busy || hasPendingRequest}}"><view class="room-menu-copy"><text class="room-menu-label">解散房间</text></view><text class="room-menu-chevron" aria-hidden="true">›</text></button>
      <button hover-class="none" class="secondary room-menu-cancel" bindtap="closeRoomMenu" disabled="{{busy || hasPendingRequest}}">取消</button>
    </view></view>
    <view wx:if="{{noteRoom && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll"><view class="error-dialog room-list-dialog" role="dialog" aria-modal="true" aria-label="个人备注">
      <view class="dialog-title">个人备注 · {{noteRoom.code}}</view><label for="room-note" class="small muted">仅你可见，最多30字；留空可清除</label>
      <input id="room-note" class="input" value="{{roomNoteDraft}}" bindinput="inputRoomNote" maxlength="30" placeholder="例如：周五朋友局" focus="{{true}}" disabled="{{busy || hasPendingRequest}}" />
      <view class="dialog-actions"><button hover-class="none" class="secondary" bindtap="closeRoomMenu" disabled="{{busy || hasPendingRequest}}">取消</button><button hover-class="none" class="primary" bindtap="saveRoomNote" disabled="{{busy || hasPendingRequest}}">保存</button></view>
    </view></view>
  </block>
  <block wx:elif="{{room}}">
    <view class="lobby-room-header">
      <view class="room-summary">
        <button hover-class="none" class="copy-room lobby-room-code" bindtap="copyRoomCode" aria-label="{{'复制房间号'+room.code}}"><text>房间 {{room.code}}</text><view class="lobby-copy-icon" aria-hidden="true" /></button>
        <button wx:if="{{room.phase==='lobby'}}" class="lobby-header-link room-invite-button" hover-class="room-invite-pressed" open-type="share" disabled="{{busy || loading || hasPendingRequest || reconnecting || !network}}" aria-label="{{'邀请好友加入房间'+room.code}}">邀请好友</button>
        <view wx:elif="{{room.me.seat!==null}}" class="room-identity-anchor">
          <button hover-class="none" class="room-identity {{identityHintVisible?'identity-entry-highlight':''}}" bindtap="reveal" loading="{{busy && busyAction==='identity'}}" disabled="{{!revealed && (busy || !network)}}" aria-label="{{room.me.seat+'号 · '+(revealed?'遮盖我的身份':'查看我的身份')}}"><view wx:if="{{!(busy && busyAction==='identity')}}" class="room-identity-icon" aria-hidden="true" /><text>{{revealed?'遮盖身份':'查看身份'}}</text></button>
          <view wx:if="{{identityHintVisible && !dealtIdentityDialog && !actionDialog && !identityChange && !fairyResult && !error && !toolType && !showRoomRules && !showRoomSettings}}" class="identity-entry-hint">
            <text role="status">随时点这里，查看身份与视野。</text>
            <button hover-class="none" class="identity-hint-close" bindtap="dismissIdentityHint" aria-label="关闭身份入口提示">×</button>
          </view>
        </view>
      </view>
      <view class="lobby-room-row lobby-board-row">
        <text class="lobby-board-name">{{room.boardName}}</text>
        <button hover-class="none" class="lobby-header-link" bindtap="openRoomRules" aria-label="查看角色配置与计分说明">配置 <text aria-hidden="true">›</text></button>
      </view>
      <view class="lobby-room-status">
        <text class="lobby-chip {{room.phase==='lobby'?'lobby-phase-chip':room.phase==='ended' || room.phase==='terminated'?'':'room-playing-chip'}}">{{room.phase==='lobby'?'准备中':room.phase==='ended'?'已结束':room.phase==='terminated'?'已终止':'对局中'}}</text>
        <text wx:if="{{room.scoreSettings}}" class="lobby-chip" aria-label="{{room.scoreNotice || (room.scoreSettings.enabled?'本局计分已开启':'本局未开启计分')}}">{{room.scoreSettings.enabled?'计分局':'不计分'}}</text>
        <text wx:if="{{room.testRoom}}" class="lobby-chip">测试房间</text>
        <text wx:if="{{room.phase!=='lobby' && room.me.seat===null}}" class="lobby-chip">围观中</text>
        <button hover-class="none" wx:if="{{room.me.isHost}}" class="lobby-header-link lobby-settings" bindtap="toggleRoomSettings" disabled="{{hasPendingRequest}}">房间设置 <text aria-hidden="true">›</text></button>
      </view>
      <button hover-class="none" wx:if="{{reconnecting || !network || needsLogin}}" class="lobby-connection" bindtap="connectionInfo" aria-label="查看连接状态"><view class="connection-dot {{reconnecting?'pending':'offline'}}" /><text>{{reconnecting?'正在重连…':'连接断开，点击查看'}}</text></button>
    </view>
    <view wx:if="{{showRoomRules && !error}}" class="dialog-backdrop" catchtouchmove="blockScroll">
      <view class="error-dialog" role="dialog" aria-modal="true" aria-label="角色配置">
        <view class="dialog-title">角色配置</view>
        <view class="small muted">{{room.boardName}} · {{room.capacity}}人</view>
        <view class="configuration-roles">
          <view wx:for="{{room.roleConfiguration}}" wx:key="faction" class="role-line">{{item.label}}：{{item.roles}}</view>
        </view>
        <view wx:if="{{room.scoreSettings}}" class="small muted">{{room.scoreNotice || (room.scoreSettings.enabled?'本局计分已开启':'本局未开启计分')}}</view>
        <view wx:if="{{room.testRoom}}" class="small muted">测试房间 · 陪测已开启</view>
        <view class="dialog-actions">
          <button hover-class="none" class="secondary" bindtap="openBoardDetails">板子详情</button>
          <button hover-class="none" class="primary" bindtap="closeRoomRules">知道了</button>
        </view>
      </view>
    </view>
    <block wx:if="{{room.phase!=='lobby' && room.me.seat!==null}}">
      <view wx:if="{{revealed}}" class="identity open">
        <view wx:if="{{secret.identityHistory.length > 1}}" class="identity-card-topline"><text class="small muted">当前身份</text><button hover-class="none" class="identity-history-entry" bindtap="openIdentityHistory" aria-haspopup="dialog"><view class="identity-history-icon" aria-hidden="{{true}}" />身份历程 <text aria-hidden="{{true}}">›</text></button></view>
        <view class="identity-title faction-{{secret.factionTone}}">{{secret.role}}</view>
        <text class="muted">{{secret.faction}}</text>
        <view class="private-info">{{secret.information}}<text wx:if="{{secret.outcome}}" class="label">{{secret.outcome}}</text></view>
<view wx:if="{{secret.skillStatus}}" class="private-info"><view class="label">技能状态 · {{secret.skillStatus.title}}</view>{{secret.skillStatus.detail}}</view>
        <view wx:if="{{secret.skillHistory.length}}" class="private-info identity-skill-history"><view class="label">技能记录</view><view wx:for="{{secret.skillHistory}}" wx:key="id" class="identity-skill-record"><text class="identity-skill-round small muted">第{{item.round}}轮</text><text class="identity-skill-text">{{item.text}}</text></view></view>
        <button hover-class="none" class="secondary" bindtap="reveal">立即遮盖</button>
      </view>
    </block>
    <view wx:if="{{room.phase!=='lobby'}}" class="table-dynamics {{room.result ? 'is-final '+(room.result.winner==='good'?'result-good':room.result.winner==='evil'?'result-evil':'result-neutral') : room.phase==='tools' || room.phase==='ended'?'result-first':'operation-first'}}">
      <block wx:if="{{room.result}}"><template is="tableFinalResult" data="{{room, hasPendingRequest, busy}}" /></block>
      <block wx:elif="{{room.phase==='tools' || room.phase==='ended'}}"><template is="tableResult" data="{{room, latestResult}}" /><template is="tablePhase" data="{{room, teamText, actionEntryLabel, hasPendingRequest, busy, actionLoading, network}}" /></block>
      <block wx:else><template is="tablePhase" data="{{room, teamText, actionEntryLabel, hasPendingRequest, busy, actionLoading, network}}" /></block>
    </view>
    <view wx:if="{{!room.result && room.recordNotice}}" class="small muted">{{room.recordNotice}}</view>
      <view wx:if="{{room.canUseTools}}" class="panel host-panel">
        <view class="label">房主操作</view>
        <view wx:if="{{room.knights}}" class="small muted">第{{room.knights.round}}轮 · B牌剩余{{room.knights.remainingCards}}张</view>
        <view class="tool-actions">
          <button hover-class="none" class="secondary" bindtap="openTool" data-kind="vote" disabled="{{hasPendingRequest || busy}}">投票</button>
          <button hover-class="none" class="secondary" bindtap="openTool" data-kind="quest" disabled="{{hasPendingRequest || busy}}">做任务</button>
          <block wx:if="{{room.knights}}">
            <button hover-class="none" class="secondary" bindtap="openTool" data-kind="skills" disabled="{{hasPendingRequest || busy}}">使用技能</button>
            <button hover-class="none" class="secondary" bindtap="openTool" data-kind="conversion" disabled="{{hasPendingRequest || busy}}">身份转换</button>
          </block>
          <button hover-class="none" wx:if="{{room.fairyEnabled}}" class="secondary" bindtap="openTool" data-kind="fairy" disabled="{{hasPendingRequest || busy}}">仙女查验</button>
          <button hover-class="none" wx:if="{{room.hasReverse && !room.knifeOffline}}" class="secondary" bindtap="openTool" data-kind="reverseStrike" disabled="{{hasPendingRequest || busy}}">刀逆仆</button>
        </view>
        <view wx:if="{{room.operationProgress}}" class="operation-progress">
          <button hover-class="none" class="disclosure-button progress-heading progress-toggle" bindtap="toggleOperationProgress" aria-expanded="{{operationProgressExpanded}}"><text class="progress-title">当前操作进度</text><text class="progress-count">{{room.operationProgress.completed}} / {{room.operationProgress.total}} 已完成</text><text class="progress-disclosure">{{operationProgressExpanded?'收起 ⌃':'展开 ⌄'}}</text></button>
          <view wx:for="{{room.operationProgress.players}}" wx:key="seat" wx:if="{{operationProgressExpanded && item.required}}" class="progress-player">
            <text class="progress-player-name">{{item.seat}}号 · {{item.name}}</text>
            <text class="progress-state {{item.completed?'completed':'pending'}}">{{item.completed?'已完成':'未完成'}}</text>
          </view>
        </view>
      </view>
    <view class="task-progress">
      <view class="section-title history-heading">
        <view class="seat-section-title"><text>{{room.phase!=='lobby' && questTimeline.length?'任务进度':'玩家'}}</text><text wx:if="{{room.phase!=='lobby'}}" class="seat-count">{{seatOccupiedCount}}/{{room.capacity}} 人</text></view>
        <text wx:if="{{room.phase==='lobby'}}" class="seat-count" aria-label="{{'已入座'+seatOccupiedCount+'人，共'+room.capacity+'个座位，'+seatReadyCount+'人已准备'}}">{{seatOccupiedCount}}/{{room.capacity}} 人入座 · {{seatReadyCount}} 人已准备</text>
        <button hover-class="none" wx:if="{{room.phase!=='lobby'}}" class="disclosure-button history-toggle" bindtap="toggleSeats" aria-expanded="{{seatsExpanded}}">{{seatsExpanded?'收起座位':'座位（'+room.capacity+'）⌄'}}</button>
      </view>
      <view wx:if="{{room.phase!=='lobby' && questTimeline.length}}" class="quest-timeline">
        <button hover-class="none" wx:for="{{questTimeline}}" wx:key="key" class="quest-step {{item.questResult}}" bindtap="showQuestRecord" data-key="{{item.key}}" aria-label="{{'第'+item.number+'次任务，'+item.text+'，查看详情'}}">第{{item.number}}次 · {{item.questResult==='success'?'✓ 成功':'× 失败'}}</button>
      </view>
    </view>
    <view wx:if="{{room.phase==='lobby' || seatsExpanded !== false}}" class="{{room.capacity>=10?'seats seats-compact':'seats'}}"
      ><button hover-class="none"
        wx:for="{{seats}}"
        wx:key="seat"
        class="seat {{item.occupied?'':'seat-empty'}} {{item.mine?'mine':''}} {{item.inTeam?'team':''}} {{item.selected?'selected':''}} {{room.phase!=='lobby' && item.occupied && room.fairyHolder===item.seat?'has-fairy':''}}"
        data-seat="{{item.seat}}"
        aria-label="{{item.seat+'号，'+item.name+(item.mine?'，你的座位':'')+(item.host?'，房主':'')+(item.alive===false?'，已出局':'')+(item.selected?'，已选入队':item.inTeam?'，任务队员':'')+(room.phase!=='lobby' && item.occupied && room.fairyHolder===item.seat?'，湖中仙女持有者':'')+(room.phase==='lobby'?'，'+(item.occupied?(item.ready?'已准备':'未准备'):'可入座')+(item.mine?'，点击站起围观':item.occupied?'，点击查看战绩':''):item.occupied?'，点击查看战绩':'')}}"
        bindtap="seat"
        disabled="{{hasPendingRequest || busy || !network || (room.phase!=='lobby' && !item.occupied)}}"
      >
        <view class="seat-head">
          <text class="seat-number">{{item.seat}}号</text>
          <view class="seat-head-tags"><text wx:if="{{item.host}}" class="seat-flag">房主</text><text wx:if="{{item.mine}}" class="seat-self">你</text></view>
        </view>
        <view wx:if="{{item.occupied}}" class="seat-player">
          <view class="seat-avatar-wrap" aria-hidden="{{true}}">
            <view class="seat-avatar">
              <text class="seat-avatar-fallback">{{item.avatarInitial}}</text>
              <image wx:if="{{item.avatarUrl && !item.avatarFailed}}" class="seat-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill" data-seat="{{item.seat}}" data-url="{{item.avatarUrl}}" binderror="seatAvatarError" aria-hidden="{{true}}" />
            </view>
          </view>
          <view class="seat-name">{{item.name}}</view>
        </view>
        <view wx:else class="seat-empty-body">
          <text class="seat-empty-mark" aria-hidden="{{true}}">+</text>
          <text class="seat-empty-label">{{room.phase==='lobby'?'入座':'空位'}}</text>
        </view>
        <view wx:if="{{room.phase==='lobby' && item.occupied && item.ready}}" class="seat-ready-badge" aria-hidden="{{true}}"><view class="seat-ready-check" /></view>
        <view wx:if="{{room.phase!=='lobby' && item.occupied && room.fairyHolder===item.seat}}" class="seat-fairy" aria-hidden="{{true}}"><image class="seat-fairy-icon" src="/assets/lake-fairy.svg" mode="aspectFit" aria-hidden="{{true}}" /></view>
        <view wx:if="{{item.occupied && room.phase!=='lobby' && (item.selected || item.inTeam || item.alive===false)}}" class="seat-meta">
          <text wx:if="{{item.selected || item.inTeam}}" class="seat-status">{{item.selected?'已选入队':'任务队员'}}</text>
          <view wx:if="{{item.alive===false}}" class="seat-tags">
            <text wx:if="{{item.alive===false}}" class="seat-out">已出局</text>
          </view>
        </view>
      </button></view
    >
    <block wx:if="{{room.phase==='lobby'}}">
      <view class="lobby-action-bar">
        <view class="lobby-action-inner">
          <view wx:if="{{room.me.seat!==null}}" class="lobby-ready-controls">
            <text wx:if="{{room.me.ready}}" class="lobby-ready-status">✓ 已准备</text>
            <button hover-class="none" class="{{room.me.ready?'text-button lobby-cancel':'primary lobby-ready-button'}}" bindtap="ready" disabled="{{hasPendingRequest || busy || !network}}" loading="{{busy && busyAction==='ready'}}">{{room.me.ready?'取消准备':'准备'}}</button>
          </view>
          <text wx:else class="lobby-spectator-hint">{{seatOccupiedCount < room.capacity?'选择空位入座':'座位已满，正在围观'}}</text>
          <button hover-class="none" wx:if="{{room.me.isHost}}" class="{{canStart?'primary':'secondary'}} lobby-start" bindtap="start" disabled="{{hasPendingRequest || busy || !network || !canStart}}" aria-label="{{canStart?'发放身份':'发放身份，'+startHint}}">发放身份</button>
        </view>
      </view>
      <button hover-class="none" class="leave-button" bindtap="leave" disabled="{{hasPendingRequest || busy}}">
        离开房间
      </button>
    </block>
    <block wx:else>
      <button hover-class="none" wx:if="{{room.me.seat===null && !room.me.isHost}}" class="leave-button" bindtap="leave" disabled="{{hasPendingRequest || busy}}">离开房间</button>
      <view wx:if="{{room.phase==='proposal' && !room.canUseTools && !room.flexible}}" class="panel"
        ><view class="label">本轮需要 {{room.teamSize}} 人</view
        ><text class="muted"
          >{{room.leader===room.me.seat?'在下方选择队员，再提交队伍':'等待队长选人'}}</text
        ><view class="team-line">当前队伍：{{teamText}}</view
        ><view wx:if="{{room.leader===room.me.seat}}" class="proposal-player-options"><button wx:for="{{seats}}" wx:key="seat" wx:if="{{item.occupied}}" hover-class="none" class="{{item.selected?'selected':''}}" bindtap="toggleProposalSeat" data-seat="{{item.seat}}" aria-pressed="{{item.selected}}" disabled="{{hasPendingRequest || busy || !network}}">{{item.seat}}号 · {{item.name}}{{item.selected?' ✓':''}}</button></view><button hover-class="none"
          wx:if="{{room.leader===room.me.seat}}"
          class="primary"
          bindtap="propose"
          disabled="{{hasPendingRequest || busy || selected.length!==room.teamSize}}"
        >
          提交队伍（已选 {{selected.length}} / {{room.teamSize}}）
        </button></view
      >
      <view wx:if="{{room.phase==='offlineFinal'}}" class="panel">
        <text class="label">{{room.offlineAssassination?'请莫德雷德线下刺梅林':'请线下完成特殊结算'}}</text><text class="muted">{{room.offlineAssassination?'三次任务已成功，请在线下完成刺梅林并确认胜负。':'任务记录已保留。起刀、内奸及最终胜负在线下完成，小程序不自动判定。'}}</text>
        <button hover-class="none" wx:if="{{room.me.isHost}}" class="primary" bindtap="closeOffline" disabled="{{hasPendingRequest || busy}}">线下已完成，记录结果</button>
      </view>

    </block>
    <view wx:if="{{room.canUseTools}}" class="finish-game-footer">
      <button hover-class="none" class="finish-game-button" bindtap="finishTools" disabled="{{hasPendingRequest || busy}}">结束本局</button>
    </view>
    <view wx:if="{{room.phase!=='lobby'}}" class="public-history-dock {{room.canUseTools && room.hasActiveOperation && room.phase!=='offlineFinal'?'with-host-actions':''}}">
      <template is="publicHistoryEntry" data="{{history, historyLatest, historyUnreadCount}}" />
      <block wx:if="{{room.canUseTools && room.hasActiveOperation && room.phase!=='offlineFinal'}}">
      <view class="host-action-bar-inner {{room.closeWaiting?'has-waiting':''}}">
        <view wx:if="{{room.closeWaiting}}" class="host-waiting-copy small muted">{{settleHint}}<view>收齐自动结算</view></view>
        <button hover-class="none" wx:if="{{room.closeWaiting}}" class="secondary bar-cancel bar-cutoff" bindtap="closeWaiting" disabled="{{hasPendingRequest || busy || !network}}">{{room.closeWaiting.label || '结束等待'}}</button>
        <button hover-class="none" wx:else class="primary bar-settle" bindtap="settleTool" disabled="{{hasPendingRequest || busy || !network || !canSettle}}" loading="{{busy && busyAction==='settleTool'}}">{{canSettle?'结算当前操作':settleHint}}</button>
        <button hover-class="none" wx:if="{{!room.closeWaiting || room.closeWaiting.mode!=='cancel'}}" class="secondary bar-cancel" bindtap="cancelTool" disabled="{{hasPendingRequest || busy}}">作废</button>
      </view>
      </block>
    </view>
  </block>
</view>
<canvas wx:if="{{!isLobby}}" type="2d" id="room-share-canvas" class="room-share-canvas" aria-hidden="{{true}}" />
