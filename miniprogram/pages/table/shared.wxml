      <input id="room-note" class="input" value="{{roomNoteDraft}}" bindinput="inputRoomNote" maxlength="30" placeholder="例如：周五朋友局" focus="{{true}}" disabled="{{busy || hasPendingRequest}}" />
      <view class="dialog-actions"><button hover-class="none" class="secondary" bindtap="closeRoomMenu" disabled="{{busy || hasPendingRequest}}">取消</button><button hover-class="none" class="primary" bindtap="saveRoomNote" disabled="{{busy || hasPendingRequest}}">保存</button></view>
    </view></view>
  </block>
  <block wx:elif="{{room}}">
    <view class="lobby-room-header">
      <view class="room-summary">
