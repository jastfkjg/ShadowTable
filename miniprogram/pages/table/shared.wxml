      <view class="home-room-skeleton is-secondary" aria-hidden="true"><view class="home-skeleton-heading"><view class="home-skeleton-icon" /><view class="home-skeleton-title" /></view><view class="home-skeleton-line" /></view>
    </view>
    <view wx:if="{{currentRoomCount>=6 || roomListFilter!=='all'}}" class="room-filters">
