      <view class="process-sheet-top"><view class="table-sheet-handle" aria-hidden="true" /><view class="table-sheet-heading"><view class="table-sheet-title"><view class="table-symbol blue"><image src="/assets/{{skillTargetMode==='fairy' || skillTargetMode==='inspect'?'process-eye':skillTargetMode==='sword' || skillTargetMode==='attack'?'record-swords':'record-spark'}}.svg" aria-hidden="true" /></view><text>{{skillTitle}}</text></view><button class="table-sheet-close" hover-class="none" bindtap="closeAction" disabled="{{busy}}" aria-label="稍后选择技能">×</button></view></view>
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="skill-body process-sheet-body" style="{{processBodyHeight?'height:'+processBodyHeight+'px;':''}}"><view class="process-sheet-fields">
        <view wx:if="{{skillTargetMode!=='fairy'}}" class="process-context"><text>{{skillTargetMeta || '技能环节'}}</text><text wx:if="{{!skillTargetMeta && (room.knights.round || room.round)}}">第 {{room.knights.round || room.round}} 轮</text></view>
        <view class="skill-hint {{!skillTargetMode && !hunterModes?'process-empty-target':''}}"><image wx:if="{{!skillTargetMode && !hunterModes}}" src="/assets/record-info.svg" aria-hidden="true" /><text>{{skillHint}}</text></view>
        <view wx:if="{{skillTargetMode}}" class="skill-target-heading"><text>{{skillTargetMode==='swap'?'选择两个座位':'选择目标'}}</text><text class="skill-target-caption">{{skillTargetCaption}}</text></view>
        <view wx:if="{{room.phase==='hunterTurn' || room.phase==='paladinTurn'}}" class="skill-context">{{room.operationStatus.detail}}</view>
        <view wx:if="{{skillTargets.length}}" class="skill-target-grid">
          <button hover-class="none" wx:for="{{skillTargets}}" wx:key="value" class="skill-option {{draftChoice===item.value?'is-selected':''}} {{item.disabledReason?'skill-option-unavailable':''}}" bindtap="submitChoice" data-value="{{item.value}}" disabled="{{item.disabledReason || hasPendingRequest || busy || !network}}" aria-pressed="{{draftChoice===item.value}}" aria-label="{{item.label+' '+item.name+(item.disabledReason?'，'+item.disabledReason:'')+(draftChoice===item.value?'，已选':'')}}"><view class="skill-seat">{{item.seat}}<text class="skill-seat-unit">号</text></view><view class="skill-name">{{item.disabledReason || item.name}}</view><text wx:if="{{draftChoice===item.value}}" class="skill-check" aria-hidden="true">✓</text></button>
        </view>
        <block wx:if="{{swapOptions.length}}"><view class="skill-context">已选 {{swapSeats.length}} / 2</view><view class="skill-target-grid">
          <button hover-class="none" wx:for="{{swapPlayers}}" wx:key="seat" class="skill-option {{item.selected?'is-selected':''}} {{item.disabledReason?'skill-option-unavailable':''}}" bindtap="toggleSwapSeat" data-seat="{{item.seat}}" disabled="{{item.disabledReason || hasPendingRequest || busy || !network || (swapSeats.length===2 && !item.selected)}}" aria-pressed="{{item.selected}}" aria-label="{{item.seat+'号 '+item.name+(item.disabledReason?'，'+item.disabledReason:'')+(item.selected?'，已选':'')}}"><view class="skill-seat">{{item.seat}}<text class="skill-seat-unit">号</text></view><view class="skill-name">{{item.disabledReason || item.name}}</view><text wx:if="{{item.selected}}" class="skill-check" aria-hidden="true">✓</text></button>
        </view></block>
        <view wx:if="{{skillEligibility}}" class="skill-eligibility">{{skillEligibility}}</view>
        <view wx:if="{{skillOtherChoices.length}}" class="skill-other-choices">
          <button hover-class="none" wx:for="{{skillOtherChoices}}" wx:key="value" class="skill-other {{item.value==='mode:'?'skill-navigation':''}} {{draftChoice===item.value?'is-selected':''}}" bindtap="submitChoice" data-value="{{item.value}}" disabled="{{hasPendingRequest || busy || !network}}" aria-pressed="{{draftChoice===item.value}}" aria-label="{{item.label+(draftChoice===item.value?'，已选':'')}}"><view class="process-choice-symbol"><image src="/assets/{{item.value==='pass'?'process-skip':item.value==='mode:'?'record-list':'record-spark'}}.svg" aria-hidden="true" /></view><text>{{item.label}}</text><view class="process-choice-radio" aria-hidden="true">{{draftChoice===item.value?'✓':''}}</view></button>
        </view>
      </view></scroll-view>
      <view class="skill-footer process-sheet-footer table-sheet-footer">
        <view class="skill-summary" aria-live="polite">{{skillTargetMode?skillSummary:draftChoice?'已选择：'+draftLabel:swapSeats.length?'还需选择一个座位':'尚未选择'}}</view>
        <view wx:if="{{skillTargetMode && skillConsequence}}" class="skill-consequence">{{skillConsequence}}</view>
        <view wx:if="{{hunterModes && draftChoice==='pass'}}" class="small">本轮若出局，将不会触发被动开枪。是否确认？</view>
        <button hover-class="none" class="primary skill-confirm" bindtap="confirmChoice" disabled="{{hasPendingRequest || busy || !network || !draftChoice}}" loading="{{busy && busyAction==='submit'}}">{{busy && busyAction==='submit'?'正在提交…':skillTargetMode?skillConfirmLabel:draftChoice?(draftLabel==='本轮确认'?'确认本轮选择':'确认'+draftLabel):'请先选择'}}</button><button hover-class="none" class="text-button skill-later" bindtap="closeAction" disabled="{{busy}}">稍后选择</button>
      </view>
    </view>
    <view wx:elif="{{stagedChoice && (room.phase==='quest' || room.phase==='teamVote')}}" class="error-dialog table-sheet task-choice-sheet process-sheet process-vote {{processBodyHeight?'has-measured-body':''}}" role="dialog" aria-modal="true" aria-label="{{room.phase==='teamVote'?'队伍表决':'选择本轮任务牌'}}">
      <view class="table-sheet-top process-sheet-top"><view class="table-sheet-handle" aria-hidden="true" /><view class="table-sheet-heading"><view class="table-sheet-title"><view class="table-symbol blue" aria-hidden="true"><image src="/assets/{{room.phase==='teamVote'?'process-vote':'table-cards'}}.svg" /></view><text>{{room.phase==='teamVote'?'队伍表决':'选择本轮任务牌'}}</text></view><button hover-class="none" class="table-sheet-close" bindtap="closeAction" disabled="{{busy}}" aria-label="稍后选择任务牌">×</button></view></view>
      <scroll-view class="table-sheet-body task-choice-body process-sheet-body" style="{{processBodyHeight?'height:'+processBodyHeight+'px;':'height:'+(62+actionChoices.length*108)+'px;'}}" scroll-y enhanced show-scrollbar="{{false}}"><view class="table-sheet-fields process-sheet-fields">
        <view class="task-choice-context muted">{{room.team.length?'任务队伍 '+teamText+' 号':room.phase==='teamVote'?'本次为全员表决（未指定任务队伍）':'本轮任务出牌'}}<text>{{room.phase==='teamVote'?'全员表决，结算后公开票型':'仅公开票数，不公开出牌人'}}</text></view>
        <view class="action-choice-list"><button hover-class="none" wx:for="{{actionChoices}}" wx:key="value" class="quest-choice {{draftChoice===item.value?'is-selected':''}} {{item.value==='reject' || item.value==='fail' || item.value==='thiefFail'?'is-fail':item.value==='magic'?'is-magic':''}}" aria-label="{{item.label+(draftChoice===item.value?'，已选':'')}}" aria-pressed="{{draftChoice===item.value}}" bindtap="submitChoice" data-value="{{item.value}}" disabled="{{hasPendingRequest || busy || !network}}"><view class="quest-choice-symbol" aria-hidden="true"><image src="/assets/{{item.value==='approve'?'process-up':item.value==='reject'?'process-down':item.value==='fail' || item.value==='thiefFail'?'record-swords':item.value==='magic'?'record-spark':'record-shield-good'}}.svg" /></view><view class="quest-choice-copy"><view>{{item.label}}</view><text>{{room.phase==='teamVote'?(item.value==='approve'?'同意这支队伍出发':item.value==='reject'?'不同意这支队伍出发':'选择后再确认提交'):'本轮任务牌 · 点击选择'}}</text></view><view class="quest-choice-radio" aria-hidden="true">{{draftChoice===item.value?'✓':''}}</view></button></view>
      </view></scroll-view>
      <view class="table-sheet-footer process-sheet-footer"><view class="task-choice-hint muted" aria-live="polite">{{draftChoice?'已选：'+draftLabel+'，确认提交后不可更改':'请先选择，再确认提交'}}</view><button hover-class="none" class="primary" bindtap="confirmChoice" disabled="{{hasPendingRequest || busy || !network || !draftChoice}}" loading="{{busy && busyAction==='submit'}}">确认提交</button><button hover-class="none" class="text-button" bindtap="closeAction" disabled="{{busy}}">稍后</button></view>
    </view>
    <view wx:else class="error-dialog action-dialog table-sheet process-sheet process-generic {{processBodyHeight?'has-measured-body':''}}" role="dialog" aria-modal="true" aria-label="当前操作">
      <view class="process-sheet-top"><view class="table-sheet-handle" aria-hidden="true" /><view class="table-sheet-heading"><view class="table-sheet-title"><view class="table-symbol blue"><image src="/assets/table-cards.svg" aria-hidden="true" /></view><text>{{room.phase==='identity'?'查看身份':actionLabel}}</text></view><button class="table-sheet-close" hover-class="none" bindtap="closeAction" disabled="{{busy}}" aria-label="稍后完成当前操作">×</button></view></view>
      <scroll-view class="process-sheet-body" style="{{processBodyHeight?'height:'+processBodyHeight+'px;':''}}" scroll-y enhanced show-scrollbar="{{false}}"><view class="process-sheet-fields">
      <view wx:if="{{room.phase==='teamVote'}}" class="action-team">{{room.team.length?'任务队伍：'+teamText+'号':'本次为全员表决（未指定任务队伍）'}}</view>
      <view wx:if="{{room.phase==='identity'}}" class="action-identity">
        <view wx:if="{{actionSecret}}" class="action-identity-details">
          <view class="identity-title faction-{{actionSecret.factionTone}}">{{actionSecret.role}}</view>
          <view class="muted">{{actionSecret.faction}}</view>
          <view class="private-info"><view class="label">你的视角</view>{{actionSecret.information}}</view>
<view wx:if="{{actionSecret.skillStatus}}" class="private-info"><view class="label">技能状态 · {{actionSecret.skillStatus.title}}</view>{{actionSecret.skillStatus.detail}}</view>
        </view>
        <button hover-class="none" class="secondary" bindtap="revealActionIdentity" loading="{{busy && busyAction==='actionIdentity'}}" disabled="{{!actionSecret && (busy || !network || hasPendingRequest)}}">{{actionSecret?'立即遮盖':'查看身份与视角'}}</button>
      </view>
      <view wx:if="{{room.phase==='hunterTurn' || room.phase==='paladinTurn'}}" class="small muted">{{room.operationStatus.detail}}</view>
      <view wx:if="{{hunterModes}}" class="small muted">{{hunterMode ? (hunterMode==='detonate' ? '第 2 步：选择相邻一人，自己将自爆出局' : '第 2 步：选择出局时开枪的目标') : '第 1 步：选择技能方式'}}</view>
      <view class="action-choice-list">
        <button hover-class="none" wx:for="{{actionChoices}}" wx:key="value" class="{{stagedChoice ? (draftChoice===item.value ? 'primary' : 'secondary') : (swapOptions.length ? 'secondary' : 'primary')}}" aria-label="{{item.label+(stagedChoice && draftChoice===item.value ? '，已选' : '')}}" bindtap="submitChoice" data-value="{{item.value}}" disabled="{{hasPendingRequest || busy || !network}}">{{stagedChoice && draftChoice===item.value?'✓ ':''}}{{room.phase==='identity'?'已记住身份与视野':item.label}}</button>
      </view>
      <block wx:if="{{swapOptions.length}}">
        <view class="small muted">选择两个座位 · 已选 {{swapSeats.length}} / 2；再次点击可取消</view>
        <view class="tool-seat-grid swap-seat-grid">
          <button hover-class="none" wx:for="{{swapPlayers}}" wx:key="seat" class="tool-seat-option {{item.selected?'active':''}}" bindtap="toggleSwapSeat" data-seat="{{item.seat}}" disabled="{{busy || !network || (swapSeats.length===2 && !item.selected)}}" aria-label="{{item.seat+'号 '+item.name+(item.selected?'，已选':'')}}"><view>{{item.selected?'✓ ':''}}{{item.seat}}号</view><view class="swap-seat-name">{{item.name}}</view></button>
        </view>
        <button hover-class="none" class="primary" bindtap="confirmSwap" disabled="{{hasPendingRequest || busy || !network || swapSeats.length!==2}}">确认换号</button>
      </block>
      <view wx:if="{{actionTargets.length}}" class="process-action-targets">
        <button hover-class="none" wx:for="{{actionTargets}}" wx:key="seat" class="secondary" bindtap="submitTarget" data-seat="{{item.seat}}" disabled="{{hasPendingRequest || busy || !network}}">{{item.seat}}号 · {{item.name}}</button>
      </view>
      </view></scroll-view><view class="process-sheet-footer table-sheet-footer">
      <block wx:if="{{stagedChoice}}">
        <view class="small muted">{{draftChoice?'已选：'+draftLabel+'，确认提交后不可更改':'请先选择，再确认提交'}}</view>
        <button hover-class="none" class="primary" bindtap="confirmChoice" disabled="{{hasPendingRequest || busy || !network || !draftChoice}}" loading="{{busy && busyAction==='submit'}}">确认提交</button>
      </block>
      <button hover-class="none" class="text-button" bindtap="closeAction" disabled="{{busy}}">稍后</button></view>
    </view>
