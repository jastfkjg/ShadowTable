      <view class="process-sheet-top"><view class="table-sheet-handle" aria-hidden="true" /><view class="table-sheet-heading"><view class="table-sheet-title"><view class="table-symbol blue"><image src="/assets/{{toolType==='vote'?'process-vote':toolType==='quest'?'table-cards':'record-spark'}}.svg" aria-hidden="true" /></view><text>{{toolTitle?toolTitle:toolType==='vote'?'发起投票':toolType==='quest'?'发起任务':toolType==='reverseStrike'?'刀逆仆':toolType==='offline'?'线下刀人':'刀梅林'}}</text></view><button class="table-sheet-close" hover-class="none" bindtap="closeTool" disabled="{{busy}}" aria-label="取消发起操作">×</button></view></view>
      <scroll-view class="process-sheet-body" style="{{processBodyHeight?'height:'+processBodyHeight+'px;':''}}" scroll-y enhanced show-scrollbar="{{false}}"><view class="process-sheet-fields">
        <view wx:if="{{toolType==='vote' || toolType==='quest'}}" class="process-tool-tabs" role="tablist" aria-label="房主操作"><button class="{{toolType==='vote'?'is-selected':''}}" hover-class="none" role="tab" aria-selected="{{toolType==='vote'}}" bindtap="openTool" data-kind="vote" disabled="{{hasPendingRequest || busy}}">发起投票</button><button class="{{toolType==='quest'?'is-selected':''}}" hover-class="none" role="tab" aria-selected="{{toolType==='quest'}}" bindtap="openTool" data-kind="quest" disabled="{{hasPendingRequest || busy}}">发起任务</button></view>
        <block wx:if="{{toolType==='vote' || toolType==='quest' || (room.knights && toolType==='assassination')}}">
          <view class="process-target-title"><text>{{toolType==='quest'?'选择任务队员':toolType==='vote'?'选择投票队伍':'选择带刀人'}}</text><text class="small muted">已选 {{toolSeats.length}} 人</text></view>
          <view class="tool-seat-grid process-team-grid"><button hover-class="none" wx:for="{{toolPlayers}}" wx:key="seat" class="tool-seat-option {{item.selected?'active':''}}" bindtap="toggleToolSeat" data-seat="{{item.seat}}" disabled="{{busy}}" aria-pressed="{{item.selected}}" aria-label="{{item.seat+'号 '+item.name+(item.selected?'，已选':'')}}"><view class="process-team-number">{{item.seat}}<text>号</text></view><view>{{item.name}}</view><text wx:if="{{item.selected}}" class="skill-check" aria-hidden="true">✓</text></button></view>
          <view class="process-help small muted">{{room.knights && toolType==='assassination'?'选择线下多数决议的红方带刀人（平票先猜拳）；由本人录入目标或空刀。提前起刀只能在发言环节。':toolType==='vote'?'可选队伍，也可直接发起全员投票。':'再次点击可取消选择。'}}</view>
          <view wx:if="{{toolType==='quest'}}" class="quest-threshold"><view class="label">失败票门槛</view><view class="threshold-options"><button hover-class="none" class="tool-seat-option {{toolThreshold===1?'active':''}}" bindtap="pickToolThreshold" data-value="1" disabled="{{busy}}" aria-pressed="{{toolThreshold===1}}" aria-label="{{'1 张失败票'+(toolThreshold===1?'，已选':'')}}">1 张<text wx:if="{{toolThreshold===1}}" aria-hidden="true">✓</text></button><button hover-class="none" class="tool-seat-option {{toolThreshold===2?'active':''}}" bindtap="pickToolThreshold" data-value="2" disabled="{{busy}}" aria-pressed="{{toolThreshold===2}}" aria-label="{{'2 张失败票'+(toolThreshold===2?'，已选':'')}}">2 张<text wx:if="{{toolThreshold===2}}" aria-hidden="true">✓</text></button></view><view class="small muted">至少 {{toolThreshold}} 张失败票，任务才失败</view><view wx:if="{{toolSeats.length>0 && toolSeats.length<toolThreshold}}" class="small threshold-hint">请至少选择 {{toolThreshold}} 名任务队员</view></view>
        </block>
        <view wx:else class="dialog-message">{{toolDescription?toolDescription:toolType==='offline'?'线下刀人后，由房主记录完成。':toolType==='reverseStrike'?'刺客选择逆仆，结果私密。':'刺客选择梅林，结算后公开是否命中。'}}</view>
      </view></scroll-view>
      <view class="process-sheet-footer table-sheet-footer"><view wx:if="{{toolType==='vote' || toolType==='quest' || (room.knights && toolType==='assassination')}}" class="process-selection-summary small muted">已选 {{toolSeats.length}} 人{{toolType==='vote' && !toolSeats.length?' · 全员投票':''}}</view><button hover-class="none" class="primary" bindtap="launchTool" disabled="{{hasPendingRequest || busy || (toolType==='quest' && toolSeats.length<toolThreshold)}}">{{toolType==='quest'?'发起任务':toolType==='vote'?(toolSeats.length?'发起投票':'发起全员投票'):'发起'}}</button><button hover-class="none" class="text-button" bindtap="closeTool" disabled="{{busy}}">取消</button></view>
    </view>
  </view>
  <view wx:if="{{notice && !reconnecting}}" class="notice">{{notice}}</view>
  <view wx:if="{{invitation && !room && !isLobby}}" class="room-invitation">
