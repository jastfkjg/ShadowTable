    <view wx:if="{{memberRooms.length && (loading || reconnecting || !network || needsLogin)}}" class="home-room-sync"><text>{{roomsSyncLabel?'上次同步于 '+roomsSyncLabel:'上次同步的牌桌'}}</text><text>已保留内容</text></view>
    <view wx:if="{{!memberRooms.length && (loading || reconnecting || !network || needsLogin)}}" class="home-room-loading" aria-label="正在获取牌桌列表" aria-busy="true">
