/* Shared game sheets: quiet surfaces, explicit native scroll regions, fixed actions. */
.process-sheet-top { flex-shrink: 0; padding: 10px 18px 12px; }
.process-sheet .table-sheet-title { font-size: 20px; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
.process-sheet .table-sheet-title > text { min-width: 0; }
.process-sheet-body { height: 350px; min-height: 0; flex-shrink: 1; max-height: calc(100vh - 294px - env(safe-area-inset-bottom)); }
.process-sheet.has-measured-body .process-sheet-body { max-height: none; }
.process-sheet-fields { padding: 0 18px 10px; overflow-wrap: anywhere; }
.process-sheet-footer { flex-shrink: 0; margin: 0; border: 0; }
.process-sheet .small { font-size: 12px; line-height: 1.7; }
.process-sheet .identity-privacy-note { margin: 2px 0 14px; color: var(--muted); font-size: 12px; font-weight: 400; }
.process-sheet .table-symbol image { width: 19px; height: 19px; }
.process-sheet button.table-sheet-close { align-self: flex-start; }
.process-sheet button.process-private-hide { display: flex; align-items: center; justify-content: center; }
.process-private-hide image { width: 21px; height: 21px; }
.process-sheet-footer button.primary[disabled] { background: #756f5a; color: #172730; border-color: transparent; opacity: 1; }
.process-context { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; margin: 3px 0 16px; color: var(--muted); font-size: 12px; line-height: 1.6; }
.process-context .identity-privacy-note { margin: 0; }
.process-help { margin-top: 12px; }
.process-target-title { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; margin: 14px 0 12px; font-size: 14px; font-weight: 600; }
.process-target-title .small { font-weight: 400; }
.process-selection-summary { margin: 0 0 10px; }

/* Two main metrics, one supporting sentence; faction rates are data, not progress. */
.player-card-metrics { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; padding: 0 0 15px; }
.player-card-metric { flex: 1; min-width: 0; }
.player-card-metric > text { display: block; margin-bottom: 5px; font-size: 12px; line-height: 18px; }
.player-card-score, .player-card-rate { display: flex; align-items: baseline; gap: 5px; font-variant-numeric: tabular-nums; line-height: 1.25; overflow-wrap: anywhere; }
.player-card-score > text:first-child { min-width: 0; font-size: 36px; font-weight: 600; color: var(--accent); }
.player-card-score > text.is-long-score { font-size: 22px; }
.player-card-rate > text:first-child { min-width: 0; font-size: 36px; font-weight: 600; }
.player-card-unit { flex-shrink: 0; font-size: 13px; font-weight: 400; color: var(--muted); }
.player-card-total-rate { text-align: right; }
.player-card-rate { justify-content: flex-end; }
.player-card-record-line { display: flex; align-items: center; flex-wrap: wrap; gap: 3px 8px; padding: 0; color: var(--muted); background: transparent; font-size: 13px; line-height: 22px; }
.player-card-record-line image { width: 17px; height: 17px; flex-shrink: 0; }
.player-card-count { font-size: 13px; color: var(--text); font-weight: 500; }
.player-card-factions { margin-top: 23px; }
.player-card-factions-heading { gap: 12px; min-height: 22px; margin-bottom: 7px; }
.player-card-factions-heading .small { font-size: 11px; }
.player-card-faction { display: flex; align-items: center; gap: 11px; min-height: 67px; padding: 12px 0; }
.player-card-faction-symbol { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 32px; height: 34px; border-radius: 11px; background: rgba(177,191,198,.06); }
.player-card-faction-symbol.faction-good { background: rgba(163,223,190,.08); }
.player-card-faction-symbol.faction-evil { background: rgba(242,182,174,.08); }
.player-card-faction-symbol.faction-third { background: rgba(138,184,217,.08); }
.player-card-faction-symbol image { display: block; width: 20px; height: 20px; }
.player-card-faction-copy { flex: 1; min-width: 0; }
.player-card-faction-copy text { display: block; }
.player-card-faction-label { font-size: 13px; font-weight: 500; }
.player-card-faction-copy .small { margin-top: 3px; }
.player-card-faction-rate { display: flex; align-items: baseline; gap: 2px; min-width: 0; font-size: 23px; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; }

/* All skills use the same body and footer; target legality stays in the controller. */
.process-skill:not(.has-targets) .process-sheet-body { height: 215px; }
.process-skill.has-measured-body .process-sheet-body { height: auto; }
.process-skill .skill-body { padding: 0; overflow-y: auto; }
.process-skill .skill-hint { margin: 0 0 17px; color: var(--text); font-size: 13px; line-height: 1.7; }
.process-empty-target { display: flex; align-items: flex-start; gap: 10px; padding: 14px; border-radius: 14px; background: rgba(177,191,198,.05); }
.process-empty-target image { flex-shrink: 0; width: 18px; height: 18px; margin-top: 2px; }
.process-skill .skill-target-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin: 0 0 10px; font-size: 13px; }
.process-skill .skill-target-caption { font-size: 12px; color: var(--muted); }
.process-skill .skill-target-grid, .process-team-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
.process-skill button.skill-option, .process-skill button.skill-option[disabled]:not([type]),
.process-tool .process-team-grid button.tool-seat-option, .process-tool .process-team-grid button.tool-seat-option[disabled]:not([type]) { display: flex; position: relative; flex-direction: column; justify-content: center; align-items: center; gap: 3px; width: 100%; min-width: 0; min-height: 67px; margin: 0; padding: 9px 4px; border: 1px solid transparent; border-radius: 12px; background: var(--control-bg, #14232c); color: var(--text); text-align: center; font-size: 12px; line-height: 1.6; }
.process-skill button.skill-option.is-selected, .process-tool .process-team-grid button.tool-seat-option.active { border-color: var(--accent); background: rgba(229,198,139,.07); }
.process-skill button.skill-option-unavailable[disabled]:not([type]) { border: 1px dashed rgba(177,191,198,.12); background: rgba(177,191,198,.035); color: #a7b5bd; opacity: 1; }
.process-skill .skill-seat, .process-team-number { margin: 0; font-size: 18px; font-weight: 600; line-height: 1.4; }
.process-skill .skill-seat-unit, .process-team-number text { margin-left: 2px; font-size: 10px; color: var(--muted); font-weight: 400; }
.process-skill .skill-name { margin: 0; width: 100%; color: inherit; font-size: 12px; font-weight: 400; line-height: 1.6; white-space: normal; overflow: visible; word-break: break-all; }
.process-skill .skill-check, .process-tool .skill-check { position: absolute; top: 4px; right: 5px; width: 13px; height: 13px; font-size: 11px; line-height: 13px; border: 0; border-radius: 0; background: transparent; color: var(--accent); }
.process-skill .skill-context, .process-skill .skill-eligibility { margin: 10px 0 12px; padding: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }
.process-skill .skill-other-choices { display: flex; flex-direction: column; gap: 10px; padding: 0; margin: 16px 0 0; }
.process-skill button.skill-other, .process-skill button.skill-other[disabled]:not([type]) { display: flex; align-items: center; justify-content: flex-start; gap: 11px; width: 100%; min-height: 76px; margin: 0; padding: 14px; border: 1px solid rgba(177,191,198,.22); border-radius: 15px; background: var(--control-bg, #14232c); color: var(--text); text-align: left; font-size: 16px; line-height: 1.6; }
.process-skill.has-targets button.skill-other { min-height: 60px; padding: 10px 12px; font-size: 14px; }
.process-skill button.skill-other > text { flex: 1; min-width: 0; font-weight: 600; }
.process-skill button.skill-other.is-selected { border-color: var(--accent); background: rgba(229,198,139,.06); }
.process-choice-symbol { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 34px; height: 34px; border-radius: 11px; background: rgba(177,191,198,.08); }
.process-choice-symbol image { width: 19px; height: 19px; }
.process-choice-radio { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 21px; height: 21px; border: 1px solid #82939b; border-radius: 50%; font-size: 13px; color: var(--bg); }
.is-selected .process-choice-radio { background: var(--accent); border-color: var(--accent); }
.process-skill button.skill-navigation { min-height: 44px; justify-content: center; padding: 8px; color: var(--muted); background: transparent; border: 0; font-size: 13px; }
.process-skill button.skill-navigation .process-choice-symbol, .process-skill button.skill-navigation .process-choice-radio { display: none; }
.process-skill button.skill-navigation > text { flex: 0 1 auto; font-weight: 400; }
.process-skill .skill-footer { padding: 12px 18px calc(16px + env(safe-area-inset-bottom)); }
.process-skill .skill-summary, .process-skill .skill-consequence { margin: 0 0 8px; color: var(--muted); font-size: 12px; font-weight: 400; line-height: 1.65; }
.process-skill .skill-footer .small { margin-bottom: 8px; }
.process-skill button.skill-confirm, .process-skill button.skill-confirm[disabled]:not([type]) { min-height: 50px; margin: 4px 0 0; padding: 12px; border-radius: 13px; font-size: 16px; line-height: 1.5; }
.process-skill button.skill-later { min-height: 44px; padding: 10px; margin-top: 4px; font-size: 13px; }

/* Host operation picker and vote/quest cards share the selection language. */
.process-tool-tabs { display: flex; gap: 4px; padding: 4px; margin: 3px 0 19px; border-radius: 13px; background: var(--control-bg, #14232c); }
.process-tool-tabs button, .process-tool-tabs button[disabled]:not([type]) { flex: 1; width: auto; min-height: 44px; margin: 0; padding: 7px; border: 0; border-radius: 10px; background: transparent; color: var(--muted); font-size: 14px; font-weight: 500; line-height: 1.5; }
.process-tool-tabs button.is-selected { background: #2b3d47; color: var(--text); }
.process-tool .quest-threshold { margin: 21px 0 0; padding: 15px 0 0; border-top: 1px solid rgba(177,191,198,.13); }
.process-tool .quest-threshold .label { margin: 0 0 12px; font-size: 14px; }
.process-tool .threshold-options { display: flex; gap: 8px; margin: 0 0 9px; }
.process-tool .threshold-options button, .process-tool .threshold-options button[disabled]:not([type]) { display: flex; flex: 1; align-items: center; justify-content: center; gap: 8px; min-height: 44px; margin: 0; padding: 8px; border: 1px solid transparent; border-radius: 10px; background: var(--control-bg, #14232c); color: var(--muted); font-size: 14px; }
.process-tool .threshold-options button.active { border-color: var(--accent); background: rgba(229,198,139,.06); color: var(--accent); }
.process-tool .dialog-message { margin: 4px 0; font-size: 14px; line-height: 1.75; }
.process-vote .quest-choice-copy > view { font-size: 16px; }
.process-vote button.quest-choice { min-height: 76px; padding: 14px; border-radius: 15px; }
.process-vote .quest-choice-symbol { width: 34px; height: 34px; border-radius: 11px; }
.process-vote .quest-choice-symbol image { width: 20px; height: 20px; }
.process-vote .task-choice-context { margin-top: 3px; }
.process-vote .process-sheet-fields { padding-top: 0; }
.process-generic .action-choice-list, .process-action-targets { display: flex; flex-direction: column; gap: 8px; margin: 14px 0 0; }
.process-generic .action-choice-list button, .process-action-targets button { min-height: 48px; margin: 0; padding: 10px 12px; border-radius: 12px; font-size: 15px; }
.process-generic .action-team, .process-generic .private-info, .process-generic .label { font-size: 13px; line-height: 1.75; }
.process-generic .identity-title { font-size: 24px; line-height: 1.5; margin: 14px 0 5px; }
.process-generic .action-identity > button { min-height: 44px; margin: 12px 0; font-size: 14px; }

/* Private content is mounted only inside existing reveal guards. */
.process-new-identity .process-sheet-body { height: 510px; max-height: calc(100vh - 248px - env(safe-area-inset-bottom)); }
.process-new-identity .dealt-role-heading { margin: 8px 0 21px; }
.process-new-identity .private-role-art { width: 72px; height: 72px; }
.process-new-identity .identity-title { margin: 7px 0 5px; font-size: 25px; }
.process-new-identity .private-info .label { display: flex; align-items: center; gap: 6px; margin: 0 0 7px; }
.process-new-identity .private-info .label image { width: 14px; height: 14px; flex-shrink: 0; }
.process-new-identity .private-info { font-size: 13px; line-height: 1.8; }
.process-skill-status { display: flex; align-items: flex-start; gap: 9px; margin: 15px 0 0; padding: 12px; border-radius: 12px; background: rgba(229,198,139,.045); color: var(--accent); font-size: 13px; }
.process-skill-status > image { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; }
.process-skill-status > view { min-width: 0; }
.process-skill-status .small { margin-top: 3px; }
.process-private-note { margin: 10px 0 0; }
.process-sealed { padding: 22px 8px; text-align: center; }
.process-sealed > .table-symbol { width: 68px; height: 68px; border-radius: 20px; margin: 0 auto 20px; }
.process-sealed > .table-symbol image { width: 30px; height: 30px; }
.process-sealed > view:nth-child(2) { margin-bottom: 10px; font-size: 20px; font-weight: 600; }
.process-sealed .small { display: block; max-width: 260px; margin: 0 auto; font-size: 13px; }
.process-inspection .process-sheet-body { height: 200px; max-height: calc(100vh - 248px - env(safe-area-inset-bottom)); }
.process-inspection-result { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 20px; min-height: 136px; box-sizing: border-box; margin: 27px 0 15px; padding: 24px 21px; border-radius: 18px; background: var(--control-bg, #14232c); }
.process-inspection-result > view { min-width: 0; }
.process-inspection-result .small { display: block; line-height: 1.7; }
.process-inspection-seat { margin-top: 8px; font-size: 44px; font-weight: 600; line-height: 1.2; }
.process-inspection-seat text { margin-left: 6px; font-size: 13px; font-weight: 400; color: var(--muted); }
.process-inspection-faction-value { display: flex; align-items: center; min-height: 53px; margin-top: 8px; font-size: 29px; font-weight: 600; line-height: 1.4; white-space: nowrap; }
.process-inspection .fairy-result-summary { margin: 22px 0; font-size: 25px; line-height: 1.6; overflow-wrap: anywhere; }
.process-history .identity-history-title { font-size: 22px; margin: 0; }
.table-sheet-backdrop .process-history { height: auto; padding: 0; }
.process-history .process-sheet-top { padding: 10px 20px 0; }
.process-history .table-sheet-handle { margin-bottom: 14px; }
.process-history .identity-history-heading { padding: 0; margin: 0; align-items: center; }
.process-history button.identity-history-close { flex-shrink: 0; width: 44px; min-height: 44px; padding: 0; margin: 0 -8px 0 0; font-size: 27px; }
.process-history .identity-history-context { margin: 18px 0 0; padding-bottom: 13px; border-bottom: 1px solid rgba(177,191,198,.15); }
.process-history .identity-history-body { padding: 0; height: 360px; max-height: calc(100vh - 248px - env(safe-area-inset-bottom)); }
.process-history .process-sheet-fields { padding: 21px 20px 12px; }
.process-history .identity-history-timeline { margin: 0 0 0 6px; padding-left: 22px; }
.process-history .identity-history-timeline::before { display: block; top: 25px; bottom: 35px; left: 0; width: 1px; background: #40525d; }
.process-history .identity-history-event { padding: 0 0 22px; }
.process-history .identity-history-event + .identity-history-event { padding-top: 22px; }
.process-history .identity-history-event:not(:last-child)::after { content: ''; position: absolute; right: 0; bottom: 0; left: 0; height: 1px; background: rgba(177,191,198,.15); }
.process-history .identity-history-event:last-child { padding-bottom: 0; }
.process-history .identity-history-dot { top: 22px; left: -25px; width: 7px; height: 7px; border-width: 1px; }
.process-history .identity-history-event + .identity-history-event .identity-history-dot { top: 44px; }
.process-history-art { display: block; width: 46px; height: 50px; object-fit: contain; flex-shrink: 0; }
.process-history .identity-history-record-heading, .process-history button.identity-history-toggle { min-height: 52px; gap: 10px; flex-wrap: nowrap; }
.process-history .identity-history-role-copy { flex: 1; min-width: 0; }
.process-history .identity-history-role { display: block; font-size: 18px; line-height: 1.45; }
.process-history .identity-history-badge { padding: 1px 5px; border: 1px solid rgba(177,191,198,.15); border-radius: 5px; background: rgba(177,191,198,.07); color: var(--muted); font-size: 10px; line-height: 1.7; white-space: nowrap; }
.process-history .identity-history-badge.is-current { color: var(--accent); background: rgba(229,198,139,.09); }
.process-history .identity-history-meta { margin: 3px 0 0; font-size: 12px; }
.process-history .identity-history-summary { margin-top: 10px; font-size: 12px; }
.process-history button.identity-history-toggle { padding: 0; margin: 0; }
.process-history .identity-history-chevron { width: 7px; height: 7px; margin: 0 3px; }
.process-history .identity-skill-history { margin-top: 9px; }
.process-history .identity-skill-record { display: flex; align-items: baseline; gap: 10px; margin: 0; padding: 7px 0; font-size: 14px; line-height: 1.6; }
.process-history .identity-skill-label { flex: 0 0 48px; white-space: nowrap; }
.process-history .identity-skill-value { display: flex; align-items: baseline; gap: 9px; flex: 1; min-width: 0; }
.process-history .identity-skill-round { font-size: 12px; white-space: nowrap; }
.process-history .identity-skill-separator { flex-shrink: 0; font-size: 12px; }
.process-history .identity-skill-text { min-width: 0; font-weight: 500; }
.process-history .identity-history-detail { margin-top: 7px; padding: 13px 14px 12px; border-radius: 12px; background: var(--control-bg, #14232c); }
.process-history .identity-history-faction { display: flex; align-items: center; gap: 6px; }
.process-history .identity-history-faction-dot { flex-shrink: 0; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
.process-history .identity-history-information { margin-top: 7px; font-size: 14px; line-height: 1.85; }
.process-history .identity-history-readonly { display: flex; align-items: center; gap: 5px; margin-top: 10px; font-size: 11px; }
.process-history .identity-history-readonly image { width: 12px; height: 12px; }
.process-history .identity-history-footer { padding: 13px 20px calc(18px + env(safe-area-inset-bottom)); border-top: 1px solid rgba(177,191,198,.15); }
.process-history .identity-history-footer button { gap: 9px; margin: 0; }
.process-history .identity-history-footer image { width: 19px; height: 19px; }
.process-sheet.has-measured-body .process-sheet-body { max-height: none; }

@media (max-width: 350px) {
  .process-sheet-top { padding-left: 14px; padding-right: 10px; }
  .process-sheet .table-sheet-title { font-size: 18px; }
  .process-sheet-fields, .process-sheet-footer, .process-skill .skill-footer { padding-left: 14px; padding-right: 14px; }
  .player-card-metrics { gap: 12px; }
  .player-card-score > text.is-long-score { font-size: 20px; }
  .player-card-rate > text:first-child { font-size: 34px; }
  .player-card-record-line { gap: 3px 7px; font-size: 12px; }
  .process-skill .skill-target-grid, .process-team-grid { gap: 6px; }
  .process-skill button.skill-option, .process-tool .process-team-grid button.tool-seat-option { min-height: 64px; }
  .process-history .process-sheet-top, .process-history .process-sheet-fields, .process-history .identity-history-footer { padding-left: 14px; padding-right: 14px; }
  .process-history .identity-history-role { font-size: 16px; }
  .process-history .identity-history-record-heading, .process-history button.identity-history-toggle { gap: 8px; }
  .process-history-art { width: 42px; }
  .process-inspection-result { padding: 20px 16px; gap: 14px; }
}
@media (max-height: 500px) and (orientation: landscape) {
  .process-sheet-top { padding-bottom: 6px; }
  .process-sheet .process-sheet-body { max-height: calc(100vh - 226px - env(safe-area-inset-bottom)); }
  .process-sheet.has-measured-body .process-sheet-body { max-height: none; }
  .process-sheet-footer { padding-top: 8px; padding-bottom: calc(8px + env(safe-area-inset-bottom)); }
}
@media (prefers-reduced-motion: reduce) {
  .process-sheet, .process-sheet button { animation: none; transition: none; }
}
