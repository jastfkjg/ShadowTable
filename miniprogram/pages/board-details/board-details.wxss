.board-detail-page {
  padding-top: 32rpx;
}
.detail-header {
  padding: 20rpx 8rpx 8rpx;
}
.detail-title {
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.4;
}
.detail-capacity {
  font-size: 26rpx;
  font-weight: 400;
  margin-left: 12rpx;
}
.detail-summary {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.7;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
}
.detail-section-title {
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
  margin: 48rpx 8rpx 20rpx;
}
.detail-line {
  padding: 18rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
  overflow-wrap: break-word;
}
.detail-line::before {
  content: "• ";
  color: var(--accent);
}
.detail-block {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-left: 6rpx solid var(--accent);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  overflow-wrap: break-word;
}
.role-list {
  margin-top: 4rpx;
}
.role-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}
.role-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.role-card-name {
  font-size: 32rpx;
  font-weight: 650;
  color: var(--accent);
  line-height: 1.4;
  min-width: 0;
  overflow-wrap: break-word;
}
.role-card-meta {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--muted);
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
}
.role-card-meta.tone-good {
  color: var(--good);
  border-color: var(--good);
}
.role-card-meta.tone-evil {
  color: var(--evil);
  border-color: var(--evil);
}
.role-card-meta.tone-third {
  color: var(--third);
  border-color: var(--third);
}
.role-card-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text);
  overflow-wrap: break-word;
}
.detail-none {
  margin: 20rpx 8rpx 0;
}
.settings-error {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #d89c92;
  border-radius: 16rpx;
  color: #f2b6ae;
}