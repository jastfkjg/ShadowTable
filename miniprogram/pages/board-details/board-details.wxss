.board-detail-page {
  padding-top: 32rpx;
}
.detail-header {
  padding: 20rpx 8rpx 8rpx;
}
.detail-title {
  font-size: 40rpx;
  font-weight: 650;
  line-height: 1.4;
}
.detail-capacity {
  font-size: 26rpx;
  font-weight: 400;
  margin-left: 12rpx;
}
.detail-summary {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.7;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
}
.detail-section-title {
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
  margin: 48rpx 8rpx 20rpx;
}
.detail-line {
  padding: 18rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
  overflow-wrap: break-word;
}
.detail-line::before {
  content: "• ";
  color: var(--accent);
}
.detail-block {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-left: 6rpx solid var(--accent);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  overflow-wrap: break-word;
}
.role-list {
  margin-top: 4rpx;
}
.role-card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}
.role-card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.role-card-name {
  font-size: 32rpx;
  font-weight: 650;
  color: var(--accent);
  line-height: 1.4;
  min-width: 0;
  overflow-wrap: break-word;
}
.role-card-meta {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--muted);
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
  white-space: nowrap;
}
.role-card-meta.tone-good {
  color: var(--good);
  border-color: var(--good);
}
.role-card-meta.tone-evil {
  color: var(--evil);
  border-color: var(--evil);
}
.role-card-meta.tone-third {
  color: var(--third);
  border-color: var(--third);
}
.role-card-text {
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--text);
  overflow-wrap: break-word;
}
.detail-none {
  margin: 20rpx 8rpx 0;
}
.settings-error {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #d89c92;
  border-radius: 16rpx;
  color: #f2b6ae;
}
.detail-sticky { position: sticky; top: 0; z-index: 10; background: var(--bg); border-bottom: 1rpx solid var(--border); }
.detail-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 32rpx; font-size: 30rpx; font-weight: 600; }
button.detail-close { margin: 0; min-height: 88rpx; padding: 12rpx 24rpx; font-size: 26rpx; background: var(--surface); color: var(--text); }
.detail-nav { white-space: nowrap; width: 100%; padding-bottom: 12rpx; }


.detail-header { padding: 0 0 8rpx; }
.detail-title { font-size: 40rpx; }
.detail-capacity { display: block; margin: 8rpx 0 0; }
.detail-summary { background: transparent; border: 0; border-left: 4rpx solid var(--accent); border-radius: 0; padding: 0 0 0 24rpx; line-height: 1.85; }
.detail-section-title { border-top: 1rpx solid var(--border); padding-top: 36rpx; margin: 40rpx 0 16rpx; font-size: 34rpx; }
.detail-section-number { color: var(--muted); font-size: 24rpx; font-weight: 400; margin-right: 16rpx; }
.detail-line, .detail-block { background: transparent; border: 0; border-radius: 0; padding: 0; margin-top: 20rpx; font-size: 30rpx; line-height: 1.85; }
.role-card { background: transparent; border: 0; border-bottom: 1rpx solid var(--border); border-radius: 0; padding: 24rpx 0; margin-top: 0; }
.role-card-name { color: var(--text); }
.role-card-text { font-size: 30rpx; line-height: 1.85; }

.board-detail-page { padding-top: 24rpx; }
.detail-title { font-size: 36rpx; }
.detail-summary { margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; }
.detail-section-title { padding-top: 24rpx; margin-top: 28rpx; margin-bottom: 8rpx; font-size: 30rpx; }
.role-card { padding: 12rpx 0; }
button.role-quick-toggle { display: flex; align-items: baseline; gap: 16rpx; width: 100%; margin: 0; min-height: 88rpx; padding: 8rpx 0; border-radius: 0; background: transparent; color: var(--text); text-align: left; font-weight: 400; }
.role-quick-name { flex: 0 0 168rpx; font-size: 28rpx; font-weight: 600; }
.role-card-name.tone-good, .role-quick-name.tone-good { color: #9ccaff; }
.role-card-name.tone-evil, .role-quick-name.tone-evil { color: var(--evil); }
.role-quick-brief { flex: 1; min-width: 0; font-size: 28rpx; line-height: 1.65; }
.role-quick-arrow { flex: 0 0 24rpx; color: var(--muted); }
.role-quick-detail { padding: 20rpx; background: var(--surface); border-radius: 12rpx; color: var(--muted); font-size: 28rpx; line-height: 1.75; }

/* Explicit sizing avoids the native mini-program button width defaults. */
button.detail-close { width: auto; flex: 0 0 auto; min-height: 88rpx; padding: 12rpx 0 12rpx 24rpx; background: transparent; border-radius: 0; color: var(--accent); font-weight: 400; }
.detail-toolbar { font-size: 26rpx; color: var(--muted); }
.detail-nav { padding-bottom: 0; }
.detail-nav-inner { display: inline-flex; align-items: center; padding: 0 32rpx; gap: 32rpx; }
.detail-nav-label { flex-shrink: 0; white-space: nowrap; color: var(--muted); font-size: 24rpx; }
.detail-nav-item { display: inline-flex; align-items: center; min-height: 88rpx; color: var(--text); font-size: 26rpx; white-space: nowrap; }
.detail-nav-arrow { margin-left: 8rpx; color: var(--accent); font-size: 22rpx; }
.detail-section-title { display: flex; align-items: baseline; border-top: 0; border-left: 6rpx solid var(--accent); border-radius: 0 12rpx 12rpx 0; background: var(--surface); padding: 20rpx; margin: 40rpx 0 16rpx; font-size: 34rpx; line-height: 1.5; font-weight: 650; color: var(--text); }
.detail-section-number { color: var(--accent); flex-shrink: 0; font-size: 26rpx; font-weight: 600; }
