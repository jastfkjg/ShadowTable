.detail-hero,
.detail-tabs,
.board-detail-content {
  box-sizing: border-box;
  max-width: 1000rpx;
  margin: 0 auto;
}
.detail-hero {
  padding: 24rpx 44rpx;
}
.detail-eyebrow {
  color: var(--accent);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.detail-title-line {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
}
.detail-title {
  min-width: 0;
  font-size: 52rpx;
  font-weight: 650;
  line-height: 1.4;
  overflow-wrap: break-word;
}
.detail-capacity {
  flex-shrink: 0;
  border: 1rpx solid #3c4b53;
  border-radius: 10rpx;
  padding: 2rpx 16rpx;
  color: var(--muted);
  font-size: 24rpx;
}
.detail-subtitle {
  color: var(--muted);
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.7;
}
.detail-tabs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  z-index: 20;
  padding: 0 44rpx;
  background: var(--bg);
  border-bottom: 1rpx solid #2b3d48;
}
.detail-tab-list {
  display: flex;
  gap: 48rpx;
  min-width: 0;
}
button.detail-tab {
  width: auto;
  margin: 0;
  min-height: 96rpx;
  padding: 0;
  border-radius: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--muted);
  position: relative;
}
button.detail-tab.selected {
  color: var(--accent);
  font-weight: 600;
}
.detail-tab.selected::before {
  content: "";
  position: absolute;
  bottom: -1rpx;
  left: 0;
  right: 0;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--accent);
}
button.detail-directory-button {
  width: auto;
  flex-shrink: 0;
  min-height: 96rpx;
  padding: 0 0 0 20rpx;
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--muted);
  margin: 0;
}
.detail-directory-button image,
.detail-search image {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}
.board-detail-content {
  padding: 32rpx 44rpx calc(64rpx + env(safe-area-inset-bottom));
}
.detail-search {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #14232d;
  border: 1rpx solid #3b505d;
  border-radius: 20rpx;
}
.detail-search input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--text);
  height: 80rpx;
}
.detail-search-placeholder {
  color: var(--muted);
}
button.detail-search-clear {
  width: 80rpx;
  min-height: 88rpx;
  padding: 0;
  margin: 0 -20rpx 0 0;
  font-size: 40rpx;
  color: var(--muted);
}
.detail-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding-bottom: 24rpx;
  margin: 20rpx 0 24rpx;
  border-bottom: 1rpx solid #2b3d48;
}
button.detail-filter {
  flex: 1;
  min-width: 160rpx;
  width: auto;
  min-height: 88rpx;
  padding: 12rpx 8rpx;
  margin: 0;
  border-radius: 14rpx;
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 400;
}
button.detail-filter.selected {
  color: #9ccaff;
  background: #273a46;
  font-weight: 600;
}
button.detail-filter.filter-evil.selected {
  color: var(--evil);
}
.detail-filters.searching {
  opacity: 0.65;
}
.detail-hint {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
  margin: 16rpx 0;
}
.detail-info-icon {
  width: 24rpx;
  height: 24rpx;
  line-height: 24rpx;
  border: 1rpx solid var(--accent);
  border-radius: 50%;
  text-align: center;
  color: var(--accent);
  font-size: 18rpx;
  flex-shrink: 0;
}
.detail-role {
  border-bottom: 1rpx solid #2b3d48;
}
button.detail-role-toggle {
  display: flex;
  align-items: center;
  width: 100%;
  text-align: left;
  gap: 24rpx;
  min-height: 152rpx;
  padding: 28rpx 0;
  border-radius: 0;
  font-weight: 400;
  margin: 0;
}
.detail-role-copy {
  flex: 1;
  min-width: 0;
}
.detail-role-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 4rpx 20rpx;
  margin-bottom: 8rpx;
}
.detail-role-name {
  font-weight: 600;
  font-size: 32rpx;
  line-height: 1.5;
  overflow-wrap: break-word;
}
.tone-good {
  color: #9ccaff;
}
.tone-evil {
  color: var(--evil);
}
.tone-third {
  color: var(--third);
}
.detail-role-type {
  color: var(--muted);
  font-size: 24rpx;
}
.detail-role-brief {
  color: #d0d8dc;
  font-size: 28rpx;
  line-height: 1.7;
  overflow-wrap: break-word;
}
.detail-chevron {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  border-right: 2rpx solid var(--muted);
  border-bottom: 2rpx solid var(--muted);
  transform: rotate(45deg);
  margin: -6rpx 6rpx 0 0;
  transition: transform 180ms ease;
}
.detail-chevron.up {
  transform: rotate(225deg);
  margin-top: 6rpx;
}
.detail-role.expanded {
  margin: 24rpx -24rpx 0;
  padding: 0 24rpx;
  border: 1rpx solid #38546a;
  border-radius: 22rpx;
  background: #172a36;
}
.detail-role.expanded .detail-role-toggle {
  min-height: 112rpx;
  padding-bottom: 16rpx;
}
.detail-role-body {
  padding-bottom: 32rpx;
  font-size: 28rpx;
  line-height: 1.8;
}
.detail-fact {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.detail-fact-label {
  flex: 0 0 56rpx;
  color: var(--muted);
  font-size: 26rpx;
}
.detail-fact-text {
  flex: 1;
  min-width: 0;
  color: #e0e5e8;
  overflow-wrap: break-word;
}
.detail-exception {
  padding: 20rpx 24rpx;
  background: #342d30;
  border-left: 4rpx solid #cfa196;
  border-radius: 0 12rpx 12rpx 0;
  color: #e4c9c4;
  font-size: 26rpx;
  line-height: 1.8;
}
.detail-exception-title {
  color: var(--evil);
  font-weight: 600;
  margin-bottom: 6rpx;
}
.detail-empty {
  padding: 48rpx 0;
  color: var(--muted);
  font-size: 28rpx;
  text-align: center;
}
.detail-rule-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: -12rpx 0 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}
button.detail-expand-all {
  width: auto;
  min-width: 128rpx;
  min-height: 88rpx;
  padding: 0;
  margin: 0;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--accent);
}
.detail-chapter {
  border-bottom: 1rpx solid #2b3d48;
}
button.detail-chapter-toggle {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  text-align: left;
  gap: 24rpx;
  min-height: 112rpx;
  padding: 20rpx 0;
  border-radius: 0;
  margin: 0;
}
.detail-chapter-number {
  color: var(--accent);
  font-size: 24rpx;
  letter-spacing: 2rpx;
  font-weight: 400;
  flex-shrink: 0;
}
.detail-chapter-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
}
.detail-chapter-body {
  padding-bottom: 24rpx;
}
.detail-paragraph {
  margin-bottom: 24rpx;
  color: #d0d8dc;
  font-size: 28rpx;
  line-height: 1.85;
  overflow-wrap: break-word;
}
.detail-paragraph:last-child {
  margin-bottom: 0;
}
.detail-deck {
  margin-bottom: 28rpx;
}
.detail-deck:last-child {
  margin-bottom: 8rpx;
}
.detail-deck-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 16rpx;
  margin-bottom: 12rpx;
}
.detail-deck-name {
  font-size: 28rpx;
  font-weight: 600;
}
.detail-deck-purpose {
  font-size: 24rpx;
  color: var(--muted);
}
.detail-deck-count {
  margin-left: auto;
  color: var(--muted);
  font-size: 24rpx;
}
.detail-deck-faction {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
  color: #c4d1d9;
  font-size: 26rpx;
  line-height: 1.85;
}
.detail-deck-faction > text:first-child {
  flex-shrink: 0;
}
.detail-deck-faction > text:last-child {
  min-width: 0;
}
.detail-layer-hint {
  margin: 12rpx 0;
  color: var(--muted);
  font-size: 24rpx;
}
.detail-layers {
  display: flex;
  gap: 20rpx;
}
.detail-layer {
  flex: 1;
  min-width: 0;
  border-top: 4rpx solid #52758b;
  padding-top: 12rpx;
  font-size: 24rpx;
  color: #d0d8dc;
}
.detail-layer > view {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 4rpx;
}
.detail-deck-note {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.8;
}
.detail-configuration {
  margin-bottom: 24rpx;
  color: #c4d1d9;
  font-size: 28rpx;
  line-height: 1.85;
}
.detail-configuration-heading {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}
.detail-configuration-heading > text:last-child {
  color: var(--muted);
  font-size: 24rpx;
}
.settings-error {
  color: var(--evil);
  margin-bottom: 24rpx;
}
.directory-backdrop {
  position: fixed;
  inset: 0;
  z-index: 110;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: flex-end;
}
.directory-panel {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 44rpx calc(24rpx + env(safe-area-inset-bottom));
}
.directory-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 34rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #2b3d48;
}
.directory-count {
  margin-left: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 400;
}
button.directory-close {
  width: auto;
  min-height: 96rpx;
  padding: 12rpx 0 12rpx 24rpx;
  margin: 0;
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 400;
}
.directory-list {
  max-height: 65vh;
}
.directory-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 104rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid #2b3d48;
  font-size: 28rpx;
}
@media (prefers-reduced-motion: reduce) {
  .detail-chevron {
    transition: none;
  }
}
@media (max-width: 360px) {
  .detail-hero,
  .detail-tabs,
  .board-detail-content {
    padding-left: 36rpx;
    padding-right: 36rpx;
  }
  .detail-tab-list {
    gap: 36rpx;
  }
}
