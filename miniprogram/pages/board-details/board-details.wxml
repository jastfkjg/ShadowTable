<app-nav title="板子详情" back="{{true}}" backLabel="返回" bindback="back" />
<view wx:if="{{loading || error}}" class="page board-detail-status">
  <view wx:if="{{loading}}" class="muted" role="status">正在加载板子详情…</view>
  <block wx:if="{{error}}"><view class="settings-error" role="alert">{{error}}</view><button hover-class="none" class="secondary" bindtap="retry">重新加载</button><button hover-class="none" class="text-button" bindtap="back">返回</button></block>
</view>
<block wx:if="{{!loading && !error && board}}">
  <view class="detail-hero">
    <view class="detail-eyebrow">{{board.eyebrow}}</view>
    <view class="detail-title-line"><view class="detail-title">{{board.title}}</view><text wx:if="{{board.capacity}}" class="detail-capacity">{{board.capacity}} 人</text></view>
    <view wx:if="{{board.subtitle}}" class="detail-subtitle">{{board.subtitle}}</view>
    <view wx:elif="{{board.summary}}" class="detail-subtitle">{{board.summary}}</view>
  </view>
  <view class="detail-tabs" style="top: {{navTop}}px;">
    <view class="detail-tab-list" role="tablist" aria-label="详情内容">
      <button hover-class="none" wx:if="{{board.hasRoles}}" class="detail-tab {{tab === 'roles' ? 'selected' : ''}}" role="tab" aria-selected="{{tab === 'roles'}}" aria-controls="detail-role-panel" data-tab="roles" bindtap="setTab">角色速查</button>
      <button hover-class="none" class="detail-tab {{tab === 'rules' ? 'selected' : ''}}" role="tab" aria-selected="{{tab === 'rules'}}" aria-controls="detail-rule-panel" data-tab="rules" bindtap="setTab">玩法规则</button>
    </view>
    <button hover-class="none" wx:if="{{chapters.length}}" class="disclosure-button detail-directory-button" bindtap="toggleDirectory" aria-expanded="{{directoryExpanded}}" aria-label="打开章节目录"><image src="/assets/board-directory.svg" aria-hidden="true" /><text>目录</text></button>
  </view>
  <view class="board-detail-content">
    <view wx:if="{{tab === 'roles'}}" id="detail-role-panel" role="tabpanel" aria-label="角色速查">
      <view class="detail-search"><image src="/assets/board-search.svg" aria-hidden="true" /><input value="{{query}}" bindinput="searchRoles" placeholder="搜索角色或技能" placeholder-class="detail-search-placeholder" aria-label="搜索角色或技能" confirm-type="search" /><button hover-class="none" wx:if="{{query}}" class="detail-search-clear" bindtap="clearSearch" aria-label="清空搜索">×</button></view>
      <view wx:if="{{board.groups.length > 1}}" class="detail-filters {{query ? 'searching' : ''}}"><button hover-class="none" wx:for="{{board.groups}}" wx:key="id" class="detail-filter {{selectedGroup === item.id ? 'selected' : ''}} {{item.id === 'b-evil' ? 'filter-evil' : ''}}" data-group="{{item.id}}" bindtap="selectGroup" aria-pressed="{{selectedGroup === item.id}}">{{item.label}}</button></view>
      <view class="detail-hint"><text class="detail-info-icon" aria-hidden="true">i</text><text>{{query ? '搜索当前板子的全部角色与技能' : board.roleHint}}</text></view>
      <view class="detail-role-list">
        <view wx:for="{{visibleRoles}}" wx:key="id" wx:for-item="role" class="detail-role {{role.expanded ? 'expanded' : ''}}">
          <button hover-class="none" class="disclosure-button detail-role-toggle" data-id="{{role.id}}" bindtap="toggleRole" aria-expanded="{{role.expanded}}" aria-controls="{{'role-body-' + role.id}}"><image class="detail-role-art" src="{{role.portrait}}" mode="aspectFit" aria-hidden="true" /><view class="detail-role-copy"><view class="detail-role-heading"><text class="detail-role-name tone-{{role.tone}}">{{role.name}}</text><text class="detail-role-type">{{role.showGroup ? role.groupLabel : role.type}}</text></view><view wx:if="{{!role.expanded}}" class="detail-role-brief">{{role.brief}}</view></view><view class="detail-chevron {{role.expanded ? 'up' : ''}}" aria-hidden="true" /></button>
          <view wx:if="{{role.expanded}}" id="{{'role-body-' + role.id}}" class="detail-role-body"><view wx:for="{{role.facts}}" wx:key="text" wx:for-item="fact" class="detail-fact"><text class="detail-fact-label">{{fact.label}}</text><text class="detail-fact-text">{{fact.text}}</text></view><view wx:if="{{role.exception}}" class="detail-exception"><view class="detail-exception-title">{{role.exceptionTitle}}</view><view>{{role.exception}}</view></view></view>
        </view>
      </view>
      <view wx:if="{{!visibleRoles.length}}" class="detail-empty" role="status">未找到匹配角色，请换个关键词。</view>
    </view>
    <view wx:if="{{tab === 'rules'}}" id="detail-rule-panel" role="tabpanel" aria-label="玩法规则">
      <view wx:if="{{chapters.length}}" class="detail-rule-intro"><text>共 {{chapters.length}} 章 · 按需展开阅读</text><button hover-class="none" class="detail-expand-all" bindtap="toggleAll">{{allExpanded ? '收起全部' : '展开全部'}}</button></view>
      <view wx:for="{{chapters}}" wx:key="id" wx:for-item="chapter" wx:for-index="chapterIndex" id="detail-section-{{chapterIndex}}" class="detail-chapter {{chapter.expanded ? 'expanded' : ''}}">
        <button hover-class="none" class="disclosure-button detail-chapter-toggle" data-index="{{chapterIndex}}" bindtap="toggleChapter" aria-expanded="{{chapter.expanded}}" aria-controls="{{'chapter-body-' + chapterIndex}}"><text class="detail-chapter-number">{{chapter.number}}</text><text class="detail-chapter-title">{{chapter.displayTitle}}</text><view class="detail-chevron {{chapter.expanded ? 'up' : ''}}" aria-hidden="true" /></button>
        <view wx:if="{{chapter.expanded}}" id="chapter-body-{{chapterIndex}}" class="detail-chapter-body">
          <block wx:if="{{chapter.decks}}"><view wx:for="{{chapter.decks}}" wx:key="name" wx:for-item="deck" class="detail-deck"><view class="detail-deck-heading"><text class="detail-deck-name">{{deck.name}}</text><text class="detail-deck-purpose">{{deck.purpose}} · {{deck.count}} 张</text><view class="detail-deck-count"><text class="tone-good">{{deck.good}} 蓝</text><text> / </text><text class="tone-evil">{{deck.evil}} 红</text></view></view><view wx:for="{{deck.factions}}" wx:key="label" wx:for-item="faction" class="detail-deck-faction"><text class="tone-{{faction.tone}}">{{faction.label}}</text><text>{{faction.roles}}</text></view><block wx:if="{{deck.layers}}"><view class="detail-layer-hint">{{deck.layerHint}}</view><view class="detail-layers"><view wx:for="{{deck.layers}}" wx:key="label" wx:for-item="layer" class="detail-layer"><view>{{layer.label}}</view><text>{{layer.text}}</text><view class="detail-layer-cards" aria-hidden="true"><view wx:for="{{layer.cards}}" wx:for-item="card" wx:key="id" class="detail-mini-card card-{{card.tone}}" /></view></view></view></block><view wx:if="{{deck.note}}" class="detail-deck-note">{{deck.note}}</view></view></block>
          <block wx:elif="{{chapter.kind === 'configuration'}}"><view wx:for="{{chapter.configuration}}" wx:key="faction" class="detail-configuration"><view class="detail-configuration-heading"><text class="tone-{{item.faction}}">{{item.label}}</text><text>{{item.count}} 人</text></view><view class="detail-configuration-members"><view wx:for="{{item.members}}" wx:key="name" wx:for-item="member" class="detail-configuration-member"><image src="{{member.portrait}}" mode="aspectFit" aria-hidden="true" /><view><text>{{member.name}}</text><text wx:if="{{member.count > 1}}" class="detail-role-count">×{{member.count}}</text></view></view></view></view></block>
          <block wx:else><view wx:for="{{chapter.items}}" wx:key="*this" class="detail-paragraph">{{item}}</view></block>
        </view>
      </view>
      <view wx:if="{{!board.hasDetail}}" class="detail-empty">本板子暂无详细说明，以上为角色配置。</view>
    </view>
  </view>
</block>
<view wx:if="{{directoryExpanded}}" class="directory-backdrop" catchtap="closeDirectory" catchtouchmove="blockScroll"><view class="directory-panel" style="max-height: calc(100vh - {{navTop}}px - 16px);" catchtap="blockScroll" role="dialog" aria-modal="true" aria-label="章节目录"><view class="directory-handle" aria-hidden="true" /><view class="directory-header"><view class="directory-symbol"><image src="/assets/sheet-book.svg" aria-hidden="true" /></view><view class="directory-heading"><view>章节目录</view><view class="directory-count">{{board.title}} · 共 {{chapters.length}} 章</view></view><button hover-class="none" class="directory-close" bindtap="closeDirectory" aria-label="关闭章节目录">×</button></view><scroll-view scroll-y class="directory-list" style="height: {{chapters.length * 65}}px;" enhanced show-scrollbar="{{true}}"><view wx:for="{{chapters}}" wx:key="id" class="directory-item {{currentChapter === index ? 'selected' : ''}}" bindtap="jumpSection" data-index="{{index}}" role="link" aria-label="{{'跳转到第'+(index+1)+'章，'+item.displayTitle}}"><text class="detail-chapter-number">{{item.number}}</text><text class="directory-item-title">{{item.displayTitle}}</text><text wx:if="{{currentChapter === index}}" class="directory-current" aria-hidden="true">✓</text><view wx:else class="directory-arrow" aria-hidden="true" /></view></scroll-view><view class="directory-footnote">点击章节，即可跳转阅读</view></view></view>
<app-dialog id="app-dialog" />
