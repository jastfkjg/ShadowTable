<view class="detail-sticky">
  <view class="detail-toolbar"><text>板子详情</text><button class="detail-close" bindtap="back">返回</button></view>
  <view wx:if="{{hasDetail}}" class="detail-nav">
    <view class="detail-nav-heading" bindtap="toggleDirectory" role="button" aria-expanded="{{directoryExpanded}}"><text>章节目录</text><text class="detail-nav-state">查看全部 ›</text></view>
  </view>
</view>
<view wx:if="{{directoryExpanded}}" class="directory-backdrop" catchtap="closeDirectory" catchtouchmove="blockScroll">
  <view class="directory-panel" catchtap="blockScroll" role="dialog" aria-modal="true" aria-label="章节目录">
    <view class="directory-header"><view>章节目录 <text class="small muted">共 {{sections.length}} 章</text></view><button class="directory-close" bindtap="closeDirectory" aria-label="关闭章节目录">关闭</button></view>
    <scroll-view scroll-y class="directory-list" style="height: {{sections.length * 92}}rpx;" enhanced show-scrollbar="{{true}}">
      <view wx:for="{{sections}}" wx:key="title" class="directory-item" bindtap="jumpSection" data-index="{{index}}" role="link" aria-label="{{'跳转到第'+(index+1)+'章，'+item.title}}"><text class="detail-nav-number">{{index+1}}.</text><text>{{item.navTitle || item.title}}</text></view>
    </scroll-view>
  </view>
</view>
<view class="page board-detail-page">
  <view wx:if="{{loading}}" class="muted">正在加载板子详情…</view>
  <view wx:if="{{error}}" class="settings-error" role="alert">{{error}}</view>
  <block wx:if="{{error}}">
    <button class="secondary" bindtap="retry">重新加载</button>
    <button class="text-button" bindtap="back">返回</button>
  </block>
  <block wx:if="{{!loading && !error}}">
    <view class="detail-header">
      <view class="detail-title">{{title}} <text wx:if="{{!titleHasCapacity}}" class="detail-capacity muted">{{capacity}}人</text></view>
      <view wx:if="{{summary}}" class="detail-summary">{{summary}}</view>
    </view>
    <block wx:if="{{hasDetail}}">
      <block wx:for="{{sections}}" wx:key="title" wx:for-item="sec" wx:for-index="secIndex">
        <view id="detail-section-{{secIndex}}" class="detail-section-title"><text class="detail-section-number">{{secIndex+1}}.</text>{{sec.title}}</view>
        <block wx:if="{{sec.kind === 'roles'}}">
          <view class="role-list">
            <view wx:for="{{sec.items}}" wx:key="name" wx:for-item="role" class="role-card">
              <block wx:if="{{role.brief}}">
                <button class="role-quick-toggle" bindtap="toggleRole" data-section="{{secIndex}}" data-role="{{index}}" aria-expanded="{{role.expanded || false}}">
                  <text class="role-quick-name tone-{{role.tone}}">{{role.name}}</text><text class="role-quick-brief">{{role.brief}}</text><text class="role-quick-arrow">{{role.expanded?'−':'+'}}</text>
                </button>
                <view wx:if="{{role.expanded}}" class="role-quick-detail">{{role.text}}</view>
              </block>
              <block wx:else>
              <view class="role-card-heading">
                <text class="role-card-name tone-{{role.tone}}">{{role.name}}</text>
              </view>
              <view class="role-card-text">{{role.text}}</view>
              </block>
            </view>
          </view>
        </block>
        <block wx:elif="{{sec.kind === 'blocks'}}">
          <view wx:for="{{sec.items}}" wx:key="*this" wx:for-item="blk" class="detail-block">{{blk}}</view>
        </block>
        <block wx:else>
          <view wx:for="{{sec.items}}" wx:key="*this" wx:for-item="line" class="detail-line">{{line}}</view>
        </block>
      </block>
    </block>
    <block wx:else>
      <view wx:for="{{roleConfiguration}}" wx:key="faction" class="detail-line">{{item.label}}：{{item.roles}}</view>
      <view class="muted small detail-none">本板子暂无详细说明，以上为角色配置。</view>
    </block>
    <button class="primary" bindtap="back">返回</button>
  </block>
</view>