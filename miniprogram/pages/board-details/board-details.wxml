<view class="page board-detail-page">
  <view wx:if="{{loading}}" class="muted">正在加载板子详情…</view>
  <view wx:if="{{error}}" class="settings-error" role="alert">{{error}}</view>
  <block wx:if="{{error}}">
    <button class="secondary" bindtap="retry">重新加载</button>
    <button class="text-button" bindtap="back">返回牌桌</button>
  </block>
  <block wx:if="{{!loading && !error}}">
    <view class="detail-header">
      <view class="detail-title">{{title}} <text class="detail-capacity muted">{{capacity}}人</text></view>
      <view wx:if="{{summary}}" class="detail-summary">{{summary}}</view>
    </view>
    <block wx:if="{{hasDetail}}">
      <block wx:for="{{sections}}" wx:key="title" wx:for-item="sec">
        <view class="detail-section-title">{{sec.title}}</view>
        <block wx:if="{{sec.kind === 'roles'}}">
          <view class="role-list">
            <view wx:for="{{sec.items}}" wx:key="name" wx:for-item="role" class="role-card">
              <view class="role-card-heading">
                <text class="role-card-name">{{role.name}}</text>
                <text wx:if="{{role.meta}}" class="role-card-meta tone-{{role.tone}}">{{role.meta}}</text>
              </view>
              <view class="role-card-text">{{role.text}}</view>
            </view>
          </view>
        </block>
        <block wx:elif="{{sec.kind === 'blocks'}}">
          <view wx:for="{{sec.items}}" wx:key="*this" wx:for-item="blk" class="detail-block">{{blk}}</view>
        </block>
        <block wx:else>
          <view wx:for="{{sec.items}}" wx:key="*this" wx:for-item="line" class="detail-line">{{line}}</view>
        </block>
      </block>
    </block>
    <block wx:else>
      <view wx:for="{{roleConfiguration}}" wx:key="faction" class="detail-line">{{item.label}}：{{item.roles}}</view>
      <view class="muted small detail-none">本板子暂无详细说明，以上为角色配置。</view>
    </block>
    <button class="primary" bindtap="back">返回牌桌</button>
  </block>
</view>