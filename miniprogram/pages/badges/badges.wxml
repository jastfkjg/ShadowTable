<import src="../../loading-placeholder.wxml" />
<app-nav title="荣誉徽章" back="{{true}}" backLabel="返回我的" bindback="back" />
<view class="page badge-page">
  <view class="badge-period-row">
    <text class="badge-period">{{badgeCollection ? badgeCollection.monthLabel : '本月荣誉'}}</text>
    <button class="badge-rules" bindtap="showBadgeRules" aria-label="荣誉徽章规则" hover-class="badge-pressed">
      <image class="badge-info-icon" src="/assets/record-info.svg" aria-hidden="true" />
    </button>
  </view>
  <view class="badge-title">我的徽章</view>
  <template wx:if="{{badgeManagerLoading && !badgeCollection}}" is="loadingPlaceholder" data="{{kind:'metrics'}}" />
  <view wx:if="{{badgeManagerError && !connectionVisible}}" class="inline-error" role="alert"><text>{{badgeManagerError}}</text><button class="secondary" bindtap="loadBadgeManager" disabled="{{badgeManagerLoading || badgeManagerSaving}}" hover-class="badge-pressed">刷新徽章</button></view>
  <block wx:if="{{badgeCollection}}">
    <view class="badge-equipment">
      <view class="badge-section-heading">
        <view><text>名片佩戴</text><text class="badge-equipped-count">{{badgeCollection.equippedCount}} / {{badgeCollection.maxEquipped}}</text></view>
        <button class="disclosure-button badge-manage" bindtap="manageBadges" disabled="{{badgeManagerSaving || badgeManagerLoading || !badgeCollection.ownedCount}}" aria-expanded="{{badgeManaging}}" hover-class="none">
          <text>{{badgeManaging ? '完成' : '调整佩戴'}}</text>
          <view wx:if="{{!badgeManaging}}" class="badge-chevron" aria-hidden="true"></view>
        </button>
      </view>
      <view class="badge-slots">
        <view wx:for="{{badgeCollection.slots}}" wx:key="id" class="badge-slot {{badgePlaced.id === item.id ? 'is-updated' : ''}}">
          <block wx:if="{{!item.empty}}">
            <button class="badge-slot-open" bindtap="showBadgeDetail" data-id="{{item.id}}" aria-label="{{'查看'+item.title}}" hover-class="badge-pressed">
              <view class="badge-slot-medallion"><image class="badge-slot-image {{item.permanent ? 'badge-art-permanent' : ''}}" src="{{item.imageUrl}}" mode="aspectFit" aria-hidden="true" /></view>
              <text class="badge-slot-title">{{item.title}}</text>
            </button>
            <button wx:if="{{badgeManaging}}" class="badge-remove" bindtap="toggleOwnedBadge" data-id="{{item.id}}" disabled="{{badgeManagerSaving || badgeManagerLoading}}" aria-label="{{'摘下'+item.title}}" hover-class="badge-pressed">摘下</button>
          </block>
          <button wx:else class="badge-slot-open badge-slot-empty" bindtap="openBadgePicker" data-slot="{{item.slotIndex}}" aria-label="{{'选择徽章佩戴到第'+(item.slotIndex+1)+'个位置'}}" hover-class="badge-pressed">
            <view class="badge-empty-ring" aria-hidden="true">＋</view><text class="badge-slot-title">待佩戴</text>
          </button>
        </view>
      </view>
      <view wx:if="{{badgePlaced}}" class="badge-caption badge-equipment-note is-updated" role="status" aria-live="polite">
        <view class="badge-check" aria-hidden="true"></view><text>{{badgePlaced.title}}已佩戴到名片位置 {{badgePlaced.slotIndex + 1}}</text>
      </view>
      <view wx:else class="badge-caption badge-equipment-note">{{badgeManaging ? '摘下后可选择空位佩戴，调整展示顺序' : '徽章会展示在玩家名片上'}}</view>
    </view>
    <view class="badge-collection-heading">
      <text class="badge-collection-title">徽章收藏</text>
      <text class="badge-collection-total">已拥有 {{badgeCollection.ownedCount}} / {{badgeCollection.totalCount}}</text>
    </view>
    <view class="badge-filters" aria-label="筛选徽章">
      <button class="{{badgeFilter==='all'?'selected':''}}" bindtap="chooseBadgeFilter" data-id="all" aria-pressed="{{badgeFilter==='all'}}" hover-class="badge-pressed">全部<text>{{badgeCollection.totalCount}}</text></button>
      <button class="{{badgeFilter==='owned'?'selected':''}}" bindtap="chooseBadgeFilter" data-id="owned" aria-pressed="{{badgeFilter==='owned'}}" hover-class="badge-pressed">已拥有<text>{{badgeCollection.ownedCount}}</text></button>
      <button class="{{badgeFilter==='unowned'?'selected':''}}" bindtap="chooseBadgeFilter" data-id="unowned" aria-pressed="{{badgeFilter==='unowned'}}" hover-class="badge-pressed">未拥有<text>{{badgeCollection.unownedCount}}</text></button>
    </view>
    <view wx:if="{{!badgeCollection.visibleBadges.length}}" class="badge-empty-message">{{badgeFilter==='owned'?'暂无已拥有的徽章，点开徽章可查看获取条件。':'已拥有全部徽章。'}}</view>
    <view class="badge-grid">
      <button wx:for="{{badgeCollection.visibleBadges}}" wx:key="id" class="badge-tile {{item.owned?'is-owned':'is-locked'}}" bindtap="showBadgeDetail" data-id="{{item.id}}" aria-label="{{item.title+'，'+item.kindLabel+'徽章，'+item.status+'，查看详情'}}" hover-class="badge-pressed">
        <view class="badge-tile-meta">
          <text>{{item.kindLabel}}</text>
          <view class="badge-tile-status">
            <view wx:if="{{!item.owned}}" class="badge-lock" aria-hidden="true"></view>
            <view wx:if="{{item.equipped}}" class="badge-check" aria-hidden="true"></view>
            <text>{{item.status}}</text>
          </view>
        </view>
        <image class="badge-tile-image {{item.permanent ? 'badge-art-permanent' : ''}}" src="{{item.imageUrl}}" mode="aspectFit" aria-hidden="true" />
        <view class="badge-tile-copy">
          <view class="badge-tile-title">{{item.title}}</view>
          <view class="badge-caption">{{item.condition}}</view>
        </view>
      </button>
    </view>
    <view class="badge-caption badge-footer">点击徽章，查看详情与获取条件</view>
  </block>
</view>
<view wx:if="{{selectedBadge && !badgePicker}}" class="badge-backdrop" bindtap="closeBadgeDetail" catchtouchmove="blockScroll">
  <view class="badge-detail" role="dialog" aria-modal="true" aria-label="{{selectedBadge.title}}" catchtap="blockScroll">
    <scroll-view scroll-y="{{true}}" class="badge-detail-scroll" style="{{badgeDetailHeight ? 'height:'+badgeDetailHeight+'px' : ''}}">
      <view class="badge-detail-content badge-detail-compact">
        <view class="badge-detail-handle" aria-hidden="true"></view>
        <button class="badge-detail-close" bindtap="closeBadgeDetail" aria-label="关闭徽章详情" disabled="{{badgeManagerSaving}}" hover-class="badge-pressed"><text aria-hidden="true">×</text></button>
        <view class="badge-detail-art"><image class="badge-detail-image {{!selectedBadge.owned?'is-locked':''}} {{selectedBadge.permanent ? 'badge-art-permanent' : ''}}" src="{{selectedBadge.imageUrl}}" mode="aspectFit" aria-hidden="true" /></view>
        <view class="badge-detail-title">{{selectedBadge.title}}</view>
        <view class="badge-detail-meta">
          <text>{{selectedBadge.periodLabel || badgeCollection.monthLabel}} · {{selectedBadge.kindLabel}}</text>
          <text class="badge-detail-status {{selectedBadge.owned ? 'is-owned' : ''}}">{{selectedBadge.status}}</text>
        </view>
        <view class="badge-detail-criteria">
          <view class="badge-caption">获取条件</view>
          <view class="badge-detail-condition">{{selectedBadge.detailCondition}}</view>
          <view wx:if="{{selectedBadge.detailNote}}" class="badge-caption">{{selectedBadge.detailNote}}</view>
          <view class="badge-caption">{{selectedBadge.holdingRule}}</view>
        </view>
        <button wx:if="{{selectedBadge.owned && !selectedBadge.equipped && badgeCollection.equippedCount >= badgeCollection.maxEquipped}}" class="primary badge-detail-action" bindtap="openBadgeReplacement" disabled="{{badgeManagerSaving || badgeManagerLoading}}" hover-class="badge-pressed">替换佩戴</button>
        <button wx:elif="{{selectedBadge.owned}}" class="{{selectedBadge.equipped?'secondary':'primary'}} badge-detail-action" bindtap="toggleOwnedBadge" data-id="{{selectedBadge.id}}" disabled="{{badgeManagerSaving || badgeManagerLoading}}" loading="{{badgeManagerSaving}}" hover-class="badge-pressed">{{selectedBadge.equipped?'摘下徽章':'佩戴徽章'}}</button>
        <button wx:else class="secondary badge-detail-action" bindtap="closeBadgeDetail" hover-class="badge-pressed">知道了</button>
      </view>
    </scroll-view>
  </view>
</view>
<view wx:if="{{badgePicker}}" class="badge-backdrop" bindtap="closeBadgePicker" catchtouchmove="blockScroll">
  <view class="badge-detail badge-picker-sheet" role="dialog" aria-modal="true" aria-label="{{badgePicker === 'add' ? '选择徽章' : '替换佩戴'}}" catchtap="blockScroll">
    <view class="badge-picker-header">
      <view class="badge-detail-handle" aria-hidden="true"></view>
      <view wx:if="{{badgePicker === 'add'}}" class="badge-picker-position">名片位置 {{badgePickerSlot + 1}}</view>
      <button wx:else class="badge-detail-back" bindtap="closeBadgePicker" aria-label="返回徽章详情" disabled="{{badgeManagerSaving}}" hover-class="badge-pressed"><view class="badge-chevron" aria-hidden="true"></view>详情</button>
      <button class="badge-detail-close" bindtap="closeBadgeDetail" aria-label="关闭" disabled="{{badgeManagerSaving}}" hover-class="badge-pressed"><text aria-hidden="true">×</text></button>
      <view class="badge-picker-heading">{{badgePicker === 'add' ? '选择徽章' : '替换佩戴'}}</view>
      <view wx:if="{{badgePicker === 'replace'}}" class="badge-picker-hint">选择要换下的名片徽章</view>
    </view>
    <scroll-view scroll-y="{{true}}" enhanced show-scrollbar="{{false}}" class="badge-picker-body" style="{{badgePickerHeight ? 'height:' + badgePickerHeight + 'px' : ''}}">
      <view class="badge-picker-content">
        <view wx:if="{{badgePicker === 'add' && !badgeCollection.availableBadges.length}}" class="badge-empty-message">暂无可佩戴的徽章</view>
        <view wx:else class="badge-picker-grid" role="group" aria-label="{{badgePicker === 'add' ? '可佩戴的徽章' : '已佩戴的徽章'}}">
          <block wx:for="{{badgePicker === 'add' ? badgeCollection.availableBadges : badgeCollection.slots}}" wx:key="id">
            <button wx:if="{{!item.empty}}" class="badge-picker-item {{badgePickerChoice.id === item.id ? 'is-selected' : ''}}" bindtap="chooseBadgePickerItem" data-id="{{item.id}}" aria-pressed="{{badgePickerChoice.id === item.id}}" disabled="{{badgeManagerSaving || badgeManagerLoading}}" hover-class="badge-pressed">
              <text wx:if="{{badgePicker === 'replace'}}" class="badge-picker-slot">位置 {{item.slotIndex + 1}}</text>
              <view wx:if="{{badgePickerChoice.id === item.id}}" class="badge-picker-mark" aria-hidden="true"><view class="badge-check"></view></view>
              <image class="badge-picker-art {{item.permanent ? 'badge-art-permanent' : ''}}" src="{{item.imageUrl}}" mode="aspectFit" aria-hidden="true" />
              <text class="badge-picker-title">{{item.title}}</text>
              <text class="badge-picker-label">{{badgePicker === 'add' ? (item.permanent ? '永久纪念' : '月榜') : (badgePickerChoice.id === item.id ? '将换下' : '已佩戴')}}</text>
            </button>
          </block>
        </view>
        <view wx:if="{{badgePicker === 'replace'}}" class="badge-swap" role="status" aria-live="polite">
          <view class="badge-swap-item">
            <image wx:if="{{badgePickerChoice}}" class="{{badgePickerChoice.permanent ? 'badge-art-permanent' : ''}}" src="{{badgePickerChoice.imageUrl}}" mode="aspectFit" aria-hidden="true" />
            <view wx:else class="badge-swap-empty" aria-hidden="true"></view>
            <view class="badge-swap-copy"><text class="badge-caption">换下</text><text class="badge-swap-name">{{badgePickerChoice ? badgePickerChoice.title : '待选择'}}</text></view>
          </view>
          <view class="badge-swap-arrow" aria-hidden="true"></view>
          <view class="badge-swap-item badge-swap-incoming">
            <image class="{{selectedBadge.permanent ? 'badge-art-permanent' : ''}}" src="{{selectedBadge.imageUrl}}" mode="aspectFit" aria-hidden="true" />
            <view class="badge-swap-copy"><text class="badge-caption">换上</text><text class="badge-swap-name">{{selectedBadge.title}}</text></view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="badge-picker-footer">
      <button wx:if="{{badgePicker === 'replace' || badgeCollection.availableBadges.length}}" class="primary badge-detail-action" bindtap="confirmBadgePicker" disabled="{{!badgePickerChoice || badgeManagerSaving || badgeManagerLoading}}" loading="{{badgeManagerSaving}}" hover-class="badge-pressed">{{badgeManagerSaving ? '正在保存…' : badgePicker === 'add' ? (badgePickerChoice ? '佩戴' + badgePickerChoice.title : '确认佩戴') : (badgePickerChoice ? '确认替换 · 位置 ' + (badgePickerChoice.slotIndex + 1) : '确认替换')}}</button>
    </view>
  </view>
</view>
<app-dialog id="app-dialog" />
