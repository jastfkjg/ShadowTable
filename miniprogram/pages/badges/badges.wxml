<app-nav title="荣誉徽章" back="{{true}}" backLabel="返回我的" bindback="back" />
<view class="page badge-page">
  <view class="badge-period-row"><text class="badge-caption">{{badgeCollection ? badgeCollection.monthLabel : '本月荣誉'}}</text><button class="badge-rules" bindtap="showBadgeRules" hover-class="badge-pressed">规则</button></view>
  <view class="badge-hero"><view><view class="badge-title">本月荣誉</view><view class="badge-caption">榜首荣誉，每月更新。</view></view><view class="badge-total"><view class="badge-total-value">{{badgeCollection ? badgeCollection.ownedCount : '—'}}<text> / {{badgeCollection ? badgeCollection.totalCount : badgeTotalCount}}</text></view><text class="badge-caption">已拥有</text></view></view>
  <view wx:if="{{badgeManagerLoading}}" class="status" role="status">正在读取徽章…</view>
  <view wx:if="{{badgeManagerError}}" class="inline-error" role="alert"><text>{{badgeManagerError}}</text><button class="secondary" bindtap="loadBadgeManager" disabled="{{badgeManagerLoading || badgeManagerSaving}}" hover-class="badge-pressed">刷新徽章</button></view>
  <block wx:if="{{badgeCollection}}">
    <view class="badge-equipment"><view class="badge-section-heading"><text>当前佩戴</text><text>{{badgeCollection.equippedCount}}/3</text></view>
      <view class="badge-slots"><view wx:for="{{badgeCollection.slots}}" wx:key="id" class="badge-slot">
        <block wx:if="{{!item.empty}}"><button class="badge-slot-open" bindtap="showBadgeDetail" data-id="{{item.id}}" aria-label="{{'查看'+item.title}}" hover-class="badge-pressed"><image class="badge-slot-image" src="{{item.imageUrl}}" mode="aspectFit" aria-hidden="true" /><text class="badge-slot-title">{{item.title}}</text></button><button class="badge-remove" bindtap="toggleOwnedBadge" data-id="{{item.id}}" disabled="{{badgeManagerSaving || badgeManagerLoading}}" aria-label="{{'摘下'+item.title}}" hover-class="badge-pressed">摘下</button></block>
        <button wx:else class="badge-slot-open badge-slot-empty" bindtap="chooseBadgeFilter" data-id="owned" aria-label="查看已拥有徽章以选择佩戴" hover-class="badge-pressed"><view class="badge-empty-ring" aria-hidden="true">＋</view><text class="badge-slot-title">待佩戴</text></button>
      </view></view><view class="badge-caption badge-equipment-note">最多佩戴3枚，将展示在玩家名片中。</view>
    </view>
    <view class="badge-filters" aria-label="筛选徽章"><button class="{{badgeFilter==='all'?'selected':''}}" bindtap="chooseBadgeFilter" data-id="all" aria-pressed="{{badgeFilter==='all'}}" hover-class="badge-pressed">全部 {{badgeCollection.totalCount}}</button><button class="{{badgeFilter==='owned'?'selected':''}}" bindtap="chooseBadgeFilter" data-id="owned" aria-pressed="{{badgeFilter==='owned'}}" hover-class="badge-pressed">已拥有 {{badgeCollection.ownedCount}}</button><button class="{{badgeFilter==='unowned'?'selected':''}}" bindtap="chooseBadgeFilter" data-id="unowned" aria-pressed="{{badgeFilter==='unowned'}}" hover-class="badge-pressed">未拥有 {{badgeCollection.unownedCount}}</button></view>
    <view wx:if="{{!badgeCollection.visibleBadges.length}}" class="badge-empty-message">{{badgeFilter==='owned'?'本月暂无徽章，登上月榜第一即可获得。':'本月已拥有全部徽章。'}}</view>
    <view class="badge-grid"><button wx:for="{{badgeCollection.visibleBadges}}" wx:key="id" class="badge-tile {{item.owned?'is-owned':'is-locked'}}" bindtap="showBadgeDetail" data-id="{{item.id}}" aria-label="{{item.title+'，'+item.status+'，查看详情'}}" hover-class="badge-pressed"><view class="badge-tile-status"><view wx:if="{{!item.owned}}" class="badge-lock" aria-hidden="true"></view><text>{{item.status}}</text></view><image class="badge-tile-image" src="{{item.imageUrl}}" mode="aspectFit" aria-hidden="true" /><view class="badge-tile-copy"><view class="badge-tile-title">{{item.title}}</view><view class="badge-caption">{{item.condition}}</view></view></button></view>
    <view class="badge-caption badge-footer">点击徽章，查看详情与获取条件</view>
  </block>
</view>
<view wx:if="{{selectedBadge}}" class="badge-backdrop" bindtap="closeBadgeDetail" catchtouchmove="blockScroll"><view class="badge-detail" role="dialog" aria-modal="true" aria-label="{{selectedBadge.title}}" catchtap="blockScroll"><scroll-view scroll-y="{{true}}" class="badge-detail-scroll"><button class="badge-detail-close" bindtap="closeBadgeDetail" aria-label="关闭徽章详情" hover-class="badge-pressed">×</button><image class="badge-detail-image {{!selectedBadge.owned?'is-locked':''}}" src="{{selectedBadge.imageUrl}}" mode="aspectFit" aria-hidden="true" /><view class="badge-detail-title">{{selectedBadge.title}}</view><view class="badge-caption">{{selectedBadge.status}}</view><view class="badge-detail-description">{{selectedBadge.description}}</view><view class="badge-caption">{{selectedBadge.rules}}</view><view wx:if="{{selectedBadge.owned && !selectedBadge.equipped && badgeCollection.equippedCount >= 3}}" class="badge-cap-hint">已佩戴3枚，请先摘下一枚。</view><button wx:if="{{selectedBadge.owned}}" class="primary badge-detail-action" bindtap="toggleOwnedBadge" data-id="{{selectedBadge.id}}" disabled="{{badgeManagerSaving || badgeManagerLoading || (!selectedBadge.equipped && badgeCollection.equippedCount >= 3)}}" loading="{{badgeManagerSaving}}" hover-class="badge-pressed">{{selectedBadge.equipped?'摘下徽章':'佩戴徽章'}}</button><button wx:else class="secondary badge-detail-action" bindtap="closeBadgeDetail" hover-class="badge-pressed">知道了</button></scroll-view></view></view>
