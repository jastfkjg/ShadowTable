<import src="../../loading-placeholder.wxml" />
<app-nav title="荣誉徽章" back="{{true}}" backLabel="返回我的" bindback="back" />
<view class="page badge-page">
  <view class="badge-period-row"><text class="badge-caption">{{badgeCollection ? badgeCollection.monthLabel : '本月荣誉'}}</text><button class="badge-rules" bindtap="showBadgeRules" hover-class="badge-pressed">规则<image class="badge-info-icon" src="/assets/record-info.svg" aria-hidden="true" /></button></view>
  <view class="badge-hero"><view><view class="badge-title">荣誉收藏</view><view class="badge-caption">月榜荣誉与永久纪念</view></view><view class="badge-total"><view class="badge-total-value">{{badgeCollection ? badgeCollection.ownedCount : '—'}}<text> / {{badgeCollection ? badgeCollection.totalCount : badgeTotalCount}}</text></view><text class="badge-caption">已拥有</text></view></view>
  <template wx:if="{{badgeManagerLoading && !badgeCollection}}" is="loadingPlaceholder" data="{{kind:'metrics'}}" />
  <view wx:if="{{badgeManagerError && !connectionVisible}}" class="inline-error" role="alert"><text>{{badgeManagerError}}</text><button class="secondary" bindtap="loadBadgeManager" disabled="{{badgeManagerLoading || badgeManagerSaving}}" hover-class="badge-pressed">刷新徽章</button></view>
  <block wx:if="{{badgeCollection}}">
    <view class="badge-equipment">
      <view class="badge-section-heading"><view><text>当前佩戴</text><text class="badge-equipped-count">{{badgeCollection.equippedCount}} / 3</text></view><button class="disclosure-button badge-manage" bindtap="manageBadges" disabled="{{badgeManagerSaving || badgeManagerLoading || !badgeCollection.ownedCount}}" aria-expanded="{{badgeManaging}}" hover-class="none">{{badgeManaging?'完成':'管理'}}<view wx:if="{{!badgeManaging}}" class="badge-chevron" aria-hidden="true"></view></button></view>
      <view class="badge-slots"><view wx:for="{{badgeCollection.slots}}" wx:key="id" class="badge-slot">
        <block wx:if="{{!item.empty}}"><button class="badge-slot-open" bindtap="showBadgeDetail" data-id="{{item.id}}" aria-label="{{'查看'+item.title}}" hover-class="badge-pressed"><image class="badge-slot-image" src="{{item.imageUrl}}" mode="aspectFit" aria-hidden="true" /><text class="badge-slot-title">{{item.title}}</text></button><button wx:if="{{badgeManaging}}" class="badge-remove" bindtap="toggleOwnedBadge" data-id="{{item.id}}" disabled="{{badgeManagerSaving || badgeManagerLoading}}" aria-label="{{'摘下'+item.title}}" hover-class="badge-pressed">摘下</button></block>
        <button wx:else class="badge-slot-open badge-slot-empty" bindtap="chooseBadgeFilter" data-id="owned" aria-label="查看已拥有徽章以选择佩戴" hover-class="badge-pressed"><view class="badge-empty-ring" aria-hidden="true">＋</view><text class="badge-slot-title">待佩戴</text></button>
      </view></view><view class="badge-caption badge-equipment-note">佩戴的徽章将展示在玩家名片中</view>
    </view>
    <view class="badge-filters" aria-label="筛选徽章"><button class="{{badgeFilter==='all'?'selected':''}}" bindtap="chooseBadgeFilter" data-id="all" aria-pressed="{{badgeFilter==='all'}}" hover-class="badge-pressed">全部<text>{{badgeCollection.totalCount}}</text></button><button class="{{badgeFilter==='owned'?'selected':''}}" bindtap="chooseBadgeFilter" data-id="owned" aria-pressed="{{badgeFilter==='owned'}}" hover-class="badge-pressed">已拥有<text>{{badgeCollection.ownedCount}}</text></button><button class="{{badgeFilter==='unowned'?'selected':''}}" bindtap="chooseBadgeFilter" data-id="unowned" aria-pressed="{{badgeFilter==='unowned'}}" hover-class="badge-pressed">未拥有<text>{{badgeCollection.unownedCount}}</text></button></view>
    <view wx:if="{{!badgeCollection.visibleBadges.length}}" class="badge-empty-message">{{badgeFilter==='owned'?'本月暂无徽章，登上月榜第一即可获得。':'本月已拥有全部徽章。'}}</view>
    <view class="badge-grid"><button wx:for="{{badgeCollection.visibleBadges}}" wx:key="id" class="badge-tile {{item.owned?'is-owned':'is-locked'}}" bindtap="showBadgeDetail" data-id="{{item.id}}" aria-label="{{item.title+'，'+item.status+'，查看详情'}}" hover-class="badge-pressed"><view class="badge-tile-status"><view wx:if="{{!item.owned}}" class="badge-lock" aria-hidden="true"></view><view wx:if="{{item.equipped}}" class="badge-check" aria-hidden="true"></view><text>{{item.status}}</text></view><image class="badge-tile-image" src="{{item.imageUrl}}" mode="aspectFit" aria-hidden="true" /><view class="badge-tile-copy"><view class="badge-tile-title">{{item.title}}</view><view class="badge-caption">{{item.condition}}</view></view></button></view>
    <view class="badge-caption badge-footer">点击徽章，查看详情与获取条件</view>
  </block>
</view>
<view wx:if="{{selectedBadge}}" class="badge-backdrop" bindtap="closeBadgeDetail" catchtouchmove="blockScroll">
  <view class="badge-detail" role="dialog" aria-modal="true" aria-label="{{selectedBadge.title}}" catchtap="blockScroll">
    <scroll-view scroll-y="{{true}}" class="badge-detail-scroll" style="{{badgeDetailHeight ? 'height:'+badgeDetailHeight+'px' : ''}}">
      <view class="badge-detail-content">
        <view class="badge-detail-handle" aria-hidden="true"></view>
        <view class="badge-detail-header"><text>徽章详情</text><button class="badge-detail-close" bindtap="closeBadgeDetail" aria-label="关闭徽章详情" hover-class="badge-pressed">×</button></view>
        <view class="badge-detail-art"><image class="badge-detail-image {{!selectedBadge.owned?'is-locked':''}}" src="{{selectedBadge.imageUrl}}" mode="aspectFit" aria-hidden="true" /></view>
        <view class="badge-detail-category">{{selectedBadge.periodLabel || badgeCollection.monthLabel}} · {{selectedBadge.category}}</view>
        <view class="badge-detail-title">{{selectedBadge.title}}</view>
        <view class="badge-detail-status"><view wx:if="{{selectedBadge.equipped}}" class="badge-check" aria-hidden="true"></view><text>{{selectedBadge.status}}</text></view>
        <view wx:if="{{selectedBadge.flavor}}" class="badge-detail-description">{{selectedBadge.flavor}}</view>
        <view class="badge-detail-criteria"><view class="badge-detail-row"><text>获取条件</text><text>{{selectedBadge.detailCondition}}</text></view><view class="badge-detail-row"><text>持有规则</text><text>{{selectedBadge.holdingRule}}</text></view></view>
        <view wx:if="{{selectedBadge.owned && !selectedBadge.equipped && badgeCollection.equippedCount >= 3}}" class="badge-cap-hint">已佩戴3枚，请先摘下一枚。</view>
        <button wx:if="{{selectedBadge.owned}}" class="{{selectedBadge.equipped?'secondary':'primary'}} badge-detail-action" bindtap="toggleOwnedBadge" data-id="{{selectedBadge.id}}" disabled="{{badgeManagerSaving || badgeManagerLoading || (!selectedBadge.equipped && badgeCollection.equippedCount >= 3)}}" loading="{{badgeManagerSaving}}" hover-class="badge-pressed">{{selectedBadge.equipped?'摘下徽章':'佩戴徽章'}}</button><button wx:else class="secondary badge-detail-action" bindtap="closeBadgeDetail" hover-class="badge-pressed">知道了</button>
      </view>
    </scroll-view>
  </view>
</view>
<app-dialog id="app-dialog" />
