.badge-page { --badge-line: rgba(177,191,198,.16); max-width: 760px; padding: 12px 20px calc(32px + env(safe-area-inset-bottom)); margin: auto; }
.badge-caption { font-size: 12px; line-height: 1.6; color: var(--muted); }
.badge-period-row, .badge-hero, .badge-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.badge-page button, .badge-detail button { margin: 0; font: inherit; min-height: 44px; transition: opacity .15s, border-color .15s, background-color .15s; }
.badge-page button:focus-visible, .badge-detail button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.badge-page .badge-rules { padding: 0 0 0 12px; width: auto; gap: 5px; color: var(--muted); font-size: 12px; }
.badge-info-icon { width: 14px; height: 14px; }
.badge-hero { margin: 0 0 24px; }
.badge-title { font-size: 28px; font-weight: 600; line-height: 1.4; margin-bottom: 5px; }
.badge-total { text-align: right; flex-shrink: 0; }
.badge-total-value { font-size: 34px; font-weight: 500; color: var(--accent); line-height: 1.2; font-variant-numeric: tabular-nums; }
.badge-total-value > text, .badge-total-value > span { font-size: 18px; }
.badge-total .badge-caption { display: block; margin-top: 7px; }
.badge-equipment { padding: 4px 14px 12px; border: 1px solid var(--badge-line); border-radius: 16px; background: var(--surface); }
.badge-section-heading { font-size: 14px; font-weight: 600; }
.badge-equipped-count { color: var(--muted); font-size: 12px; font-weight: 400; margin-left: 8px; }
.badge-page .badge-manage { width: auto; flex-shrink: 0; gap: 7px; font-size: 12px; color: var(--accent); padding: 0 0 0 8px; }
.badge-chevron { width: 5px; height: 5px; border-top: 1px solid; border-right: 1px solid; transform: rotate(45deg); margin-right: 2px; }
.badge-slots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 2px -4px 0; }
.badge-slot { min-width: 0; text-align: center; }
.badge-page .badge-slot-open { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; width: 100%; padding: 0; gap: 8px; color: var(--text); background: transparent; }
.badge-slot-image, .badge-empty-ring { display: block; width: 68px; height: 68px; max-width: 100%; margin: auto; }
.badge-slot-image { filter: drop-shadow(0 4px 8px rgba(0,0,0,.2)); }
.badge-empty-ring { box-sizing: border-box; border: 1px dashed var(--control-border); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 28px; font-weight: 300; }
.badge-slot-title { display: block; font-size: 12px; line-height: 1.5; min-height: 36px; overflow-wrap: anywhere; }
.badge-slot-empty .badge-slot-title { color: var(--muted); }
.badge-page .badge-remove { width: 76px; max-width: 100%; margin: 4px auto 0; padding: 4px 12px; border: 1px solid var(--control-border); border-radius: 8px; font-size: 12px; color: var(--muted); }
.badge-equipment-note { text-align: center; margin-top: 8px; padding-top: 10px; border-top: 1px solid var(--badge-line); }
.badge-filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--badge-line); margin: 13px 0 14px; gap: 12px; }
.badge-page .badge-filters button { position: relative; border-radius: 0; padding: 12px 0; color: var(--muted); font-size: 13px; background: transparent; width: 100%; gap: 5px; }
.badge-filters button > text, .badge-filters button > span { font-size: 12px; }
.badge-page .badge-filters .selected { color: var(--accent); font-weight: 600; }
.badge-filters .selected::before { content: ''; position: absolute; bottom: -1px; left: 50%; transform: translateX(-50%); height: 2px; width: 38px; border-radius: 2px; background: var(--accent); }
.badge-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.badge-page .badge-tile { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; width: 100%; min-width: 0; min-height: 184px; padding: 28px 8px 14px; gap: 10px; border: 1px solid var(--badge-line); border-radius: 12px; text-align: center; background: var(--surface); color: var(--text); }
.badge-page .badge-tile.is-locked { background: var(--control-bg); }
.badge-tile-status { position: absolute; top: 8px; right: 9px; display: flex; align-items: center; gap: 5px; color: var(--muted); font-size: 12px; line-height: 1.5; }
.is-owned .badge-tile-status { color: var(--accent); }
.badge-check { box-sizing: border-box; width: 8px; height: 5px; border-left: 1.5px solid; border-bottom: 1.5px solid; transform: rotate(-45deg); margin: -2px 2px 0 1px; flex-shrink: 0; }
.badge-tile-image { display: block; width: 80px; height: 80px; flex-shrink: 0; object-fit: contain; }
.is-locked .badge-tile-image, .badge-detail-image.is-locked { filter: grayscale(1); opacity: .5; }
.badge-tile-copy { min-width: 0; width: 100%; }
.badge-tile-copy > span { display: block; }
.badge-tile-title { font-size: 13px; font-weight: 500; line-height: 1.5; margin-bottom: 5px; overflow-wrap: anywhere; }
.badge-tile-copy .badge-caption { overflow-wrap: anywhere; }
.badge-lock { position: relative; box-sizing: border-box; width: 9px; height: 8px; border: 1px solid var(--muted); border-radius: 2px; margin-top: 4px; }
.badge-lock::before { content: ''; position: absolute; top: -5px; left: 1px; width: 5px; height: 5px; box-sizing: border-box; border: 1px solid var(--muted); border-bottom: 0; border-radius: 5px 5px 0 0; }
.badge-footer, .badge-empty-message { text-align: center; padding: 24px 8px; }
.badge-empty-message { color: var(--muted); font-size: 14px; }
.badge-backdrop { position: fixed; inset: 0; z-index: 110; background:var(--overlay-scrim); display: flex; justify-content: center; align-items: flex-end; box-sizing: border-box; }
.badge-detail { --badge-line: rgba(177,191,198,.16); width: 100%; max-width: 440px; max-height: 90vh; overflow: hidden; box-sizing: border-box; border: 1px solid var(--overlay-border); border-bottom: 0; border-radius:var(--sheet-radius) var(--sheet-radius) 0 0; background: var(--surface); color: var(--text); text-align: center; animation: badge-detail-enter .18s ease-out; }
.badge-detail-scroll { display: block; height: auto; }
.badge-detail-content { padding: 10px 24px calc(24px + env(safe-area-inset-bottom)); box-sizing: border-box; }
.badge-detail-handle { width: 32px; height: 4px; margin: 0 auto 4px; border-radius: 4px; background: var(--control-border); }
.badge-detail-header { display: flex; align-items: center; justify-content: space-between; height: 36px; color: var(--muted); font-size: 12px; text-align: left; }
.badge-detail .badge-detail-close { width: 44px; height: 44px; padding: 0; margin-right: -12px; font-size: 28px; font-weight: 300; color: var(--muted); background: transparent; }
.badge-detail-art { display: flex; align-items: center; justify-content: center; width: 166px; height: 140px; margin: 0 auto 8px; background: radial-gradient(ellipse at center,rgba(229,198,139,.1),transparent 68%); }
.badge-detail-image { display: block; width: 124px; height: 124px; object-fit: contain; filter: drop-shadow(0 8px 10px rgba(0,0,0,.25)); }
.badge-detail-category { color: var(--accent); font-size: 12px; letter-spacing: 1px; }
.badge-detail-title { font-size: 25px; font-weight: 600; line-height: 1.5; margin: 7px 0 0; overflow-wrap: anywhere; }
.badge-detail-status { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; line-height: 1.5; color: var(--accent); margin-top: 9px; padding: 3px 10px; border: 1px solid rgba(229,198,139,.25); border-radius: 20px; background: rgba(229,198,139,.04); }
.badge-detail-description { margin: 17px 0 24px; color: var(--muted); font-size: 13px; line-height: 1.8; overflow-wrap: anywhere; }
.badge-detail-criteria { border-top: 1px solid var(--badge-line); border-bottom: 1px solid var(--badge-line); padding: 10px 0; margin-top: 24px; }
.badge-detail-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; min-height: 34px; padding: 5px 0; font-size: 12px; text-align: left; }
.badge-detail-row > text:first-child, .badge-detail-row > span:first-child { color: var(--muted); flex-shrink: 0; }
.badge-detail-row > text:last-child, .badge-detail-row > span:last-child { text-align: right; overflow-wrap: anywhere; }
.badge-detail-row:first-child > text:last-child, .badge-detail-row:first-child > span:last-child { font-size: 13px; font-weight: 500; }
.badge-detail .badge-detail-action { display: flex; width: 100%; margin-top: 22px; min-height: 46px; border-radius:var(--dialog-control-radius); padding: 10px 12px; font-size: 14px; }
.badge-detail .secondary.badge-detail-action { background: rgba(130,149,160,.13); border: 1px solid var(--border); color: var(--text); }
.badge-cap-hint { color: var(--accent); font-size: 13px; margin-top: 16px; }
.badge-pressed { opacity: .72; }
.badge-web-header { display: grid; grid-template-columns: 48px 1fr 48px; align-items: center; margin-bottom: 8px; }
.badge-web-header h1 { font-size: 18px; text-align: center; margin: 0; }
.badge-page .badge-web-back { width: 44px; min-height: 48px; font-size: 30px; padding: 0; }
.badge-page-shell { max-width: 800px; padding: 0; }
body:has(.badge-backdrop) { overflow: hidden; }
section.badge-detail { overflow-y: auto; }
@media (min-width: 700px) { .badge-page { padding: 16px 24px 32px; } .badge-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } }
@media (max-width: 359px) { .badge-page { padding-left: 12px; padding-right: 12px; } .badge-slots { gap: 4px; } .badge-slot-image, .badge-empty-ring { width: 60px; height: 60px; } .badge-grid { gap: 8px; } .badge-detail-content { padding-left: 20px; padding-right: 20px; } }
@media (max-height: 500px) { .badge-detail-art { height: 100px; } .badge-detail-image { width: 88px; height: 88px; } }
@keyframes badge-detail-enter { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .badge-page button, .badge-detail button { transition: none; } .badge-detail { animation: none; } }

.badge-picker-scroll { display: block; max-height: 75vh; }
.badge-picker-header { height: 48px; color: var(--text); font-size: 18px; font-weight: 600; }
.badge-picker-hint { margin: 2px 0 16px; text-align: left; color: var(--muted); font-size: 13px; line-height: 1.5; }
.badge-detail .badge-picker-item { display: flex; align-items: center; justify-content: flex-start; box-sizing: border-box; gap: 12px; width: 100%; min-width: 0; min-height: 72px; padding: 8px 14px; margin: 0 0 8px; border: 1px solid var(--border); border-radius: 12px; background: rgba(130,149,160,.08); color: var(--text); text-align: left; }
.badge-picker-item image, .badge-picker-item img { width: 52px; height: 52px; flex: 0 0 52px; object-fit: contain; }
.badge-picker-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: flex-start; gap: 4px; line-height: 1.4; }
.badge-picker-title { font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
.badge-picker-subtitle { font-size: 12px; color: var(--muted); }
.badge-picker-arrow { flex-shrink: 0; color: var(--accent); font-size: 22px; }
