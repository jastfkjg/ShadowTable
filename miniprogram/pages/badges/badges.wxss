.badge-page, .badge-detail {
  --badge-line: rgba(177, 191, 198, .2);
  --badge-gold-line: rgba(229, 198, 139, .42);
  --badge-gold-fill: rgba(229, 198, 139, .13);
}
.badge-page { max-width: 760px; padding: 14px 18px calc(28px + env(safe-area-inset-bottom)); margin: auto; }
.badge-caption { font-size: 12px; line-height: 1.5; color: var(--muted); }
.badge-page button, .badge-detail button { margin: 0; font: inherit; min-height: 44px; transition: opacity .15s, border-color .15s, background-color .15s; }
.badge-page button:focus-visible, .badge-detail button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.badge-period-row { position: relative; min-height: 24px; padding-right: 44px; display: flex; align-items: center; }
.badge-period { font-size: 12px; color: var(--accent); }
.badge-page .badge-rules { position: absolute; right: 0; top: -10px; width: 44px; height: 44px; padding: 0 0 0 12px; }
.badge-info-icon { width: 20px; height: 20px; }
.badge-title { margin: 3px 0 16px; font-family: "Songti SC", "Noto Serif CJK SC", serif; font-size: 29px; font-weight: 700; line-height: 1.3; }

.badge-equipment { padding: 4px 13px 10px; border: 1px solid var(--badge-gold-line); border-radius: 16px; background: linear-gradient(145deg, var(--badge-gold-fill), transparent 66%), var(--control-bg); }
.badge-section-heading, .badge-collection-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 2px 12px; }
.badge-section-heading { font-size: 16px; font-weight: 600; }
.badge-equipped-count { margin-left: 8px; color: var(--accent); font-size: 12px; font-weight: 500; font-variant-numeric: tabular-nums; }
.badge-page .badge-manage { position: relative; width: auto; flex-shrink: 0; gap: 7px; padding: 0 10px; color: var(--accent); font-size: 12px; font-weight: 600; }
.badge-manage::before { content: ''; position: absolute; inset: 7px 0; border: 1px solid var(--badge-gold-line); border-radius: 8px; background: var(--badge-gold-fill); pointer-events: none; }
.badge-chevron { width: 6px; height: 6px; flex-shrink: 0; border-top: 1px solid; border-right: 1px solid; transform: rotate(45deg); margin-right: 2px; }
.badge-slots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0 -4px; }
.badge-slot { min-width: 0; text-align: center; }
.badge-page .badge-slot-open { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 4px; width: 100%; padding: 3px 2px 5px; border: 1px solid transparent; border-radius: 10px; color: var(--text); background: transparent; }
.badge-slot.is-updated .badge-slot-open { border-color: var(--badge-gold-line); background: var(--badge-gold-fill); }
.badge-slot-medallion, .badge-empty-ring { box-sizing: border-box; width: 62px; height: 62px; max-width: 100%; margin: 0 auto; border-radius: 50%; }
.badge-slot-medallion { display: flex; align-items: center; justify-content: center; border: 1px solid var(--badge-line); box-shadow: inset 0 0 0 4px rgba(177, 191, 198, .035); }
.badge-slot-image { display: block; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 3px 6px rgba(0, 0, 0, .26)); }
.badge-empty-ring { border: 1px dashed var(--control-border); display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 25px; }
.badge-slot-title { display: block; max-width: 100%; font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
.badge-slot-empty .badge-slot-title { color: var(--muted); }
.badge-page .badge-remove { width: 76px; max-width: 100%; margin: 4px auto 0; padding: 4px 8px; border: 1px solid var(--badge-line); border-radius: 8px; font-size: 12px; color: var(--muted); }
.badge-equipment-note { text-align: center; margin-top: 6px; padding-top: 8px; border-top: 1px solid var(--badge-line); }
.badge-equipment-note.is-updated { display: flex; align-items: center; justify-content: center; gap: 6px; color: var(--good); }

.badge-collection-heading { margin: 17px 0 8px; }
.badge-collection-title { margin: 0; font-size: 20px; font-weight: 600; line-height: 1.4; }
.badge-collection-total { color: var(--muted); font-size: 13px; font-variant-numeric: tabular-nums; }
.badge-filters { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0 0 10px; }
.badge-page .badge-filters button { width: 100%; min-width: 0; flex-wrap: wrap; gap: 0 5px; padding: 5px 4px; border: 1px solid var(--badge-line); border-radius: 8px; background: var(--control-bg); color: var(--muted); font-size: 13px; }
.badge-filters button > text, .badge-filters button > span { font-size: 12px; font-variant-numeric: tabular-nums; }
.badge-page .badge-filters .selected { border-color: var(--badge-gold-line); background: var(--badge-gold-fill); color: var(--accent); font-weight: 600; }
.badge-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.badge-page .badge-tile { display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 5px; width: 100%; min-width: 0; min-height: 145px; padding: 8px 10px 9px; border: 1px solid var(--badge-line); border-radius: 12px; text-align: center; background: radial-gradient(ellipse at 50% 28%, var(--surface), var(--control-bg) 86%); color: var(--text); }
.badge-page .badge-tile.is-locked { background: var(--control-bg); }
.badge-tile-meta { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 2px 6px; width: 100%; color: var(--muted); font-size: 11px; line-height: 1.5; }
.badge-tile-status { display: flex; align-items: center; gap: 4px; }
.is-owned .badge-tile-status { color: var(--accent); }
.badge-check { box-sizing: border-box; width: 8px; height: 5px; border-left: 1.5px solid; border-bottom: 1.5px solid; transform: rotate(-45deg); margin: -2px 1px 0; flex-shrink: 0; }
.badge-tile-image { display: block; width: 74px; height: 74px; flex-shrink: 0; object-fit: contain; }
.is-locked .badge-tile-image, .badge-detail-image.is-locked { filter: grayscale(1); opacity: .55; }
.badge-tile-copy { min-width: 0; width: 100%; }
.badge-tile-copy > span { display: block; }
.badge-tile-title { font-size: 15px; font-weight: 600; line-height: 1.4; margin-bottom: 2px; overflow-wrap: anywhere; }
.badge-tile-copy .badge-caption { font-size: 11px; overflow-wrap: anywhere; }
.badge-lock { position: relative; box-sizing: border-box; width: 9px; height: 8px; border: 1px solid currentColor; border-radius: 2px; margin-top: 4px; }
.badge-lock::before { content: ''; position: absolute; top: -5px; left: 1px; width: 5px; height: 5px; box-sizing: border-box; border: 1px solid currentColor; border-bottom: 0; border-radius: 5px 5px 0 0; }
.badge-footer, .badge-empty-message { text-align: center; padding: 20px 8px; }
.badge-empty-message { color: var(--muted); font-size: 14px; }

.badge-backdrop { position: fixed; inset: 0; z-index: 110; background: var(--overlay-scrim); display: flex; justify-content: center; align-items: flex-end; box-sizing: border-box; }
.badge-detail { width: 100%; max-width: 440px; max-height: 90vh; overflow: hidden; box-sizing: border-box; border: 1px solid var(--overlay-border); border-bottom: 0; border-radius: var(--sheet-radius) var(--sheet-radius) 0 0; background: var(--surface); color: var(--text); text-align: center; animation: badge-detail-enter .18s ease-out; }
.badge-detail-scroll { display: block; height: auto; }
.badge-detail-content { padding: 8px 18px calc(18px + env(safe-area-inset-bottom)); box-sizing: border-box; }
.badge-detail-handle { width: 34px; height: 4px; margin: 0 auto 4px; border-radius: 4px; background: var(--control-border); }
.badge-detail .badge-detail-close { justify-self: end; width: 44px; height: 44px; padding: 0; margin-right: -8px; font-size: 26px; color: var(--muted); background: transparent; }
.badge-detail .badge-detail-back { width: 52px; justify-content: flex-start; padding: 0 2px; gap: 4px; font-size: 12px; color: var(--accent); }
.badge-detail-back .badge-chevron { transform: rotate(-135deg); }
.badge-detail-compact { position: relative; padding: 10px 22px calc(24px + env(safe-area-inset-bottom)); }
.badge-detail-compact .badge-detail-close, .badge-picker-header .badge-detail-close { position: absolute; top: 13px; right: 11px; margin: 0; }
.badge-detail .badge-detail-close > text, .badge-detail .badge-detail-close > span { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: rgba(177, 191, 198, .08); font-size: 22px; line-height: 1; }
.badge-detail-art { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 98px; height: 98px; margin: 15px auto 12px; border: 1px solid var(--badge-line); border-radius: 50%; background: radial-gradient(ellipse, var(--badge-gold-fill), transparent 70%); }
.badge-detail-image { display: block; width: 94px; height: 94px; object-fit: contain; filter: drop-shadow(0 5px 8px rgba(0, 0, 0, .28)); }
.badge-detail-title { margin: 0; font-family: "Songti SC", "Noto Serif CJK SC", serif; font-size: 26px; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.badge-detail-meta { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 5px 10px; margin-top: 7px; color: var(--muted); font-size: 12px; }
.badge-detail-status { padding: 2px 8px; border: 1px solid var(--badge-line); border-radius: 5px; font-size: 11px; }
.badge-detail-status.is-owned { border-color: var(--badge-gold-line); background: var(--badge-gold-fill); color: var(--accent); }
.badge-detail-criteria { display: flex; flex-direction: column; gap: 6px; margin-top: 17px; padding-top: 12px; border-top: 1px solid var(--badge-line); text-align: left; overflow-wrap: anywhere; }
.badge-detail-condition { color: var(--text); font-size: 15px; font-weight: 600; line-height: 1.5; }
.badge-detail .badge-detail-action { display: flex; width: 100%; margin-top: 14px; min-height: 46px; border-radius: var(--dialog-control-radius); padding: 8px 12px; font-size: 15px; font-weight: 600; }
.badge-detail-compact .badge-detail-action { margin-top: 24px; min-height: 48px; }
.badge-detail .secondary.badge-detail-action { background: var(--control-bg); border: 1px solid var(--border); color: var(--text); }

.badge-detail.badge-picker-sheet { display: flex; flex-direction: column; overflow: hidden; }
.badge-picker-header { position: relative; flex-shrink: 0; padding: 10px 22px 13px; text-align: left; }
.badge-picker-position { margin: 14px 0 6px; color: var(--accent); font-size: 12px; font-weight: 600; }
.badge-picker-heading { margin: 0; color: var(--text); font-size: 23px; font-weight: 600; line-height: 1.4; }
.badge-picker-hint { margin-top: 6px; color: var(--muted); font-size: 13px; line-height: 1.5; }
.badge-picker-body { display: block; flex: 0 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; }
.badge-picker-content { padding: 4px 22px; }
.badge-picker-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.badge-detail button.badge-picker-item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 4px; width: 100%; min-width: 0; min-height: 125px; padding: 23px 4px 8px; border: 1px solid var(--badge-line); border-radius: 10px; background: var(--control-bg); color: var(--text); line-height: 1.35; }
.badge-detail .badge-picker-item.is-selected { border-color: var(--badge-gold-line); background: var(--badge-gold-fill); }
.badge-picker-slot { position: absolute; top: 7px; left: 8px; color: var(--muted); font-size: 10px; }
.badge-picker-mark { position: absolute; top: 7px; right: 7px; display: flex; align-items: center; justify-content: center; width: 15px; height: 15px; border-radius: 50%; background: var(--accent); color: var(--bg); }
.badge-picker-art { width: 58px; max-width: 100%; height: 58px; flex-shrink: 0; object-fit: contain; }
.badge-picker-title { max-width: 100%; font-size: 13px; font-weight: 600; overflow-wrap: anywhere; }
.badge-picker-label { font-size: 11px; color: var(--muted); }
.is-selected .badge-picker-slot, .is-selected .badge-picker-label { color: var(--accent); }
.badge-swap { display: grid; grid-template-columns: minmax(0, 1fr) 22px minmax(0, 1fr); align-items: center; gap: 8px; box-sizing: border-box; margin-top: 14px; padding: 12px 10px; min-height: 74px; border: 1px solid var(--badge-line); border-radius: 10px; background: var(--control-bg); text-align: left; }
.badge-swap-item { display: flex; align-items: center; gap: 7px; min-width: 0; }
.badge-swap-item image, .badge-swap-item img, .badge-swap-empty { width: 34px; height: 34px; flex: 0 0 34px; object-fit: contain; box-sizing: border-box; }
.badge-swap-empty { border: 1px dashed var(--control-border); border-radius: 50%; }
.badge-swap-copy { display: flex; flex-direction: column; min-width: 0; }
.badge-swap-name { font-size: 13px; font-weight: 600; line-height: 1.35; overflow-wrap: anywhere; }
.badge-swap-incoming .badge-caption { color: var(--accent); }
.badge-swap-arrow { position: relative; height: 1px; background: var(--accent); opacity: .8; }
.badge-swap-arrow::after { content: ''; position: absolute; top: -3px; right: 0; width: 6px; height: 6px; border-top: 1px solid var(--accent); border-right: 1px solid var(--accent); transform: rotate(45deg); }
.badge-picker-footer { flex-shrink: 0; padding: 16px 22px calc(22px + env(safe-area-inset-bottom)); }
.badge-detail .badge-picker-footer .badge-detail-action { min-height: 48px; margin: 0; }
.badge-detail .badge-picker-footer .badge-detail-action[disabled] { border: 1px solid var(--badge-line); background: var(--control-bg); color: var(--muted); opacity: 1; }
.badge-pressed { opacity: .72; }

.badge-web-header { display: grid; grid-template-columns: 48px 1fr 48px; align-items: center; margin-bottom: 8px; }
.badge-web-header h1 { font-size: 18px; text-align: center; margin: 0; }
.badge-page .badge-web-back { width: 44px; min-height: 48px; font-size: 30px; padding: 0; }
.badge-page-shell { max-width: 800px; padding: 0; }
body:has(.badge-backdrop) { overflow: hidden; }
section.badge-detail { overflow-y: auto; }
@media (min-width: 700px) { .badge-page { padding: 16px 24px 32px; } .badge-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 359px) { .badge-page { padding-left: 12px; padding-right: 12px; } .badge-slots { gap: 4px; } .badge-slot-medallion, .badge-empty-ring { width: 56px; height: 56px; } .badge-grid { gap: 8px; } }
@media (max-width: 359px) { .badge-picker-header, .badge-picker-content, .badge-picker-footer { padding-left: 16px; padding-right: 16px; } .badge-swap { gap: 5px; } .badge-swap-item { gap: 5px; } .badge-swap-item image, .badge-swap-item img, .badge-swap-empty { width: 28px; height: 28px; flex-basis: 28px; } }
@media (max-height: 500px) { .badge-detail-art { width: 76px; height: 76px; } .badge-detail-image { width: 72px; height: 72px; } }
@keyframes badge-detail-enter { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .badge-page button, .badge-detail button { transition: none; } .badge-detail { animation: none; } }
