.owned-page { max-width: 600px; margin: auto; padding: 20px 19px calc(32px + env(safe-area-inset-bottom)); }
.owned-summary,.owned-heading,.owned-row,.owned-avatar { display: flex; align-items: center; }
.owned-summary { gap: 12px; padding-bottom: 16px; border-bottom: 1px solid rgba(184,204,207,.15); }
.owned-avatar { flex: none; width: 46px; height: 46px; justify-content: center; overflow: hidden; border-radius: 50%; background: var(--surface); color: var(--accent); font-size: 22px; }
.owned-avatar image { width: 100%; height: 100%; }
.owned-name { flex: 1; min-width: 0; font-size: 23px; font-weight: 600; overflow-wrap: anywhere; }
.owned-name text { display: block; margin-top: 3px; }
.owned-name text,.owned-count,.owned-heading text:last-child,.owned-row text { font-size: 12px; color: var(--muted); font-weight: 400; }
.owned-count { white-space: nowrap; }
.owned-count text { font-family: Georgia,serif; font-size: 32px; color: var(--accent); }
.owned-heading { justify-content: space-between; margin: 20px 0 4px; color: var(--accent); font-size: 15px; font-weight: 600; }
.owned-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 12px; }
.owned-row { gap: 9px; min-height: 66px; border-bottom: 1px solid rgba(184,204,207,.15); font-size: 14px; overflow-wrap: anywhere; }
.owned-row image { width: 42px; height: 42px; flex-shrink: 0; }
.owned-row text { display: block; margin-top: 3px; }
.owned-row text.worn { color: var(--accent); }
.owned-empty { margin-top: 22px; }
