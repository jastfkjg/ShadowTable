.monthly-page { --monthly-line: rgba(177,191,198,.14); padding: 0 16px calc(28px + env(safe-area-inset-bottom)); max-width: 520px; }
.monthly-page.monthly-has-share { padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
.monthly-hero { position: relative; overflow: hidden; height: 132px; margin: 0 -16px; box-sizing: border-box; }
.monthly-hero-art { position: absolute; top: 0; left: 0; width: 100%; height: auto; }
.monthly-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg,var(--bg) 1%,rgba(16,28,36,.45) 40%,rgba(16,28,36,.02)),linear-gradient(0deg,var(--bg),transparent 32%); pointer-events: none; }
.monthly-hero-content { position: relative; z-index: 1; padding: 18px 24px 0; }
.monthly-month-picker { display: flex; flex-direction: column; align-items: flex-start; width: fit-content; min-width: 112px; }
.monthly-hero picker { width: fit-content; min-width: 112px; }
.monthly-year { color: var(--accent); font-size: 12px; line-height: 1.5; letter-spacing: 1px; }
.monthly-month-line { display: flex; align-items: center; gap: 8px; min-height: 53px; font-weight: 600; line-height: 1.2; }
.monthly-month-number { font-size: 38px; letter-spacing: -1px; font-variant-numeric: tabular-nums; }
.monthly-month-unit { font-size: 24px; }
.monthly-picker-arrow { width: 6px; height: 6px; margin: 4px 4px 0 8px; border-right: 1.5px solid var(--accent); border-bottom: 1.5px solid var(--accent); transform: rotate(45deg); }
.monthly-preview-status { display: flex; align-items: center; gap: 6px; margin-top: 6px; font-size: 11px; line-height: 1.5; color: var(--muted); }
.monthly-status-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--good); }
.monthly-status-complete { background: var(--accent); }
.monthly-overview { display: flex; align-items: center; gap: 20px; min-height: 64px; margin: 0 4px; border-bottom: 1px solid var(--monthly-line); }
.monthly-overview > view { min-width: 0; display: flex; align-items: baseline; gap: 8px; }
.monthly-overview > view + view { position: relative; padding-left: 20px; }
.monthly-overview > view + view::before { content: ""; position: absolute; top: 50%; left: 0; width: 1px; height: 22px; margin-top: -11px; background: var(--monthly-line); }
.monthly-overview-value { font-size: 30px; line-height: 1.2; font-weight: 600; letter-spacing: -.5px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.monthly-caption { color: var(--muted); font-size: 12px; line-height: 1.65; overflow-wrap: anywhere; }
.monthly-overview .monthly-caption { white-space: nowrap; }
.monthly-overview > button { min-height: 44px; width: 44px; min-width: 44px; padding: 0; margin: 0 0 0 auto; justify-content: flex-end; }
.monthly-overview > button image { width: 18px; height: 18px; }
.monthly-tabs { position: sticky; z-index: 20; background: var(--bg); display: flex; gap: 24px; margin: 0 -16px; padding: 0 20px; }
.monthly-tabs button { position: relative; flex: 1; min-width: 0; width: 0; min-height: 55px; margin: 0; padding: 10px 0; border-radius: 0; font-size: 14px; color: var(--muted); }
.monthly-tabs button.selected { color: var(--accent); font-weight: 600; }
.monthly-tabs button.selected::before { content: ""; position: absolute; bottom: 4px; left: 50%; width: 27px; height: 3px; margin-left: -13.5px; background: var(--accent); border-radius: 2px; }
.monthly-boards { padding-top: 9px; }
.monthly-board { border-radius: 20px; background: var(--surface); padding: 0 14px; margin-bottom: 16px; overflow: hidden; }
.monthly-board-header { display: flex; align-items: center; gap: 10px; min-height: 64px; padding: 10px 0; box-sizing: border-box; }
.monthly-heading-icon { width: 24px; height: 24px; flex-shrink: 0; }
.monthly-role-art { width: 37px; height: 48px; margin: 0 -3px; }
.monthly-heading-copy { flex: 1; min-width: 0; }
.monthly-section-title { font-size: 17px; font-weight: 600; line-height: 1.5; letter-spacing: .2px; }
.monthly-board-caption { font-size: 11px; line-height: 1.5; margin-top: 2px; }
.monthly-top-label { font-size: 10px; color: var(--muted); white-space: nowrap; letter-spacing: .5px; }
button.monthly-row { display: flex; align-items: center; justify-content: flex-start; width: 100%; text-align: left; min-height: 64px; gap: 10px; padding: 10px 0; margin: 0; border-radius: 0; border-top: 1px solid var(--monthly-line); font-weight: 400; }
.monthly-rank { position: relative; display: flex; align-items: center; justify-content: center; width: 27px; height: 28px; flex-shrink: 0; color: #ddbcaa; font-size: 10px; font-variant-numeric: tabular-nums; }
.monthly-rank image { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .8; }
.monthly-rank text { position: relative; }
.monthly-rank-1 { color: var(--accent); }
.monthly-rank-2 { color: #c7d7e3; }
.monthly-avatar { width: 36px; height: 36px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; color: var(--muted); background: var(--control-bg); font-size: 16px; }
.monthly-avatar image { width: 100%; height: 100%; }
.monthly-identity { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
.monthly-name-line { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; min-width: 0; }
.monthly-name { font-size: 15px; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.monthly-tied { font-size: 10px; line-height: 1.6; color: var(--muted); background: rgba(177,191,198,.07); padding: 0 4px; border-radius: 4px; white-space: nowrap; }
.monthly-identity .monthly-caption { font-size: 11px; }
.monthly-value { max-width: 33%; flex-shrink: 0; font-size: 27px; line-height: 1.2; font-weight: 600; letter-spacing: -.6px; text-align: right; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.monthly-row-first .monthly-value { color: var(--accent); }
.monthly-compact { font-size: 17px; }
.monthly-unit { font-size: 11px; font-weight: 400; color: var(--muted); margin-left: 3px; letter-spacing: 0; }
.monthly-category-note { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; margin: 0 2px 12px; min-height: 28px; }
.monthly-category-note image { width: 18px; height: 18px; flex-shrink: 0; }
.monthly-category-empty, .monthly-empty { padding: 36px 8px; text-align: center; color: var(--muted); font-size: 14px; line-height: 1.9; }
.monthly-share-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 30; padding: 10px 20px calc(12px + env(safe-area-inset-bottom)); border-top: 1px solid var(--monthly-line); background: var(--bg); }
.monthly-share-inner { max-width: 480px; margin: 0 auto; }
button.monthly-share { width: 100%; min-height: 48px; margin: 0; padding: 10px 12px; gap: 8px; border-radius: 12px; background: var(--accent); color: var(--bg); font-size: 14px; font-weight: 600; }
.monthly-share image { width: 17px; height: 17px; flex-shrink: 0; }
.monthly-page .status,.monthly-page .inline-error { padding: 24px 0; font-size: 14px; }
.monthly-page .inline-error .secondary { min-height: 44px; font-size: 14px; }
.monthly-rules-backdrop { position: fixed; inset: 0; z-index: 110; display: flex; align-items: flex-end; justify-content: center; background:var(--overlay-scrim); }
.monthly-rules-sheet { display: flex; flex-direction: column; box-sizing: border-box; width: 100%; max-width: 520px; min-height: 0; border-radius:var(--sheet-radius) var(--sheet-radius) 0 0; background: var(--surface); border-top: 1px solid var(--overlay-border); padding: 10px 20px calc(12px + env(safe-area-inset-bottom)); }
.monthly-sheet-handle { width: 34px; height: 4px; margin: 0 auto 8px; flex-shrink: 0; border-radius: 4px; background: var(--border); }
.monthly-rules-heading { display: flex; align-items: center; gap: 10px; min-height: 66px; flex-shrink: 0; border-bottom: 1px solid rgba(177,191,198,.14); font-size: 19px; font-weight: 600; }
.monthly-rules-heading > image { width: 24px; height: 24px; flex-shrink: 0; }
.monthly-rules-heading > view { min-width: 0; flex: 1; }
.monthly-rules-heading text { display: block; font-weight: 400; font-size: 12px; color: var(--muted); }
.monthly-rules-heading button { min-width: 44px; width: 44px; min-height: 44px; margin: 0 -10px 0 0; padding: 0; color: var(--muted); font-size: 27px; }
.monthly-rules-body { height: 55vh; min-height: 0; flex-shrink: 1; }
.monthly-rule { display: flex; align-items: baseline; gap: 12px; padding: 15px 0; border-bottom: 1px solid rgba(177,191,198,.14); font-size: 14px; line-height: 1.9; }
.monthly-rule > text { color: var(--accent); font-size: 12px; width: 15px; flex-shrink: 0; }
.monthly-rule > view { min-width: 0; color: var(--muted); }
.monthly-rules-footer { flex-shrink: 0; padding-top: 14px; }
.monthly-rules-footer button { min-height: 48px; width: 100%; margin: 0; color: var(--bg); background: var(--accent); font-size: 15px; font-weight: 600; border-radius: 12px; }
@media (max-width: 374px) { .monthly-overview { gap: 13px; } .monthly-overview > view { gap: 6px; } .monthly-overview > view + view { padding-left: 13px; } .monthly-overview-value { font-size: 27px; } .monthly-overview .monthly-caption { font-size: 11px; } .monthly-value { font-size: 25px; } .monthly-compact { font-size: 17px; } }
@media (max-width: 350px) { .monthly-page { padding-left: 12px; padding-right: 12px; } .monthly-hero,.monthly-tabs { margin-left: -12px; margin-right: -12px; } .monthly-board { padding: 0 12px; } button.monthly-row { gap: 7px; } .monthly-avatar { width: 31px; height: 31px; } .monthly-name { font-size: 14px; } .monthly-value { font-size: 23px; } .monthly-compact { font-size: 16px; } .monthly-share-bar { padding-left: 16px; padding-right: 16px; } }
