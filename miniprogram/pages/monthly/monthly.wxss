.monthly-page { --monthly-border: #3c515b; --monthly-bg: #0e2028; padding: 0 42rpx calc(28rpx + env(safe-area-inset-bottom)); max-width: 640px; background: var(--monthly-bg); }
.monthly-hero { position: relative; overflow: hidden; height: 328rpx; margin: 0 -42rpx; padding: 44rpx 42rpx; box-sizing: border-box; }
.monthly-hero-art { position: absolute; top: 0; left: 0; width: 100%; height: auto; }
.monthly-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, var(--monthly-bg), transparent 28%); pointer-events: none; }
.monthly-hero-content { position: relative; z-index: 1; }
.monthly-month-picker { display: flex; align-items: center; gap: 14rpx; min-height: 48px; width: fit-content; color: var(--accent); font-size: 27rpx; }
.monthly-picker-arrow { width: 10rpx; height: 10rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); margin-top: -6rpx; }
.monthly-title { font-family: "Songti SC", serif; font-size: 70rpx; line-height: 1.2; letter-spacing: 4rpx; font-weight: 600; margin-top: 12rpx; }
.monthly-overview { display: flex; padding: 32rpx 0 38rpx; border-top: 1rpx solid var(--accent); border-bottom: 1rpx solid var(--border); }
.monthly-overview > view { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 22rpx; }
.monthly-overview > view + view { border-left: 1rpx solid var(--monthly-border); }
.monthly-overview-value { font-size: 76rpx; line-height: 1.1; font-family: "Songti SC", serif; color: var(--accent); overflow-wrap: anywhere; }
.monthly-caption { color: var(--muted); font-size: 23rpx; line-height: 1.6; overflow-wrap: anywhere; }
.monthly-overview .monthly-caption { white-space: nowrap; font-size: 25rpx; }
.monthly-board { margin-top: 48rpx; }
.monthly-section-title { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 40rpx; font-family: "Songti SC", serif; font-weight: 600; line-height: 1.4; }
.monthly-heading-label { display: flex; align-items: center; gap: 18rpx; min-width: 0; }
.monthly-heading-icon { width: 42rpx; height: 42rpx; flex-shrink: 0; }
.monthly-top-label { font-size: 21rpx; color: var(--accent); font-weight: 400; font-family: -apple-system, "PingFang SC", sans-serif; white-space: nowrap; }
.monthly-board-caption { margin: 8rpx 0 16rpx 60rpx; }
button.monthly-row { width: 100%; display: flex; justify-content: flex-start; text-align: left; gap: 22rpx; padding: 22rpx 0; margin: 0; min-height: 134rpx; border-radius: 0; border-bottom: 1rpx solid var(--monthly-border); font-weight: 400; }
button.monthly-row:last-child { border-bottom: 0; }
.monthly-row-first { background: linear-gradient(90deg, rgba(229,198,139,.04), transparent); }
.monthly-rank { width: 64rpx; height: 76rpx; flex-shrink: 0; position: relative; display: flex; align-items: center; justify-content: center; color: #bf9278; font-size: 32rpx; font-family: "Songti SC", serif; }
.monthly-rank image { position: absolute; inset: 0; width: 100%; height: 100%; }
.monthly-rank-1 { color: var(--accent); }
.monthly-rank-2 { color: #a9c2ce; }
.monthly-avatar { width: 76rpx; height: 76rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; border: 1rpx solid var(--muted); color: var(--text); background: var(--surface); font-family: "Songti SC", serif; font-size: 36rpx; }
.monthly-avatar-1 { border-color: var(--accent); }
.monthly-avatar-3 { border-color: #bf9278; }
.monthly-avatar image { width: 100%; height: 100%; }
.monthly-identity { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.monthly-name-line { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; min-width: 0; }
.monthly-name { font-size: 32rpx; font-weight: 600; overflow-wrap: anywhere; }
.monthly-tied { color: var(--muted); font-size: 18rpx; line-height: 1.5; padding: 0 6rpx; border: 1rpx solid var(--border); border-radius: 4rpx; white-space: nowrap; }
.monthly-value { max-width: 36%; flex-shrink: 0; font-size: 56rpx; line-height: 1.2; font-family: "Songti SC", serif; text-align: right; overflow-wrap: anywhere; }
.monthly-row-first .monthly-value { color: var(--accent); }
.monthly-compact { font-size: 32rpx; }
.monthly-unit { font-size: 23rpx; margin-left: 6rpx; color: var(--muted); font-family: -apple-system, "PingFang SC", sans-serif; font-weight: 400; }
.monthly-empty { padding: 56rpx 0; line-height: 1.8; }
.monthly-tabs { display: flex; gap: 16rpx; margin-top: 28rpx; border-bottom: 1rpx solid var(--border); }
.monthly-tabs button { flex: 1; width: 0; min-width: 0; min-height: 48px; margin: 0; padding: 12rpx 8rpx; font-size: 28rpx; border-radius: 0; color: var(--muted); }
.monthly-tabs button.selected { color: var(--accent); border-bottom: 3rpx solid var(--accent); }
.monthly-share-bar { padding-top: 28rpx; }
button.monthly-share { width: 100%; min-height: 52px; margin: 0; background: var(--accent); color: var(--bg); font-size: 30rpx; font-weight: 600; }
@media (orientation: landscape) { .monthly-hero { height: 230px; } .monthly-caption { font-size: 14px; } .monthly-name { font-size: 18px; } .monthly-value { font-size: 30px; } .monthly-unit, .monthly-tied { font-size: 13px; } .monthly-tabs button, button.monthly-share { font-size: 16px; } }
