<template name="monthly-board">
  <view wx:if="{{board.rows.length}}" class="monthly-board">
    <view class="monthly-board-header"><image class="monthly-heading-icon {{board.portrait?'monthly-role-art':''}}" src="{{board.portrait || board.iconPath}}" mode="aspectFit" aria-hidden="true" /><view class="monthly-heading-copy"><view class="monthly-section-title">{{board.title}}</view><view class="monthly-caption monthly-board-caption">{{board.subtitle}}</view></view><text class="monthly-top-label">TOP 3</text></view>
    <button wx:for="{{board.rows}}" wx:key="publicId" class="monthly-row {{item.rank===1?'monthly-row-first':''}}" data-id="{{item.publicId}}" bindtap="openMonthlyPlayer" hover-class="none" aria-label="{{(item.tied?'并列':'')+'第'+item.rank+'名，'+item.nickname+'，'+item.value+board.unit+'，查看玩家战绩'}}">
      <text class="monthly-rank monthly-rank-{{item.rank}}" aria-hidden="true">{{item.rankLabel}}</text>
      <view class="monthly-avatar" aria-hidden="true"><image wx:if="{{item.avatarSrc}}" src="{{item.avatarSrc}}" mode="aspectFill" /><text wx:else>{{item.initial}}</text></view>
      <view class="monthly-identity"><view class="monthly-name-line"><text class="monthly-name">{{item.nickname}}</text><text wx:if="{{item.tied}}" class="monthly-tied">并列</text></view><text class="monthly-caption">{{item.secondaryLabel}}</text></view>
      <view class="monthly-value {{item.valueCompact?'monthly-compact':''}}">{{item.value}}<text class="monthly-unit">{{board.unit}}</text></view>
    </button>
  </view>
</template>
<app-nav title="月度战报" back="{{true}}" backLabel="返回我的" bindback="back" />
<view class="page monthly-page">
  <view class="monthly-hero"><image class="monthly-hero-art" src="/assets/monthly-report-background.jpg" mode="widthFix" aria-hidden="true" /><view class="monthly-hero-content"><picker mode="date" fields="month" value="{{month}}" start="{{minMonth}}" end="{{maxMonth}}" bindchange="chooseMonth" aria-label="选择月报月份"><view class="monthly-month-picker">{{report?report.monthLabel:month}}<view class="monthly-picker-arrow" aria-hidden="true" /></view></picker><view class="monthly-title">月度战报</view><view wx:if="{{report}}" class="monthly-preview-status"><view class="monthly-status-dot" aria-hidden="true" />{{report.statusLabel}}</view></view></view>
  <view wx:if="{{loading && !connectionVisible}}" class="status" role="status">正在生成月度战报…</view>
  <view wx:if="{{error && !connectionVisible}}" class="inline-error" role="alert"><text>{{error}}</text><button class="secondary" bindtap="retry" disabled="{{loading}}" hover-class="none">重试</button></view>
  <block wx:if="{{report && !loading}}">
    <view class="monthly-overview"><view><text class="monthly-overview-value">{{report.overview.games}}</text><text class="monthly-caption">有效对局</text></view><view><text class="monthly-overview-value">{{report.overview.players}}</text><text class="monthly-caption">参赛玩家</text></view><button hover-class="none" bindtap="openRules" aria-label="查看月报统计说明"><image src="/assets/record-info.svg" aria-hidden="true" /></button></view>
    <view wx:if="{{!report.canShare}}" class="monthly-empty"><view>这个月还没有有效对局</view><text class="monthly-caption">换一个月份，或完成对局后再来看看。</text></view>
    <block wx:else>
      <view class="monthly-tabs" style="top: {{navTop}}px;" role="tablist" aria-label="月报类别"><button bindtap="chooseCategory" data-id="overall" class="{{category === 'overall'?'selected':''}}" role="tab" aria-selected="{{category === 'overall'}}" aria-controls="monthly-board-panel" hover-class="none">综合榜单</button><button bindtap="chooseCategory" data-id="honors" class="{{category === 'honors'?'selected':''}}" role="tab" aria-selected="{{category === 'honors'}}" aria-controls="monthly-board-panel" hover-class="none">趣味荣誉</button><button bindtap="chooseCategory" data-id="fun" class="{{category === 'fun'?'selected':''}}" role="tab" aria-selected="{{category === 'fun'}}" aria-controls="monthly-board-panel" hover-class="none">娱乐榜</button></view>
      <view class="monthly-boards" id="monthly-board-panel" role="tabpanel" aria-label="{{category==='overall'?'综合榜单':entertainment?'娱乐榜':'趣味荣誉'}}">
        <block wx:if="{{category === 'overall'}}"><block wx:for="{{report.coreBoards}}" wx:key="id"><template is="monthly-board" data="{{board:item}}" /></block><block wx:for="{{report.extraBoards}}" wx:key="id"><template is="monthly-board" data="{{board:item}}" /></block><view wx:if="{{!report.coreBoards.length && !report.extraBoards.length}}" class="monthly-category-empty">暂无达到入榜条件的综合榜单。</view></block>
        <block wx:else><view class="monthly-category-note"><image src="{{entertainment?'/assets/record-spark.svg':'/assets/record-medal.svg'}}" aria-hidden="true" /><text>{{entertainment?'另一种值得记录的桌边趣事':'那些值得记住的高光时刻'}}</text></view><block wx:for="{{detailBoards}}" wx:key="id"><template is="monthly-board" data="{{board:item}}" /></block><view wx:if="{{!detailBoards.length}}" class="monthly-category-empty">这个月暂无{{entertainment?'娱乐榜':'趣味荣誉'}}记录。</view></block>
      </view>
      <view class="monthly-share-bar"><view class="monthly-asof">统计截至 {{report.asOfLabel}} · {{report.versionLabel}}</view><button class="monthly-share" bindtap="share" loading="{{shareOpening}}" disabled="{{shareOpening || loading}}" hover-class="none"><image src="/assets/share-dark.svg" aria-hidden="true" />{{entertainment?'生成娱乐版分享图':'生成月报分享图'}}</button><button hover-class="none" class="monthly-rules-entry" bindtap="openRules">统计口径与入榜规则<text aria-hidden="true">›</text></button></view>
    </block>
  </block>
</view>
<view wx:if="{{rulesExpanded && report}}" class="monthly-rules-backdrop" catchtap="closeRules" catchtouchmove="blockScroll"><view class="monthly-rules-sheet" style="max-height: calc(100vh - {{navTop}}px - 16px);" role="dialog" aria-modal="true" aria-label="月报统计口径" catchtap="blockScroll"><view class="monthly-sheet-handle" aria-hidden="true" /><view class="monthly-rules-heading"><image src="/assets/record-info.svg" aria-hidden="true" /><view>统计口径<text>{{report.monthLabel}}</text></view><button bindtap="closeRules" hover-class="none" aria-label="关闭统计说明">×</button></view><scroll-view scroll-y class="monthly-rules-body"><view wx:for="{{report.rules}}" wx:key="*this" class="monthly-rule"><text>{{index+1}}</text><view>{{item}}</view></view></scroll-view><view class="monthly-rules-footer"><button bindtap="closeRules" hover-class="none">知道了</button></view></view></view>
<include src="../../player-card.wxml" />
<app-dialog id="app-dialog" />
