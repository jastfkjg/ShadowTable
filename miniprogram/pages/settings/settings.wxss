.settings-page {
  padding-top: 40rpx;
}
.settings-header {
  margin: 0 8rpx 40rpx;
}
.settings-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.settings-eyebrow {
  color: var(--accent);
  font-size: 26rpx;
}
.settings-save-status {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 24rpx;
  text-align: right;
}
.settings-title {
  font-size: 42rpx;
  font-weight: 650;
  line-height: 1.35;
  margin-bottom: 20rpx;
  overflow-wrap: break-word;
}
.settings-header-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.settings-meta-dot {
  color: var(--accent);
}
.settings-phase {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border-radius: 10rpx;
  background: #3b372d;
  color: var(--accent);
  font-size: 24rpx;
  line-height: 1.5;
}
.settings-phase-lobby {
  background: #293e38;
  color: var(--good);
}
.settings-section-title {
  color: var(--muted);
  font-size: 28rpx;
  font-weight: 600;
  margin: 36rpx 0 16rpx;
}
.settings-section {
  background: var(--surface);
  border-radius: 44rpx;
  overflow: hidden;
}
.settings-config {
  padding: 0 28rpx;
}
.settings-config > picker + picker,
.settings-config > view + view {
  border-top: 1rpx solid rgba(177, 191, 198, 0.13);
}
.settings-config-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 108rpx;
  padding: 24rpx 0;
  box-sizing: border-box;
}
.settings-config-picker:active .settings-config-row {
  opacity: 0.72;
}
.settings-config-disabled {
  opacity: 0.5;
}
.settings-config-label {
  flex-shrink: 0;
  font-weight: 500;
}
.settings-config-value {
  flex: 1;
  min-width: 0;
  color: var(--accent);
  line-height: 1.45;
  text-align: right;
  overflow-wrap: break-word;
}
.settings-config-readonly { color: var(--muted); }
.settings-config-chevron {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 36rpx;
  line-height: 1;
}
.settings-row {
  min-height: 112rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
}
.settings-row + .settings-row {
  border-top: 1rpx solid rgba(177, 191, 198, 0.13);
}
.settings-rules,
.settings-management {
  padding: 0 28rpx;
}
.settings-row-content {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}
.settings-rule {
  padding: 28rpx 0;
}
.settings-caption {
  color: var(--muted);
  font-size: 26rpx;
  margin-top: 4rpx;
}
.management-help {
  color: var(--muted);
  font-size: 26rpx;
  margin-top: 4rpx;
  line-height: 1.5;
}
.settings-footer {
  margin-top: 48rpx;
}
.settings-footer button.settings-return,
.settings-footer button.settings-return[disabled]:not([type]) {
  width: 100%;
  min-height: 96rpx;
  margin: 0;
  gap: 14rpx;
  border: 0;
  border-radius: 32rpx;
  background: var(--surface);
  color: var(--text);
  font-weight: 600;
}
.settings-return-arrow {
  color: var(--accent);
  font-size: 36rpx;
  line-height: 1;
}
.settings-error {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #d89c92;
  border-radius: 16rpx;
  color: #f2b6ae;
}
switch {
  flex-shrink: 0;
}
.management-entry + .management-entry {
  border-top: 1rpx solid rgba(177, 191, 198, 0.13);
}
.settings-management button.management-button,
.settings-management button.management-button[disabled]:not([type]) {
  display: flex;
  justify-content: space-between;
  width: 100%;
  min-height: 120rpx;
  margin: 0;
  padding: 22rpx 0;
  gap: 24rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 32rpx;
  font-weight: 500;
  text-align: left;
}
.settings-management button.management-button[disabled]:not([type]) { opacity: 1; }
.management-icon-well {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
}
.management-icon-gold { background: #3b372d; }
.management-icon-blue { background: #263e52; }
.management-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}
.management-copy {
  flex: 1;
  min-width: 0;
}
.management-disabled .management-label,
.management-disabled .management-icon-well,
.management-disabled .management-chevron { opacity: 0.55; }
.management-chevron {
  color: var(--muted);
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
}
.transfer-dialog {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 660rpx;
  max-height: calc(100vh - 96rpx);
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid var(--overlay-border);
  border-radius:var(--dialog-radius);
  background: var(--surface);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.3);
}
.transfer-header {
  flex-shrink: 0;
  padding: 32rpx 32rpx 24rpx;
}
.transfer-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.transfer-count {
  color: var(--muted);
  font-size: 24rpx;
  flex-shrink: 0;
}
.transfer-list {
  width: 100%;
  min-height: 0;
  max-height: 52vh;
  flex-shrink: 1;
  border-top: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}
.transfer-dialog button.transfer-option,
.transfer-dialog button.transfer-option[disabled]:not([type]) {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  width: 100%;
  max-width: none;
  min-width: 0;
  min-height: 104rpx;
  margin: 0;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--text);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
}
.transfer-dialog button.transfer-option + button.transfer-option {
  border-top: 1rpx solid rgba(177, 191, 198, 0.14);
}
.transfer-seat {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--bg);
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}
.transfer-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}
.transfer-chevron {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 36rpx;
}
.transfer-dialog button.transfer-option-hover,
.transfer-dialog button.transfer-option-hover[disabled]:not([type]) {
  background: rgba(229, 198, 139, 0.08);
}
.transfer-footer {
  flex-shrink: 0;
  padding: 20rpx 24rpx;
}
.transfer-dialog button.transfer-cancel,
.transfer-dialog button.transfer-cancel[disabled]:not([type]) {
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius:var(--dialog-control-radius);
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-weight: 400;
}

.kick-label { color: var(--evil); }
.kick-label { flex-shrink: 0; font-size: 28rpx; }
