.settings-page {
  padding-top: 48rpx;
}
.settings-header {
  margin-bottom: 56rpx;
}
.settings-eyebrow {
  color: var(--accent);
  font-size: 26rpx;
  margin-bottom: 12rpx;
}
.settings-title {
  font-size: 42rpx;
  font-weight: 650;
  margin-bottom: 8rpx;
}
.settings-section-title {
  color: var(--muted);
  font-size: 28rpx;
  margin: 40rpx 0 16rpx;
}
.settings-section {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  overflow: hidden;
}
.settings-row {
  min-height: 112rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
}
.settings-row + .settings-row,
.settings-section picker + picker {
  border-top: 1rpx solid var(--border);
}
.settings-value {
  text-align: right;
  max-width: 70%;
  overflow-wrap: break-word;
}
.settings-caption {
  color: var(--muted);
  font-size: 26rpx;
  margin-top: 4rpx;
}
.settings-help {
  color: var(--muted);
  font-size: 26rpx;
  margin: 16rpx 8rpx 0;
  line-height: 1.7;
}
.settings-footer {
  margin-top: 64rpx;
}
.settings-error {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #d89c92;
  border-radius: 16rpx;
  color: #f2b6ae;
}
switch {
  flex-shrink: 0;
}
.transfer-entry {
  margin-top: 40rpx;
}
.transfer-dialog {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 660rpx;
  max-height: calc(100vh - 96rpx);
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 28rpx;
  background: var(--surface);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.3);
}
.transfer-header {
  flex-shrink: 0;
  padding: 32rpx 32rpx 24rpx;
}
.transfer-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.transfer-count {
  color: var(--muted);
  font-size: 24rpx;
  flex-shrink: 0;
}
.transfer-description {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--muted);
}
.transfer-list {
  width: 100%;
  min-height: 0;
  max-height: 52vh;
  flex-shrink: 1;
  border-top: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}
.transfer-dialog button.transfer-option,
.transfer-dialog button.transfer-option[disabled]:not([type]) {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  width: 100%;
  max-width: none;
  min-width: 0;
  min-height: 104rpx;
  margin: 0;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--text);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
}
.transfer-dialog button.transfer-option + button.transfer-option {
  border-top: 1rpx solid rgba(177, 191, 198, 0.14);
}
.transfer-seat {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--bg);
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}
.transfer-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}
.transfer-chevron {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 36rpx;
}
.transfer-dialog button.transfer-option-hover,
.transfer-dialog button.transfer-option-hover[disabled]:not([type]) {
  background: rgba(229, 198, 139, 0.08);
}
.transfer-footer {
  flex-shrink: 0;
  padding: 20rpx 24rpx;
}
.transfer-dialog button.transfer-cancel,
.transfer-dialog button.transfer-cancel[disabled]:not([type]) {
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius: 16rpx;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-weight: 400;
}

button.kick-entry, .kick-label,
button.kick-entry[disabled]:not([type]) { color: var(--evil); }
.kick-label { flex-shrink: 0; font-size: 28rpx; }
