.settings-page {
  padding-top: 28rpx;
}
.settings-header {
  margin-bottom: 48rpx;
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
}
.settings-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.settings-eyebrow {
  color: var(--accent);
  font-size: 26rpx;
}
.settings-save-status {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 24rpx;
  text-align: right;
}
.settings-title {
  font-size: 42rpx;
  font-weight: 650;
  line-height: 1.35;
  margin-bottom: 20rpx;
  overflow-wrap: break-word;
}
.settings-header-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.settings-phase {
  flex-shrink: 0;
  padding: 4rpx 18rpx;
  border: 1rpx solid rgba(138, 184, 217, 0.48);
  border-radius: 999rpx;
  background: rgba(138, 184, 217, 0.12);
  color: var(--third);
  font-size: 24rpx;
  line-height: 1.5;
}
.settings-section-title {
  color: var(--muted);
  font-size: 28rpx;
  font-weight: 600;
  margin: 36rpx 0 16rpx;
}
.settings-section {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  overflow: hidden;
}
.settings-config {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}
.settings-config-picker,
.settings-config > .settings-config-tile {
  flex: 1;
  min-width: 0;
}
.settings-config-tile {
  position: relative;
  height: 100%;
  min-height: 192rpx;
  padding: 26rpx 32rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  background: var(--surface);
}
.settings-config-picker:active .settings-config-tile {
  background: var(--control-bg);
}
.settings-config-disabled {
  opacity: 0.5;
}
.settings-config-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 12rpx;
}
.settings-config-label {
  padding-right: 24rpx;
  font-weight: 600;
}
.settings-config-value {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.45;
  overflow-wrap: break-word;
}
.settings-config-chevron {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  line-height: 1;
}
.settings-row {
  min-height: 112rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
}
.settings-row + .settings-row {
  border-top: 1rpx solid var(--border);
}
.settings-rules,
.settings-management {
  padding: 0 12rpx;
}
.settings-row-content {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}
.settings-rule {
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}
.settings-caption {
  color: var(--muted);
  font-size: 26rpx;
  margin-top: 4rpx;
}
.management-help {
  color: var(--muted);
  font-size: 26rpx;
  padding: 0 20rpx 24rpx 96rpx;
  line-height: 1.5;
}
.settings-footer {
  margin-top: 64rpx;
}
.settings-error {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #d89c92;
  border-radius: 16rpx;
  color: #f2b6ae;
}
switch {
  flex-shrink: 0;
}
.management-entry + .management-entry {
  border-top: 1rpx solid var(--border);
}
.settings-management button.management-button,
.settings-management button.management-button[disabled]:not([type]) {
  display: flex;
  justify-content: space-between;
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 24rpx 20rpx;
  gap: 28rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  font-size: 32rpx;
  font-weight: 600;
  text-align: left;
}
.management-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}
.management-label {
  flex: 1;
  min-width: 0;
}
.management-chevron {
  color: var(--muted);
  flex-shrink: 0;
  font-size: 40rpx;
  line-height: 1;
}
.transfer-dialog {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 660rpx;
  max-height: calc(100vh - 96rpx);
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid var(--overlay-border);
  border-radius:var(--dialog-radius);
  background: var(--surface);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.3);
}
.transfer-header {
  flex-shrink: 0;
  padding: 32rpx 32rpx 24rpx;
}
.transfer-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.transfer-count {
  color: var(--muted);
  font-size: 24rpx;
  flex-shrink: 0;
}
.transfer-list {
  width: 100%;
  min-height: 0;
  max-height: 52vh;
  flex-shrink: 1;
  border-top: 1rpx solid var(--border);
  border-bottom: 1rpx solid var(--border);
  box-sizing: border-box;
}
.transfer-dialog button.transfer-option,
.transfer-dialog button.transfer-option[disabled]:not([type]) {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
  width: 100%;
  max-width: none;
  min-width: 0;
  min-height: 104rpx;
  margin: 0;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--text);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
}
.transfer-dialog button.transfer-option + button.transfer-option {
  border-top: 1rpx solid rgba(177, 191, 198, 0.14);
}
.transfer-seat {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--bg);
  color: var(--accent);
  font-size: 26rpx;
  font-weight: 600;
}
.transfer-name {
  flex: 1;
  min-width: 0;
  overflow-wrap: break-word;
}
.transfer-chevron {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 36rpx;
}
.transfer-dialog button.transfer-option-hover,
.transfer-dialog button.transfer-option-hover[disabled]:not([type]) {
  background: rgba(229, 198, 139, 0.08);
}
.transfer-footer {
  flex-shrink: 0;
  padding: 20rpx 24rpx;
}
.transfer-dialog button.transfer-cancel,
.transfer-dialog button.transfer-cancel[disabled]:not([type]) {
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  border: 0;
  border-radius:var(--dialog-control-radius);
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-weight: 400;
}

.kick-label { color: var(--evil); }
.kick-label { flex-shrink: 0; font-size: 28rpx; }
