<import src="../../loading-placeholder.wxml" />
<app-nav title="房间设置" back="{{true}}" backLabel="返回牌桌" bindback="back" />
<view class="page settings-page">
  <template wx:if="{{loading && !room}}" is="loadingPlaceholder" data="{{kind:'list'}}" />
  <view wx:if="{{error && !connectionVisible}}" class="settings-error" role="alert">{{error}}</view>
  <button hover-class="none" wx:if="{{error && !connectionVisible && authorized && (dirty || pendingSave)}}" class="secondary" bindtap="save" disabled="{{busy || refreshing || pendingTransfer || pendingKick}}">重试保存</button>
  <block wx:if="{{!loading && authorized}}">
    <view class="settings-header">
      <view class="settings-header-top"><view class="settings-eyebrow">房间 {{room.code}} · 管理员</view><view class="settings-save-status" role="status">{{pendingSave?(busy?'正在保存…':'保存未确认'):dirty?'尚未保存':''}}</view></view>
      <view class="settings-title">{{room.boardName}}</view>
      <view class="settings-header-meta"><view class="muted">{{room.capacity}} 人</view><view class="settings-meta-dot" aria-hidden="true">·</view><view class="settings-phase {{room.phase==='lobby'?'settings-phase-lobby':''}}">{{room.phase==='lobby'?'准备中':room.phase==='ended'?'本局已结束':room.phase==='terminated'?'本局已终止':'对局进行中'}}</view></view>
    </view>
    <view class="settings-section-title">房间配置</view>
    <view class="settings-section settings-config">
      <picker wx:if="{{room.phase==='lobby'}}" class="settings-config-picker" range="{{capacities}}" value="{{capacityIndex}}" bindchange="pickCapacity" disabled="{{busy || refreshing || pendingSave || pendingTransfer || pendingKick}}">
        <view class="settings-config-row {{busy || refreshing || pendingSave || pendingTransfer || pendingKick ? 'settings-config-disabled' : ''}}"><text class="settings-config-label">人数</text><text class="settings-config-value">{{capacity}} 人</text><text class="settings-config-chevron" aria-hidden="true">›</text></view>
      </picker>
      <view wx:else class="settings-config-row"><text class="settings-config-label">人数</text><text class="settings-config-value settings-config-readonly">{{room.capacity}} 人</text></view>
      <picker wx:if="{{room.phase==='lobby'}}" class="settings-config-picker" range="{{choices}}" range-key="name" value="{{boardIndex}}" bindchange="pickBoard" disabled="{{busy || refreshing || pendingSave || pendingTransfer || pendingKick}}">
        <view class="settings-config-row {{busy || refreshing || pendingSave || pendingTransfer || pendingKick ? 'settings-config-disabled' : ''}}"><text class="settings-config-label">板子</text><text class="settings-config-value">{{choices[boardIndex].name}}</text><text class="settings-config-chevron" aria-hidden="true">›</text></view>
      </picker>
      <view wx:else class="settings-config-row"><text class="settings-config-label">板子</text><text class="settings-config-value settings-config-readonly">{{room.boardName}}</text></view>
    </view>
    <view class="settings-section-title">对局规则</view>
    <view class="settings-section settings-rules">
      <view wx:if="{{room.recordSettings}}" class="settings-row settings-rule">
        <view class="settings-row-content"><view>不计战绩</view><view class="settings-caption">保留对局记录，不计入胜率、积分和趣味统计。{{room.recordSettings.editable?'发牌后固定':'本局设置已固定'}}</view></view>
        <switch checked="{{recordPurpose==='test'}}" bindchange="toggleRecordPurpose" color="#c3a361" disabled="{{busy || refreshing || pendingSave || pendingTransfer || pendingKick || !room.recordSettings.editable}}" aria-label="不计战绩" />
      </view>
      <view wx:if="{{room.scoreSettings}}" class="settings-row settings-rule">
        <view class="settings-row-content"><view>本局计分</view><view class="settings-caption">{{room.scoreSettings.unavailableReason || (scoreEnabled?'已开启':'已关闭')}} · {{room.scoreSettings.editable?'发牌后固定':'本局设置已固定'}}</view></view>
        <switch checked="{{scoreEnabled}}" bindchange="toggleScoring" color="#c3a361" disabled="{{busy || refreshing || pendingSave || pendingTransfer || pendingKick || !room.scoreSettings.editable}}" aria-label="本局计分" />
      </view>
      <view class="settings-row settings-rule">
        <view class="settings-row-content"><view>启用湖中仙女</view><view class="settings-caption">{{7 > capacity?'5、6人局不支持':fairyEnabled?'持有者对所有玩家公开':'本房间不使用仙女查验'}}</view><view wx:if="{{room.phase==='fairy'}}" class="settings-caption">请先完成或作废当前查验。</view></view>
        <switch checked="{{fairyEnabled}}" bindchange="toggleFairy" color="#c3a361" disabled="{{busy || refreshing || pendingSave || pendingTransfer || pendingKick || 7 > capacity || room.phase==='fairy'}}" aria-label="启用湖中仙女"/>
      </view>
      <view wx:if="{{boardId==='knights' || boardId==='knights-10' || boardId==='knights-11' || boardId==='knights-13'}}" class="settings-row settings-rule">
        <view class="settings-row-content"><view>公开技能过程</view><view class="settings-caption">{{visible?'所有玩家可见':'仅公示最终结果'}}</view></view>
        <switch checked="{{visible}}" bindchange="toggleVisibility" color="#c3a361" disabled="{{busy || refreshing || pendingSave || pendingTransfer || pendingKick}}" aria-label="公开技能过程"/>
      </view>
    </view>
    <view class="settings-section-title">房主管理</view>
    <view class="settings-section settings-management">
      <view class="management-entry">
        <button hover-class="none" class="management-button {{busy || refreshing || pendingSave || pendingTransfer || pendingKick || !transferPlayers.length ? 'management-disabled' : ''}}" bindtap="openTransfer" disabled="{{busy || refreshing || pendingSave || pendingTransfer || pendingKick || !transferPlayers.length}}"><view class="management-icon-well management-icon-gold"><image class="management-icon" src="/assets/settings-host.svg" aria-hidden="true" /></view><view class="management-copy"><view class="management-label">移交房主</view><view wx:if="{{!transferPlayers.length}}" class="management-help">暂无可移交的玩家</view></view><text class="management-chevron" aria-hidden="true">›</text></button>
      </view>
      <view class="management-entry">
        <button hover-class="none" class="management-button {{busy || refreshing || pendingSave || pendingTransfer || pendingKick || !room.canKick || !transferPlayers.length ? 'management-disabled' : ''}}" bindtap="openKick" disabled="{{busy || refreshing || pendingSave || pendingTransfer || pendingKick || !room.canKick || !transferPlayers.length}}"><view class="management-icon-well management-icon-blue"><image class="management-icon" src="/assets/room-menu-remove.svg" aria-hidden="true" /></view><view class="management-copy"><view class="management-label">移出玩家</view><view wx:if="{{!room.canKick || !transferPlayers.length}}" class="management-help">{{room.canKick === undefined?'暂不支持移出玩家':!room.canKick?'对局进行中不能移出玩家':'暂无可移出的玩家'}}</view></view><text class="management-chevron" aria-hidden="true">›</text></button>
      </view>
    </view>
    <button hover-class="none" wx:if="{{pendingKick}}" class="secondary" bindtap="sendKick" disabled="{{busy}}">重试确认移出结果</button>
    <button hover-class="none" wx:if="{{pendingTransfer}}" class="secondary" bindtap="sendTransfer" disabled="{{busy}}">重试确认移交结果</button>
    <view class="settings-footer">
      <button hover-class="none" class="settings-return" bindtap="back" disabled="{{busy}}"><text class="settings-return-arrow" aria-hidden="true">←</text><text>返回牌桌</text></button>
    </view>
  </block>
  <block wx:if="{{!loading && !authorized}}">
    <button hover-class="none" class="secondary" bindtap="load">重新加载</button>
    <button hover-class="none" class="text-button" bindtap="back">返回牌桌</button>
  </block>
</view>

<view wx:if="{{showTransferPicker && authorized}}" class="dialog-backdrop" catchtap="closeTransfer" catchtouchmove="stopPropagation">
  <view class="transfer-dialog" catchtap="stopPropagation" role="dialog" aria-modal="true" aria-label="选择新房主">
    <view class="transfer-header">
      <view class="transfer-heading"><view class="dialog-title">选择新房主</view><text class="transfer-count">{{transferPlayers.length}} 位玩家</text></view>
    </view>
    <scroll-view class="transfer-list" style="height: {{transferPlayers.length * 104}}rpx" scroll-y enhanced show-scrollbar="{{true}}" catchtouchmove="stopPropagation">
      <button wx:for="{{transferPlayers}}" wx:key="seat" class="transfer-option" hover-class="transfer-option-hover" bindtap="transfer" data-seat="{{item.seat}}" disabled="{{busy}}">
        <text class="transfer-seat">{{item.seat}}</text><text class="transfer-name">{{item.name}}</text><text class="transfer-chevron" aria-hidden="true">›</text>
      </button>
    </scroll-view>
    <view class="transfer-footer"><button hover-class="none" class="transfer-cancel" bindtap="closeTransfer" disabled="{{busy}}">取消</button></view>
  </view>
</view>

<view wx:if="{{showKickPicker && authorized}}" class="dialog-backdrop" catchtap="closeKick" catchtouchmove="stopPropagation">
  <view class="transfer-dialog" catchtap="stopPropagation" role="dialog" aria-modal="true" aria-label="选择要移出的玩家">
    <view class="transfer-header">
      <view class="transfer-heading"><view class="dialog-title">移出玩家</view><text class="transfer-count">{{transferPlayers.length}} 位玩家</text></view>
    </view>
    <scroll-view class="transfer-list" style="height: {{transferPlayers.length * 104}}rpx" scroll-y enhanced show-scrollbar="{{true}}" catchtouchmove="stopPropagation">
      <button wx:for="{{transferPlayers}}" wx:key="seat" class="transfer-option" hover-class="transfer-option-hover" bindtap="kick" data-seat="{{item.seat}}" disabled="{{busy}}" aria-label="{{'移出 '+item.seat+'号 '+item.name}}">
        <text class="transfer-seat">{{item.seat}}</text><text class="transfer-name">{{item.name}}</text><text class="kick-label">移出</text>
      </button>
    </scroll-view>
    <view class="transfer-footer"><button hover-class="none" class="transfer-cancel" bindtap="closeKick" disabled="{{busy}}">取消</button></view>
  </view>
</view>
<app-dialog id="app-dialog" />
