<import src="../home/panels.wxml" />
<import src="../me/shared.wxml" />
<import src="../shared/content.wxml" />
<block wx:if="{{singlePage}}"><template is="sharedRecordContent" data="{{intro:publicIntro,singlePage:true}}" /></block>
<block wx:else>
<app-nav title="{{activeTab === 1 ? '我的' : '对局'}}" />
<view class="main-panel" hidden="{{activeTab !== 0}}">
  <template is="lobbyPanel" data="{{...lobby, homeShell: true}}" />
</view>
<view class="main-panel" hidden="{{activeTab !== 1}}">
  <template is="personalPanel" data="{{...personal}}" />
</view>
<app-dialog id="app-dialog" />
</block>
