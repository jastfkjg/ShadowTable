.profile-page {
  padding-top: 24rpx;
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}
.profile-page.has-pending-save { padding-bottom: calc(264rpx + env(safe-area-inset-bottom)); }
.avatar-editor { padding: 16rpx 0 40rpx; gap: 16rpx; }
.avatar-preview .profile-avatar.large { width: 184rpx; height: 184rpx; }
.nickname-editor { width: 100%; max-width: 600rpx; text-align: center; }
button.nickname-display,
button.nickname-display[disabled]:not([type]) {
  width: auto;
  max-width: 100%;
  min-height: 96rpx;
  margin: 0 auto;
  padding: 12rpx 20rpx;
  gap: 16rpx;
  background: transparent;
  color: var(--text);
}
.nickname-text { min-width: 0; font-size: 40rpx; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.nickname-edit-icon { flex-shrink: 0; width: 36rpx; height: 36rpx; }
.nickname-input-row { display: flex; align-items: center; gap: 12rpx; min-height: 96rpx; }
.input.nickname-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  margin: 0;
  border-color: var(--accent);
  text-align: center;
  font-size: 36rpx;
}
.input.nickname-input.is-invalid { border-color: var(--evil); }
button.nickname-done,
button.nickname-done[disabled]:not([type]) { width: auto; flex-shrink: 0; min-height: 96rpx; margin: 0; padding: 12rpx 16rpx; color: var(--accent); background: transparent; font-size: 28rpx; }
.nickname-error { margin-top: 12rpx; color: var(--evil); font-size: 26rpx; }
.avatar-library { margin: 0; }
.custom-avatar-editor { margin: 0 0 32rpx; }
.custom-avatar-actions { display: flex; gap: 12rpx; }
button.custom-avatar-button,
button.custom-avatar-retry { width: 100%; min-height: 96rpx; margin: 0; }
button.custom-avatar-button { flex: 1; min-width: 0; }
button.custom-avatar-cancel { flex-shrink: 0; width: auto; min-height: 96rpx; margin: 0; padding: 12rpx 20rpx; background: transparent; color: var(--muted); }
.avatar-upload-hint { margin-top: 12rpx; }
.avatar-upload-status { margin-top: 12rpx; color: var(--accent); }
.avatar-upload-error { margin-top: 12rpx; color: var(--evil); font-size: 26rpx; line-height: 1.5; }
button.custom-avatar-retry { margin-top: 16rpx; }
.avatar-library .field-title { margin: 0; padding-bottom: 20rpx; border-bottom: 2rpx solid var(--border); font-size: 30rpx; }
.avatar-styles { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16rpx; padding-top: 16rpx; }
button.avatar-style,
button.avatar-style[disabled]:not([type]) { width: 100%; min-width: 0; min-height: 44px; margin: 0; padding: 12rpx 4rpx; border: 0; border-bottom: 4rpx solid transparent; border-radius: 0; color: var(--muted); background: transparent; font-size: 28rpx; line-height: 1.5; white-space: nowrap; }
button.avatar-style.is-active,
button.avatar-style.is-active[disabled]:not([type]) { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
.avatar-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16rpx; padding: 20rpx 0 0; }
.avatar-grid button.avatar-option,
.avatar-grid button.avatar-option[disabled]:not([type]) { position: relative; display: flex; align-items: center; width: 100%; min-width: 0; min-height: 136rpx; margin: 0; padding: 12rpx 4rpx; border: 2rpx solid transparent; border-radius: 20rpx; background: transparent; color: var(--muted); }
.avatar-option-image { display: block; width: 104rpx; height: 104rpx; border-radius: 50%; }
.avatar-option-selected { position: absolute; right: 4rpx; top: 4rpx; width: 32rpx; height: 32rpx; border-radius: 50%; background: var(--accent); color: var(--bg); font-size: 24rpx; line-height: 32rpx; text-align: center; }
.avatar-grid button.avatar-option.is-selected { border-color: var(--accent); background: var(--surface); color: var(--accent); }
.avatar-grid button.avatar-option:not([disabled]):active { background: var(--surface); opacity: 0.8; }
.profile-save-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; border-top: 1rpx solid var(--border); background: var(--bg); padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.profile-save-content { max-width: 836rpx; margin: 0 auto; }
button.primary.profile-save,
button.primary.profile-save[disabled]:not([type]) { width: 100%; min-height: 96rpx; margin: 0; }
.profile-save-hint { margin-bottom: 16rpx; text-align: center; }
