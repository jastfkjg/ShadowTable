.profile-page {
  --profile-line: rgba(177,191,198,.2);
  --profile-tile: rgba(27,43,53,.72);
  --profile-selected: rgba(229,198,139,.12);
  max-width: 500px;
  padding: 16px 18px calc(100px + env(safe-area-inset-bottom));
}
.profile-page.has-pending-save { padding-bottom: calc(128px + env(safe-area-inset-bottom)); }
.profile-page.has-keyboard { padding-bottom: 24px; }
.profile-page .inline-error button { min-height: 44px; }
.profile-page .avatar-editor {
  display: block;
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
}
.profile-identity-row { display: flex; align-items: center; gap: 18px; }
.avatar-preview { position: relative; flex-shrink: 0; width: 88px; min-height: 106px; text-align: center; }
.avatar-image-wrap { position: relative; width: 76px; margin: 0 auto; }
.avatar-preview .profile-avatar.large {
  display: block;
  width: 76px;
  height: 76px;
  margin: 0;
  border: 1px solid var(--profile-line);
  border-radius: 50%;
  box-sizing: border-box;
}
.avatar-preview .profile-avatar.avatar-fallback { display: flex; }
.avatar-preview-caption { display: block; margin-top: 10px; color: var(--muted); font-size: 12px; line-height: 20px; }
button.avatar-change, button.avatar-change[disabled]:not([type]) {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-direction: column;
  width: 100%;
  min-height: 106px;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: var(--muted);
  font-size: 12px;
  line-height: 20px;
}
.avatar-change-badge {
  position: absolute;
  right: 0;
  top: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  border: 2px solid var(--surface);
  border-radius: 50%;
  background: var(--accent);
  box-sizing: border-box;
}
.avatar-camera-icon { display: block; width: 18px; height: 18px; }
.avatar-upload-progress { position: absolute; left: 8px; right: 8px; bottom: -7px; height: 3px; border-radius: 3px; background: var(--control-bg); overflow: hidden; }
.avatar-upload-progress-fill { height: 100%; border-radius: inherit; background: var(--accent); transition: width 160ms ease-out; }
.nickname-editor { flex: 1; min-width: 0; text-align: left; }
.nickname-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; color: var(--muted); font-size: 12px; line-height: 20px; }
.nickname-heading > text { flex-shrink: 0; font-variant-numeric: tabular-nums; }
button.nickname-display, button.nickname-display[disabled]:not([type]) {
  display: flex;
  justify-content: space-between;
  width: 100%;
  min-height: 50px;
  margin: 0;
  padding: 4px 0 8px;
  gap: 10px;
  border: 0;
  border-bottom: 1px solid var(--control-border);
  border-radius: 0;
  background: transparent;
  color: var(--text);
  text-align: left;
}
.nickname-text { flex: 1; min-width: 0; font-size: 23px; font-weight: 600; line-height: 36px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nickname-edit-icon { display: block; width: 20px; height: 20px; flex-shrink: 0; }
.nickname-input-row { display: flex; align-items: center; width: 100%; min-height: 50px; border-bottom: 1px solid var(--accent); box-sizing: border-box; background: var(--control-bg); transition: background-color 160ms ease-out; }
.profile-page .input.nickname-input { width: 100%; flex: 1; min-width: 0; height: 49px; min-height: 49px; margin: 0; padding: 4px 0 8px; border: 0; border-radius: 0; box-sizing: border-box; background: transparent; color: var(--text); text-align: left; font-size: 23px; font-weight: 600; line-height: 36px; }
.nickname-input-row.is-invalid { border-color: var(--evil); }
.nickname-hint, .nickname-error { margin-top: 7px; font-size: 12px; line-height: 20px; }
.nickname-hint { color: var(--muted); }
.nickname-error { color: var(--evil); }
.custom-avatar-editor { display: flex; align-items: center; gap: 12px; margin-top: 16px; padding-top: 12px; border-top: 1px solid var(--profile-line); text-align: left; }
.avatar-upload-error { flex: 1; min-width: 0; color: var(--evil); font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }
button.custom-avatar-retry { flex-shrink: 0; width: auto; min-width: 52px; min-height: 44px; margin: 0; padding: 9px 12px; background: transparent; color: var(--accent); font-size: 13px; }
.avatar-library { margin-top: 20px; }
.avatar-library-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 32px; margin-bottom: 12px; }
.avatar-library .field-title { margin: 0; padding: 0; color: var(--text); font-size: 18px; font-weight: 600; line-height: 28px; }
.avatar-library-heading > text { color: var(--muted); font-size: 12px; }
.avatar-styles { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 4px; padding: 4px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
button.avatar-style, button.avatar-style[disabled]:not([type]) { width: 100%; min-width: 0; min-height: 44px; margin: 0; padding: 8px 0; border: 0; border-radius: 9px; background: transparent; color: var(--muted); font-size: 14px; line-height: 24px; transition: background-color 120ms ease-out, color 120ms ease-out; }
button.avatar-style.is-active, button.avatar-style.is-active[disabled]:not([type]) { background: var(--accent); color: var(--bg); font-weight: 600; }
.avatar-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10px 8px; padding-top: 12px; }
.avatar-grid button.avatar-option, .avatar-grid button.avatar-option[disabled]:not([type]) {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 80px;
  margin: 0;
  padding: 10px 3px;
  border: 1px solid var(--profile-line);
  border-radius: 12px;
  background: var(--profile-tile);
  color: var(--text);
  transition: background-color 120ms ease-out, border-color 120ms ease-out;
}
.avatar-option-image { display: block; flex-shrink: 0; width: 58px; height: 58px; max-width: 100%; border-radius: 50%; }
.avatar-option-selected { position: absolute; right: 3px; top: 3px; display: flex; align-items: center; justify-content: center; width: 19px; height: 19px; border: 2px solid var(--surface); border-radius: 50%; background: var(--accent); color: var(--bg); font-size: 13px; font-weight: 600; line-height: 19px; }
.avatar-grid button.avatar-option.is-selected, .avatar-grid button.avatar-option.is-selected[disabled]:not([type]) { border-color: var(--accent); background: var(--profile-selected); color: var(--accent); }
.avatar-grid button.avatar-option:not([disabled]):active { background: var(--surface); opacity: .8; }
button.avatar-change:focus-visible, button.nickname-display:focus-visible, button.avatar-style:focus-visible, .avatar-grid button.avatar-option:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.profile-save-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; padding: 10px 18px calc(16px + env(safe-area-inset-bottom)); border-top: 1px solid var(--profile-line); background: var(--bg); box-sizing: border-box; }
.profile-save-content { max-width: 464px; margin: 0 auto; }
.profile-save-hint { margin-bottom: 8px; color: var(--muted); text-align: center; font-size: 12px; line-height: 20px; }
button.primary.profile-save, button.primary.profile-save[disabled]:not([type]) { width: 100%; min-height: 52px; margin: 0; padding: 12px; border-radius: 12px; font-size: 17px; font-weight: 600; }
@media (max-width: 350px) {
  .profile-page { padding-left: 14px; padding-right: 14px; }
  .profile-page .avatar-editor { padding: 12px; }
  .profile-identity-row { gap: 12px; }
  .avatar-preview { width: 76px; min-height: 96px; }
  .avatar-image-wrap, .avatar-preview .profile-avatar.large { width: 66px; }
  .avatar-preview .profile-avatar.large { height: 66px; }
  button.avatar-change, button.avatar-change[disabled]:not([type]) { min-height: 96px; }
  .avatar-change-badge { top: 43px; }
  .nickname-text, .profile-page .input.nickname-input { font-size: 21px; }
  .avatar-grid { gap: 8px 6px; }
  .avatar-option-image { width: 52px; height: 52px; }
  .avatar-grid button.avatar-option { min-height: 76px; }
  .profile-save-bar { padding-left: 14px; padding-right: 14px; }
}
@media (prefers-reduced-motion: reduce) { .avatar-upload-progress-fill, .nickname-input-row, button.avatar-style, .avatar-grid button.avatar-option { transition: none; } }
