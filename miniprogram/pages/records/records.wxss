@import "../stats/panel.wxss";
@import "../matches/panel.wxss";
.records-shell { --records-line: rgba(177,191,198,.16); --records-selected: #30404a; display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; padding-bottom: env(safe-area-inset-bottom); overflow: hidden; }
.records-shell > app-nav { flex-shrink: 0; }
.records-tabs { display: flex; flex-shrink: 0; gap: 8px; padding: 0 12px; background: var(--bg); }
.records-tabs button { position: relative; flex: 1; min-width: 0; width: 0; margin: 0; padding: 12px 0 14px; min-height: 48px; border-radius: 0; font-size: 15px; font-weight: 400; color: var(--muted); }
.records-tabs button.selected { color: var(--accent); font-weight: 600; }
.records-tabs button.selected::before { content: ""; position: absolute; bottom: 0; left: 50%; width: 24px; height: 3px; border-radius: 3px; background: var(--accent); transform: translateX(-50%); }
.records-body { position: relative; flex: 1; min-height: 0; }
.records-pane { position: absolute; inset: 0; width: 100%; height: 100%; }
.records-pane[hidden] { display: none; }
.records-pane .page { max-width: 600px; padding: 12px 20px calc(32px + env(safe-area-inset-bottom)); }
@media (min-width: 600px) {
  .records-tabs { padding: 0 24px; }
  .records-pane .page { padding: 16px 24px calc(32px + env(safe-area-inset-bottom)); }
}

/* Keep the accepted mobile gutters for records while retaining each tab's scroll. */
.records-pane .page.matches-page, .records-pane .page.fun-page { padding-left:16px; padding-right:16px; }
