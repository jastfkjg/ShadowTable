.shared-scroll { height:100vh; width:100%; background:var(--bg); color:var(--text); }
.shared-page { max-width:600px; margin:0 auto; padding:20px 24px calc(36px + env(safe-area-inset-bottom)); box-sizing:border-box; font-size:14px; line-height:1.6; }
.shared-brand { margin-bottom:24px; color:var(--accent); font-size:13px; }
.shared-owner { display:flex; gap:12px; align-items:center; margin-bottom:26px; }
.shared-avatar { flex-shrink:0; display:block; width:44px; height:44px; border-radius:13px; background:var(--surface); }
.shared-initial { display:flex; align-items:center; justify-content:center; color:var(--accent); font-size:22px; }
.shared-owner-copy { min-width:0; overflow-wrap:anywhere; font-size:17px; font-weight:600; }
.shared-owner-copy text { display:block; color:var(--muted); font-size:12px; font-weight:400; margin-top:3px; }
.shared-muted { color:var(--muted); }
.shared-hero { position:relative; z-index:1; margin-top:8px; font-size:clamp(56px,22vw,86px); font-weight:600; line-height:1.15; letter-spacing:-3px; color:var(--accent); font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.shared-hero > text { margin-left:7px; font-size:30px; font-weight:400; letter-spacing:0; }
.shared-hero.is-long { font-size:clamp(32px,11vw,48px); letter-spacing:-1px; }
.shared-scope, .shared-context { color:var(--muted); font-size:12px; line-height:1.8; overflow-wrap:anywhere; }
.shared-scope { margin-top:12px; }
.shared-context { margin-bottom:8px; }
.shared-metrics { display:flex; gap:8px; margin:24px 0; padding:22px 0; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
.shared-metric { flex:1; min-width:0; text-align:center; overflow-wrap:anywhere; }
.shared-metric:first-child { text-align:left; }
.shared-metric:last-child { text-align:right; }
.shared-metric + .shared-metric { border-left:1px solid var(--border); padding-left:8px; }
.shared-metric > view { font-size:clamp(19px,6.5vw,27px); line-height:1.3; font-variant-numeric:tabular-nums; }
.shared-metric > text { display:block; margin-top:8px; color:var(--muted); font-size:12px; }
.shared-section { margin-top:25px; }
.shared-section-heading { display:flex; justify-content:space-between; align-items:baseline; gap:12px; margin-bottom:15px; font-size:16px; font-weight:500; }
.shared-section-heading > text:last-child { color:var(--muted); font-size:11px; font-weight:400; text-align:right; }
.shared-faction { margin:18px 0; }
.shared-faction-copy { display:flex; align-items:baseline; justify-content:space-between; gap:12px; }
.shared-faction-copy > view > text { margin-left:8px; color:var(--muted); font-size:11px; }
.shared-faction-copy > text { font-size:17px; }
.shared-bar { height:4px; margin-top:10px; overflow:hidden; border-radius:4px; background:var(--surface); }
.shared-bar > view { height:100%; background:var(--third); border-radius:4px; }
.shared-bar .is-good { background:var(--good); }.shared-bar .is-evil { background:var(--evil); }
.shared-role-row { display:flex; align-items:center; gap:10px; padding:13px 0; border-bottom:1px solid var(--border); }
.shared-role-row:last-child { border-bottom:0; }
.shared-role-row > image { flex-shrink:0; width:35px; height:43px; }
.shared-role-main { flex:1; min-width:0; overflow-wrap:anywhere; }
.shared-role-main > text { display:block; margin-top:3px; color:var(--muted); font-size:11px; }
.shared-role-row > text { color:var(--accent); font-size:17px; }
.shared-result { font-size:28px; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.shared-role-scene { display:flex; align-items:center; justify-content:space-between; position:relative; min-height:202px; margin-top:8px; }
.shared-role-copy { flex:1; min-width:0; position:relative; z-index:1; }
.shared-role-copy > text { display:block; color:var(--muted); font-size:12px; }
.shared-role-copy > view { font:600 38px/1.5 "Songti SC",serif; margin:8px 0; overflow-wrap:anywhere; }
.shared-role-scene > image { flex-shrink:0; width:48%; height:200px; }
.shared-event { position:relative; padding:0 0 22px 22px; margin-left:4px; border-left:1px solid var(--border); }
.shared-event::before { content:""; position:absolute; width:6px; height:6px; left:-4px; top:6px; border:1px solid var(--accent); border-radius:50%; background:var(--bg); }
.shared-event:last-child { padding-bottom:0; border-left-color:transparent; }
.shared-event > text { display:block; margin-bottom:5px; color:var(--muted); font-size:11px; }
.shared-fun-hero { position:relative; min-height:178px; }
.shared-fun-label { position:relative; z-index:1; font-size:23px; font-weight:500; margin-bottom:10px; overflow-wrap:anywhere; }
.shared-fun-hero > image { position:absolute; right:0; bottom:0; width:110px; height:110px; opacity:.8; }
.shared-fun-hero > image.is-portrait { width:142px; height:170px; }
.shared-fun-hero .shared-hero { max-width:100%; text-shadow:0 2px 10px var(--bg); }
.shared-description { margin:15px 0 0; color:var(--muted); font-size:13px; line-height:1.85; overflow-wrap:anywhere; }
.shared-related { display:flex; justify-content:space-between; align-items:center; gap:16px; padding:14px 0; border-bottom:1px solid var(--border); }
.shared-related:last-child { border-bottom:0; }.shared-related > view { flex:1; min-width:0; overflow-wrap:anywhere; }
.shared-related > view > text { display:block; color:var(--muted); font-size:11px; margin-top:5px; }.shared-related > text { flex-shrink:0; color:var(--accent); font-size:12px; }
.shared-stamp { margin-top:26px; color:var(--muted); font-size:11px; }
.shared-author-note { margin-top:20px; color:var(--muted); font-size:12px; }
button.shared-poster { min-height:44px; padding:8px 0; justify-content:flex-start; font-size:13px; color:var(--accent); background:transparent; }
.shared-status { padding:64px 0; color:var(--muted); text-align:center; }.shared-retry { margin-top:20px; }.shared-page .stats-pressed { opacity:.75; }
button.shared-data-entry { display:flex; align-items:center; gap:7px; width:100%; min-height:44px; margin:0; padding:9px 14px; border-radius:0; background:transparent; color:var(--accent); font-size:12px; font-weight:400; }
.shared-data-entry > image { width:16px; height:16px; }
@media (max-width:350px) { .shared-page { padding-left:18px; padding-right:18px; }.shared-fun-hero > image.is-portrait { width:118px; }.shared-role-copy > view { font-size:30px; } }
