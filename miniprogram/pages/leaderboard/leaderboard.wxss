@import "../../share-entry.wxss";
.leaderboard-page { padding-top: 16rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.rank-period { display: flex; gap: 8rpx; padding: 6rpx; background: var(--surface); border-radius: 20rpx; }
.rank-period button { flex: 1 1 0%; width: 0; min-width: 0; margin: 0; min-height: 48px; padding: 12rpx; color: var(--muted); }
.rank-period button.selected { color: var(--text); background: var(--bg); }
.rank-period button:not([disabled]):active, button.rank-metric:not([disabled]):active { opacity: 1; }
.rank-metrics { display: flex; width: 100%; margin: 12rpx 0 20rpx; border-bottom: 1rpx solid var(--border); }
/* Explicit widths override WeChat's native button sizing, including style v2. */
button.rank-metric { flex: 1 1 0%; width: 0; min-width: 0; max-width: 25%; min-height: 48px; margin: 0; padding: 0; border: 0; border-radius: 0; font-size: 28rpx; color: var(--muted); text-align: center; overflow: visible; }
.rank-metric-label { position: relative; display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 20rpx 0; box-sizing: border-box; white-space: nowrap; }
.rank-metric-indicator { position: absolute; bottom: 0; left: 0; right: 0; height: 4rpx; border-radius: 4rpx; background: transparent; }
button.rank-metric.selected { color: var(--accent); }
button.rank-metric.good.selected { color: var(--good); }
button.rank-metric.evil.selected { color: var(--evil); }
.rank-metric.selected .rank-metric-indicator { background: currentColor; }
.rank-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding-bottom: 8rpx; }
.rank-heading-label { display: flex; align-items: center; flex-shrink: 0; min-height: 28px; }
.rank-heading-label button.share-entry-button, .rank-heading-label button.share-entry-button[disabled]:not([type]) { margin: -8px 0; }
.rank-share-status { margin: 8rpx 0 20rpx; line-height: 1.6; }
.rank-row { display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; min-height: 128rpx; padding: 20rpx 16rpx; border-bottom: 1rpx solid rgba(177,191,198,.18); }
.rank-row.is-self { background: var(--surface); border-radius: 16rpx; border-bottom-color: transparent; box-shadow: inset 3rpx 0 var(--accent); }
.rank-number { flex-shrink: 0; width: 48rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; color: var(--muted); font-variant-numeric: tabular-nums; }
.rank-place-1 { color: var(--accent); }
.rank-place-2 { color: #c1cdd6; }
.rank-place-3 { color: #c99778; }
.rank-crown { width: 36rpx; height: 28rpx; }
.rank-avatar { flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--bg); border: 1rpx solid var(--border); box-sizing: border-box; }
.rank-avatar-fallback { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 28rpx; }
.rank-identity { flex: 1; min-width: 0; }
.rank-name { font-weight: 500; margin-bottom: 4rpx; white-space: normal; overflow-wrap: anywhere; }
.rank-self-label { color: var(--accent); }
.rank-value { flex-shrink: 0; font-size: 38rpx; font-weight: 500; font-variant-numeric: tabular-nums; text-align: right; }
.rank-unit { margin-left: 4rpx; font-size: 24rpx; font-weight: 400; color: var(--muted); }
.rank-empty { padding: 64rpx 0; text-align: center; font-size: 28rpx; }
button.rank-more { width: 100%; min-height: 48px; margin-top: 24rpx; color: var(--accent); }
.rank-mine { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; padding: 12rpx 32rpx calc(12rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--border); }
.rank-mine-content { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.rank-mine-copy { min-width: 0; }
.rank-mine-label { color: var(--muted); font-size: 24rpx; line-height: 1.5; margin-bottom: 8rpx; }
.rank-mine-place, .rank-mine-value { color: var(--accent); font-size: 48rpx; font-weight: 600; line-height: 1.25; font-variant-numeric: tabular-nums; white-space: nowrap; }
.rank-mine-prefix, .rank-mine-unit { color: var(--muted); font-size: 26rpx; font-weight: 400; }
.rank-mine-prefix { margin-right: 8rpx; }
.rank-mine-unit { margin-left: 8rpx; }
.rank-mine-place.is-unranked { color: var(--muted); font-size: 32rpx; line-height: 60rpx; }
.rank-mine-metric { min-width: 0; text-align: right; }
.rank-visibility { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 56px; margin-top: 16rpx; border-top: 1rpx solid var(--border); font-size: 28rpx; }
.rank-visibility switch { flex-shrink: 0; }
.rank-visibility-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 24rpx; color: var(--evil); }
.rank-visibility-error button { flex-shrink: 0; width: auto; margin: 0; min-height: 44px; color: var(--accent); }
@media (max-height: 500px) { .rank-mine { position: static; margin-top: 24rpx; } .leaderboard-page { padding-bottom: 32rpx; } }

.fun-rank-filters { margin: 4rpx 0 24rpx; padding-bottom: 12rpx; border-bottom: 1rpx solid var(--border); }
.fun-metric-selector { background: var(--surface); border-radius: 16rpx; }
button.fun-metric-toggle { width: 100%; min-height: 48px; margin: 0; padding: 20rpx 24rpx; justify-content: space-between; gap: 24rpx; text-align: left; }
.fun-metric-current { min-width: 0; }
.fun-filter-label { flex-shrink: 0; color: var(--muted); font-size: 24rpx; font-weight: 400; }
.fun-metric-name { color: var(--text); font-size: 28rpx; font-weight: 500; overflow-wrap: anywhere; }
.fun-metric-action { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; color: var(--muted); font-size: 24rpx; font-weight: 400; }
.fun-filter-chevron { flex-shrink: 0; width: 10rpx; height: 10rpx; margin-top: -5rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); }
.is-expanded .fun-metric-action .fun-filter-chevron { margin-top: 5rpx; transform: rotate(225deg); }
.fun-metric-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; padding: 20rpx; border-top: 1rpx solid var(--border); }
button.fun-metric-option { width: 100%; min-width: 0; min-height: 64px; margin: 0; padding: 16rpx; gap: 12rpx; justify-content: space-between; text-align: left; border: 1rpx solid transparent; border-radius: 12rpx; }
button.fun-metric-option.selected { color: var(--accent); border-color: var(--accent); background: var(--bg); }
.fun-option-copy { display: flex; flex-direction: column; min-width: 0; gap: 4rpx; overflow-wrap: anywhere; }
.fun-option-title { color: var(--muted); font-size: 24rpx; font-weight: 400; }
.fun-option-label { font-size: 28rpx; font-weight: 500; }
.fun-option-check { flex-shrink: 0; width: 8rpx; height: 16rpx; margin: 0 4rpx 4rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.fun-sort-row, .fun-role-filter { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.fun-sort-row { margin-top: 12rpx; }
.fun-sort { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 16rpx; min-width: 0; }
.fun-sort button { width: auto; min-height: 48px; margin: 0; padding: 12rpx 4rpx; gap: 10rpx; font-size: 26rpx; font-weight: 400; color: var(--muted); border-radius: 8rpx; }
.fun-sort button.selected { color: var(--accent); }
.fun-sort-dot { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 24rpx; height: 24rpx; border: 2rpx solid currentColor; border-radius: 50%; box-sizing: border-box; }
.fun-sort .selected .fun-sort-dot::after { content: ""; width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; }
.fun-role-filter picker { min-width: 0; }
.fun-picker { min-height: 48px; box-sizing: border-box; display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; padding: 12rpx 4rpx 12rpx 16rpx; color: var(--text); font-size: 26rpx; overflow-wrap: anywhere; }
.fun-rank-threshold { padding: 0 0 12rpx; }
.fun-mine-sample { margin-top: 12rpx; }
.fun-leaderboard { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
@media (max-height: 500px) { .fun-leaderboard { padding-bottom: 32rpx; } }
.rank-rates { display: flex; gap: 12rpx; margin: -12rpx 0 24rpx; }
.rank-rates button { flex: 1; width: 0; min-width: 0; min-height: 48px; margin: 0; font-size: 26rpx; color: var(--muted); }
.rank-rates button.selected { color: var(--accent); background: var(--surface); }

.rank-details-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
button.rank-disclosure { width: auto; min-height: 44px; margin: 0; padding: 8rpx 0 8rpx 16rpx; font-size: 25rpx; flex-shrink: 0; color: var(--accent); }
button.rank-mine-toggle { width: 100%; padding: 4rpx 0; margin: 0; min-height: 56px; display: flex; justify-content: space-between; text-align: left; gap: 20rpx; }
.rank-mine-brief { display: flex; flex-direction: column; min-width: 0; gap: 2rpx; }
.rank-mine .rank-mine-place, .rank-mine .rank-mine-value { font-size: 32rpx; line-height: 1.4; white-space: normal; overflow-wrap: anywhere; }
.rank-details-dialog { padding: 0; display: flex; flex-direction: column; overflow: hidden; max-height: 80vh; }
.rank-details-header { padding: 20rpx 32rpx; flex-shrink: 0; border-bottom: 1rpx solid var(--border); }
.rank-details-body { box-sizing: border-box; height: 45vh; max-height: 520rpx; min-height: 0; padding: 28rpx 32rpx; }
.rank-details-body .rank-mine-label { font-size: 26rpx; }
.rank-details-body .rank-mine-content { align-items: flex-start; }
.rank-details-body .rank-mine-value { white-space: normal; overflow-wrap: anywhere; }
@media (max-height: 500px) {
  .rank-details-dialog { max-width: 440px; }
  .rank-details-header { padding: 10px 16px; }
  .rank-details-header .dialog-title { font-size: 18px; }
  .rank-details-header .rank-disclosure { font-size: 13px; }
  .rank-details-body { padding: 16px; }
  .rank-details-body .small, .rank-details-body .rank-mine-label { font-size: 13px; }
  .rank-details-body .rank-mine-place, .rank-details-body .rank-mine-value { font-size: 24px; }
  .rank-details-body .rank-visibility { font-size: 14px; }
}
