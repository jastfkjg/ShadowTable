.leaderboard-page { --rank-line: rgba(177,191,198,.13); --rank-selected: rgba(229,198,139,.12); max-width: 600px; padding: 12px 16px calc(136px + env(safe-area-inset-bottom)); }
.leaderboard-page.has-wide-rank { padding-bottom: calc(192px + env(safe-area-inset-bottom)); }
.rank-toolbar, .rank-tools, .rank-period { display: flex; align-items: center; }
.rank-toolbar { justify-content: space-between; gap: 12px; padding: 0 2px; }
.rank-period { flex-shrink: 0; padding: 3px; gap: 3px; background: var(--surface); border-radius: 12px; }
.rank-period button { width: 64px; min-width: 48px; min-height: 44px; margin: 0; padding: 6px 10px; border-radius: 9px; color: var(--muted); font-size: 13px; font-weight: 400; }
.rank-period button.selected { color: var(--text); background: #30424d; font-weight: 600; }
.rank-tools { flex-wrap: wrap; justify-content: flex-end; gap: 4px 10px; }
button.rank-tool, button.rank-tool[disabled]:not([type]) { width: auto; min-width: 44px; min-height: 44px; margin: 0; padding: 4px 0; gap: 4px; color: var(--muted); font-size: 12px; font-weight: 400; }
.rank-tool-icon { flex-shrink: 0; width: 17px; height: 17px; }
.rank-metrics { display: flex; width: 100%; margin: 4px 0 12px; }
button.rank-metric { flex: 1 1 0%; width: 0; min-width: 0; max-width: 25%; min-height: 60px; margin: 0; padding: 0; border: 0; border-radius: 0; font-size: 15px; color: var(--muted); text-align: center; overflow: visible; font-weight: 400; }
.rank-metric-label { position: relative; display: flex; align-items: center; justify-content: center; gap: 6px; min-height: 60px; padding: 16px 0; box-sizing: border-box; white-space: nowrap; }
.rank-metric-icon { width: 17px; height: 17px; flex-shrink: 0; }
.rank-metric-indicator { position: absolute; bottom: 0; left: 50%; margin-left: -11px; width: 22px; height: 3px; border-radius: 3px; background: transparent; }
button.rank-metric.selected { color: var(--accent); font-weight: 600; }
.rank-metric.selected .rank-metric-indicator { background: currentColor; }
.rank-rates { display: flex; gap: 4px; margin: 0 0 16px; padding: 3px; background: var(--surface); border-radius: 12px; }
.rank-rates button { flex: 1; width: 0; min-width: 0; min-height: 44px; margin: 0; padding: 4px; font-size: 13px; color: var(--muted); }
.rank-rates button.selected { color: var(--accent); background: var(--rank-selected); }
.rank-panel { padding: 0 10px 4px; border-radius: 22px; background: var(--surface); overflow: hidden; }
.rank-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 42px; padding: 0 9px; color: var(--muted); font-size: 12px; }
.rank-list-heading text:last-child { text-align: right; }
.rank-notice, .rank-share-status { margin: 12px 0; line-height: 1.6; }
.rank-list { margin: 0; }
button.rank-row, button.rank-row[disabled]:not([type]) { position: relative; width: 100%; display: flex; justify-content: flex-start; align-items: center; gap: 10px; min-height: 78px; margin: 0; padding: 12px 9px; border: 0; border-radius: 13px; text-align: left; font-weight: 400; }
button.rank-row[disabled] { opacity: 1; }
.rank-row + .rank-row::before { content: ''; position: absolute; top: 0; left: 49px; right: 9px; height: 1px; background: var(--rank-line); pointer-events: none; }
button.rank-row.is-self { background: rgba(229,198,139,.055); }
.rank-row.is-self::after { content: ''; position: absolute; left: -10px; top: 50%; margin-top: -16px; width: 3px; height: 32px; background: var(--accent); border-radius: 2px; transform: none; box-sizing: border-box; pointer-events: none; }
.rank-number { flex-shrink: 0; width: 26px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: var(--muted); line-height: 1.2; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.rank-place-value { max-width: 100%; font-size: 17px; }
.rank-number-wide { width: auto; min-width: 26px; }
.rank-number-wide .rank-place-value { font-size: 12px; white-space: nowrap; overflow-wrap: normal; }
.rank-place-1 .rank-place-value, .rank-place-2 .rank-place-value, .rank-place-3 .rank-place-value { width: 25px; height: 27px; box-sizing: border-box; border: 1px solid rgba(229,198,139,.2); border-radius: 8px 8px 11px 11px; text-align: center; font-size: 16px; font-weight: 600; line-height: 25px; color: var(--accent); background: rgba(229,198,139,.1); }
.rank-place-2 .rank-place-value { color: #c7d7e3; background: rgba(199,215,227,.07); border-color: rgba(199,215,227,.14); }
.rank-place-3 .rank-place-value { color: #ddbcaa; background: rgba(221,188,170,.07); border-color: rgba(221,188,170,.14); }
.rank-tie { font-size: 10px; font-weight: 400; line-height: 1.2; }
.rank-avatar { flex-shrink: 0; width: 42px; height: 42px; border-radius: 15px; background: #30424d; box-sizing: border-box; }
.rank-avatar-fallback { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 18px; }
.rank-identity { flex: 1; min-width: 0; }
.rank-name { display: flex; align-items: center; gap: 6px; font-size: 15px; font-weight: 600; line-height: 1.4; margin-bottom: 5px; }
.rank-nickname { min-width: 0; white-space: normal; overflow-wrap: anywhere; }
.rank-self-label { flex-shrink: 0; padding: 0 4px; border-radius: 4px; color: var(--accent); background: rgba(229,198,139,.13); font-size: 10px; font-weight: 400; }
.rank-secondary { font-size: 12px; line-height: 1.5; color: var(--muted); overflow-wrap: anywhere; }
.rank-value { flex-shrink: 0; max-width: 34%; overflow-wrap: anywhere; font-size: 26px; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; line-height: 1.3; }
.rank-value.is-compact { max-width: 40%; font-size: 18px; }
/* Very large scores move below the identity instead of squeezing names to one column. */
button.rank-row-compact, button.rank-row-compact[disabled]:not([type]) { display:grid; grid-template-columns:auto 42px minmax(0,1fr); gap:6px 10px; }
.rank-row-compact .rank-number, .rank-row-compact .rank-avatar { grid-row:1 / 3; }
.rank-row-compact .rank-identity { grid-column:3; grid-row:1; }
.rank-row-compact .rank-value { grid-column:3; grid-row:2; max-width:100%; text-align:left; }
.is-self .rank-value { color: var(--accent); }
.rank-unit { margin-left: 3px; font-size: 12px; font-weight: 400; color: var(--muted); }
.rank-empty { padding: 36px 10px; text-align: center; }
.rank-empty-title { margin-bottom: 8px; font-size: 15px; }
.rank-empty .small { font-size: 13px; }
.rank-list-end { padding: 20px 0; text-align: center; color: var(--muted); font-size: 12px; }
.rank-list-end.is-sparse { margin-top: 16px; padding-top: 24px; }
.rank-end-hint { margin-top: 8px; }
button.rank-more { width: 100%; min-height: 48px; margin-top: 12px; color: var(--accent); font-size: 14px; }
.rank-mine { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; padding: 12px 16px calc(16px + env(safe-area-inset-bottom)); background: #20323d; border-top: 1px solid var(--border); }
button.rank-mine-toggle { width: 100%; min-height: 56px; margin: 0 auto; padding: 0; max-width: 568px; display: flex; justify-content: space-between; text-align: left; gap: 12px; }
.rank-mine-stats { display: flex; flex: 1; flex-wrap: wrap; align-items: center; gap: 8px 12px; min-width: 0; }
.rank-mine-symbol { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 34px; height: 40px; border-radius: 12px; background: rgba(229,198,139,.08); }
.rank-mine-symbol image { width: 25px; height: 25px; }
.rank-mine-brief { display: flex; flex-direction: column; min-width: 0; }
.rank-mine-brief + .rank-mine-brief { padding-left: 12px; border-left: 1px solid var(--rank-line); }
.rank-mine-label { color: var(--muted); font-size: 12px; font-weight: 400; line-height: 1.5; margin-bottom: 4px; }
.rank-mine-place, .rank-mine-value { font-size: 18px; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.rank-mine-place { color: var(--accent); }
.rank-mine-brief .rank-mine-place { white-space: nowrap; }
.rank-mine-entry { display: flex; align-items: center; flex-shrink: 0; gap: 6px; color: var(--muted); font-size: 12px; font-weight: 400; }
.rank-chevron { width: 5px; height: 5px; border-right: 1.5px solid currentColor; border-top: 1.5px solid currentColor; transform: rotate(45deg); }
.rank-row-pressed { background: rgba(177,191,198,.07) !important; }
@media (max-width:350px) { .rank-mine-symbol { display:none; }.rank-toolbar { gap:8px; }.rank-tools { gap:4px; }.rank-period button { width:56px; }.rank-row { column-gap:8px; }.rank-avatar { width:38px; height:38px; } }
.fun-rank-filters { padding-top: 24rpx; }
button.fun-metric-toggle { width: 100%; min-height: 80px; margin: 0; padding: 16rpx 24rpx; justify-content: space-between; gap: 20rpx; text-align: left; background: var(--surface); border-radius: 18rpx; }
.fun-metric-current { min-width: 0; overflow-wrap: anywhere; }
.fun-metric-name { font-size: 18px; font-weight: 600; }
.fun-metric-description { display: block; margin-top: 8rpx; color: var(--muted); font-size: 14px; font-weight: 400; line-height: 1.5; }
.fun-filter-chevron { color: var(--muted); flex-shrink: 0; width: 12rpx; height: 12rpx; margin-top: -6rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); }
.fun-sort-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 24rpx 0 20rpx; }
.fun-sort { display: flex; min-width: 0; border: 1rpx solid var(--rank-line); border-radius: 18rpx; overflow: hidden; }
.fun-sort button { width: auto; min-width: 104rpx; min-height: 44px; margin: 0; padding: 8rpx 20rpx; font-size: 25rpx; font-weight: 400; color: var(--muted); border: 1rpx solid transparent; border-radius: 16rpx; }
.fun-sort button.selected { color: var(--accent); background: var(--rank-selected); border-color: rgba(229,198,139,.35); }
.fun-rank-count { color: var(--muted); font-size: 24rpx; text-align: right; }
.fun-leaderboard .rank-list-end { padding-top: 36rpx; }
.rank-sheet-backdrop { padding: 0; align-items: flex-end; }
.rank-sheet { --rank-line: rgba(177,191,198,.18); width: 100%; max-width: 540px; max-height: 90vh; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; background: var(--surface); border-top: 1rpx solid var(--border); border-radius: 36rpx 36rpx 0 0; padding-bottom: env(safe-area-inset-bottom); animation: rank-sheet-enter .2s ease-out; }
.rank-sheet-handle { flex-shrink: 0; width: 64rpx; height: 7rpx; background: var(--border); border-radius: 8rpx; margin: 16rpx auto 6rpx; }
.rank-sheet-header { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 0 32rpx; }
.rank-sheet-title { flex: 1; min-width: 0; font-size: 36rpx; font-weight: 600; }
button.rank-sheet-close { flex-shrink: 0; width: auto; min-width: 48px; min-height: 48px; margin: 0 -12rpx 0 0; padding: 8rpx 12rpx; color: var(--muted); font-size: 25rpx; }
.fun-categories { flex-shrink: 0; display: flex; gap: 12rpx; padding: 0 32rpx 16rpx; }
.fun-categories button { flex: 1; min-width: 0; width: auto; min-height: 44px; margin: 0; padding: 8rpx 12rpx; background: rgba(177,191,198,.08); color: var(--muted); font-size: 26rpx; white-space: nowrap; }
.fun-categories .selected { color: var(--accent); background: rgba(229,198,139,.12); }
.fun-options-count { flex-shrink: 0; padding: 0 32rpx 16rpx; color: var(--muted); font-size: 12px; line-height: 1.5; }
.fun-metric-options { flex: 0 1 auto; height: 44vh; min-height: 0; box-sizing: border-box; padding: 0 32rpx; }
.fun-metric-options.is-compact { height: 160px; max-height: 44vh; }
button.fun-metric-option { width: 100%; min-width: 0; min-height: 68px; margin: 0 0 8rpx; padding: 20rpx; gap: 16rpx; justify-content: space-between; text-align: left; border: 1rpx solid transparent; border-radius: 16rpx; }
button.fun-metric-option.selected { border-color: rgba(229,198,139,.5); background: rgba(229,198,139,.08); }
.fun-option-copy { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.fun-option-heading { display: flex; flex-wrap: wrap; align-items: center; gap: 8rpx 16rpx; }
.fun-option-title { font-size: 15px; font-weight: 600; line-height: 1.5; }
.fun-identity { display: inline-block; max-width: 100%; padding: 2rpx 12rpx; border-radius: 8rpx; background: rgba(177,191,198,.09); color: var(--muted); font-size: 12px; font-weight: 400; line-height: 1.5; white-space: nowrap; }
.fun-option-label { display: block; margin-top: 8rpx; color: var(--muted); font-size: 13px; font-weight: 400; line-height: 1.5; }
.fun-scroll-hint { flex-shrink: 0; min-height: 24px; padding: 4rpx 32rpx 8rpx; box-sizing: border-box; color: var(--muted); font-size: 12px; line-height: 1.5; text-align: center; }
.fun-option-radio { flex-shrink: 0; display: flex; justify-content: center; align-items: center; width: 32rpx; height: 32rpx; border: 2rpx solid var(--muted); border-radius: 50%; }
.selected .fun-option-radio { background: var(--accent); border-color: var(--accent); color: var(--bg); }
.fun-option-check { width: 8rpx; height: 14rpx; margin-bottom: 4rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.rank-sheet-footer { flex-shrink: 0; padding: 20rpx 32rpx 24rpx; border-top: 1rpx solid var(--rank-line); }
.rank-sheet-note { font-size: 24rpx; color: var(--muted); line-height: 1.6; margin-bottom: 20rpx; }
button.rank-confirm { min-height: 48px; width: 100%; margin: 0; padding: 16rpx; background: var(--accent); color: var(--bg); font-size: 28rpx; font-weight: 600; }
.rank-rules-body, .rank-details-body { box-sizing: border-box; height: 44vh; min-height: 0; padding: 20rpx 32rpx 32rpx; }
.rank-rules-metric { font-size: 28rpx; color: var(--accent); margin-bottom: 20rpx; }
.rank-rule-line { color: var(--muted); font-size: 26rpx; line-height: 1.8; margin-bottom: 20rpx; }
.rank-mine-content { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; margin-bottom: 24rpx; }
.rank-details-body .rank-mine-value, .rank-details-body .rank-mine-place { font-size: 44rpx; }
.rank-details-body .rank-mine-metric { text-align: right; }
.rank-status-label { font-size: 26rpx; color: var(--accent); margin-bottom: 12rpx; }
.rank-visibility { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 56px; margin-top: 24rpx; padding: 12rpx 0; border-top: 1rpx solid var(--rank-line); font-size: 28rpx; }
.rank-visibility switch { flex-shrink: 0; }
.rank-visibility-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 24rpx; color: var(--evil); }
.rank-visibility-error button { flex-shrink: 0; width: auto; margin: 0; min-height: 44px; color: var(--accent); }
.rank-category-empty { padding: 32rpx 0; }
.rank-pressed { opacity: .7; }
@keyframes rank-sheet-enter { from { opacity: .6; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .rank-sheet { animation: none; } }
@media (max-height: 500px) {
  .rank-mine { position: static; margin-top: 24px; padding: 12px 0; }
  .leaderboard-page, .leaderboard-page.has-wide-rank { padding-bottom: 24px; }
  .rank-sheet { max-height: 96vh; border-radius: 16px 16px 0 0; }
  .rank-sheet-header, .fun-categories, .fun-metric-options, .rank-sheet-footer, .rank-rules-body, .rank-details-body { padding-left: 16px; padding-right: 16px; }
  .rank-sheet-title { font-size: 20px; }
  .fun-option-title, .fun-metric-name { font-size: 15px; }
  .fun-identity { font-size: 12px; padding: 1px 6px; border-radius: 4px; }
  .fun-option-heading { gap: 4px 8px; }
  .fun-metric-description { font-size: 13px; margin-top: 4px; }
  .fun-options-count { font-size: 12px; padding: 0 16px 8px; }
  .fun-scroll-hint { font-size: 12px; padding: 2px 16px 4px; }
  button.rank-sheet-close, .fun-categories button, .fun-option-label, .rank-rule-line, .rank-visibility { font-size: 14px; }
  .rank-sheet-note, .rank-details-body .small { font-size: 12px; }
  .fun-categories { padding-bottom: 8px; }
  .fun-categories button { padding: 4px 6px; }
  .fun-metric-options { height: 28vh; }
  .rank-sheet-footer { padding-top: 8px; padding-bottom: 8px; }
  .rank-sheet-note { margin-bottom: 8px; }
  button.rank-confirm { font-size: 14px; padding: 8px; }
  button.fun-metric-option { padding: 8px 10px; margin-bottom: 4px; font-size: 14px; }
  .fun-option-radio { width: 16px; height: 16px; border-width: 1px; }
  .fun-option-check { width: 4px; height: 7px; border-width: 0 1.5px 1.5px 0; margin-bottom: 2px; }
  .rank-sheet-handle { width: 32px; height: 4px; margin: 8px auto 3px; }
}

.rank-month-label { display:flex; flex-direction:column; gap:5px; padding:8px 4px; color:var(--accent); font-size:16px; font-weight:600; }
.rank-month-caption { color:var(--muted); font-size:12px; font-weight:400; }
