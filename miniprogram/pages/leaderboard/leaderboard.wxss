.leaderboard-page { padding-top: 16rpx; padding-bottom: calc(340rpx + env(safe-area-inset-bottom)); }
.rank-period { display: flex; gap: 8rpx; padding: 6rpx; background: var(--surface); border-radius: 20rpx; }
.rank-period button { flex: 1 1 0%; width: 0; min-width: 0; margin: 0; min-height: 48px; padding: 12rpx; color: var(--muted); }
.rank-period button.selected { color: var(--text); background: var(--bg); }
.rank-period button:not([disabled]):active, button.rank-metric:not([disabled]):active { opacity: 1; }
.rank-metrics { display: flex; width: 100%; margin: 24rpx 0 32rpx; border-bottom: 1rpx solid var(--border); }
/* Explicit widths override WeChat's native button sizing, including style v2. */
button.rank-metric { flex: 1 1 0%; width: 0; min-width: 0; max-width: 25%; min-height: 48px; margin: 0; padding: 0; border: 0; border-radius: 0; font-size: 28rpx; color: var(--muted); text-align: center; overflow: visible; }
.rank-metric-label { position: relative; display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 20rpx 0; box-sizing: border-box; white-space: nowrap; }
.rank-metric-indicator { position: absolute; bottom: 0; left: 0; right: 0; height: 4rpx; border-radius: 4rpx; background: transparent; }
button.rank-metric.selected { color: var(--accent); }
button.rank-metric.good.selected { color: var(--good); }
button.rank-metric.evil.selected { color: var(--evil); }
.rank-metric.selected .rank-metric-indicator { background: currentColor; }
.rank-list-heading { display: flex; justify-content: space-between; gap: 20rpx; padding-bottom: 8rpx; }
.rank-row { display: flex; align-items: center; gap: 20rpx; min-height: 136rpx; padding: 24rpx 0; border-bottom: 1rpx solid rgba(177,191,198,.18); }
.rank-row.is-self { background: var(--surface); }
.rank-number { flex-shrink: 0; width: 44rpx; color: var(--muted); font-variant-numeric: tabular-nums; }
.rank-number.rank-top { color: var(--accent); font-weight: 600; }
.rank-avatar { flex-shrink: 0; width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--surface); }
.rank-avatar-fallback { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 28rpx; }
.rank-identity { flex: 1; min-width: 0; }
.rank-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rank-self-label { color: var(--accent); }
.rank-value { flex-shrink: 0; font-size: 38rpx; font-weight: 500; font-variant-numeric: tabular-nums; text-align: right; }
.rank-unit { margin-left: 4rpx; font-size: 24rpx; font-weight: 400; color: var(--muted); }
.rank-empty { padding: 64rpx 0; text-align: center; font-size: 28rpx; }
button.rank-more { width: 100%; min-height: 48px; margin-top: 24rpx; color: var(--accent); }
.rank-mine { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--border); }
.rank-mine-content { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.rank-mine-copy { min-width: 0; }
.rank-mine-status { font-size: 30rpx; overflow-wrap: anywhere; }
button.rank-enable { min-height: 48px; margin: 8rpx 0 0; padding: 12rpx 0 0; justify-content: flex-start; color: var(--accent); font-size: 28rpx; }
@media (max-height: 500px) { .rank-mine { position: static; margin-top: 24rpx; } .leaderboard-page { padding-bottom: 32rpx; } }
