.leaderboard-page { --rank-line: rgba(177,191,198,.18); --rank-selected: rgba(229,198,139,.12); padding-top: 12rpx; padding-bottom: calc(172rpx + env(safe-area-inset-bottom)); }
.rank-toolbar, .rank-tools, .rank-period { display: flex; align-items: center; }
.rank-toolbar { justify-content: space-between; gap: 16rpx; }
.rank-period { padding: 4rpx; gap: 4rpx; background: var(--surface); border-radius: 20rpx; }
.rank-period button { width: 124rpx; min-width: 48px; min-height: 44px; margin: 0; padding: 8rpx 12rpx; border-radius: 14rpx; color: var(--muted); font-size: 26rpx; }
.rank-period button.selected { color: var(--text); background: rgba(177,191,198,.10); }
.rank-tools { gap: 8rpx; }
button.rank-tool, button.rank-tool[disabled]:not([type]) { width: auto; min-width: 44px; min-height: 48px; margin: 0; padding: 8rpx; gap: 8rpx; color: var(--muted); font-size: 24rpx; }
.rank-tool-icon { width: 30rpx; height: 30rpx; }
.rank-info-icon { display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 23rpx; height: 23rpx; border: 2rpx solid currentColor; border-radius: 50%; font-size: 19rpx; line-height: 1; font-weight: 500; box-sizing: border-box; }
.rank-metrics { display: flex; width: 100%; margin: 8rpx 0 0; border-bottom: 1rpx solid var(--rank-line); }
button.rank-metric { flex: 1 1 0%; width: 0; min-width: 0; max-width: 25%; min-height: 48px; margin: 0; padding: 0; border: 0; border-radius: 0; font-size: 30rpx; color: var(--muted); text-align: center; overflow: visible; }
.rank-metric-label { position: relative; display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 18rpx 0; box-sizing: border-box; white-space: nowrap; }
.rank-metric-indicator { position: absolute; bottom: -1rpx; left: 50%; margin-left: -22rpx; width: 44rpx; height: 5rpx; border-radius: 4rpx; background: transparent; }
button.rank-metric.selected { color: var(--accent); }
.rank-metric.selected .rank-metric-indicator { background: currentColor; }
.rank-rates { display: flex; gap: 8rpx; margin: 20rpx 0 0; padding: 4rpx; background: var(--surface); border-radius: 16rpx; }
.rank-rates button { flex: 1; width: 0; min-width: 0; min-height: 44px; margin: 0; padding: 8rpx; font-size: 25rpx; color: var(--muted); }
.rank-rates button.selected { color: var(--accent); background: var(--rank-selected); }
.rank-list-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 80rpx; color: var(--muted); font-size: 24rpx; }
.rank-list-heading text:last-child { text-align: right; }
.rank-notice, .rank-share-status { margin: 16rpx 0; line-height: 1.6; }
.rank-list { margin: 0 -12rpx; }
button.rank-row, button.rank-row[disabled]:not([type]) { width: 100%; display: flex; justify-content: flex-start; align-items: center; gap: 20rpx; min-height: 128rpx; margin: 0; padding: 18rpx 12rpx; border-bottom: 1rpx solid var(--rank-line); border-radius: 0; text-align: left; font-weight: 400; }
button.rank-row[disabled] { opacity: 1; }
button.rank-row:last-child { border-bottom-color: transparent; }
button.rank-row.is-self { margin: 0 0 4rpx; min-height: 144rpx; background: var(--surface); border-radius: 22rpx; border-bottom-color: transparent; }
.rank-number { flex-shrink: 0; width: auto; min-width: 56rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; color: var(--muted); font-size: 36rpx; line-height: 1.2; font-variant-numeric: tabular-nums; }
.rank-place-1 { color: var(--accent); }
.rank-crown { width: 32rpx; height: 24rpx; margin-bottom: 2rpx; }
.rank-tie { font-size: 20rpx; font-weight: 400; line-height: 1.4; }
.rank-avatar { flex-shrink: 0; width: 76rpx; height: 76rpx; border-radius: 50%; background: rgba(177,191,198,.12); box-sizing: border-box; }
.rank-avatar-fallback { display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 30rpx; }
.is-self .rank-avatar-fallback { background: rgba(229,198,139,.13); color: var(--accent); border: 1rpx solid rgba(229,198,139,.4); }
.rank-identity { flex: 1; min-width: 0; }
.rank-name { display: flex; align-items: center; gap: 12rpx; font-size: 30rpx; font-weight: 600; margin-bottom: 4rpx; }
.rank-nickname { min-width: 0; white-space: normal; overflow-wrap: anywhere; }
.rank-self-label { flex-shrink: 0; padding: 0 8rpx; border-radius: 6rpx; color: var(--accent); background: rgba(229,198,139,.13); font-size: 20rpx; font-weight: 400; }
.rank-secondary { font-size: 24rpx; line-height: 1.5; color: var(--muted); overflow-wrap: anywhere; }
.rank-value { flex-shrink: 0; max-width: 34%; overflow-wrap: anywhere; font-size: 48rpx; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; line-height: 1.3; }
.is-self .rank-value { color: var(--accent); }
.rank-unit { margin-left: 4rpx; font-size: 24rpx; font-weight: 400; color: var(--muted); }
.rank-empty { padding: 72rpx 20rpx; text-align: center; }
.rank-empty-title { margin-bottom: 12rpx; font-size: 28rpx; }
.rank-list-end { padding: 28rpx 0; text-align: center; color: var(--muted); font-size: 24rpx; }
.rank-list-end.is-sparse { margin-top: 64rpx; padding-top: 48rpx; border-top: 1rpx solid var(--rank-line); }
.rank-end-hint { margin-top: 12rpx; }
button.rank-more { width: 100%; min-height: 48px; margin-top: 24rpx; color: var(--accent); }
.rank-mine { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--surface); border-top: 1rpx solid var(--border); }
button.rank-mine-toggle { width: 100%; min-height: 56px; margin: 0 auto; padding: 0; max-width: 900rpx; display: flex; justify-content: space-between; text-align: left; gap: 20rpx; }
.rank-mine-stats { display: flex; align-items: stretch; gap: 24rpx; min-width: 0; }
.rank-mine-brief { display: flex; flex-direction: column; min-width: 0; }
.rank-mine-brief + .rank-mine-brief { padding-left: 24rpx; border-left: 1rpx solid var(--rank-line); }
.rank-mine-label { color: var(--muted); font-size: 23rpx; font-weight: 400; line-height: 1.5; margin-bottom: 4rpx; }
.rank-mine-place, .rank-mine-value { font-size: 36rpx; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.rank-mine-place { color: var(--accent); }
.rank-mine-entry { display: flex; align-items: center; flex-shrink: 0; gap: 10rpx; color: var(--muted); font-size: 24rpx; font-weight: 400; }
.rank-chevron { width: 10rpx; height: 10rpx; border-right: 2rpx solid currentColor; border-top: 2rpx solid currentColor; transform: rotate(45deg); }
.fun-rank-filters { padding-top: 24rpx; }
button.fun-metric-toggle { width: 100%; min-height: 48px; margin: 0; padding: 16rpx 24rpx; justify-content: space-between; gap: 20rpx; text-align: left; background: var(--surface); border-radius: 18rpx; }
.fun-metric-current { min-width: 0; overflow-wrap: anywhere; }
.fun-metric-role { font-size: 26rpx; color: var(--muted); font-weight: 400; margin-right: 14rpx; }
.fun-metric-name { font-size: 30rpx; font-weight: 600; }
.fun-filter-chevron { color: var(--muted); flex-shrink: 0; width: 12rpx; height: 12rpx; margin-top: -6rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); }
.fun-sort-row, .fun-role-filter { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.fun-sort-row { margin-top: 6rpx; }
.fun-sort { display: flex; gap: 12rpx; min-width: 0; }
.fun-sort button { position: relative; width: auto; min-height: 48px; margin: 0; padding: 12rpx 12rpx; font-size: 25rpx; font-weight: 400; color: var(--muted); border-radius: 0; }
.fun-sort button:first-child { padding-left: 0; }
.fun-sort button.selected { color: var(--accent); }
.fun-sort button.selected::before { content: ""; position: absolute; bottom: 6rpx; left: 12rpx; right: 12rpx; height: 4rpx; border-radius: 4rpx; background: currentColor; }
.fun-sort button.selected:first-child::before { left: 0; }
.fun-sort-direction, .fun-filter-label { flex-shrink: 0; color: var(--muted); font-size: 24rpx; }
.fun-role-filter picker { min-width: 0; }
.fun-picker { min-height: 44px; display: flex; align-items: center; gap: 16rpx; padding: 8rpx; font-size: 26rpx; overflow-wrap: anywhere; }
.rank-sheet-backdrop { padding: 0; align-items: flex-end; }
.rank-sheet { --rank-line: rgba(177,191,198,.18); width: 100%; max-width: 540px; max-height: 90vh; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; background: var(--surface); border-top: 1rpx solid var(--border); border-radius: 36rpx 36rpx 0 0; padding-bottom: env(safe-area-inset-bottom); animation: rank-sheet-enter .2s ease-out; }
.rank-sheet-handle { flex-shrink: 0; width: 64rpx; height: 7rpx; background: var(--border); border-radius: 8rpx; margin: 16rpx auto 6rpx; }
.rank-sheet-header { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 0 32rpx; }
.rank-sheet-title { flex: 1; min-width: 0; font-size: 36rpx; font-weight: 600; }
button.rank-sheet-close { flex-shrink: 0; width: auto; min-width: 48px; min-height: 48px; margin: 0 -12rpx 0 0; padding: 8rpx 12rpx; color: var(--muted); font-size: 25rpx; }
.fun-categories { flex-shrink: 0; display: flex; gap: 16rpx; padding: 0 32rpx 20rpx; }
.fun-categories button { min-width: 136rpx; width: auto; min-height: 44px; margin: 0; padding: 8rpx 24rpx; background: rgba(177,191,198,.08); color: var(--muted); font-size: 26rpx; }
.fun-categories .selected { color: var(--accent); background: rgba(229,198,139,.12); }
.fun-metric-options { height: 36vh; min-height: 0; box-sizing: border-box; padding: 0 32rpx; }
button.fun-metric-option { width: 100%; min-width: 0; min-height: 48px; margin: 0 0 8rpx; padding: 16rpx 20rpx; gap: 16rpx; justify-content: space-between; text-align: left; border: 1rpx solid transparent; border-radius: 16rpx; }
button.fun-metric-option.selected { border-color: rgba(229,198,139,.5); background: rgba(229,198,139,.08); }
.fun-option-copy { min-width: 0; overflow-wrap: anywhere; }
.fun-option-title { color: var(--muted); font-size: 24rpx; font-weight: 400; margin-right: 14rpx; }
.fun-option-label { font-size: 28rpx; font-weight: 500; }
.fun-option-radio { flex-shrink: 0; display: flex; justify-content: center; align-items: center; width: 32rpx; height: 32rpx; border: 2rpx solid var(--muted); border-radius: 50%; }
.selected .fun-option-radio { background: var(--accent); border-color: var(--accent); color: var(--bg); }
.fun-option-check { width: 8rpx; height: 14rpx; margin-bottom: 4rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.rank-sheet-footer { flex-shrink: 0; padding: 20rpx 32rpx 24rpx; border-top: 1rpx solid var(--rank-line); }
.rank-sheet-note { font-size: 24rpx; color: var(--muted); line-height: 1.6; margin-bottom: 20rpx; }
button.rank-confirm { min-height: 48px; width: 100%; margin: 0; padding: 16rpx; background: var(--accent); color: var(--bg); font-size: 28rpx; font-weight: 600; }
.rank-rules-body, .rank-details-body { box-sizing: border-box; height: 44vh; min-height: 0; padding: 20rpx 32rpx 32rpx; }
.rank-rules-metric { font-size: 28rpx; color: var(--accent); margin-bottom: 20rpx; }
.rank-rule-line { color: var(--muted); font-size: 26rpx; line-height: 1.8; margin-bottom: 20rpx; }
.rank-mine-content { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; margin-bottom: 24rpx; }
.rank-details-body .rank-mine-value, .rank-details-body .rank-mine-place { font-size: 44rpx; }
.rank-details-body .rank-mine-metric { text-align: right; }
.rank-status-label { font-size: 26rpx; color: var(--accent); margin-bottom: 12rpx; }
.rank-visibility { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 56px; margin-top: 24rpx; padding: 12rpx 0; border-top: 1rpx solid var(--rank-line); font-size: 28rpx; }
.rank-visibility switch { flex-shrink: 0; }
.rank-visibility-error { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 24rpx; color: var(--evil); }
.rank-visibility-error button { flex-shrink: 0; width: auto; margin: 0; min-height: 44px; color: var(--accent); }
.rank-category-empty { padding: 32rpx 0; }
.rank-pressed { opacity: .7; }
@keyframes rank-sheet-enter { from { opacity: .6; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .rank-sheet { animation: none; } }
@media (max-height: 500px) {
  .rank-mine { position: static; margin-top: 24px; padding: 12px 0; }
  .leaderboard-page { padding-bottom: 24px; }
  .rank-sheet { max-height: 96vh; border-radius: 16px 16px 0 0; }
  .rank-sheet-header, .fun-categories, .fun-metric-options, .rank-sheet-footer, .rank-rules-body, .rank-details-body { padding-left: 16px; padding-right: 16px; }
  .rank-sheet-title { font-size: 20px; }
  button.rank-sheet-close, .fun-categories button, .fun-option-label, .rank-rule-line, .rank-visibility { font-size: 14px; }
  .fun-option-title, .rank-sheet-note, .rank-details-body .small { font-size: 12px; }
  .fun-categories { padding-bottom: 8px; }
  .fun-categories button { min-width: 72px; padding: 4px 12px; }
  .fun-metric-options { height: 28vh; }
  .rank-sheet-footer { padding-top: 8px; padding-bottom: 8px; }
  .rank-sheet-note { margin-bottom: 8px; }
  button.rank-confirm { font-size: 14px; padding: 8px; }
  button.fun-metric-option { padding: 8px 10px; margin-bottom: 4px; font-size: 14px; }
  .fun-option-radio { width: 16px; height: 16px; border-width: 1px; }
  .fun-option-check { width: 4px; height: 7px; border-width: 0 1.5px 1.5px 0; margin-bottom: 2px; }
  .rank-sheet-handle { width: 32px; height: 4px; margin: 8px auto 3px; }
}

.rank-value.is-compact { font-size: 36rpx; }
