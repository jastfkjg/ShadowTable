<app-nav title="排行榜" back="{{true}}" backLabel="返回我的" bindback="back" />
<view class="page personal-page leaderboard-page">
  <view class="rank-period" aria-label="统计周期">
    <button class="{{period==='all'?'selected':''}}" bindtap="choosePeriod" data-id="all" aria-pressed="{{period==='all'}}" hover-class="none">全部</button>
    <button class="{{period==='month'?'selected':''}}" bindtap="choosePeriod" data-id="month" aria-pressed="{{period==='month'}}" hover-class="none">本月</button>
  </view>
  <view class="rank-metrics" aria-label="排行指标"><button wx:for="{{metrics}}" wx:key="id" class="rank-metric {{item.id}} {{metric===item.id?'selected':''}}" bindtap="chooseMetric" data-id="{{item.id}}" aria-pressed="{{metric===item.id}}" hover-class="none"><view class="rank-metric-label"><text>{{item.label}}</text><view class="rank-metric-indicator" aria-hidden="true"></view></view></button></view>
  <view wx:if="{{loading && !board}}" class="status" role="status">正在读取榜单…</view>
  <view wx:if="{{notice}}" class="small muted" role="status">{{notice}}</view>
  <view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button class="secondary" bindtap="retry" disabled="{{loading || loadingMore}}">重试</button></view>
  <block wx:if="{{board}}">
    <view wx:if="{{board.rows.length}}" class="rank-list">
      <view class="rank-list-heading small muted"><text>排名 / 玩家</text><text>{{board.metric==='games'?'有效局数':board.metricLabel}}</text></view>
      <view wx:for="{{board.rows}}" wx:key="publicId" class="rank-row {{item.isSelf?'is-self':''}}">
        <text class="rank-number {{3 >= item.rank?'rank-top':''}}">{{item.rank}}</text>
        <image wx:if="{{item.avatarUrl}}" class="rank-avatar" src="{{item.avatarUrl}}" mode="aspectFill" aria-hidden="true" />
        <view wx:else class="rank-avatar rank-avatar-fallback" aria-hidden="true">{{item.initial}}</view>
        <view class="rank-identity"><view class="rank-name">{{item.nickname}}<text wx:if="{{item.isSelf}}" class="rank-self-label"> · 我</text></view><view class="small muted">{{item.wins}}胜 · {{item.total}}局</view></view>
        <view class="rank-value">{{item.value}}<text class="rank-unit">{{item.unit}}</text></view>
      </view>
    </view>
    <view wx:else class="rank-empty muted">暂无战绩</view>
    <button wx:if="{{board.hasMore}}" class="rank-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loading || loadingMore}}">{{loadingMore?'正在加载…':'加载更多'}}</button>
    <view class="rank-mine" aria-label="我的排名">
      <view class="rank-mine-content"><view class="rank-mine-copy"><view class="small muted">我的{{board.metricLabel}}</view><view wx:if="{{board.me.statusLabel}}" class="rank-mine-status">{{board.me.statusLabel}}</view><view class="small muted">{{board.me.wins}}胜 · {{board.me.total}}局</view></view><view class="rank-value accent">{{board.me.value}}<text class="rank-unit">{{board.me.unit}}</text></view></view>
      <button wx:if="{{board.me.status==='hidden'}}" class="rank-enable" bindtap="editProfile">参与排行 ›</button>
    </view>
  </block>
</view>
