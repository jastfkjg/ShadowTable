<app-nav title="排行榜" back="{{true}}" backLabel="返回我的" bindback="back" />
<view class="page personal-page leaderboard-page {{board.fun?'fun-leaderboard':''}}">
  <view class="rank-period" aria-label="统计周期">
    <button class="{{period==='all'?'selected':''}}" bindtap="choosePeriod" data-id="all" aria-pressed="{{period==='all'}}" hover-class="none">全部</button>
    <button class="{{period==='month'?'selected':''}}" bindtap="choosePeriod" data-id="month" aria-pressed="{{period==='month'}}" hover-class="none">本月</button>
  </view>
  <view class="rank-metrics" aria-label="排行指标"><button wx:for="{{groups}}" wx:key="id" class="rank-metric {{item.id}} {{metric===item.id || (item.id==='fun' && funSelected) || (item.id==='overall' && (metric==='good' || metric==='evil'))?'selected':''}}" bindtap="chooseGroup" data-id="{{item.id}}" disabled="{{(item.id==='points' && !pointsAvailable) || (item.id==='fun' && !funAvailable)}}" aria-pressed="{{metric===item.id || (item.id==='fun' && funSelected) || (item.id==='overall' && (metric==='good' || metric==='evil'))}}" hover-class="none"><view class="rank-metric-label"><text>{{item.label}}</text><view class="rank-metric-indicator" aria-hidden="true"></view></view></button></view>
  <view wx:if="{{metric==='overall' || metric==='good' || metric==='evil'}}" class="rank-rates"><button wx:for="{{rateMetrics}}" wx:key="id" class="{{metric===item.id?'selected':''}}" bindtap="chooseMetric" data-id="{{item.id}}" aria-pressed="{{metric===item.id}}" hover-class="none">{{item.label}}</button></view>
  <view wx:if="{{funSelected}}" class="fun-rank-filters">
    <view class="fun-metric-selector {{metricsExpanded?'is-expanded':''}}">
      <button class="disclosure-button fun-metric-toggle" bindtap="toggleMetrics" aria-expanded="{{metricsExpanded}}" hover-class="none">
        <view class="fun-metric-current">
          <block wx:for="{{funOptions}}" wx:key="key"><text wx:if="{{metric===item.key}}" class="fun-metric-name">{{item.tabLabel}}</text></block>
        </view>
        <view class="fun-metric-action"><text>{{metricsExpanded?'收起':'切换'}}</text><view class="fun-filter-chevron" aria-hidden="true"></view></view>
      </button>
      <view wx:if="{{metricsExpanded}}" class="fun-metric-options" aria-label="选择趣味指标">
        <button wx:for="{{funOptions}}" wx:key="key" class="fun-metric-option {{metric===item.key?'selected':''}}" bindtap="chooseFunMetric" data-id="{{item.key}}" aria-label="{{item.tabLabel}}" aria-pressed="{{metric===item.key}}" hover-class="none">
          <view class="fun-option-copy"><text class="fun-option-title">{{item.title}}</text><text class="fun-option-label">{{item.label}}</text></view>
          <view wx:if="{{metric===item.key}}" class="fun-option-check" aria-hidden="true"></view>
        </button>
      </view>
    </view>
    <view class="fun-sort-row">
      <text class="fun-filter-label">排序</text>
      <view class="fun-sort" aria-label="排序方式">
        <button hover-class="none" bindtap="chooseFunSort" data-id="count" class="{{funSort==='count'?'selected':''}}" aria-pressed="{{funSort==='count'}}"><view class="fun-sort-dot" aria-hidden="true"></view><text>按次数</text></button>
        <button hover-class="none" bindtap="chooseFunSort" data-id="rate" class="{{funSort==='rate'?'selected':''}}" aria-pressed="{{funSort==='rate'}}"><view class="fun-sort-dot" aria-hidden="true"></view><text>按成功率</text></button>
      </view>
    </view>
    <view wx:if="{{funRoleOptions.length>1}}" class="fun-role-filter">
      <text class="fun-filter-label">出刀角色</text>
      <picker range="{{funRoleOptions}}" range-key="label" value="{{funRoleIndex}}" bindchange="chooseFunRole" aria-label="出刀角色"><view class="fun-picker"><text>{{funRoleOptions[funRoleIndex].label}}</text><view class="fun-filter-chevron" aria-hidden="true"></view></view></picker>
    </view>
    <view wx:if="{{board.fun && funSort==='rate'}}" class="small muted fun-rank-threshold">至少 {{board.threshold}} 次机会参与排名</view>
  </view>
  <view wx:if="{{loading && !board}}" class="status" role="status">正在读取榜单…</view>
  <view wx:if="{{notice}}" class="small muted" role="status">{{notice}}</view>
  <view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button hover-class="none" class="secondary" bindtap="retry" disabled="{{loading || loadingMore}}">重试</button></view>
  <block wx:if="{{board}}">
    <view wx:if="{{board.rows.length || shareable}}" class="rank-list-heading small muted"><view class="rank-heading-label"><text>排名 / 玩家</text><button class="share-entry-button" bindtap="shareLeaderboard" disabled="{{loading || loadingMore || error || visibilitySaving || !shareable}}" hover-class="none" aria-label="分享我的榜单成绩"><image class="share-entry-icon" src="/assets/share.svg" aria-hidden="true" /></button></view><text>{{board.metric==='games'?'有效局数':board.metricLabel}}</text></view>
    <view wx:if="{{board.rows.length}}" class="rank-list">
      <view wx:for="{{board.rows}}" wx:key="publicId" class="rank-row {{item.isSelf?'is-self':''}}">
        <view class="rank-number rank-place-{{item.rank}}" aria-label="第{{item.rank}}名"><image wx:if="{{3 >= item.rank}}" class="rank-crown" src="/assets/rank-{{item.rank}}.svg" aria-hidden="true" /><text>{{item.rank}}</text></view>
        <image wx:if="{{item.avatarUrl}}" class="rank-avatar" src="{{item.avatarUrl}}" mode="aspectFill" aria-hidden="true" />
        <view wx:else class="rank-avatar rank-avatar-fallback" aria-hidden="true">{{item.initial}}</view>
        <view class="rank-identity"><view class="rank-name">{{item.nickname}}<text wx:if="{{item.isSelf}}" class="rank-self-label"> · 我</text></view><view class="small muted">{{board.fun?item.sampleLabel:board.metric==='points'?item.total+'场计分局':item.wins+'胜 · '+item.total+'局'}}</view></view>
        <view class="rank-value">{{item.value}}<text class="rank-unit">{{item.unit}}</text></view>
      </view>
    </view>
    <view wx:else class="rank-empty muted">暂无公开排名</view>
    <button hover-class="none" wx:if="{{board.hasMore}}" class="rank-more" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loading || loadingMore}}">{{loadingMore?'正在加载…':'加载更多'}}</button>
    <view class="rank-mine" aria-label="我的排名">
      <button class="disclosure-button rank-mine-toggle" bindtap="toggleMine" aria-expanded="{{mineExpanded}}" aria-label="我的排名，详情与公开设置" hover-class="none">
        <view class="rank-mine-brief"><text class="small muted">我的名次</text><text class="rank-mine-place">{{board.me.rank?'第 '+board.me.rank+' 名':'未上榜'}}</text></view>
        <view class="rank-mine-brief rank-mine-metric"><text class="rank-mine-value">{{board.me.value}}<text class="rank-unit">{{board.me.unit}}</text></text><text class="small muted">详情与设置 ›</text></view>
      </button>
    </view>
    <view wx:if="{{mineExpanded}}" class="dialog-backdrop rank-details-backdrop" catchtap="toggleMine" catchtouchmove="blockScroll">
      <view class="error-dialog rank-details-dialog" catchtap="blockScroll" role="dialog" aria-modal="true" aria-label="我的排名与公开设置">
        <view class="rank-details-header"><view class="dialog-title">我的排名</view><button class="rank-disclosure" bindtap="toggleMine" hover-class="none">关闭</button></view>
        <scroll-view scroll-y class="rank-details-body">
      <view class="rank-mine-content">
        <view class="rank-mine-copy"><view class="rank-mine-label">我的名次</view><view class="rank-mine-place {{board.me.rank?'':'is-unranked'}}"><block wx:if="{{board.me.rank}}"><text class="rank-mine-prefix">第</text><text>{{board.me.rank}}</text><text class="rank-mine-unit">名</text></block><text wx:else>未上榜</text></view></view>
        <view class="rank-mine-metric"><view class="rank-mine-label">{{board.metric==='games'?'总局数':board.metricLabel}}</view><view class="rank-mine-value">{{board.me.value}}<text class="rank-mine-unit">{{board.me.unit}}</text></view></view>
      </view>
      <view wx:if="{{board.fun}}" class="small muted fun-mine-sample">{{board.me.knownGames?board.me.count+" / "+board.me.opportunities+" 次机会":"暂无完整样本"}}<text wx:if="{{board.me.statusLabel}}"> · {{board.me.statusLabel}}</text><text wx:if="{{board.me.unknownGames}}"> · {{board.me.unknownGames}} 局未记录</text></view>
      <label wx:if="{{board.me.status!=='unsupported'}}" class="rank-visibility"><text>{{visibilitySaving?'正在保存…':'在排行榜公开展示'}}</text><switch checked="{{visible}}" bindchange="changeVisibility" disabled="{{visibilitySaving}}" color="#e5c68b" aria-label="在排行榜公开展示" /></label>
      <view wx:if="{{board.me.status!=='unsupported'}}" class="small muted">关闭后不参与公开排名，仍可分享本人成绩；已发送图片不会撤回。</view>
      <view wx:if="{{visibilityError}}" class="rank-visibility-error" role="alert"><text>{{visibilityError}}</text><button hover-class="none" bindtap="retryVisibility" disabled="{{visibilitySaving}}">重试</button></view>
        </scroll-view>
      </view>
    </view>
  </block>
</view>
