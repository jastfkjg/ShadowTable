.rank-metrics-sheet { height: 88vh; }
.rank-metrics-sheet .rank-sheet-header { gap: 12px; margin: 6px 0 12px; }
.rank-picker-modes, .rank-picker-search {
  display: flex; align-items: center; box-sizing: border-box; border: 1px solid var(--border);
  background: var(--bg); border-radius: 9px;
}
.rank-picker-modes { flex: 1; min-width: 0; padding: 3px; gap: 3px; }
button.rank-picker-mode { flex: 1; min-width: 0; min-height: 38px; width: auto; margin: 0; padding: 4px; background: transparent; border: 1px solid transparent; color: var(--muted); font-weight: 600; font-size: 15px; }
button.rank-picker-mode.selected { background: rgba(229,198,139,.14); border-color: rgba(229,198,139,.28); color: var(--accent); }
.rank-picker-search { flex-shrink: 0; gap: 9px; margin: 0 16px 10px; padding: 0 12px; }
.rank-picker-search-icon { flex: none; width: 18px; height: 18px; }
input.rank-picker-input { box-sizing: border-box; flex: 1; width: 0; min-width: 0; height: 42px; min-height: 0; margin: 0; padding: 0; border: 0; background: transparent; font-size: 15px; color: var(--text); }
.rank-picker-placeholder { color: var(--muted); }
.rank-picker-art { flex: none; width: 40px; height: 40px; object-fit: contain; }
.rank-picker-selected { color: var(--text); font-weight: 600; }
.rank-metrics-sheet .fun-metric-options { flex: 1 1 0%; height: 0; max-height: none; }
.rank-metrics-sheet .fun-metric-option { border-bottom-color: var(--rank-line); border-radius: 0; margin-bottom: 0; }
.rank-metrics-sheet .fun-metric-option.selected { border-color: rgba(229,198,139,.55); border-radius: 8px; }
.rank-metrics-sheet .rank-category-empty { padding: 20px 8px; text-align: center; }
@media (max-height: 500px) {
  .rank-metrics-sheet { height: 96vh; }
  .rank-metrics-sheet .rank-sheet-header { margin: 0 0 4px; }
  .rank-picker-search { margin-bottom: 4px; }
  .rank-metrics-sheet .fun-scroll-hint { display: none; }
}
