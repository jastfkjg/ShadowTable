<import src="./detail.wxml" />
<template name="historyPanel">
<view class="page personal-page matches-page">
  <view wx:if="{{funFilter}}" class="fun-filter"><text>相关趣味记录</text><button hover-class="none" bindtap="historyClearFunFilter" disabled="{{loading || loadingMore}}">查看全部 ›</button></view>
  <view class="matches-toolbar">
    <view class="matches-filters" aria-label="对局筛选">
      <button hover-class="none" class="{{scoredOnly?'':'selected'}}" bindtap="historyFilterScores" data-scored="0" aria-pressed="{{!scoredOnly}}" disabled="{{loading || loadingMore}}"><text>全部对局</text></button>
      <button hover-class="none" class="{{scoredOnly?'selected':''}}" bindtap="historyFilterScores" data-scored="1" aria-pressed="{{scoredOnly}}" disabled="{{loading || loadingMore}}"><text>计分对局</text></button>
    </view>
    <button wx:if="{{filtersAvailable}}" class="disclosure-button matches-filter-toggle {{filterCount?'active':''}}" bindtap="historyToggleFilters" aria-expanded="{{filtersExpanded}}" hover-class="none"><text>筛选{{filterCount?' · '+filterCount:''}}</text><view class="match-arrow {{filtersExpanded?'expanded':''}}" aria-hidden="true"></view></button>
  </view>
  <view wx:if="{{filtersExpanded && filtersAvailable}}" class="matches-filter-panel">
    <picker wx:for="{{filterGroups}}" wx:key="key" range="{{item.options}}" range-key="label" value="{{item.index}}" data-key="{{item.key}}" bindchange="historyChooseFilter" disabled="{{loading || loadingMore}}" aria-label="{{item.label+'筛选，'+item.valueLabel}}">
      <view class="match-filter-field {{item.active?'active':''}}"><text class="match-filter-label">{{item.label}}</text><view class="match-filter-value"><text>{{item.valueLabel}}</text><view class="match-filter-chevron" aria-hidden="true"></view></view></view>
    </picker>
    <view class="match-filter-note">时间按北京时间计算；角色为结算时的身份。</view>
  </view>
  <view class="matches-result-summary" wx:if="{{loaded || filterCount}}">
    <view class="matches-result-copy"><text wx:if="{{loaded}}" class="matches-count">{{filterCount?'筛选结果':'共'}} {{total}} 场</text><view wx:if="{{filterCount}}" class="match-filter-summary">{{filterSummary}}</view></view>
    <button wx:if="{{filterCount}}" class="matches-filter-clear" bindtap="historyClearFilters" disabled="{{loading || loadingMore}}" hover-class="none">清空筛选</button>
  </view>
  <view wx:if="{{loading && !loaded && !records.length}}" class="status">正在读取对局记录…</view>
  <view wx:if="{{error}}" class="inline-error" role="alert"><view>{{error}}</view><button hover-class="none" class="secondary" bindtap="historyRetry" disabled="{{loading || loadingMore}}">重新加载</button></view>
  <view wx:if="{{(loaded || !loading) && !error && !total}}" class="matches-empty muted"><view>{{filterCount?'没有符合筛选条件的对局':funFilter?'暂无相关趣味记录':scoredOnly?'暂无计分对局':'暂无对局记录'}}</view><view wx:if="{{filterCount}}" class="match-note">可调整条件，或清空筛选查看记录。</view></view>
  <block wx:if="{{records.length}}">
    <block wx:for="{{records}}" wx:key="id">
      <view wx:if="{{index===0 || item.dayKey!==records[index-1].dayKey}}" class="match-day">{{item.dayLabel}}</view>
      <view class="match-entry {{index===records.length-1 || item.dayKey!==records[index+1].dayKey?'match-day-last':''}}">
        <button hover-class="none" class="disclosure-button match-toggle" bindtap="historyToggleRecord" data-id="{{item.id}}" aria-expanded="{{item.expanded}}" aria-label="{{item.boardName}}，{{item.outcomeLabel}}，{{item.role}}，{{item.factionLabel}}，{{item.capacity}}人，{{item.dateLabel}}，{{item.scoreLabel}}，{{item.expanded?'收起详情':'展开详情'}}">
          <view class="match-top"><text class="match-board">{{item.boardName}}</text><text class="match-outcome {{item.outcome}}">{{item.outcomeLabel}}</text></view>
          <view class="match-secondary"><text>{{item.role}} · {{item.factionLabel}} · {{item.capacity}}人</text><view class="match-arrow {{item.expanded?'expanded':''}}" aria-hidden="true"></view></view>
          <view class="match-meta"><text>{{item.timeLabel}}</text><text class="match-meta-dot" aria-hidden="true">·</text><text class="{{item.score.status==='scored'?'accent':''}}">{{item.scoreLabel}}</text></view>
          <view wx:if="{{item.funLabel}}" class="match-fun-label">{{item.funLabel}}</view>
        </button>
        <template wx:if="{{item.expanded}}" is="matchDetails" data="{{item}}" />
      </view>
    </block>
    <button hover-class="none" wx:if="{{hasMore && !error}}" class="matches-more" bindtap="historyLoadMore" disabled="{{loadingMore}}" loading="{{loadingMore}}">{{loadingMore?'正在加载…':'加载更多'}}</button>
  </block>
</view>
</template>
