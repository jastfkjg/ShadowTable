.matches-page { padding-top: 26rpx; }
.matches-count { margin-bottom: 8rpx; color: var(--muted); font-size: 24rpx; }
.match-entry { border-bottom: 1rpx solid rgba(177,191,198,.22); }
button.match-toggle { display: block; width: 100%; min-height: 168rpx; margin: 0; padding: 24rpx 0; text-align: left; border-radius: 0; }
.match-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.match-date { color: var(--muted); font-size: 24rpx; font-weight: 400; }
.match-outcome { color: var(--muted); font-size: 25rpx; font-weight: 600; white-space: nowrap; }
.match-outcome.win { color: var(--good); }
.match-outcome.loss { color: var(--evil); }
.match-board { margin-top: 8rpx; font-size: 32rpx; font-weight: 600; overflow-wrap: anywhere; }
.match-secondary { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; color: var(--muted); font-size: 25rpx; }
.match-secondary text:first-child { min-width: 0; overflow-wrap: anywhere; }
.match-arrow { flex-shrink: 0; font-size: 38rpx; line-height: 1; }
.match-details { margin-bottom: 24rpx; padding: 22rpx 24rpx; border-radius: 16rpx; background: var(--surface); font-size: 26rpx; }
.match-detail-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 5rpx 0; }
.match-detail-row text:first-child { flex-shrink: 0; color: var(--muted); }
.match-detail-row text:last-child { text-align: right; overflow-wrap: anywhere; }
.match-members-label { margin-top: 18rpx; color: var(--muted); }
.match-members { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8rpx 18rpx; margin-top: 12rpx; }
.match-member { display: flex; gap: 10rpx; min-width: 0; font-size: 25rpx; line-height: 1.6; }
.match-member text:first-child { flex-shrink: 0; color: var(--muted); }
.match-member text:last-child { min-width: 0; overflow-wrap: anywhere; }
.match-member.is-self text:last-child { color: var(--accent); }
button.matches-more { width: auto; min-height: 88rpx; margin: 24rpx 0; padding: 8rpx 0; color: var(--accent); font-size: 27rpx; }
.matches-empty { padding: 34rpx 0; text-align: center; font-size: 26rpx; }

.matches-filters { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.matches-filters button { flex: 1; width: 0; min-height: 48px; margin: 0; background: var(--surface); color: var(--muted); }
.matches-filters button.selected { color: var(--accent); }
.match-score { margin-top: 8rpx; font-size: 26rpx; font-weight: 500; }
.score-breakdown { margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid var(--border); }
