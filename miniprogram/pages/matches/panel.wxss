.matches-page { --matches-list-bg: var(--surface); --matches-selected: #30424d; --matches-line: rgba(177,191,198,.13); padding-top: 14px; }
.records-pane .page.matches-page { padding-top: 14px; }
.matches-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.matches-filters { display: flex; flex: 1; max-width: 360px; min-width: 0; padding: 3px; gap: 3px; border-radius: 12px; background: var(--matches-list-bg); }
.matches-filters button, .matches-filters button[disabled]:not([type]) { flex: 1; width: 0; min-width: 0; min-height: 44px; margin: 0; padding: 6px; color: var(--muted); font-size: 13px; font-weight: 400; border-radius: 9px; }
.matches-filters button.selected, .matches-filters button.selected[disabled]:not([type]) { background: var(--matches-selected); color: var(--text); font-weight: 600; }
.matches-count { display: flex; align-items: baseline; gap: 5px; color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
.matches-count-value { font-size: 24px; font-weight: 600; color: var(--text); }
.match-day { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 16px; color: var(--muted); font-size: 13px; font-weight: 600; }
.matches-page .match-day { margin: 22px 4px 12px; color: var(--text); font-size: 14px; }
.match-calendar-icon { flex-shrink: 0; width: 17px; height: 17px; }
.match-year { color: var(--muted); font-size: 12px; font-weight: 400; }
/* Consecutive records keep one surface per day, including across pagination. */
.match-entry { position: relative; background: var(--matches-list-bg); }
.match-entry::after { content: ''; position: absolute; bottom: 0; left: 16px; right: 16px; height: 1px; background: var(--matches-line); pointer-events: none; }
.match-entry.match-day-first { border-top-left-radius: 22px; border-top-right-radius: 22px; }
.match-entry.match-day-last { border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; }
.match-entry.match-day-last::after { display: none; }
.match-summary { position: relative; border-radius: inherit; }
button.match-toggle { display: block; width: 100%; min-height: 44px; margin: 0; padding: 18px 16px 8px; text-align: left; border-radius: inherit; font-weight: 400; }
button.match-toggle:not([disabled]):active { background: rgba(177,191,198,.04); }
button.match-toggle:focus-visible, .match-summary button.match-replay-entry:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.match-heading { display: flex; align-items: flex-start; gap: 11px; position: relative; min-height: 53px; }
.match-portrait { position: relative; display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 48px; height: 51px; margin-top: 1px; background: var(--control-bg); border-radius: 15px; }
.match-portrait image { width: 54px; height: 54px; flex-shrink: 0; }
.match-faction-dot { position: absolute; right: 0; bottom: 0; width: 7px; height: 7px; border: 1.5px solid var(--surface); border-radius: 50%; background: var(--muted); box-sizing: border-box; }
.match-faction-dot.is-good { background: var(--good); }.match-faction-dot.is-evil { background: var(--evil); }.match-faction-dot.is-third { background: var(--third); }
.match-copy { flex: 1; min-width: 0; }
.match-identity { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; gap: 6px; padding-right: 52px; overflow-wrap: anywhere; }
.match-role { min-width: 0; max-width: 100%; color: var(--text); font-size: 16px; font-weight: 600; line-height: 1.5; }
.match-entry .match-board { margin-top: 6px; padding-right: 14px; color: var(--muted); font-size: 12px; font-weight: 400; line-height: 1.6; overflow-wrap: anywhere; }
.match-capacity, .match-context { white-space: nowrap; }
.match-context { color: var(--muted); font-size: 12px; }
.match-outcome { position: absolute; right: 0; top: 3px; padding: 1px 6px; border-radius: 6px; color: var(--muted); background: rgba(177,191,198,.07); font-size: 11px; font-weight: 400; line-height: 20px; white-space: nowrap; }
.match-outcome.win { color: var(--good); background: rgba(163,223,190,.08); }.match-outcome.loss { color: var(--evil); background: rgba(242,182,174,.08); }
.match-arrow { position: absolute; right: 3px; bottom: 3px; width: 5px; height: 5px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; color: var(--muted); transform: rotate(135deg); transition: transform 160ms ease; }
.match-arrow.expanded { transform: rotate(-45deg); }
.match-footer { display: flex; align-items: center; min-height: 44px; margin: 4px 0 0 59px; }
.match-footer.has-replay { padding-right: 76px; }
.match-meta { display: flex; flex: 1; min-width: 0; flex-wrap: wrap; align-items: baseline; gap: 6px; color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
.match-score-negative { color: var(--evil); }
button.match-replay-entry { flex-shrink: 0; width: auto; min-height: 44px; margin: 0 0 0 auto; padding: 7px 0; border-radius: 8px; color: var(--muted); font-size: 12px; font-weight: 400; }
.match-summary button.match-replay-entry { position: absolute; bottom: 8px; right: 16px; min-width: 68px; padding: 0; justify-content: flex-end; gap: 4px; }
.match-replay-entry image { width: 15px; height: 15px; flex-shrink: 0; }
.match-replay-chevron { width: 5px; height: 5px; margin: 0 2px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: rotate(45deg); }
.match-fun-label, .match-highlight { color: var(--muted); font-size: 12px; font-weight: 400; line-height: 1.5; }
.match-highlights { display: flex; flex-wrap: wrap; min-width: 0; gap: 4px 8px; }
.match-highlight.good { color: var(--good); }.match-highlight.evil { color: var(--evil); }
@media (max-width:350px) { .match-heading { gap:8px; }.match-portrait { width:40px; height:46px; }.match-portrait image { width:46px; height:46px; }.match-role { font-size:15px; }.match-footer { margin-left:48px; } }
.matches-end { padding-top: 24px; color: var(--muted); font-size: 12px; text-align: center; }
.match-details { margin-top: 8px; padding: 24rpx; border-radius: 16rpx; background: var(--surface); font-size: 26rpx; overflow-wrap: anywhere; }
.match-entry .match-details { margin: 0 16px 12px; background: var(--bg); }
.match-entry.match-expanded { padding-bottom: 1px; }
.match-result { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx 16rpx; margin-bottom: 12rpx; }
.match-source { color: var(--muted); font-size: 24rpx; }
.match-source::before { content: "·"; margin-right: 16rpx; }
.match-detail-row { display: flex; justify-content: space-between; align-items: baseline; gap: 24rpx; padding: 6rpx 0; }
.match-detail-row > text:first-child { flex: 1; min-width: 0; color: var(--muted); }
.match-detail-row > text:last-child { max-width: 62%; text-align: right; }
.match-note { color: var(--muted); font-size: 24rpx; line-height: 1.7; margin-top: 6rpx; }
.match-section-label { font-size: 26rpx; font-weight: 500; }
.match-fun, .score-breakdown { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); }
.fun-event { padding: 16rpx 0 0; }
.score-total { margin-top: 8rpx; }
.match-members-section { margin-top: 20rpx; margin-bottom: -24rpx; border-top: 1rpx solid var(--border); }
button.match-members-toggle { justify-content: space-between; gap: 20rpx; width: 100%; min-height: 48px; margin: 0; padding: 20rpx 0; border-radius: 0; font-size: 26rpx; font-weight: 400; text-align: left; }
.match-member-count { color: var(--muted); font-size: 24rpx; }
.match-members { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx 24rpx; padding: 0 0 24rpx; }
.match-member { display: flex; align-items: baseline; gap: 8rpx; min-width: 0; font-size: 25rpx; line-height: 1.6; }
.match-seat { flex-shrink: 0; width: 3em; color: var(--muted); font-size: 24rpx; font-variant-numeric: tabular-nums; }
.match-member-name { min-width: 0; overflow-wrap: anywhere; }
.match-member.is-self .match-member-name { color: var(--accent); }
.match-self { white-space: nowrap; }
button.matches-more { width: 100%; min-height: 48px; margin: 24rpx 0; padding: 8rpx 0; color: var(--accent); font-size: 27rpx; }
.matches-empty { padding: 64rpx 0; text-align: center; font-size: 26rpx; }
.fun-filter { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 8rpx; color: var(--accent); font-size: 26rpx; }
.fun-filter button { width: auto; margin: 0; min-height: 48px; padding: 12rpx 0; color: var(--accent); font-size: 26rpx; }

button.matches-filter-toggle { width: auto; min-width: 64px; flex-shrink: 0; justify-content: flex-end; min-height: 48px; gap: 5px; padding: 0 0 0 7px; margin: 0; font-size: 13px; color: var(--muted); white-space: nowrap; }
.matches-filter-toggle image { width: 17px; height: 17px; flex-shrink: 0; }
.matches-filter-toggle text { flex-shrink: 0; }
button.matches-filter-toggle.active { color: var(--accent); }
.matches-result-summary { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 12px; margin: 18px 3px 0; min-height: 32px; }
.matches-result-copy { min-width: 0; }
.matches-outcome-summary { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: baseline; gap: 4px 6px; color: var(--muted); font-size: 12px; text-align: right; font-variant-numeric: tabular-nums; }
.matches-outcome-summary > text { white-space: nowrap; }
.matches-outcome-summary .win { color: var(--good); }
.matches-outcome-summary .loss { color: var(--evil); }
.match-filter-summary { color: var(--accent); font-size: 12px; overflow-wrap: anywhere; margin-top: 4px; }
button.matches-filter-clear { width: auto; flex-shrink: 0; min-height: 48px; margin: 0; padding: 12px 0 12px 12px; color: var(--accent); font-size: 12px; }
/* Kept outside the retained scroll pane so the sheet covers the full viewport. */
.matches-filter-backdrop { position: fixed; inset: 0; z-index: 300; display: flex; align-items: flex-end; background: rgba(0,0,0,.55); }
.matches-filter-sheet { display: flex; flex-direction: column; width: 100%; max-width: 600px; max-height: 90vh; margin: 0 auto; padding: 10px 20px calc(24px + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 24px 24px 0 0; background: var(--surface); animation: records-sheet-in 180ms ease-out; }
.matches-sheet-handle { flex-shrink: 0; width: 32px; height: 4px; margin: 0 auto 8px; border-radius: 4px; background: var(--border); }
.matches-sheet-heading { display: flex; flex-shrink: 0; align-items: center; justify-content: space-between; margin-bottom: 16px; font-size: 18px; font-weight: 600; }
button.matches-sheet-close { width: 44px; min-height: 44px; margin: 0 -10px 0 0; padding: 0; font-size: 28px; font-weight: 400; color: var(--muted); }
.matches-sheet-body { height: 244px; min-height: 0; max-height: 52vh; flex-shrink: 1; }
.matches-filter-panel { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 19px 13px; }
.matches-filter-panel picker { min-width: 0; }
.match-filter-field { display: flex; flex-direction: column; justify-content: center; min-height: 76px; box-sizing: border-box; }
.match-filter-label { color: var(--muted); font-size: 12px; margin-bottom: 9px; }
.match-filter-value { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; padding: 10px; box-sizing: border-box; border: 1rpx solid var(--border); border-radius: 9px; background: var(--bg); font-size: 13px; }
.match-filter-value > text { min-width: 0; overflow-wrap: anywhere; }
.match-filter-field.active .match-filter-value { color: var(--accent); border-color: var(--accent); }
.match-filter-chevron { width: 6px; height: 6px; flex-shrink: 0; margin: -3px 3px 0 0; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); }
.match-filter-note { color: var(--muted); font-size: 12px; line-height: 1.8; margin: 19px 0; }
.matches-sheet-actions { display: flex; flex-shrink: 0; gap: 12px; }
.matches-sheet-actions button { min-height: 48px; margin: 0; padding: 10px; border-radius: 9px; font-size: 14px; font-weight: 600; }
button.matches-filter-reset { width: 90px; background: var(--records-selected); }
button.matches-filter-apply { flex: 1; width: 0; background: var(--accent); color: var(--bg); }
@keyframes records-sheet-in { from { transform: translateY(24px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@media (max-height: 500px) {
  .matches-filter-sheet { max-height: 95vh; padding-bottom: calc(12px + env(safe-area-inset-bottom)); }
  .matches-sheet-heading { margin-bottom: 8px; }
  .matches-sheet-body { max-height: 46vh; }
}
@media (prefers-reduced-motion: reduce) { .match-arrow { transition: none; } .matches-filter-sheet { animation: none; } }
