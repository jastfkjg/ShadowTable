.matches-page { padding-top: 20rpx; }
.matches-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; }
.matches-filters { position: relative; display: flex; flex: 1; max-width: 456rpx; min-width: 0; padding: 0 4rpx; }
.matches-filters::before { content: ""; position: absolute; inset: 8rpx 0; border-radius: 16rpx; background: var(--surface); }
.matches-filters button, .matches-filters button[disabled]:not([type]) { position: relative; flex: 1; width: 0; min-height: 48px; margin: 0; padding: 12rpx 4rpx; background: transparent; color: var(--muted); font-size: 27rpx; font-weight: 400; }
.matches-filters button text { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 64rpx; padding: 4rpx 8rpx; box-sizing: border-box; border-radius: 12rpx; }
.matches-filters button.selected text { background: var(--bg); color: var(--accent); font-weight: 500; }
.matches-count { flex-shrink: 0; color: var(--muted); font-size: 24rpx; font-variant-numeric: tabular-nums; }
.match-day { margin-top: 24rpx; padding: 8rpx 0; color: var(--muted); font-size: 24rpx; font-weight: 400; }
.match-entry { border-bottom: 1rpx solid var(--border); }
.match-entry.match-day-last { border-bottom: 0; }
button.match-toggle { display: block; width: 100%; margin: 0; padding: 24rpx 0; text-align: left; border-radius: 0; font-weight: 400; }
.match-top { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; }
.match-board { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.match-outcome { flex-shrink: 0; color: var(--muted); font-size: 25rpx; font-weight: 600; }
.match-outcome.win { color: var(--good); }
.match-outcome.loss { color: var(--evil); }
.match-secondary { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 8rpx; color: var(--text); font-size: 27rpx; }
.match-secondary > text { min-width: 0; overflow-wrap: anywhere; }
.match-arrow { width: 12rpx; height: 12rpx; flex-shrink: 0; margin-right: 6rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; color: var(--muted); transform: rotate(45deg); transition: transform 160ms ease; }
.match-arrow.expanded { transform: rotate(135deg); }
.match-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12rpx; margin-top: 8rpx; color: var(--muted); font-size: 24rpx; font-variant-numeric: tabular-nums; }
.match-fun-label { margin-top: 12rpx; color: var(--accent); font-size: 24rpx; }
.match-details { margin-bottom: 24rpx; padding: 24rpx; border-radius: 16rpx; background: var(--surface); font-size: 26rpx; overflow-wrap: anywhere; }
.match-result { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx 16rpx; margin-bottom: 12rpx; }
.match-source { color: var(--muted); font-size: 24rpx; }
.match-source::before { content: "·"; margin-right: 16rpx; }
.match-detail-row { display: flex; justify-content: space-between; align-items: baseline; gap: 24rpx; padding: 6rpx 0; }
.match-detail-row > text:first-child { flex: 1; min-width: 0; color: var(--muted); }
.match-detail-row > text:last-child { max-width: 62%; text-align: right; }
.match-note { color: var(--muted); font-size: 24rpx; line-height: 1.7; margin-top: 6rpx; }
.match-section-label { font-size: 26rpx; font-weight: 500; }
.match-fun, .score-breakdown { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--border); }
.fun-event { padding: 16rpx 0 0; }
.score-total { margin-top: 8rpx; }
.match-members-section { margin-top: 20rpx; margin-bottom: -24rpx; border-top: 1rpx solid var(--border); }
button.match-members-toggle { justify-content: space-between; gap: 20rpx; width: 100%; min-height: 48px; margin: 0; padding: 20rpx 0; border-radius: 0; font-size: 26rpx; font-weight: 400; text-align: left; }
.match-member-count { color: var(--muted); font-size: 24rpx; }
.match-members { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx 24rpx; padding: 0 0 24rpx; }
.match-member { display: flex; align-items: baseline; gap: 8rpx; min-width: 0; font-size: 25rpx; line-height: 1.6; }
.match-seat { flex-shrink: 0; width: 3em; color: var(--muted); font-size: 24rpx; font-variant-numeric: tabular-nums; }
.match-member-name { min-width: 0; overflow-wrap: anywhere; }
.match-member.is-self .match-member-name { color: var(--accent); }
.match-self { white-space: nowrap; }
button.matches-more { width: 100%; min-height: 48px; margin: 24rpx 0; padding: 8rpx 0; color: var(--accent); font-size: 27rpx; }
.matches-empty { padding: 64rpx 0; text-align: center; font-size: 26rpx; }
.fun-filter { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 8rpx; color: var(--accent); font-size: 26rpx; }
.fun-filter button { width: auto; margin: 0; min-height: 48px; padding: 12rpx 0; color: var(--accent); font-size: 26rpx; }
.adjustment-history { margin-top: 36rpx; }
.adjustment-history .section-title { font-size: 28rpx; }
.adjustment-entry { padding: 24rpx 0; line-height: 1.6; overflow-wrap: anywhere; }
.match-date { color: var(--muted); font-size: 24rpx; font-weight: 400; }
@media (prefers-reduced-motion: reduce) { .match-arrow { transition: none; } }

button.matches-filter-toggle { width: auto; flex-shrink: 0; min-height: 48px; gap: 16rpx; padding: 12rpx 4rpx 12rpx 16rpx; margin: 0; font-size: 26rpx; color: var(--muted); }
button.matches-filter-toggle.active { color: var(--accent); }
.matches-filter-panel { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; padding: 24rpx; border-radius: 20rpx; background: var(--surface); }
.matches-filter-panel picker { min-width: 0; }
.match-filter-field { display: flex; flex-direction: column; justify-content: center; min-height: 64px; padding: 12rpx 16rpx; border-radius: 12rpx; background: var(--bg); box-sizing: border-box; }
.match-filter-label { color: var(--muted); font-size: 24rpx; }
.match-filter-value { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 6rpx; font-size: 26rpx; }
.match-filter-value > text { min-width: 0; overflow-wrap: anywhere; }
.match-filter-field.active .match-filter-value { color: var(--accent); }
.match-filter-chevron { width: 10rpx; height: 10rpx; flex-shrink: 0; margin: -4rpx 4rpx 0 0; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); }
.match-filter-note { grid-column: 1 / -1; color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.matches-result-summary { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 16rpx 0 8rpx; min-height: 32px; }
.matches-result-copy { min-width: 0; }
.match-filter-summary { color: var(--muted); font-size: 24rpx; overflow-wrap: anywhere; margin-top: 4rpx; }
button.matches-filter-clear { width: auto; flex-shrink: 0; min-height: 48px; margin: 0; padding: 12rpx 0 12rpx 16rpx; color: var(--accent); font-size: 24rpx; }
