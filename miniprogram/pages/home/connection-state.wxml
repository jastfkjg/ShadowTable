<!-- Connection feedback takes space only while connection or confirmation is pending. -->
<view wx:if="{{(!connectionDeferred || reconnecting || !network || needsLogin || hasPendingRequest) && (loading || reconnecting || !network || needsLogin || hasPendingRequest || connectionPhase==='connecting')}}" class="home-connection {{connectionPhase==='offline' || (!connectionPhase && !network)?'is-offline':reconnecting || needsLogin?'is-reconnecting':''}}">
  <view class="home-connection-symbol" aria-hidden="true">
    <image wx:if="{{connectionPhase==='offline' || (!connectionPhase && !network)}}" class="home-connection-offline-icon" src="/assets/connection-offline.svg" />
    <view wx:elif="{{connectionPhase==='waiting' || (!connectionPhase && reconnecting)}}" class="home-connection-clock" />
    <view wx:else class="home-connection-signal"><view /><view /><view /><view /></view>
  </view>
  <view class="home-connection-copy">
    <view class="home-connection-title" role="status" aria-live="polite" aria-atomic="true">{{connectionTitle || (needsLogin?'登录已过期':!network?'网络已断开':reconnecting?'暂时无法连接':'正在连接牌桌')}}</view>
    <text class="home-connection-detail">{{connectionDetail || (needsLogin?'重新登录后即可同步牌桌':!network?'请检查 Wi-Fi 或移动网络':hasPendingRequest?'上次操作还在确认，请勿重复操作':reconnecting?'可重新连接以更新牌桌':'连接后即可创建或加入房间')}}</text>
  </view>
  <view wx:if="{{(connectionPhase==='connecting' && network) || (!connectionPhase && loading && network && !needsLogin)}}" class="home-connection-running" aria-busy="true">
    <view class="home-connection-spinner" aria-hidden="true" />
    <text>已等待 {{connectionElapsedSeconds || 0}} 秒</text>
  </view>
  <button wx:else class="home-connection-retry" hover-class="room-swipe-pressed" bindtap="retryLobbyConnection" disabled="{{!!(busy || loading || roomsRefreshing || connectionCanRetry===false)}}" aria-label="{{needsLogin?'重新登录':'重新连接'}}">{{needsLogin?'登录':connectionCanRetry===false && connectionPhase==='waiting'?'稍后重试':'重新连接'}}</button>
</view>
