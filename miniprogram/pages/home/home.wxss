/* Home-only presentation. Every new rule is scoped away from the table. */
@import "../../room-list.wxss";
.home-lobby { --home-divider:rgba(177,191,198,.13); --home-state-bg:rgba(163,223,190,.08); max-width:600px; padding:12px 16px calc(32px + 50px + env(safe-area-inset-bottom)); }
.home-lobby .brand { border:0; padding:0; margin:0 2px 14px; flex-wrap:nowrap; gap:8px; }
.home-lobby .brand-identity { flex-wrap:wrap; gap:0 7px; }.home-lobby .brand-mark { color:var(--text); font-size:20px; letter-spacing:.4px; line-height:1.4; }
.home-lobby .home-brand-symbol { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:30px; height:32px; border-radius:10px; background:#3b372d; }.home-lobby .home-brand-symbol image { width:20px; height:20px; }
.home-lobby .brand-identity .connection-button { width:auto; min-width:44px; min-height:44px; margin:0; padding:0; gap:4px; }.home-lobby .connection-label { font-size:11px; font-weight:400; }.home-lobby .connection-dot { width:6px; height:6px; }
.home-lobby .brand .home-entry { width:auto; min-width:44px; min-height:44px; padding:4px 0; gap:4px; color:var(--muted); font-size:12px; }.home-lobby .home-help-icon { width:16px; height:16px; flex-shrink:0; }
.home-lobby .home-entry-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
.home-lobby button.room-filter { min-width:44px; min-height:44px; font-size:12px; }
.home-lobby button.home-action, .home-lobby button.home-action[disabled]:not([type]) { position:relative; display:flex; flex-direction:column; justify-content:flex-start; align-items:flex-start; gap:8px; width:100%; min-width:0; min-height:133px; padding:16px; margin:0; border:0; border-radius:22px; background:var(--surface); color:var(--text); line-height:1.5; text-align:left; transition:opacity 120ms ease; }
.home-lobby button.home-action-join, .home-lobby button.home-action-join[disabled]:not([type]) { background:#2b3030; box-shadow:inset 0 0 0 1px rgba(229,198,139,.2); }
.home-lobby .home-action-symbol { display:flex; align-items:center; justify-content:center; width:35px; height:35px; margin-bottom:3px; border-radius:12px; background:#263e52; }.home-lobby .home-action-join .home-action-symbol { background:#3b372d; }
.home-lobby .home-action-icon { display:block; width:23px; height:23px; }.home-lobby .home-action-title { font-size:16px; font-weight:600; line-height:1.4; }.home-lobby .home-action-join .home-action-title { color:var(--accent); }.home-lobby .home-action-hint { font-size:12px; font-weight:400; color:var(--muted); }
.home-lobby .home-entry-arrow { position:absolute; right:17px; top:28px; width:6px; height:6px; border-top:1.5px solid var(--accent); border-right:1.5px solid var(--accent); transform:rotate(45deg); }
.home-lobby .history-heading { margin:22px 4px 9px; gap:12px; font-size:16px; }.home-lobby .room-count { margin-left:7px; font-size:12px; font-weight:400; }
.home-lobby button.room-refresh, .home-lobby button.room-refresh[disabled]:not([type]) { display:flex; width:auto; min-width:44px; min-height:44px; padding:0; margin:0; gap:5px; color:var(--muted); font-size:12px; font-weight:400; }.home-lobby .room-refresh-icon { width:15px; height:15px; }.home-lobby .room-refresh-icon.is-refreshing { animation:home-refresh-spin 900ms linear infinite; }
.home-lobby .member-room.room-list-item { display:block; padding:12px 15px 0; margin:0; background:var(--surface); border:0; border-radius:22px; }
.home-lobby .room-swipe { --swipe-remove-bg:#263b47; --swipe-remove-text:#d4e0e6; --swipe-remove-border:#4a606d; --swipe-danger-bg:#3c2a2e; --swipe-danger-text:#efb0a5; --swipe-danger-border:#79504e; position:relative; overflow:hidden; border-radius:22px; margin-bottom:12px; }
.home-lobby .room-swipe .room-swipe-content { position: relative; z-index: 1; width: 100%; min-height:166px; box-sizing: border-box; margin: 0; transition: transform 180ms ease-out; }
.home-lobby .room-swipe.is-dragging .room-swipe-content { transition: none; }
.home-lobby .room-swipe-actions { position:absolute; top:0; right:0; bottom:0; display:flex; flex-direction:column; justify-content:center; gap:10px; width:116px; padding:12px 0; box-sizing:border-box; }
.home-lobby button.room-swipe-action,
.home-lobby button.room-swipe-action[disabled]:not([type]) { display:flex; flex-direction:row; align-items:center; justify-content:center; flex-shrink:0; gap:6px; width:116px; min-width:116px; height:64px; min-height:64px; margin:0; padding:6px; box-sizing:border-box; border:1px solid var(--swipe-remove-border); border-radius:14px; background:var(--swipe-remove-bg); color:var(--swipe-remove-text); font-size:13px; font-weight:500; line-height:1.5; }
.home-lobby button.room-swipe-action.danger,
.home-lobby button.room-swipe-action.danger[disabled]:not([type]) { border-color:var(--swipe-danger-border); background:var(--swipe-danger-bg); color:var(--swipe-danger-text); }
.home-lobby button.room-swipe-action[disabled]:not([type]) { opacity: 1; }
.room-swipe-label { flex-shrink:0; white-space:nowrap; }
.room-swipe-pressed { opacity: .8; }
.room-swipe-remove-icon { position:relative; flex-shrink:0; width:18px; height:18px; border:1.5px solid currentColor; border-radius:50%; box-sizing:border-box; }
.room-swipe-remove-icon::after { content:''; position:absolute; width:8px; height:1.5px; top:50%; left:50%; transform:translate(-50%,-50%); background:currentColor; }
.room-swipe-dissolve-icon { position:relative; flex:0 0 16px; width:16px; height:20px; margin-right:2px; border:1.5px solid currentColor; border-radius:2px; box-sizing:border-box; }
.room-swipe-dissolve-icon > view { position:absolute; width:11px; height:1.5px; right:-4px; top:8px; background:currentColor; box-shadow:0 0 0 3px var(--swipe-danger-bg); }
.room-swipe-dissolve-icon > view::after { content: ''; position: absolute; width: 6px; height: 6px; left: 0; top: -3px; border-left: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); }
@media (prefers-reduced-motion: reduce) { .home-lobby .room-swipe .room-swipe-content { transition: none; } }
.home-lobby .room-list-top { align-items:center; gap:7px; min-height:36px; padding-right:30px; }.home-lobby .home-room-icon { flex-shrink:0; width:18px; height:18px; }
.home-lobby .room-list-title { flex:1; min-width:0; font-size:15px; font-weight:600; line-height:1.5; white-space:normal; overflow:visible; text-overflow:clip; overflow-wrap:anywhere; }
.home-lobby .room-status { padding:1px 6px; border-radius:7px; color:var(--muted); background:rgba(177,191,198,.07); font-size:11px; font-weight:400; line-height:1.7; white-space:nowrap; }
.home-lobby .room-status.lobby { color:var(--good); background:var(--home-state-bg); }.home-lobby .room-status.playing { color:var(--accent); background:rgba(229,198,139,.1); }
.home-lobby .room-list-board { margin:5px 0 0; color:var(--muted); font-size:12px; }
.home-lobby .room-list-code { display:flex; align-items:center; min-height:44px; gap:4px; color:var(--muted); font-size:12px; line-height:1.5; font-weight:400; }.home-lobby .home-room-code-value { color:#c7d3d9; font-size:15px; font-weight:500; letter-spacing:1px; margin-left:3px; font-variant-numeric:tabular-nums; }
.home-lobby button.room-list-copy, .home-lobby button.room-list-copy[disabled]:not([type]) { display:inline-flex; flex:0 0 44px; align-items:center; justify-content:center; width:44px; height:44px; min-height:44px; margin:0; padding:0; border:0; background:transparent; color:var(--muted); border-radius:8px; }.home-lobby .room-list-copy .lobby-copy-icon { width:13px; height:15px; }
.home-lobby .room-list-meta { justify-content:space-between; align-items:baseline; gap:4px 10px; margin:5px 0 13px; font-size:12px; line-height:1.5; }.home-lobby .room-list-people { display:flex; align-items:center; flex-shrink:0; gap:5px; color:var(--text); }.home-lobby .room-list-people image { flex-shrink:0; width:14px; height:14px; }.home-lobby .room-list-relation { min-width:0; overflow-wrap:anywhere; text-align:right; }
.home-lobby .room-list-footer { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:48px; border-top:1px solid var(--home-divider); }.home-lobby .room-list-time { display:flex; align-items:center; gap:4px; flex:1; min-width:0; margin:0; font-size:11px; line-height:1.5; }.home-lobby .room-list-time image { flex-shrink:0; width:12px; height:12px; }.home-lobby .room-list-time text { min-width:0; overflow-wrap:anywhere; }
.home-lobby button.room-list-open, .home-lobby button.room-list-open[disabled]:not([type]) { display:flex; flex-shrink:0; align-items:center; justify-content:flex-end; gap:7px; width:auto; max-width:45%; min-height:44px; margin:0; padding:6px 0 6px 6px; border:0; border-radius:0; background:transparent; color:var(--accent); font-size:12px; line-height:1.5; font-weight:400; }.home-lobby .home-room-arrow { flex-shrink:0; width:5px; height:5px; margin-right:3px; border-top:1.5px solid currentColor; border-right:1.5px solid currentColor; transform:rotate(45deg); }
.home-lobby button.room-more, .home-lobby button.room-more[disabled]:not([type]) { right:0; top:8px; display:flex; align-items:center; justify-content:center; width:44px; min-height:44px; padding:0; }.home-lobby .room-more image { width:18px; height:18px; }
.home-lobby .is-unavailable .room-list-title, .home-lobby .is-unavailable .room-list-people, .home-lobby .is-unavailable button.room-list-open[disabled] { color:var(--muted); }
.home-lobby .room-empty { margin-top:12px; padding:32px 0; }.home-lobby .room-empty-title { color:var(--text); font-size:15px; font-weight:500; }.home-lobby .room-empty-hint { margin-top:10px; font-size:13px; }
@media(max-width:350px) { .home-lobby { padding-left:12px; padding-right:12px; }.home-lobby .brand-mark { font-size:18px; }.home-lobby .brand-identity { gap:0 5px; }.home-lobby button.home-action { padding:14px; }.home-lobby .home-action-title { font-size:15px; }.home-lobby .home-action-hint { font-size:12px; }.home-lobby .member-room.room-list-item { padding-left:12px; padding-right:12px; }.home-lobby .room-list-title { font-size:14px; } }
@media(min-width:600px) { .home-lobby { padding-left:24px; padding-right:24px; } }

@import "./room-sheets.wxss";

@media(max-width:360px) {
 .home-lobby .brand-mark { font-size:40rpx; }.home-lobby .brand-identity { gap:0 8rpx; }.home-lobby .connection-label { font-size:11px; }.home-lobby .room-list-title { font-size:14px; }.home-lobby .home-action-title { font-size:18px; }
 .home-lobby .home-action-hint, .home-lobby .room-list-meta, .home-lobby .room-list-time, .home-lobby .room-list-board, .home-lobby .room-status, .home-lobby button.room-list-open, .home-lobby button.room-refresh, .home-lobby .brand .home-entry { font-size:12px; }.home-lobby .room-list-code { font-size:14px; }
}
