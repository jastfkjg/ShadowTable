/* Home-only presentation; the shared table controller keeps its game styles. */
.home-lobby {
  --home-divider: rgba(177, 191, 198, .18);
  --home-card-border: rgba(177, 191, 198, .25);
  --home-state-bg: rgba(163, 223, 190, .12);
  padding: 20rpx 32rpx calc(32rpx + 50px + env(safe-area-inset-bottom));
}
.home-lobby .brand { border: 0; padding: 0; margin-bottom: 20rpx; flex-wrap: nowrap; gap: 8rpx; }
.home-lobby .brand-identity { flex-wrap: wrap; gap: 0 12rpx; }
.home-lobby .brand-mark { font-size: 44rpx; letter-spacing: 2rpx; line-height: 1.4; }
.home-lobby .brand-identity .connection-button { min-width: 0; min-height: 44px; padding: 0; gap: 8rpx; }
.home-lobby .connection-label { font-size: 22rpx; }
.home-lobby .brand .home-entry { width: auto; min-width: 44px; min-height: 44px; padding: 8rpx 0 8rpx 12rpx; gap: 10rpx; font-size: 26rpx; }
.home-entry-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; }
.home-lobby button.home-action,
.home-lobby button.home-action[disabled]:not([type]) {
  display: flex; flex-direction: column; justify-content: center; gap: 4rpx;
  width: 100%; min-width: 0; min-height: 212rpx; padding: 24rpx 12rpx; margin: 0;
  border: 1rpx solid var(--home-card-border); border-radius: 20rpx;
  background: var(--surface); color: var(--text); line-height: 1.5;
  transition: opacity 120ms ease;
}
.home-lobby button.home-action-join,
.home-lobby button.home-action-join[disabled]:not([type]) { background: var(--accent); color: var(--bg); border-color: var(--accent); }
.home-action-icon { display: block; width: 60rpx; height: 60rpx; margin-bottom: 8rpx; }
.home-action-title { font-size: 34rpx; font-weight: 600; }
.home-action-hint { font-size: 24rpx; font-weight: 400; color: var(--muted); }
.home-action-join .home-action-hint { color: var(--bg); }
.home-lobby .history-heading { margin: 28rpx 0 12rpx; gap: 12rpx; font-size: 32rpx; }
.home-lobby button.room-refresh,
.home-lobby button.room-refresh[disabled]:not([type]) { display: flex; width: auto; min-width: 44px; min-height: 44px; padding: 0; margin: 0; gap: 10rpx; font-size: 24rpx; }
.room-refresh-icon { width: 32rpx; height: 32rpx; }
.room-refresh-icon.is-refreshing { animation: home-refresh-spin 900ms linear infinite; }
.home-lobby .member-room.room-list-item { display: block; padding: 22rpx 24rpx 0; margin: 0 0 18rpx; background: var(--surface); border: 1rpx solid var(--home-card-border); border-radius: 20rpx; }
.home-lobby .room-swipe { --swipe-remove-bg: #405360; --swipe-danger-bg: #a94440; position: relative; overflow: hidden; border-radius: 20rpx; margin-bottom: 18rpx; }
.home-lobby .room-swipe .room-swipe-content { position: relative; z-index: 1; width: 100%; box-sizing: border-box; margin: 0; transition: transform 180ms ease-out; }
.home-lobby .room-swipe.is-dragging .room-swipe-content { transition: none; }
.room-swipe-actions { position: absolute; top: 0; right: 0; bottom: 0; display: flex; }
.home-lobby button.room-swipe-action,
.home-lobby button.room-swipe-action[disabled]:not([type]) { display: flex; flex-direction: column; justify-content: center; gap: 12rpx; width: 80px; min-width: 80px; min-height: 48px; height: 100%; margin: 0; padding: 16rpx 8rpx; border: 0; border-radius: 0; background: var(--swipe-remove-bg); color: var(--text); font-size: 30rpx; line-height: 1.4; }
.home-lobby button.room-swipe-action.danger,
.home-lobby button.room-swipe-action.danger[disabled]:not([type]) { background: var(--swipe-danger-bg); }
.home-lobby button.room-swipe-action[disabled]:not([type]) { opacity: 1; }
.room-swipe-label { display: flex; flex-direction: column; }
.room-swipe-pressed { opacity: .8; }
.room-swipe-remove-icon { position: relative; width: 22px; height: 22px; border: 1.5px solid currentColor; border-radius: 50%; box-sizing: border-box; }
.room-swipe-remove-icon::after { content: ''; position: absolute; width: 10px; height: 1.5px; top: 9px; left: 4.5px; background: currentColor; }
.room-swipe-dissolve-icon { position: relative; width: 20px; height: 24px; border: 1.5px solid currentColor; border-radius: 2px; box-sizing: border-box; }
.room-swipe-dissolve-icon > view { position: absolute; width: 13px; height: 1.5px; right: -5px; top: 10px; background: currentColor; box-shadow: 0 0 0 3px var(--swipe-danger-bg); }
.room-swipe-dissolve-icon > view::after { content: ''; position: absolute; width: 6px; height: 6px; left: 0; top: -3px; border-left: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); }
@media (prefers-reduced-motion: reduce) { .home-lobby .room-swipe .room-swipe-content { transition: none; } }
.home-lobby .room-list-top { align-items: center; gap: 12rpx; padding-right: 54rpx; }
.home-lobby .room-list-title { font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.home-lobby .room-status { padding: 2rpx 14rpx; border-radius: 24rpx; font-size: 22rpx; line-height: 1.5; background: var(--home-divider); color: var(--muted); white-space: nowrap; }
.home-lobby .room-status.lobby { color: var(--good); background: var(--home-state-bg); }
.home-lobby .room-status.playing { color: var(--accent); background: rgba(229, 198, 139, .12); }
.home-lobby .room-list-board { margin: 4rpx 0 0; font-size: 24rpx; }
.room-list-code { display: flex; align-items: center; min-height: 44px; color: var(--muted); font-size: 28rpx; line-height: 1.4; font-weight: 400; }
.home-lobby button.room-list-copy,
.home-lobby button.room-list-copy[disabled]:not([type]) { display: inline-flex; flex: 0 0 44px; align-items: center; justify-content: center; width: 44px; height: 44px; min-height: 44px; margin: 0; padding: 0; border: 0; background: transparent; color: var(--muted); border-radius: 8rpx; }
.home-lobby .room-list-copy .lobby-copy-icon { width: 24rpx; height: 26rpx; }
.home-lobby .room-list-meta { justify-content: space-between; align-items: baseline; gap: 4rpx 16rpx; margin: 0 0 16rpx; font-size: 24rpx; line-height: 1.5; }
.room-list-people { flex-shrink: 0; color: var(--text); }
.room-list-relation { min-width: 0; overflow-wrap: anywhere; }
.room-list-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; border-top: 1rpx solid var(--home-divider); }
.home-lobby .room-list-time { margin: 0; font-size: 22rpx; line-height: 1.5; }
.home-lobby button.room-list-open,
.home-lobby button.room-list-open[disabled]:not([type]) { display: flex; flex-shrink: 0; align-items: center; justify-content: flex-end; gap: 12rpx; width: auto; min-height: 44px; margin: 0; padding: 8rpx 0 8rpx 8rpx; border: 0; border-radius: 0; background: transparent; color: var(--accent); font-size: 24rpx; line-height: 1.5; font-weight: 400; }
.home-lobby button.room-more,
.home-lobby button.room-more[disabled]:not([type]) { right: 0; top: 4rpx; width: 44px; min-height: 44px; padding: 0; font-size: 40rpx; }
.home-lobby .is-unavailable .room-list-title,
.home-lobby .is-unavailable .room-list-people,
.home-lobby .is-unavailable button.room-list-open[disabled] { color: var(--muted); }
.home-lobby .room-empty { margin-top: 12rpx; padding: 36rpx 0; }
.room-empty-title { color: var(--text); font-size: 30rpx; font-weight: 500; }
.room-empty-hint { margin-top: 12rpx; font-size: 26rpx; }

/* Native keyboard supplies its height; no simulated keyboard is shipped. */
.entry-backdrop { position: fixed; inset: 0; z-index: 900; background: rgba(0, 0, 0, .52); animation: home-scrim-in 160ms ease-out; }
form.entry-panel.entry-sheet { --entry-divider: rgba(177, 191, 198, .2); position: absolute; left: 0; right: 0; display: block; width: 100%; max-width: 640px; max-height: var(--entry-available-height); margin: 0 auto; padding: 0; box-sizing: border-box; border: 1rpx solid var(--border); border-bottom: 0; border-radius: 40rpx 40rpx 0 0; background: var(--surface); overflow: hidden; animation: home-sheet-in 200ms ease-out; }
/* WeChat form adds an internal wrapper. Keep flex layout on an ordinary view. */
.entry-sheet-layout { display: flex; flex-direction: column; max-height: calc(var(--entry-available-height) - 1rpx); }
.is-create .entry-sheet-layout { height: calc(var(--entry-available-height) - 1rpx); }
.entry-sheet-handle { flex-shrink: 0; width: 64rpx; height: 8rpx; margin: 20rpx auto 0; border-radius: 8rpx; background: var(--border); }
.entry-sheet-heading { position: relative; flex-shrink: 0; padding: 20rpx 92rpx 24rpx 32rpx; }
.entry-sheet-title { font-size: 40rpx; font-weight: 600; line-height: 1.4; }
.entry-sheet button.entry-sheet-close,
.entry-sheet button.entry-sheet-close[disabled]:not([type]) { position: absolute; top: 4rpx; right: 12rpx; width: 44px; min-height: 44px; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--muted); font-size: 48rpx; font-weight: 400; }
.entry-sheet-scroll-region { min-height: 0; flex: 0 1 auto; overflow: hidden; }
.entry-sheet-body { display: block; max-height: calc(var(--entry-available-height) - 152px); overflow-y: auto; }
/* The view receives the remaining space; the native scroll-view fills its height. */
.is-create .entry-sheet-scroll-region { flex: 1 1 0; }
.is-create .entry-sheet-body { height: 100%; max-height: none; }
.entry-sheet-fields { padding: 0 32rpx 24rpx; }
.entry-sheet .label { margin: 0 0 12rpx; font-size: 30rpx; }
.entry-sheet .field-title { margin: 32rpx 0 16rpx; font-size: 30rpx; }
.entry-sheet .input { height: 88rpx; min-height: 44px; margin: 0; padding: 0 24rpx; border-radius: 14rpx; font-size: 30rpx; }
.entry-name-field { position: relative; }
.entry-sheet .entry-name-input { padding-right: 76rpx; font-size: 32rpx; }
.entry-name-input.is-focused { border-color: var(--accent); }
.entry-name-pencil { position: absolute; right: 28rpx; top: 50%; width: 28rpx; height: 9rpx; border: 1.5px solid var(--muted); border-radius: 2rpx; transform: translateY(-50%) rotate(-45deg); pointer-events: none; }
.entry-name-pencil::before { content: ''; position: absolute; left: -8rpx; top: -1.5px; border-top: 6rpx solid transparent; border-bottom: 6rpx solid transparent; border-right: 6rpx solid var(--muted); }
.entry-code-field { display: flex; align-items: center; min-height: 104rpx; border: 2rpx solid var(--border); border-radius: 14rpx; background: var(--bg); box-sizing: border-box; }
.entry-code-field.is-focused { border-color: var(--accent); }
.entry-code-field .room-input { border: 0; background: transparent; flex: 1; min-width: 0; height: 100rpx; padding: 0 12rpx 0 24rpx; box-sizing: border-box; color: var(--text); font-size: 42rpx; font-weight: 500; letter-spacing: 8rpx; line-height: normal; }
.entry-code-placeholder { color: var(--muted); font-size: 28rpx; letter-spacing: 0; font-weight: 400; }
.entry-sheet button.entry-paste,
.entry-sheet button.entry-paste[disabled]:not([type]) { flex-shrink: 0; width: auto; min-width: 44px; min-height: 44px; margin: 0; padding: 12rpx 24rpx 12rpx 12rpx; color: var(--muted); background: transparent; font-size: 24rpx; }
.entry-sheet .has-error { border-color: var(--evil); }
.entry-field-error { margin: 10rpx 0 0; color: var(--evil); font-size: 24rpx; line-height: 1.5; }
.entry-field-help { margin: 12rpx 0 0; color: var(--muted); font-size: 24rpx; line-height: 1.5; }
.entry-sheet-footer { flex-shrink: 0; padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); background: var(--surface); }
.is-create .entry-sheet-footer { border-top: 1rpx solid var(--entry-divider); }
.entry-sheet.has-keyboard .entry-sheet-footer { padding-bottom: 20rpx; }
.entry-sheet-footer .entry-field-error, .entry-sheet-footer .entry-field-help { margin: 0 0 12rpx; }
.entry-sheet button.entry-submit,
.entry-sheet button.entry-submit[disabled]:not([type]) { min-height: 48px; margin: 0; padding: 20rpx; border-radius: 16rpx; font-size: 30rpx; background: var(--accent); color: var(--bg); }
.entry-sheet .capacity-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; margin-top: 0; }
.entry-sheet button.capacity-option,
.entry-sheet button.board-option,
.entry-sheet button.text-button { min-height: 44px; }
.entry-sheet button.capacity-option { position: relative; padding: 16rpx 36rpx; font-size: 32rpx; font-weight: 500; }
.entry-selection-check { flex-shrink: 0; width: 14rpx; height: 8rpx; border-left: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(-45deg); }
.capacity-option .entry-selection-check { position: absolute; right: 20rpx; top: calc(50% - 8rpx); }
.entry-board-card { padding: 12rpx 24rpx 24rpx; border: 1rpx solid var(--border); border-radius: 20rpx; background: var(--control-bg); }
.entry-sheet .board-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 12rpx; }
.entry-sheet button.board-option,
.entry-sheet button.board-option[disabled]:not([type]) { position: relative; display: flex; flex-direction: column; align-items: stretch; justify-content: center; gap: 4rpx; min-height: 64px; padding: 16rpx 40rpx 16rpx 20rpx; border-radius: 14rpx; background: transparent; }
.entry-sheet button.board-option.active,
.entry-sheet button.board-option.active[disabled]:not([type]) { background: rgba(229, 198, 139, .08); }
.board-option .entry-selection-check { position: absolute; top: 22rpx; right: 16rpx; }
.entry-board-option-name { font-size: 28rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.entry-board-option-hint { color: var(--muted); font-size: 24rpx; font-weight: 400; line-height: 1.5; }
.entry-sheet .rules-detail { padding: 20rpx 0 0; font-size: 28rpx; }
.entry-role-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 44px; padding-bottom: 8rpx; border-bottom: 1rpx solid var(--entry-divider); }
.entry-role-heading.has-board-options { margin-top: 24rpx; padding-top: 8rpx; border-top: 1rpx solid var(--entry-divider); }
.entry-board-title { min-width: 0; font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.entry-sheet button.entry-board-details,
.entry-sheet button.entry-board-details[disabled]:not([type]) { flex-shrink: 0; gap: 12rpx; width: auto; min-width: 44px; min-height: 44px; margin: 0; padding: 0; border: 0; background: transparent; color: var(--accent); font-size: 26rpx; font-weight: 500; line-height: 1.5; }
.entry-option-pressed { opacity: .78; }
.entry-role-group + .entry-role-group { margin-top: 24rpx; }
.entry-role-label { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: var(--muted); font-size: 26rpx; font-weight: 500; line-height: 1.5; }
.entry-role-faction { display: flex; align-items: center; gap: 12rpx; }
.entry-faction-dot { flex-shrink: 0; width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--muted); }
.entry-faction-dot.is-good { background: var(--good); }
.entry-faction-dot.is-evil { background: var(--evil); }
.entry-faction-dot.is-third { background: var(--third); }
.entry-sheet .role-line { margin-top: 6rpx; line-height: 1.6; overflow-wrap: anywhere; }
@keyframes home-sheet-in { from { transform: translateY(32px); opacity: .7; } to { transform: translateY(0); opacity: 1; } }
@keyframes home-scrim-in { from { background: rgba(0, 0, 0, 0); } to { background: rgba(0, 0, 0, .52); } }
@keyframes home-refresh-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) {
  .entry-backdrop, form.entry-panel.entry-sheet, .room-refresh-icon.is-refreshing { animation: none; }
  .home-lobby button.home-action { transition: none; }
}
@media (max-width: 360px) {
  .home-lobby .brand-mark { font-size: 40rpx; }
  .home-lobby .brand-identity { gap: 0 8rpx; }
  .home-lobby .connection-label { font-size: 11px; }
  .home-lobby .room-list-title { font-size: 14px; }
  .home-lobby .home-action-title { font-size: 18px; }
  .home-lobby .home-action-hint,
  .home-lobby .room-list-meta,
  .home-lobby .room-list-time,
  .home-lobby .room-list-board,
  .home-lobby .room-status,
  .home-lobby button.room-list-open,
  .home-lobby button.room-refresh,
  .home-lobby .brand .home-entry,
  .entry-role-label,
  .entry-sheet button.entry-board-details,
  .entry-field-error,
  .entry-field-help,
  .entry-sheet button.entry-paste { font-size: 12px; }
  .home-lobby .room-list-code,
  .entry-sheet .input,
  .entry-code-placeholder { font-size: 14px; }
  .entry-sheet button.entry-submit { font-size: 16px; }
  .entry-sheet .label, .entry-sheet .field-title, .entry-sheet button.capacity-option, .entry-sheet .entry-name-input { font-size: 16px; }
  .entry-board-title, .entry-board-option-name, .entry-sheet .rules-detail { font-size: 14px; }
  .entry-board-option-hint { font-size: 12px; }
  .entry-sheet button.capacity-option { padding-right: 22px; padding-left: 22px; }
}
@media (orientation: landscape) and (max-height: 500px) {
  .entry-sheet-handle { display: none; }
  .entry-sheet-heading { padding: 12px 64px 12px 20px; }
  .entry-sheet-title { font-size: 20px; }
  .entry-sheet-fields { padding: 0 20px 4px; }
  .entry-sheet .label, .entry-sheet .field-title { font-size: 14px; margin-bottom: 8px; }
  .entry-sheet .field-title { margin-top: 16px; }
  .entry-role-heading { margin-top: 16px; }
  .entry-role-label, .entry-sheet button.entry-board-details { font-size: 14px; }
  .entry-sheet .role-line { font-size: 14px; }
  .entry-sheet .input { font-size: 16px; }
  .entry-sheet .input { height: 44px; }
  .entry-sheet .entry-field-help, .entry-sheet .entry-field-error { font-size: 12px; }
  .entry-code-field { min-height: 50px; }
  .entry-code-field .room-input { height: 48px; font-size: 24px; }
  .entry-code-placeholder { font-size: 16px; }
  .entry-sheet button.entry-paste { font-size: 14px; }
  .entry-sheet button.capacity-option, .entry-sheet button.board-option { font-size: 14px; padding: 8px; }
  .entry-sheet-footer, .entry-sheet.has-keyboard .entry-sheet-footer { padding: 12px 20px; }
  .entry-sheet button.entry-submit { padding: 12px; font-size: 16px; }
  .entry-sheet button.entry-sheet-close { top: 4px; right: 8px; font-size: 32px; }
}
