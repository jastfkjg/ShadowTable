<template name="personalRoomCard">
    <view class="room-swipe {{compact?'is-compact':''}} {{item.canSwipeDissolve?'has-dissolve':''}} {{roomSwipeCode===item.code && roomSwipeDragging?'is-dragging':''}}" data-code="{{item.code}}" bindtouchstart="startRoomSwipe" bindtouchmove="moveRoomSwipe" bindtouchend="endRoomSwipe" bindtouchcancel="cancelRoomSwipe">
      <view wx:if="{{roomSwipeCode===item.code && roomSwipeOffset<0}}" class="room-swipe-actions" aria-hidden="{{roomSwipeDragging}}">
        <button hover-class="room-swipe-pressed" class="room-swipe-action" data-code="{{item.code}}" data-kind="hide" catchtap="swipeRoomAction" bindtouchstart="startRoomSwipeAction" disabled="{{busy || loading || roomsRefreshing || hasPendingRequest || roomSwipeDragging}}" aria-label="{{'从列表移除房间'+item.code+'，保留房间和座位，需再次确认'}}"><view class="room-swipe-remove-icon" aria-hidden="true" /><text class="room-swipe-label">移除记录</text></button>
        <button wx:if="{{item.canSwipeDissolve}}" hover-class="room-swipe-pressed" class="room-swipe-action danger" data-code="{{item.code}}" data-kind="delete" catchtap="swipeRoomAction" bindtouchstart="startRoomSwipeAction" disabled="{{busy || loading || roomsRefreshing || hasPendingRequest || roomSwipeDragging}}" aria-label="{{'解散房间'+item.code+'，需再次确认'}}"><view class="room-swipe-dissolve-icon" aria-hidden="true"><view /></view><text class="room-swipe-label">解散房间</text></button>
      </view>
      <view class="member-room room-list-item room-swipe-content {{item.available===false?'is-unavailable':''}}" style="transform:translateX({{roomSwipeCode===item.code?roomSwipeOffset:0}}px)" data-code="{{item.code}}" catchtap="openRoom">
      <view class="room-list-top"><image wx:if="{{!compact}}" class="home-room-icon" src="/assets/home-table-blue.svg" aria-hidden="true" /><text class="room-list-title">{{item.note || item.boardName || '房间 '+item.code}}</text></view>
      <view wx:if="{{item.note && item.boardName}}" class="room-list-board">{{item.boardName}}</view>
      <view wx:if="{{item.available===false}}" class="room-list-expired-meta">
        <view class="room-list-code-row"><view class="room-list-code"><text>房间 <text class="home-room-code-value">{{item.code}}</text></text><button class="room-list-copy" hover-class="none" data-code="{{item.code}}" catchtap="copyListedRoom" aria-label="{{'复制房间码'+item.code}}"><view class="lobby-copy-icon" aria-hidden="true" /></button></view><text class="room-status unavailable">已失效</text></view>
        <view class="room-list-expired-status"><text class="room-list-expired-reason">{{item.compactRelation || item.relationLabel || '房间已无法进入'}}</text><text wx:if="{{item.lastActivityAt || item.updatedAt}}" class="room-list-expired-time">{{item.activityLabel}}</text></view>
      </view>
      <block wx:else>
      <view class="room-list-code-row"><view class="room-list-code"><text>房间 <text class="home-room-code-value">{{item.code}}</text><text wx:if="{{compact}}"> · {{item.peopleLabel}}</text></text><button class="room-list-copy" hover-class="none" data-code="{{item.code}}" catchtap="copyListedRoom" aria-label="{{'复制房间码'+item.code}}"><view class="lobby-copy-icon" aria-hidden="true" /></button></view><text class="room-status {{item.status}}">{{item.statusLabel}}</text></view>
      <view class="room-list-meta"><text wx:if="{{!compact}}">{{item.peopleLabel}}{{item.compactRelation || item.relationLabel?' · ':''}}</text><text class="room-list-relation">{{item.compactRelation || item.relationLabel}}</text></view>
      <view class="room-list-footer"><view class="room-list-time"><image wx:if="{{item.lastActivityAt || item.updatedAt}}" src="/assets/home-clock.svg" aria-hidden="true" /><text>{{item.lastActivityAt || item.updatedAt?item.activityLabel:''}}</text></view><button wx:if="{{item.available!==false}}" class="room-list-open" hover-class="none" data-code="{{item.code}}" catchtap="openRoom" disabled="{{busy || loading || hasPendingRequest || enteringCode}}" aria-label="{{(item.entryLabel || '返回牌桌')+'，房间'+item.code+'，'+item.statusLabel}}"><text>{{enteringCode===item.code?'正在进入…':item.entryLabel || '返回牌桌'}}</text><view class="home-room-arrow" aria-hidden="true" /></button></view>
      </block>
      <button hover-class="none" class="room-more" data-code="{{item.code}}" catchtap="openRoomMenu" disabled="{{busy || loading || hasPendingRequest}}" aria-label="{{'管理房间'+item.code+'的个人记录'}}"><image src="/assets/record-more.svg" aria-hidden="true" /></button>
      </view>
    </view>
</template>
