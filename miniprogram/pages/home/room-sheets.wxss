.room-sheet-symbol.is-gold { background:#3b372d; }.room-sheet-symbol image { width:20px; height:20px; }
.entry-sheet button.entry-sheet-close, .entry-sheet button.entry-sheet-close[disabled]:not([type]), button.room-rules-close { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:44px; min-width:44px; min-height:44px; margin:0; padding:0; border:0; background:transparent; color:var(--muted); border-radius:12px; }
