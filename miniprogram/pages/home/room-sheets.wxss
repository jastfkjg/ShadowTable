.entry-single-board { display:flex; align-items:center; gap:9px; min-height:56px; padding:12px; border-radius:14px; background:var(--control-bg); }.entry-single-board>.room-sheet-symbol { width:30px; height:32px; border-radius:10px; }.entry-single-board>view:last-child { min-width:0; }
.entry-role-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:44px; margin:18px 0 2px; }.entry-board-title { min-width:0; font-size:14px; font-weight:500; line-height:1.5; overflow-wrap:anywhere; }
.entry-sheet button.entry-board-details, .entry-sheet button.entry-board-details[disabled]:not([type]) { display:flex; align-items:center; justify-content:center; flex-shrink:0; gap:4px; width:auto; min-width:44px; min-height:44px; margin:0; padding:0; border:0; background:transparent; color:var(--muted); font-size:12px; font-weight:400; line-height:1.5; }.entry-board-details image { width:14px; height:14px; flex-shrink:0; }
.room-sheet-chevron { width:5px; height:5px; flex-shrink:0; margin:0 3px; border-top:1.5px solid currentColor; border-right:1.5px solid currentColor; transform:rotate(45deg); }
.entry-code-section .entry-field-heading { min-height:44px; margin:18px 0 6px; }
.entry-sheet button.entry-paste, .entry-sheet button.entry-paste[disabled]:not([type]) { display:flex; align-items:center; gap:5px; flex-shrink:0; width:auto; min-width:44px; min-height:44px; margin:0; padding:0; border:0; background:transparent; color:var(--accent); font-size:12px; font-weight:400; }.entry-paste image { width:16px; height:16px; }
.entry-code-field { position:relative; min-height:65px; padding:3px; border:0; border-radius:15px; background:var(--control-bg); }.entry-code-field.is-focused { box-shadow:inset 0 0 0 1px var(--accent); }
.entry-code-slots { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:6px; pointer-events:none; }.entry-code-slot { position:relative; display:flex; align-items:center; justify-content:center; min-width:0; min-height:59px; font-size:25px; font-weight:500; font-variant-numeric:tabular-nums; }.entry-code-slot:not(:last-child)::after { content:''; position:absolute; right:-3px; top:18px; bottom:18px; width:1px; background:var(--entry-divider); }.entry-code-dash { width:9px; height:2px; border-radius:2px; background:#536570; }
/* One native number input owns focus, form submission and paste; slots only paint. */
.entry-code-field .room-input { position:absolute; inset:0; width:100%; height:100%; margin:0; padding:0; border:0; background:transparent; color:transparent; caret-color:transparent; opacity:.02; font-size:25px; }
.entry-sheet .has-error { box-shadow:inset 0 0 0 1px var(--evil); }.entry-field-error, .entry-field-help { margin:9px 0 0; color:var(--muted); font-size:12px; line-height:1.6; overflow-wrap:anywhere; }.entry-field-error { color:var(--evil); }
