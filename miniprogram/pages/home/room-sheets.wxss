.room-rules-options { display:flex; flex-direction:column; gap:9px; margin:16px 2px 0; padding-bottom:3px; color:var(--muted); font-size:12px; line-height:1.5; }.room-rules-option { display:flex; align-items:center; gap:6px; }.room-rules-option image { width:15px; height:15px; flex-shrink:0; }.room-rules-option>text:last-child { margin-left:auto; flex-shrink:0; }.room-rules-option.is-enabled>text:last-child { color:var(--good); }.room-rules-notice { font-size:12px; line-height:1.6; overflow-wrap:anywhere; }
.room-rules-sheet-footer { display:flex; flex-shrink:0; gap:10px; padding:16px 20px calc(12px + env(safe-area-inset-bottom)); background:var(--surface); }.room-rules-sheet-footer button { display:flex; align-items:center; justify-content:center; flex:1; gap:7px; min-width:0; min-height:50px; margin:0; padding:12px; border:0; border-radius:14px; font-size:14px; font-weight:500; line-height:1.5; }.room-rules-sheet-footer .secondary { background:#30424d; color:var(--text); }.room-rules-sheet-footer .primary { background:var(--accent); color:var(--bg); font-size:16px; font-weight:600; }.room-rules-sheet-footer image { width:17px; height:17px; flex-shrink:0; }
@keyframes room-sheet-in { from { opacity:.7; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
@keyframes room-sheet-scrim-in { from { background:rgba(0,0,0,0); } to { background:rgba(0,0,0,.56); } }
/* The refresh icon belongs to the unchanged home list. */
@keyframes home-refresh-spin { to { transform:rotate(360deg); } }
