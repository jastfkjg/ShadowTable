.entry-sheet button.entry-submit, .entry-sheet button.entry-submit[disabled]:not([type]) { display:flex; align-items:center; justify-content:center; gap:12px; min-height:50px; margin:0; padding:12px; border:0; border-radius:14px; background:var(--accent); color:var(--bg); font-size:16px; font-weight:600; line-height:1.5; }.entry-submit>text { min-width:0; overflow-wrap:anywhere; }
.entry-option-pressed { opacity:.78; }
.room-role-groups { padding:0 13px; border-radius:18px; background:var(--control-bg); }.room-role-group { padding:14px 0; }.room-role-group+.room-role-group { border-top:1px solid rgba(177,191,198,.13); }.room-role-faction { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:14px; color:var(--muted); font-size:12px; line-height:1.5; }.room-role-faction>view { display:flex; align-items:center; gap:6px; }.room-role-faction>text { flex-shrink:0; color:var(--text); }
.room-role-dot { width:6px; height:6px; flex-shrink:0; border-radius:50%; background:var(--muted); }.room-role-dot.is-good { background:var(--good); }.room-role-dot.is-evil { background:var(--evil); }.room-role-dot.is-third { background:var(--third); }
.room-role-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px 6px; }.room-role { display:flex; flex-direction:column; align-items:center; justify-content:flex-start; gap:4px; min-width:0; min-height:65px; text-align:center; }.room-role>image { width:38px; height:38px; flex-shrink:0; }.room-role-name { min-width:0; font-size:12px; line-height:1.5; overflow-wrap:anywhere; }.room-role-count { color:var(--muted); font-size:11px; margin-left:3px; white-space:nowrap; }.room-role-name>view { display:inline; }.room-role-name>view+view { display:block; }.room-role-text { font-size:13px; line-height:1.7; overflow-wrap:anywhere; }
.room-role-groups.is-compact .room-role-group { padding:11px 0; }.is-compact .room-role-faction { margin-bottom:7px; }.is-compact .room-role-grid { display:flex; flex-wrap:wrap; gap:8px 14px; }.is-compact .room-role { flex-direction:row; align-items:center; gap:4px; min-height:28px; text-align:left; }.is-compact .room-role>image { width:26px; height:28px; }
.dialog-backdrop.room-rules-backdrop { align-items:flex-end; padding:0; background:rgba(0,0,0,.56); }
.error-dialog.room-rules-sheet { display:flex; flex-direction:column; width:100%; max-width:600px; max-height:calc(100vh - 88px); margin:0 auto; padding:0; border:0; border-radius:24px 24px 0 0; overflow:hidden; box-shadow:0 -1px 0 rgba(177,191,198,.16); animation:room-sheet-in 180ms ease-out; }
