.entry-sheet-scroll-region { min-height:0; flex:0 1 auto; overflow:hidden; }.is-create:not(.has-measured-body) .entry-sheet-scroll-region { flex:1 1 0; }
.entry-sheet-body { display:block; height:100%; overflow-y:auto; }.entry-sheet:not(.is-create):not(.has-measured-body) .entry-sheet-body { height:auto; max-height:calc(var(--entry-available-height) - 180px); }
