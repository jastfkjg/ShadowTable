.help-intro { padding: 12rpx 0 40rpx; }
.help-eyebrow { color: var(--accent); font-size: 26rpx; }
.help-title { margin: 16rpx 0; font-size: 44rpx; font-weight: 600; line-height: 1.4; }
.help-copy { color: var(--muted); font-size: 28rpx; line-height: 1.8; }
.help-heading { font-size: 34rpx; font-weight: 600; color: var(--text); }
.help-quick { margin-bottom: 28rpx; padding: 28rpx; background: var(--surface); border-radius: 24rpx; }
.help-step { display: flex; align-items: flex-start; gap: 24rpx; margin-top: 28rpx; }
.help-number { flex-shrink: 0; font-size: 28rpx; color: var(--accent); line-height: 1.7; }
.help-step-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.help-section { border-top: 1rpx solid var(--border); }
button.help-toggle { width: 100%; margin: 0; padding: 28rpx 0; border-radius: 0; background: transparent; color: var(--accent); justify-content: space-between; gap: 24rpx; text-align: left; }
.help-toggle-copy { flex: 1; min-width: 0; }
.help-caption { font-size: 26rpx; color: var(--muted); font-weight: 400; margin-top: 8rpx; }
.help-answers { padding-bottom: 8rpx; }
.help-answer { margin-bottom: 28rpx; }
.help-board-content { padding-bottom: 28rpx; }
.help-board { margin-top: 32rpx; }
.help-board-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 16rpx; }
.help-board-links-single { grid-template-columns: minmax(0, 1fr); }
button.help-board-link { width: 100%; margin: 0; min-width: 0; min-height: 96rpx; padding: 16rpx 24rpx; background: var(--surface); color: var(--accent); font-size: 28rpx; }
.help-board-error { margin-top: 24rpx; }
.help-board-error button { margin-top: 16rpx; }
