.help-page { --help-line: rgba(177,191,198,.14); padding: 0 18px calc(32px + env(safe-area-inset-bottom)); max-width: 500px; }
.help-intro { display: flex; align-items: center; gap: 6px; padding: 24px 0 20px; }
.help-intro-copy { flex: 1; min-width: 0; }
.help-eyebrow { font-size: 12px; color: var(--accent); letter-spacing: 1px; }
.help-title { font-size: 22px; font-weight: 600; line-height: 1.5; margin: 4px 0 5px; }
.help-intro-caption { color: var(--muted); font-size: 13px; line-height: 1.7; }
.help-intro-art { width: 70px; height: 82px; flex-shrink: 0; }
.help-modes { display: flex; gap: 8px; padding: 4px; background: var(--control-bg); border-radius: 12px; }
.help-modes button { flex: 1; min-width: 0; min-height: 44px; margin: 0; padding: 8px; border-radius: 9px; font-size: 14px; color: var(--muted); gap: 7px; }
.help-modes button.selected { color: var(--accent); background: rgba(229,198,139,.08); }
.help-modes image { width: 18px; height: 18px; flex-shrink: 0; }
.help-steps { margin-top: 18px; }
.help-step { border-bottom: 1px solid var(--help-line); }
button.help-step-toggle { min-height: 62px; display: flex; align-items: center; justify-content: flex-start; width: 100%; margin: 0; padding: 12px 0; border-radius: 0; gap: 12px; text-align: left; }
.help-number { width: 30px; height: 30px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 9px; font-size: 12px; font-weight: 400; color: var(--muted); background: rgba(177,191,198,.04); font-variant-numeric: tabular-nums; }
.help-step-label { flex: 1; min-width: 0; font-weight: 600; font-size: 15px; line-height: 1.7; }
.help-chevron { width: 7px; height: 7px; flex-shrink: 0; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: rotate(45deg); margin: 0 4px 4px; transition: transform 160ms ease-out; }
.help-step.expanded { background: var(--surface); border: 0; border-radius: 16px; padding: 0 14px 16px; margin-bottom: 5px; }
.help-step.expanded .help-step-toggle { min-height: 58px; }
.help-step.expanded .help-number { color: var(--accent); background: rgba(229,198,139,.08); }
.help-step.expanded .help-chevron, .help-chevron.up { transform: rotate(225deg); margin-top: 5px; }
.help-step-body { margin-left: 42px; }
.help-copy { color: var(--muted); font-size: 14px; line-height: 1.85; overflow-wrap: anywhere; }
.help-flow { display: flex; align-items: center; gap: 8px; border-top: 1px solid var(--help-line); padding-top: 13px; margin-top: 16px; font-size: 12px; line-height: 1.8; }
.help-flow image { height: 17px; width: 17px; flex-shrink: 0; }
.help-flow > text:first-of-type { flex: 1; min-width: 0; }
.help-flow-caption { font-size: 10px; color: var(--muted); flex-shrink: 0; }
.help-reference-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 24px 0 12px; }
.help-heading { font-size: 16px; font-weight: 600; line-height: 1.6; }
.help-reference-heading > text { font-size: 11px; color: var(--muted); }
.help-search { display: flex; align-items: center; gap: 10px; min-height: 46px; padding: 0 13px; background: var(--control-bg); border: 1px solid var(--help-line); border-radius: 12px; }
.help-search > image { width: 18px; height: 18px; flex-shrink: 0; }
.help-search input { min-width: 0; flex: 1; min-height: 44px; height: 44px; font-size: 14px; color: var(--text); }
.help-search-placeholder { color: var(--muted); }
.help-search button { min-height: 44px; min-width: 44px; width: 44px; margin: 0 -12px 0 0; padding: 0; font-size: 24px; color: var(--muted); }
.help-search-status { font-size: 12px; color: var(--muted); padding: 12px 0 0; }
.help-references { margin-top: 10px; }
.help-section { border-bottom: 1px solid var(--help-line); }
button.help-toggle { width: 100%; min-height: 76px; margin: 0; padding: 12px 0; border-radius: 0; justify-content: flex-start; gap: 12px; text-align: left; }
.help-reference-icon { width: 23px; height: 23px; margin: 0 3px; flex-shrink: 0; }
.help-toggle-copy { min-width: 0; flex: 1; }
.help-toggle .help-heading { font-size: 15px; font-weight: 500; }
.help-caption { color: var(--muted); font-size: 12px; font-weight: 400; line-height: 1.7; margin-top: 3px; }
.help-answers { padding: 0 4px 4px 41px; }
.help-answer { margin-bottom: 20px; }
.help-step-title { font-size: 15px; font-weight: 600; margin-bottom: 6px; line-height: 1.8; overflow-wrap: anywhere; }
.help-score-scope { margin-bottom: 16px; }
.help-note { margin-bottom: 12px; }
.help-board { margin-bottom: 24px; }
.help-board-links { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; margin-top: 12px; }
.help-board-links-single { grid-template-columns: minmax(0,1fr); }
button.help-board-link { min-height: 44px; width: 100%; min-width: 0; margin: 0; padding: 10px 8px; font-size: 13px; background: var(--control-bg); color: var(--accent); border: 1px solid var(--help-line); border-radius: 9px; }
.help-board-error { padding-bottom: 18px; }
.help-page .secondary { margin-top: 12px; min-height: 44px; font-size: 14px; }
.help-footnote { margin-top: 24px; text-align: center; font-size: 12px; color: var(--muted); line-height: 1.8; }
.help-scoring-page { padding-top: 24px; }
.help-scoring-page .help-score-scope { padding: 18px; background: var(--surface); border-radius: 16px; }
.help-scoring-page .help-score-scope .help-heading { margin-bottom: 8px; }
.help-score-heading { margin: 24px 0 16px; }
@media (max-width: 350px) { .help-page { padding-left: 14px; padding-right: 14px; } .help-title { font-size: 20px; } .help-intro-art { width: 54px; height: 76px; } .help-step-body { margin-left: 0; } .help-answers { padding-left: 0; } }
@media (prefers-reduced-motion: reduce) { .help-chevron { transition: none; } }
