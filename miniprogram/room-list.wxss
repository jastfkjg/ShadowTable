/* Quiet list organization, shared by the mini-program and web client. */
.room-heading-actions { display:flex; align-items:center; flex-shrink:0; gap:14px; }
.room-heading-actions button.room-cleanup { display:flex; align-items:center; justify-content:center; gap:5px; width:auto; min-width:44px; min-height:44px; margin:0; padding:0; border:0; border-radius:8px; background:transparent; color:var(--muted); font-size:12px; font-weight:400; line-height:1.5; }
.room-cleanup-count { color:var(--accent); font-variant-numeric:tabular-nums; }
.room-subheading { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin:20px 4px 10px; color:var(--muted); font-size:13px; font-weight:500; line-height:1.5; }
.room-section-hint { font-size:12px; font-weight:400; }
.room-archive-section { margin-top:8px; border-top:1px solid var(--home-divider,var(--border)); }
/* Native disabled buttons must keep the same layout as the enabled disclosure. */
button.room-archive-toggle,
button.room-archive-toggle[disabled]:not([type]) { display:flex; align-items:center; justify-content:space-between; gap:12px; width:100%; min-height:56px; margin:0; padding:10px 4px; border:0; border-radius:0; background:transparent; color:var(--muted); font-size:13px; font-weight:400; line-height:1.5; text-align:left; }
.room-archive-title, .room-archive-action { display:flex; align-items:center; min-width:0; }
.room-archive-title .room-count { margin-left:8px; font-size:12px; font-variant-numeric:tabular-nums; }
.room-archive-action { flex-shrink:0; gap:10px; font-size:12px; }
.room-archive-chevron { width:6px; height:6px; margin-right:4px; border-right:1.5px solid currentColor; border-bottom:1.5px solid currentColor; transform:rotate(45deg); transition:transform 160ms ease; }
.room-archive-chevron.is-expanded { transform:rotate(225deg); }
.room-archive-toggle:active .room-archive-action { color:var(--text); }
button.room-archive-toggle:focus-visible, .room-heading-actions button.room-cleanup:focus-visible { outline:2px solid var(--accent); outline-offset:-2px; }
@media (hover:hover) { button.room-archive-toggle:hover, .room-heading-actions button.room-cleanup:hover { color:var(--text); } }
@media (prefers-reduced-motion:reduce) { .room-archive-chevron { transition:none; } }
