@import "../../share-entry.wxss";
.app-nav { position: sticky; top: 0; z-index: 100; width: 100%; box-sizing: border-box; background: #101c24; border-bottom: 1rpx solid #30404a; color: #f2eee5; }
.app-nav-row { position: relative; display: flex; align-items: center; justify-content: center; }
.app-nav-title { display: block; max-width: 52%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 32rpx; font-weight: 600; line-height: 1.3; }
.app-nav-title-group { display: flex; align-items: center; min-width: 0; }
.app-nav-title-group .app-nav-title { max-width: none; min-width: 0; }
.app-nav-back { position: absolute; left: 24rpx; top: 0; width: auto; height: 100%; min-width: 44px; margin: 0; padding: 0 12rpx; display: flex; align-items: center; justify-content: flex-start; gap: 8rpx; border: 0; background: transparent; color: #f2eee5; font-size: 28rpx; line-height: 40rpx; }
.app-nav-back-icon { display: block; flex-shrink: 0; width: 40rpx; height: 40rpx; }
.app-nav-back-text { display: block; white-space: nowrap; font-weight: 500; line-height: 40rpx; }
.app-nav-back::after { border: 0; }
.app-nav-back:active { opacity: .7; }
