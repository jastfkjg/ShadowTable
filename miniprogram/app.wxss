}

/* Current action stays separate from the last durable public result. */
.action-status-copy { flex: 1; min-width: 0; }
.action-status-copy .small { margin-top: 8rpx; }
.latest-result { margin: 32rpx 0; padding: 32rpx; border: 1px solid var(--accent); border-radius: 24rpx; background: var(--surface); }
.latest-result-title { margin: 16rpx 0; font-size: 40rpx; font-weight: 600; }
.latest-result .history-detail { white-space: pre-line; overflow-wrap: anywhere; }
.host-waiting-copy { flex: 1; min-width: 0; }
.history-vote-count.abstain { color: var(--muted); }

.host-action-bar-inner .bar-cutoff { flex: 0 0 192rpx; padding: 16rpx 12rpx; font-size: 28rpx; }

/* Public history and seat status */
.seat-out { display: inline-block; margin-top: 6rpx; padding: 0 10rpx; border: 1rpx solid var(--evil); border-radius: 6rpx; color: var(--evil); font-size: 24rpx; }
.seat-flag { float: none; display: block; min-height: 32rpx; padding-top: 0; }
.history-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
button.history-toggle,
button.history-toggle[disabled]:not([type]) { width: auto; flex-shrink: 0; margin: 0; min-height: 88rpx; padding: 8rpx 12rpx; background: transparent; color: var(--accent); font-size: 26rpx; }
.history-filters, .quest-timeline { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
button.history-filter, button.quest-step,
button.history-filter[disabled]:not([type]),
button.quest-step[disabled]:not([type]) { width: auto; margin: 0; min-height: 88rpx; padding: 12rpx 20rpx; font-size: 26rpx; background: var(--surface); color: var(--text); border: 1rpx solid var(--border); }
button.history-filter.active,
button.history-filter.active[disabled]:not([type]) { color: var(--accent); border-color: var(--accent); }
button.quest-step.success,
button.quest-step.success[disabled]:not([type]) { color: var(--good); }
button.quest-step.failure,
button.quest-step.failure[disabled]:not([type]) { color: var(--evil); }

.seat-name { white-space: normal; overflow: visible; word-break: break-all; text-overflow: clip; }

/* Public holder marker, independent of role and host privileges. */
.seat-fairy {
  position: absolute;
  right: 8rpx;
  bottom: 6rpx;
  width: 40rpx;
  height: 40rpx;
  pointer-events: none;
}
.seat-fairy-icon { display: block; width: 100%; height: 100%; }
.seat-meta { min-height: 40rpx; }

/* Seat cards: seat context, centered player identity, then public status. */
button.seat,
button.seat[disabled]:not([type]) { position: relative; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; gap: 8rpx; min-height: 288rpx; padding: 16rpx; }
.seats-compact button.seat,
.seats-compact button.seat[disabled]:not([type]) { gap: 6rpx; min-height: 272rpx; padding: 12rpx; }
.seat-head { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; min-height: 40rpx; }
.seat-head .seat-number { display: block; flex-shrink: 0; font-size: 32rpx; line-height: 40rpx; }
.seat-self { flex-shrink: 0; padding: 2rpx 8rpx; font-size: 22rpx; line-height: 36rpx; }
.seat-player { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; min-width: 0; }
.seat-avatar-wrap { position: relative; flex: 0 0 100rpx; width: 100rpx; height: 100rpx; }
.seat-avatar { position: relative; display: block; flex: 0 0 100rpx; width: 100rpx; height: 100rpx; overflow: hidden; border-radius: 50%; background: var(--bg); color: var(--muted); }
.seat-avatar-fallback { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 600; }
.seat-avatar-image { position: absolute; top: 0; right: 0; bottom: 0; left: 0; display: block; width: 100%; height: 100%; object-fit: cover; }
button.seat .seat-name { display: -webkit-box; width: 100%; min-height: 40rpx; font-weight: 600; line-height: 40rpx; text-align: center; white-space: normal; overflow: hidden; word-break: break-all; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
button.seat .seat-meta { display: flex; flex-direction: column; align-items: center; gap: 4rpx; min-height: 32rpx; margin-top: auto; line-height: 32rpx; }
.seat.has-fairy .seat-status { white-space: normal; }
.seat-tags { display: flex; justify-content: center; flex-wrap: wrap; gap: 8rpx; width: 100%; }
button.seat .seat-flag { display: inline-block; min-height: 0; padding: 0 6rpx; border: 2rpx solid var(--border); border-radius: 8rpx; font-size: 22rpx; line-height: 28rpx; white-space: nowrap; }
button.seat .seat-out { margin-top: 0; padding: 0 6rpx; border-width: 2rpx; border-radius: 8rpx; font-size: 22rpx; line-height: 28rpx; white-space: nowrap; }
.seat-status { display: block; max-width: 100%; white-space: nowrap; }
.seat-ready-badge { position: absolute; right: 8rpx; bottom: 6rpx; display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; border-radius: 50%; background: var(--good); pointer-events: none; }
.seat-ready-check { width: 12rpx; height: 6rpx; margin-top: -3rpx; border-left: 3rpx solid var(--bg); border-bottom: 3rpx solid var(--bg); transform: rotate(-45deg); }
button.seat.seat-empty,
button.seat.seat-empty[disabled]:not([type]) { background: var(--bg); border-style: dashed; border-color: var(--seat-empty-border); }
.seat-empty .seat-number { color: var(--muted); }
.seat-empty-body { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; color: var(--muted); }
.seat-empty-mark { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; font-size: 48rpx; font-weight: 400; line-height: 1; }
.seat-empty-label { font-size: 24rpx; line-height: 40rpx; }
.seat-section-title { display: flex; align-items: center; gap: 16rpx; }
.seat-count { font-size: 24rpx; font-weight: 400; color: var(--muted); white-space: nowrap; }
.seat-section-caption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx 24rpx; font-size: 24rpx; line-height: 36rpx; color: var(--muted); }
.seat-ready-count { white-space: nowrap; }

/* Shared room context and seats keep preparation and play visually continuous. */
.page.table-room { padding-top: 16rpx; }
.page.table-lobby { padding-bottom: calc(192rpx + env(safe-area-inset-bottom)); }
.lobby-room-header { padding-bottom: 24rpx; border-bottom: 1rpx solid var(--border); }
.lobby-room-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.room-share-canvas { position: fixed; left: -2000px; top: 0; width: 600px; height: 480px; pointer-events: none; }
button.lobby-header-link.room-invite-button { min-height: 48px; }
button.room-invite-pressed { opacity: .65; }
.room-invitation { padding: 64rpx 0 24rpx; }
.invitation-eyebrow { color: var(--accent); font-size: 26rpx; }
.invitation-title { margin-top: 16rpx; color: var(--text); font-size: 44rpx; font-weight: 600; overflow-wrap: anywhere; }
.invitation-board { margin-top: 16rpx; color: var(--muted); font-size: 28rpx; overflow-wrap: anywhere; }
.invitation-message { margin-top: 32rpx; color: var(--muted); font-size: 28rpx; line-height: 1.6; }
.invitation-form { margin-top: 48rpx; }
.invitation-help { margin: 16rpx 0 32rpx; }
.invitation-actions { margin-top: 32rpx; }
.lobby-room-code { flex: 0 1 auto; min-width: 0; }
.table-room button.lobby-room-code { min-height: 44px; color: var(--text); font-size: 36rpx; font-weight: 600; }
.lobby-room-code text { overflow-wrap: anywhere; }
.lobby-copy-icon { position: relative; flex-shrink: 0; width: 30rpx; height: 32rpx; color: var(--muted); }
.lobby-copy-icon::before, .lobby-copy-icon::after { content: ""; position: absolute; width: 20rpx; height: 24rpx; box-sizing: border-box; border: 2rpx solid currentColor; border-radius: 3rpx; }
.lobby-copy-icon::before { top: 0; right: 0; }
.lobby-copy-icon::after { bottom: 0; left: 0; background: var(--bg); }
button.lobby-header-link,
button.lobby-header-link[disabled]:not([type]) { flex-shrink: 0; width: auto; min-width: 44px; min-height: 44px; margin: 0; padding: 12rpx 0 12rpx 16rpx; gap: 12rpx; border: 0; color: var(--accent); font-size: 26rpx; background: transparent; }
.lobby-board-name { min-width: 0; color: var(--muted); font-size: 28rpx; overflow-wrap: anywhere; }
.lobby-room-status { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; min-height: 64rpx; padding-top: 8rpx; }
.lobby-chip { display: inline-block; padding: 4rpx 16rpx; border: 1rpx solid var(--border); border-radius: 40rpx; color: var(--muted); font-size: 24rpx; line-height: 36rpx; }
.lobby-phase-chip { color: var(--good); border-color: var(--good); }
.room-playing-chip { color: var(--accent); border-color: var(--accent); }
.lobby-room-status button.lobby-settings { margin-left: auto; }
button.lobby-connection { justify-content: flex-start; gap: 12rpx; width: 100%; min-height: 44px; margin: 8rpx 0 0; padding: 12rpx 0; color: var(--muted); font-size: 24rpx; }
.lobby-connection .connection-dot { margin: 0; }
.table-room .task-progress { margin: 28rpx 0 20rpx; }
.table-room .task-progress .section-title { display: flex; justify-content: space-between; align-items: baseline; gap: 8rpx 16rpx; margin: 0; }
.table-room .seat-count { font-size: 24rpx; white-space: normal; }
.table-room .seats { gap: 14rpx; }
/* Reserve the lower corner for the public marker even when a nickname wraps. */
.table-room button.seat,
.table-room button.seat[disabled]:not([type]) { min-height: 256rpx; padding: 12rpx 12rpx 38rpx; gap: 8rpx; border-radius: 16rpx; }
.table-room button.seat.mine,
.table-room button.seat.mine[disabled]:not([type]) { border-color: var(--accent); }
.seat-head-tags { display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: 6rpx; min-width: 0; }
.table-room .seat-head { min-height: 32rpx; gap: 6rpx; }
.table-room .seat-head .seat-number { color: var(--muted); font-size: 28rpx; line-height: 1.3; }
.table-room .seat-self { padding: 0 8rpx; border-radius: 24rpx; background: var(--accent); font-size: 22rpx; line-height: 32rpx; }
.table-room .seat-avatar, .table-room .seat-avatar-wrap { flex-basis: 104rpx; width: 104rpx; height: 104rpx; }
.table-room .seat-avatar-fallback { font-size: 44rpx; }
.table-room button.seat .seat-name { min-height: 36rpx; font-size: 28rpx; line-height: 1.4; }
.table-room .seat-empty-mark { width: 104rpx; height: 104rpx; font-size: 48rpx; }
.table-room button.seat.has-fairy,
.table-room button.seat.has-fairy[disabled]:not([type]) { padding-bottom: 48rpx; }
.table-room .seat-empty-label { font-size: 26rpx; line-height: 36rpx; }
.lobby-action-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--border); background: var(--bg); }
.lobby-action-inner { display: flex; align-items: center; gap: 24rpx; max-width: 836rpx; margin: 0 auto; }
.lobby-ready-controls { display: flex; flex: 1; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0 12rpx; min-width: 0; }
.lobby-ready-status { color: var(--good); font-size: 28rpx; line-height: 40rpx; }
.lobby-action-inner button,
.lobby-action-inner button[disabled]:not([type]) { min-height: 48px; margin: 0; }
.lobby-action-inner button.lobby-ready-button { width: 100%; }
.lobby-action-inner button.lobby-cancel { width: auto; padding: 12rpx 0; font-size: 26rpx; }
.lobby-action-inner button.lobby-start { flex: 0 1 45%; min-width: 0; }
.lobby-spectator-hint { flex: 1; padding: 24rpx 0; color: var(--muted); font-size: 28rpx; }
/* Short viewports keep controls in flow so they cannot cover the seat grid. */
@media (max-height: 500px) and (orientation: landscape) {
  .page.table-lobby { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
  .lobby-action-bar { position: static; margin-top: 24rpx; padding: 20rpx 0; }
}

.result-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.result-team { font-size: 28rpx; font-weight: 400; color: var(--muted); margin-left: auto; }
.history-title { flex-wrap: wrap; }
.history-meta { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.action-team { margin: 16rpx 0 28rpx; font-size: 32rpx; font-weight: 600; color: var(--accent); }
button.history-more,
button.history-more[disabled]:not([type]) { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; width: 100%; min-height: 112rpx; margin: 8rpx 0; padding: 20rpx; background: transparent; color: var(--muted); border: 0; border-radius: 0; box-shadow: none; font-size: 24rpx; font-weight: 400; line-height: 1.4; }
button.history-more::after { border: 0; }
.history-more-chevron { display: block; width: 14rpx; height: 14rpx; border-right: 3rpx solid var(--accent); border-bottom: 3rpx solid var(--accent); transform: rotate(45deg); }
.history-more-chevron.is-expanded { transform: rotate(225deg); }

.fairy-result-summary { margin: 40rpx 0; font-size: 48rpx; line-height: 1.4; font-weight: 650; }
