page {
  --bg: #101c24;
  --surface: #1b2b35;
  --text: #f2eee5;
  --muted: #b1bfc6;
  --accent: #e5c68b;
  --border: #536570;
  --good: #a3dfbe;
  --evil: #f2b6ae;
  --third: #8ab8d9;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 32rpx;
  line-height: 1.6;
}
button {
  font-size: 30rpx;
  border-radius: 16rpx;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: normal;
  line-height: 1.5;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.5;
}
button:not([disabled]):active {
  opacity: 0.78;
}
.page {
  padding: 36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  max-width: 900rpx;
  margin: auto;
  box-sizing: border-box;
}
.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid var(--border);
  padding-bottom: 28rpx;
}
.brand-mark {
  font-size: 40rpx;
  letter-spacing: 8rpx;
  color: var(--accent);
  font-weight: 700;
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
}
.intro {
  padding: 60rpx 0 36rpx;
}
.headline {
  font-size: 60rpx;
  line-height: 1.3;
  font-weight: 600;
  margin: 20rpx 0 24rpx;
  letter-spacing: 2rpx;
}
.kicker {
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: var(--accent);
}
.muted {
  color: var(--muted);
  display: block;
}
.small {
  font-size: 26rpx;
}
.panel {
  background: var(--surface);
  border: 1rpx solid var(--border);
  padding: 28rpx;
  border-radius: 20rpx;
  margin: 24rpx 0;
}
.label {
  display: block;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.input {
  box-sizing: border-box;
  height: 104rpx;
  background: var(--bg);
  border: 1rpx solid var(--border);
  padding: 0 24rpx;
  line-height: normal;
  border-radius: 12rpx;
  margin: 12rpx 0 24rpx;
  color: var(--text);
  font-size: 32rpx;
}
.room-input {
  letter-spacing: 5rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.picker {
  padding: 22rpx;
  color: var(--accent);
}
.primary {
  background: var(--accent);
  color: var(--bg);
  font-weight: 600;
  margin-top: 24rpx;
}
.secondary {
  background: transparent;
  color: var(--text);
  border: 1rpx solid var(--border);
  margin-top: 20rpx;
}
.text-button {
  background: transparent;
  color: var(--muted);
  margin-top: 12rpx;
  font-size: 28rpx;
}
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 36rpx 0;
}
.section-title {
  margin: 40rpx 0 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.board-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.tag {
  font-size: 24rpx;
  color: var(--accent);
  white-space: nowrap;
}
.error {
  background: #542d30;
  color: #ffe7e7;
  padding: 24rpx;
  border-radius: 16rpx;
  margin: 24rpx 0;
}
.error button {
  background: transparent;
  color: #ffe7e7;
  border: 1rpx solid #d6a5aa;
  margin-top: 16rpx;
}
.notice,
.status {
  color: var(--accent);
  padding: 20rpx 0;
  font-size: 28rpx;
}
.room-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 36rpx 0 12rpx;
}
.room-code {
  font-size: 76rpx;
  letter-spacing: 8rpx;
  line-height: 1.3;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.my-seat {
  text-align: right;
  font-size: 52rpx;
}
.subline {
  font-size: 24rpx;
  color: var(--muted);
  flex-wrap: wrap;
}
.phase-strip {
  border-left: 4rpx solid var(--accent);
  padding: 16rpx 20rpx;
  margin: 24rpx 0;
  background: var(--surface);
}
.phase-heading {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.phase-label {
  flex-shrink: 0;
  color: var(--muted);
  font-size: 24rpx;
}
.phase-name {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.phase-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}
.phase-title {
  font-size: 44rpx;
  font-weight: 600;
  margin: 8rpx 0;
}
.seats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}
.seat {
  display: block;
  background: var(--surface);
  color: var(--text);
  padding: 16rpx 12rpx;
  text-align: left;
  border: 2rpx solid var(--border);
  margin: 0;
  width: 100%;
  min-height: 172rpx;
}
.seat.team,
.seat.selected {
  border-color: var(--accent);
  background: #354039;
}
.seat-number {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--accent);
}
.seat-flag {
  float: right;
  font-size: 24rpx;
  color: var(--muted);
  padding-top: 8rpx;
}
.seat-name {
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.seat-meta {
  font-size: 24rpx;
  color: var(--muted);
}
.identity {
  padding: 36rpx 28rpx;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  text-align: center;
  margin: 32rpx 0;
  background: repeating-linear-gradient(
    135deg,
    #182831,
    #182831 18rpx,
    #1b2b35 18rpx,
    #1b2b35 20rpx
  );
}
.identity.open {
  background: var(--surface);
}
.identity-title {
  font-size: 46rpx;
  font-weight: 600;
  margin: 26rpx 0 12rpx;
}
.private-info {
  margin-top: 24rpx;
  text-align: left;
}
.private-actions {
  text-align: left;
  border-top: 1rpx solid var(--border);
  margin-top: 24rpx;
  padding-top: 24rpx;
}
.submission {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 20rpx;
}
.team-line {
  margin-top: 24rpx;
  color: var(--accent);
}
.host-panel {
  border-style: dashed;
}
.result {
  background: #263c38;
  padding: 32rpx;
  border-radius: 20rpx;
  margin-top: 24rpx;
}
.history-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  padding-top: 48rpx;
}
.compact {
  font-size: 28rpx;
}
.row .label {
  margin-bottom: 0;
}

button.seat[disabled] {
  opacity: 1;
  background: var(--surface);
  color: var(--text);
}
button.seat.team[disabled],
button.seat.selected[disabled] {
  background: #354039;
}

/* Keep the entry focused on the current action. */
.brand {
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  padding-bottom: 24rpx;
}
.brand-mark {
  font-size: 38rpx;
  letter-spacing: 4rpx;
}
.eyebrow {
  font-size: 24rpx;
  letter-spacing: 0;
}
button {
  width: 100%;
}
.entry-panel {
  margin-top: 28rpx;
  padding: 24rpx;
}
.entry-panel .input {
  margin-bottom: 24rpx;
}
.entry-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--border);
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.entry-tab {
  flex: 1;
  background: transparent;
  color: var(--muted);
  border-radius: 0;
  min-height: 96rpx;
  padding: 16rpx 0;
  border-bottom: 4rpx solid transparent;
  margin: 0;
}
.entry-tab.active {
  color: var(--accent);
  border-bottom-color: var(--accent);
  font-weight: 600;
}
.field-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-weight: 600;
  margin: 24rpx 0 16rpx;
}
.field-title .muted {
  font-weight: 400;
}
.capacity-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
}
.capacity-option {
  background: var(--bg);
  border: 1rpx solid var(--border);
  color: var(--text);
  padding: 16rpx 4rpx;
  margin: 0;
}
.capacity-option.active {
  background: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
  font-weight: 700;
}
.board-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.board-option {
  background: var(--bg);
  border: 1rpx solid var(--border);
  color: var(--text);
  justify-content: space-between;
  text-align: left;
  gap: 16rpx;
  margin: 0;
}
.board-option.active {
  border-color: var(--accent);
  color: var(--accent);
}
.selection-mark {
  font-size: 24rpx;
  flex-shrink: 0;
}
.single-board {
  color: var(--accent);
  padding: 16rpx 0;
}
.rules-toggle {
  min-height: 88rpx;
  justify-content: flex-start;
  padding: 16rpx 0;
  margin: 0;
  font-size: 26rpx;
}
.rules-detail {
  padding: 0 0 16rpx;
}
.assisted-hint {
  margin-top: 16rpx;
}
.entry-panel .primary {
  margin-top: 8rpx;
}
.setting-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

form.entry-panel {
  display: block;
}
button.capacity-option,
button.board-option,
button.primary,
button.secondary,
button.text-button {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}
button.entry-tab {
  width: 100%;
  min-width: 0;
}
button.capacity-option {
  margin: 0;
}

.member-room {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 20rpx;
}
button.room-open {
  flex: 1;
  width: 0;
  margin: 0;
  text-align: left;
  justify-content: flex-start;
}
button.room-delete {
  flex-shrink: 0;
  width: 104rpx;
  margin: 0;
  background: transparent;
  color: #f2b6ae;
  border: 1rpx solid var(--border);
  padding: 16rpx 8rpx;
}

.dialog-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.error-dialog {
  width: 100%;
  max-width: 620rpx;
  max-height: 80vh;
  overflow-y: auto;
  padding: 36rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
}
.dialog-title {
  font-size: 36rpx;
  font-weight: 600;
}
.dialog-message {
  margin: 24rpx 0 32rpx;
  color: var(--muted);
  font-size: 30rpx;
  line-height: 1.7;
  overflow-wrap: break-word;
}
.dialog-actions {
  display: flex;
  gap: 16rpx;
}
.dialog-actions button {
  flex: 1;
  margin: 0;
}

/* Explicit button selectors override WeChat's default non-mini button width. */
button.seat {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 20rpx;
  min-height: 184rpx;
  padding: 18rpx;
}
.seat-number {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}
.seat-flag {
  float: none;
  padding: 0;
  font-size: 22rpx;
}
.seat.mine .seat-flag {
  background: var(--text);
  color: var(--bg);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-weight: 700;
}
.seat.team .seat-meta,
.seat.selected .seat-meta {
  color: var(--accent);
  font-weight: 600;
}
button.leave-button {
  width: 100%;
  margin: 32rpx 0 0;
  background: #35272b;
  color: #f2b6ae;
  border: 1rpx solid #ab7774;
  font-weight: 600;
}
.brand {
  justify-content: space-between;
  flex-wrap: nowrap;
  gap: 8rpx;
}
.brand-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
button.switch-table {
  width: auto;
  margin: 0;
  min-height: 88rpx;
  padding: 12rpx;
  font-size: 26rpx;
  background: transparent;
  color: var(--muted);
}
button.connection-button {
  width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
}
.connection-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.connection-dot.online {
  background: #83cba0;
  box-shadow: 0 0 0 6rpx rgba(131, 203, 160, 0.12);
}
.connection-dot.pending {
  background: var(--accent);
}
.connection-dot.offline {
  background: #ed9d94;
}

.room-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 12rpx 0 8rpx;
}
button.copy-room {
  width: auto;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 0;
  display: flex;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: transparent;
  color: var(--muted);
}
.copy-label {
  color: var(--accent);
  font-size: 24rpx;
}
.summary-seat {
  font-size: 26rpx;
  color: var(--muted);
  flex-shrink: 0;
}

.role-line {
  font-size: 28rpx;
  line-height: 1.8;
  margin-top: 12rpx;
  color: var(--text);
}
.configuration-roles {
  margin: 24rpx 0;
}
.room-subline {
  flex-wrap: nowrap;
  gap: 0 16rpx;
}
.room-board-info {
  display: flex;
  flex: 1;
  align-items: center;
  flex-wrap: nowrap;
  gap: 0 12rpx;
  min-width: 0;
}
.room-board-name {
  min-width: 0;
}
button.room-rules-button {
  width: auto;
  min-width: 0;
  flex-shrink: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 12rpx 8rpx;
  background: transparent;
  color: var(--accent);
  font-size: 24rpx;
}
.room-host-label {
  flex-shrink: 0;
  white-space: nowrap;
  margin-left: auto;
}

.tool-actions,
.tool-seat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin: 24rpx 0;
}
.tool-actions button {
  margin: 0;
}
button.tool-seat-option {
  width: 100%;
  min-width: 0;
  margin: 0;
  min-height: 88rpx;
  padding: 12rpx;
  background: var(--bg);
  color: var(--text);
  border: 1rpx solid var(--border);
  font-size: 26rpx;
}
button.tool-seat-option.active {
  color: var(--accent);
  border-color: var(--accent);
  background: #354039;
}

.tool-seat-scroll {
  margin: 24rpx 0;
  overflow-y: auto;
}
.tool-seat-scroll .tool-seat-grid {
  margin: 0;
}

button.identity-compact {
  width: 100%;
  min-height: 96rpx;
  margin: 24rpx 0;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--border);
  font-size: 28rpx;
}
.identity-compact-action {
  color: var(--accent);
}
.operation-progress {
  margin: 28rpx 0;
  border-top: 1rpx solid var(--border);
  padding-top: 24rpx;
}
.progress-heading,
.progress-player {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.progress-heading {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.progress-player {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
}
.progress-player-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.progress-state {
  flex-shrink: 0;
  font-size: 26rpx;
}
.progress-state.completed {
  color: var(--accent);
}
.progress-state.not-required {
  color: var(--muted);
}
.finish-game-footer {
  margin-top: 48rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--border);
}
button.finish-game-button {
  width: 100%;
  margin: 0;
  background: #35272b;
  color: #f2b6ae;
  border: 1rpx solid #ab7774;
  font-weight: 600;
}

.action-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 16rpx 0 24rpx;
  font-size: 28rpx;
  color: var(--accent);
}
.action-entry button {
  width: auto;
  min-height: 88rpx;
  margin: 0;
  flex-shrink: 0;
}
.action-choice-list {
  margin-top: 24rpx;
}
.action-choice-list button {
  margin: 0 0 16rpx;
}
.action-choice-list button:last-child {
  margin-bottom: 0;
}
.action-target-scroll {
  height: 440rpx;
  overflow-y: auto;
}
.action-dialog .text-button {
  margin-bottom: 0;
}

.action-identity {
  margin: 24rpx 0;
  overflow-wrap: break-word;
}
.action-identity-details {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
}
.action-identity .identity-title {
  margin-top: 0;
}
.action-identity .private-info {
  white-space: pre-wrap;
}
.action-identity button {
  margin: 0;
}

.quest-threshold {
  margin-top: 24rpx;
}
.threshold-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin: 12rpx 0;
}
.threshold-hint {
  color: var(--accent);
  margin-top: 8rpx;
}

/* Compact two-seat selection for the magician's private action. */
.swap-seat-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.swap-seat-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
}

.history-detail {
  white-space: pre-line;
  line-height: 1.7;
}
.history-title,
.quest-summary,
.quest-summary-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.history-title {
  margin-bottom: 8rpx;
}
.quest-summary {
  flex-wrap: wrap;
  gap: 24rpx;
  margin: 24rpx 0;
  font-size: 28rpx;
}
.quest-result-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}
.quest-result-icon.success {
  color: #a3dfbe;
  background: #253e35;
}
.quest-result-icon.failure {
  color: #f2b6ae;
  background: #493033;
}

button.room-open {
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  padding: 20rpx 24rpx;
  line-height: 1.5;
}
.member-room-code {
  font-size: 32rpx;
  font-weight: 600;
}
.member-room-board {
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 400;
  white-space: normal;
}
.history-row {
  padding: 24rpx 0;
}
.history-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.history-vote-line {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  margin: 10rpx 0;
  font-size: 26rpx;
  line-height: 1.65;
}
.history-vote-count {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex: 0 0 140rpx;
}
.history-count {
  font-weight: 600;
  font-size: 30rpx;
  color: var(--text);
}
.history-vote-seats {
  flex: 1;
  min-width: 0;
  color: var(--muted);
  overflow-wrap: anywhere;
}
.history-team {
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.65;
}
.history-cards {
  display: flex;
  flex-wrap: wrap;
  column-gap: 28rpx;
  row-gap: 8rpx;
  margin-top: 10rpx;
}
.history-card-count {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--muted);
}

/* Faction color system: color the role name only — good green, evil red, third blue. */
.faction-good {
  color: var(--good);
}
.faction-evil {
  color: var(--evil);
}
.faction-third {
  color: var(--third);
}
.result-good {
  background: #263c38;
}
.result-evil {
  background: #3a2a2c;
}
.result-neutral {
  background: var(--surface);
}
.history-vote-count.approve,
.history-vote-count.approve .history-count {
  color: var(--good);
}
.history-vote-count.reject,
.history-vote-count.reject .history-count {
  color: var(--evil);
}

/* Sticky host action bar: settle / cancel stay reachable during an operation. */
.page.has-host-bar {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}
.host-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  background: var(--bg);
  border-top: 1rpx solid var(--border);
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.host-action-bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  max-width: 900rpx;
  margin: 0 auto;
}
.host-action-bar-inner button {
  margin: 0;
  min-height: 88rpx;
}
.host-action-bar-inner .bar-settle {
  flex: 2;
}
.host-action-bar-inner .bar-cancel {
  flex: 0 0 152rpx;
  font-size: 26rpx;
}

/* Current action stays separate from the last durable public result. */
.action-status-copy { flex: 1; min-width: 0; }
.action-status-copy .small { margin-top: 8rpx; }
.latest-result { margin: 32rpx 0; padding: 32rpx; border: 1px solid var(--accent); border-radius: 24rpx; background: var(--surface); }
.latest-result-title { margin: 16rpx 0; font-size: 40rpx; font-weight: 600; }
.latest-result .history-detail { white-space: pre-line; overflow-wrap: anywhere; }
.host-waiting-copy { flex: 1; min-width: 0; }
.history-vote-count.abstain { color: var(--muted); }

.host-action-bar-inner .bar-cutoff { flex: 0 0 192rpx; padding: 16rpx 12rpx; font-size: 28rpx; }

/* Public history and seat status */
.seat-out { display: inline-block; margin-top: 6rpx; padding: 0 10rpx; border: 1rpx solid var(--evil); border-radius: 6rpx; color: var(--evil); font-size: 24rpx; }
.seat-flag { float: none; display: block; min-height: 32rpx; padding-top: 0; }
.history-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
button.history-toggle { width: auto; flex-shrink: 0; margin: 0; min-height: 88rpx; padding: 8rpx 12rpx; background: transparent; color: var(--accent); font-size: 26rpx; }
.history-filters, .quest-timeline { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
button.history-filter, button.quest-step { width: auto; margin: 0; min-height: 88rpx; padding: 12rpx 20rpx; font-size: 26rpx; background: var(--surface); color: var(--text); border: 1rpx solid var(--border); }
button.history-filter.active { color: var(--accent); border-color: var(--accent); }
button.quest-step.success { color: var(--good); }
button.quest-step.failure { color: var(--evil); }

.seat-name { white-space: normal; overflow: visible; word-break: break-all; text-overflow: clip; }

/* Public holder marker, independent of role and host privileges. */
.seat-fairy {
  display: inline-block;
  padding: 0 8rpx;
  margin-right: 8rpx;
  border: 1px solid var(--accent);
  border-radius: 8rpx;
  color: var(--accent);
  font-size: 24rpx;
  line-height: 1.5;
  white-space: nowrap;
}
.seat-meta { min-height: 40rpx; }

.result-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; }
.result-team { font-size: 28rpx; font-weight: 400; color: var(--muted); margin-left: auto; }
.history-title { flex-wrap: wrap; }
.history-meta { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.action-team { margin: 16rpx 0 28rpx; font-size: 32rpx; font-weight: 600; color: var(--accent); }
button.history-more { margin: 20rpx 0; background: transparent; color: var(--accent); border: 1rpx solid var(--border); }

.fairy-result-summary { margin: 40rpx 0; font-size: 48rpx; line-height: 1.4; font-weight: 650; }
.host-action-bar-inner.has-waiting { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: stretch; gap: 12rpx 16rpx; }
.has-waiting .host-waiting-copy { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 16rpx; }
.host-action-bar-inner.has-waiting button { width: 100%; min-width: 0; min-height: 88rpx; padding: 16rpx 12rpx; line-height: 1.4; display: flex; align-items: center; justify-content: center; white-space: normal; overflow-wrap: anywhere; box-sizing: border-box; }
