  background: #35272b;
  color: #f2b6ae;
  border: 1rpx solid #ab7774;
  font-weight: 600;
}

.action-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 16rpx 0 24rpx;
  font-size: 28rpx;
