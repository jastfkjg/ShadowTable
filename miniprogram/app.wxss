}
.history-vote-count.reject,
.history-vote-count.reject .history-count {
  color: var(--evil);
}

/* Sticky host action bar: settle / cancel stay reachable during an operation. */
.page.has-host-bar {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}
.host-action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  background: var(--bg);
  border-top: 1rpx solid var(--border);
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.host-action-bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
