}
button.progress-toggle { width:100%; min-height:88rpx; margin:0; padding:8rpx 0; border:0; border-radius:0; background:transparent; color:var(--text); text-align:left; flex-wrap:wrap; }
.progress-title { flex:1; }
.progress-count { white-space:nowrap; }
.progress-disclosure { color:var(--muted); font-size:24rpx; font-weight:400; white-space:nowrap; }
.progress-player {
